# A directory of games, built by ix's tools: the author's playground's
# games (docs/plans/done/plan_playground.md), each linked with the
# libraries (mkfiles/mklibs): lib_playground and its APIs' libraries
# (physics, gui, audio, juice, netcode), lib_graphics, and one platform
# (PLATFORM):
# ppm, no window, a frame written to a file (Linux's); and Plan 9's two
# (mini-mk O=5 OS=plan9: mini-9pi's), over lib_graphics's client of the
# draw device: draw, the device asked for each shape (the default there:
# the author, 2026-10-07, having seen its frames a second: "let's
# default to the draw-device platform then when building games, for
# now"), and software, the pixels computed here and given as a picture
# (PLATFORM=software: made beside, games/puzzle-soft). A directory's mkfile sets TOP,
# DIR (its directory from TOP), GAMES (its units: Tetris) and WITH,
# says its first target (all: games), then includes this; games/mkfile
# makes the libraries once (libs), then each directory.
# A program links only the units it uses: every library is named, and
# WITH says only which of other programs' units a directory's programs
# stand on, compiled here, each directory's objects in a directory of
# its own (a % of mk's takes a / too: one directory under another would
# be two rules for a unit).
# old: each library's units listed here by WITH (physics, gui, audio,
# juice, multiplayer, ways, pdf, studio: now in the libraries) and
# compiled here, as many lists as libraries
<$TOP/mkfiles/mkconfig
PLATFORM=`{if(~ $OS plan9) echo draw; if not echo ppm}
# (a game linked with the platform that computes its pixels is made
# beside the other: games/puzzle-soft)
BESIDE=`{~ $PLATFORM software && echo -soft}
D=$B/$DIR$BESIDE
# (each after the ones it names)
LIBDIRS=lib_compression lib_graphics lib_playground lib_playground/physics lib_playground/juice lib_gui lib_audio lib_networking \
 lib_networking/netcode lib_playground/ai lib_playground/apis lib_playground/platforms lib_playground/platforms/$PLATFORM
<$TOP/mkfiles/mklibs
S=$TOP/languages/scheme
SO=$B/lib_playground/scheme
M=$TOP/apps/office/formula
MO=$B/lib_playground/formula
X=$TOP/examples/gui4
XO=$B/lib_playground/gui4
Q=$TOP/apps/office
QO=$B/lib_playground/office
K=$TOP/games/shmup/kit
KO=$B/lib_playground/shmup
R=$TOP/apps/music/rebirth
RBO=$B/lib_playground/rebirth
# (apps/office's folders: a unit is compiled from the one that has it)
OFFICEDIRS=document richtext paint draw sheet shapes parts file_menu suite
OFFICEI=${OFFICEDIRS:%=-I $Q/%}
# (lib_playground before lib_core: its Cmd is Elm's, not commons/'s)
INCLUDES=-I . -I $K -I $R -I $S -I $M -I $X $OFFICEI $LIBI $STDI
# (what only some programs ask, other programs' units: a directory's
# mkfile says WITH=scheme. scheme, the language, languages/scheme's
# units but its command; formula, a sheet's formulas
# (apps/office/formula); undo, apps/office's Undo alone; gui4, the tasks
# written four ways (examples/gui4); office, what mini-office stands on
# (apps/office's folders: a text with looks and its page, a picture as
# bits, one as objects, a document's bytes, their shapes, the parts);
# sheet, a sheet and how it is drawn, alone, for Gui7Cells; rebirth,
# mini-rebirth's studio and its two voices, apps/music/rebirth's units
# but the program; shmup, the shooters' kit, games/shmup/kit)
REBIRTH=`{~ $WITH *rebirth* && echo Patch_text Voice_tb303 Voice_tr808 Studio_rebirth Skin}
REBIRTHOBJS=`{for(u in $REBIRTH) echo $RBO/$u.$O}
KIT=`{~ $WITH *shmup* && echo Shots}
KITOBJS=`{for(u in $KIT) echo $KO/$u.$O}
SCHEME=`{~ $WITH *scheme* && echo Sexpr Sexpr_read Scheme_image Scheme Scheme_syntax Scheme_prims Scheme_prelude Scheme_eval Scheme_step}
SCHEMEOBJS=`{for(u in $SCHEME) echo $SO/$u.$O}
FORMULA=`{~ $WITH *formula* && echo Formula}
FORMULAOBJS=`{for(u in $FORMULA) echo $MO/$u.$O}
KITS=`{~ $WITH *office* *undo* && echo Undo}
KITSOBJS=`{for(u in $KITS) echo $QO/$u.$O}
GUI4=`{~ $WITH *gui4* && echo Gui4 Gui4Counter Gui4Temperature Gui4Flight Gui4Timer Gui4Circles}
GUI4OBJS=`{for(u in $GUI4) echo $XO/$u.$O}
OFFICE=`{if(~ $WITH *office*) echo Saved Style Rich Page Bitmap Pattern Seed_fill Paint Figure Drawing Sheet Sheet_view Stroke_text Figure_shapes Component Part_text Part_sheet Part_picture Part_drawing Part_chart Part_image File_menu Document Office_page Office_templates Office_model Office_edit Office_update Office_view Office_export; if not if(~ $WITH *sheet*) echo Sheet Sheet_view}
OFFICEOBJS=`{for(u in $OFFICE) echo $QO/$u.$O}
LIB=$REBIRTH $FORMULA $KITS $GUI4 $KIT $SCHEME $OFFICE
LIBOBJS=$REBIRTHOBJS $FORMULAOBJS $KITSOBJS $GUI4OBJS $KITOBJS $SCHEMEOBJS $OFFICEOBJS
LOCAL=`{ls *.ml $S/*.ml $S/*.mli $M/*.ml $M/*.mli $X/*.ml $X/*.mli $Q/[a-eg-z]*/*.ml $Q/[a-eg-z]*/*.mli $Q/file_menu/*.ml $Q/file_menu/*.mli $K/*.ml $K/*.mli $R/*.ml $R/*.mli >[2]/dev/null} $LIBSRC
LIBS=$LIBOBJS $LIBA $STDOBJS $STDEND $TOP/mkfiles/mkconfig

libs:V: $LIBA $LIBOBJS
games:V: ${GAMES:%=$D/%.linked}

$RBO/%.$O: $R/%.ml $LOCAL
	mkdir -p $RBO
	$ML $INCLUDES -o $target $R/$stem.ml
$KO/%.$O: $K/%.ml $LOCAL
	mkdir -p $KO
	$ML $INCLUDES -o $target $K/$stem.ml
$SO/%.$O: $S/%.ml $LOCAL
	mkdir -p $SO
	$ML $INCLUDES -o $target $S/$stem.ml
$MO/%.$O: $M/%.ml $LOCAL
	mkdir -p $MO
	$ML $INCLUDES -o $target $M/$stem.ml
$XO/%.$O: $X/%.ml $LOCAL
	mkdir -p $XO
	$ML $INCLUDES -o $target $X/$stem.ml
$QO/%.$O: $LOCAL
	mkdir -p $QO
	$ML $INCLUDES -o $target `{ls $Q/*/$stem.ml | awk '!/\/tests\/|\/formula\//'}

# a game: its unit (Tetris.ml), the program its name in small letters
# (tetris); Tetris.linked says it is made
$D/%.$O: %.ml $LOCAL
	mkdir -p $D
	$ML $INCLUDES -o $target $stem.ml
$D/%.linked: $D/%.$O $LIBS
	$ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA} $LIB $stem Std_exit -o $D/$stem.start.$O
	$LD $LDH -nofollow -o $D/`{echo $stem | tr A-Z a-z} $D/$stem.start.$O $STDOBJS $LIBA $LIBOBJS $D/$stem.$O $STDEND
	touch $target

# the units' order (mkfiles/depend.rc) in the directories their objects
# share, as this mkfile's WITH asks them, a file each, beside this
# game's objects (not theirs: another game's WITH may ask others); made
# when older than the mkfile or a source. mini-mk depend: made again
depend:V:
	{ cflag=() $RC $TOP/mkfiles/depend.rc -f $D/.depend-QO QO -- $KITS $OFFICE
	  cflag=() $RC $TOP/mkfiles/depend.rc -f $D/.depend-XO XO -- $GUI4
	  cflag=() $RC $TOP/mkfiles/depend.rc -f $D/.depend-SO SO -- $SCHEME
	  cflag=() $RC $TOP/mkfiles/depend.rc -f $D/.depend-MO MO -- $FORMULA
	  cflag=() $RC $TOP/mkfiles/depend.rc -f $D/.depend-RBO RBO -- $REBIRTH
	  cflag=() $RC $TOP/mkfiles/depend.rc -f $D/.depend-KO KO -- $KIT } > /dev/null
<|cflag=() $RC $TOP/mkfiles/depend.rc $D/.depend-QO QO -- $KITS $OFFICE
<|cflag=() $RC $TOP/mkfiles/depend.rc $D/.depend-XO XO -- $GUI4
<|cflag=() $RC $TOP/mkfiles/depend.rc $D/.depend-SO SO -- $SCHEME
<|cflag=() $RC $TOP/mkfiles/depend.rc $D/.depend-MO MO -- $FORMULA
<|cflag=() $RC $TOP/mkfiles/depend.rc $D/.depend-RBO RBO -- $REBIRTH
<|cflag=() $RC $TOP/mkfiles/depend.rc $D/.depend-KO KO -- $KIT

clean:V:
	rm -rf $D
	if(~ $DIR games) rm -rf $B/lib_playground/scheme $B/lib_playground/formula $B/lib_playground/gui4 $B/lib_playground/office $B/lib_playground/shmup $B/lib_playground/rebirth
