# mini-acid, built by ix's tools: its lexer by mini-lex, its grammar by
# mini-yacc; Ptrace linux/mini-ml/'s, which has none (dune's is linux/'s)
TOP=../..
DIR=debuggers/acid
PROG=mini-acid
SRC=Ast Code Value Eval Das Das_arm64 Ptrace Acid_dwarf Frame64 Proc Parser Lexer Builtin CLI Main
LOCAL=`{ls *.ml *.mli *.mly *.mll linux/mini-ml/*.ml}
LIBI=
LIBUNITS=
LIBOBJS=
# (the program's tables read)
LIBDIRS=lib_executable
<$TOP/mkfiles/mkconfig
GEN=$B/debuggers/acid/Parser.ml $B/debuggers/acid/Lexer.ml
<$TOP/mkfiles/mkprog

# the units mini-yacc and mini-lex made, by their names
$D/Parser.$O: $D/Parser.ml $LOCAL
	$ML $INCLUDES -o $target $D/Parser.ml
$D/Lexer.$O: $D/Lexer.ml $D/Parser.ml $LOCAL
	$ML $INCLUDES -o $target $D/Lexer.ml
$D/Ptrace.$O: linux/mini-ml/Ptrace.ml $LOCAL
	$ML $INCLUDES -o $target linux/mini-ml/Ptrace.ml
