# mini-9pi on the Pi 4 (mini-9pi4), built by ix's tools
# (docs/plans/done/plan_kernel_mini_ml.md, step 8). It is the Makefile's
# kernel, which the Makefile builds with ocaml-light, gcc, and GNU's as
# and ld, built here by mini-ml, mini-cc, mini-asm and mini-ld instead.
# It has the
# same OCaml, the same C, and the pixels in OCaml (the Makefile's
# PIXEL=ocaml, its default); ../lib_machine/mkkernel says what else it
# has. Like the Makefile's kernel, it takes principia's programs (the
# boot's, in the kernel's bootdir) and principia's SD card image.
#   mini-mk          builds _mk/7/kernels/9pi/kernel8.img
#   mini-mk run      runs it under mini-qemu (Ctrl-A x quits)
#   mini-mk check    runs the Makefile's check with this image
TOP=../..
DIR=kernels/9pi
PRINCIPIA=/home/pad/principia
<$TOP/mkfiles/mkconfig
D=$B/$DIR
GFX=lib_graphics
# The Makefile's ML, for this machine. The trap frame's Ureg is arm64's
# on the Pi 4 and arm's on the Pi 1 (mini-mk O=5); the drivers under
# arm/ serve both boards.
UREG=syscalls/`{if(~ $O 5) echo arm; if not if(~ $O 7) echo arm64}
BOARD=`{if(~ $O 5) echo pi1; if not if(~ $O 7) echo pi4}
KML=$UREG/Ureg core/Errors core/Types files/Dev processes/Proc files/Kchan processes/Kproc devices/sys/Devroot security/Rng console/Devcons \
 devices/sys/Devenv devices/sys/Devsys devices/sys/Devarch devices/sys/Devdup devices/sys/Devsrv devices/sys/Devpipe \
 devices/sys/Devproc devices/storage/arm/Emmc devices/storage/Devsd filesystems/lib_fat/Fat filesystems/Kdos filesystems/lib_xv6fs/Xv6fs filesystems/Kfs files/P9 files/P9_wire devices/sys/Devmnt \
 buses/Usb buses/arm/Usbdwc buses/Devusb devices/keyboard/Latin1 devices/keyboard/Kbd \
 $GFX/Memdata $GFX/lib_memdraw/Memchan $GFX/lib_memdraw/Memimage $GFX/lib_memdraw/Memgeneral $GFX/lib_memdraw/Memdraw $GFX/lib_memdraw/Memfont \
 $GFX/lib_memlayer/Memlayer $GFX/lib_memlayer/Memshape $GFX/ocaml/Kdraw \
 devices/screen/Swcursor devices/screen/Swconsole devices/keyboard/Devkbin devices/mouse/Devmouse devices/audio/Devaudio \
 buses/lib_usb/Usbdesc buses/lib_usb/Hid buses/lib_usb/Usbbus buses/Kusb devices/web/Kweb devices/screen/Devdraw \
 devices/Devstub network/Etherusb network/Devether network/ip/Ip network/ip/Icmp network/ip/Udp network/ip/Tcp network/ip/Devip memory/Fault memory/Sysseg processes/Exec \
 ../../lib_executable/Symbols ../../lib_executable/Frames syscalls/Usermem processes/Sysproc processes/Syssema files/Sysfile security/Auth syscalls/Systab \
 syscalls/arm/Syscall init/Main
KNAMES=Ureg Errors Types Dev Proc Kchan Kproc Devroot Rng Devcons Devenv Devsys Devarch Devdup Devsrv Devpipe Devproc Emmc Devsd Fat Kdos Xv6fs Kfs P9 P9_wire Devmnt \
 Usb Usbdwc Devusb Latin1 Kbd Memdata Memchan Memimage Memgeneral Memdraw Memfont Memlayer Memshape Kdraw Swcursor Swconsole Devkbin Devmouse Devaudio Usbdesc Hid Usbbus Kusb Kweb \
 Devdraw Devstub Etherusb Devether Ip Icmp Udp Tcp Devip Fault Sysseg Exec Symbols Frames Usermem Sysproc Syssema Sysfile Auth Systab Syscall Main
# (syscalls comes before its arm/, so that Ureg's interface is found
# there, and not the Pi 1's Ureg.ml.)
KI=-I syscalls -I $UREG -I core -I files -I processes -I devices -I devices/sys -I console \
 -I devices/storage -I devices/storage/arm -I buses -I buses/arm -I buses/lib_usb -I filesystems -I filesystems/lib_fat -I filesystems/lib_xv6fs -I devices/keyboard -I devices/mouse -I devices/audio -I devices/web -I devices/screen \
 -I $GFX -I $GFX/lib_memdraw -I $GFX/lib_memlayer -I $GFX/ocaml -I network -I network/ip -I memory -I security -I syscalls/arm -I init \
 -I ../../lib_executable
# The status of an AArch32 process (board.h), because principia's
# programs are arm programs. The Pi 4 needs this flag; on the Pi 1 it
# is board.h's own value, so it is just said twice.
KFLAGS='-DTF_USER_PSR=0x10'
FS=$D/bootdir
<$TOP/kernels/lib_machine/mkkernel

# The boot's directory, made by the Makefile's generator. (The pixels'
# tables, principia's, are in the repository: lib_graphics/Memdata.ml.)
BOOTRC=$PRINCIPIA/kernel/init/user/boot/arm/boot.rc
BIN=$PRINCIPIA/ROOT/arch/arm/bin
$D/bootdir: $BOOTRC
	mkdir -p $D
	mini-mkbootdir $target $PRINCIPIA 'boot='$BOOTRC 'rcmain='$PRINCIPIA/ROOT/rc/lib/rcmain \
	  'rc='$BIN/rc 'echo='$BIN/echo 'bind='$BIN/bind 'fdisk='$BIN/fdisk 'dossrv='$BIN/dossrv 'mount='$BIN/mount 'ls='$BIN/ls

SD=-drive file=$PRINCIPIA/qemu-sd.img,if=sd,format=raw,snapshot=on
run:V: $IMAGE
	mini-qemu $BOOT -nographic $SD

# The Makefile's check, with this image (and a second one, with the
# boot script of stage B, in a directory of its own). The Makefile runs
# for its check only: it is told not to make the images (-o) and where
# its outputs go. So the commands, the sessions and the expected
# screens are the Makefile's, and nothing here repeats them.
#   mini-mk check    (long: it runs every session under mini-qemu and
#                    QEMU)
IMAGE_B=$B/kernels/9pi-b/`{basename $IMAGE}
stageb:V:
	$MK 'O='$O 'DIR='kernels/9pi-b 'BOOTRC='tests/boot-b.rc
check:V: $IMAGE stageb
	mkdir -p $D/check
	make 'BOARD='$BOARD check 'IMAGE='$IMAGE 'IMAGE_B='$IMAGE_B 'B='$D/check -o $IMAGE -o $IMAGE_B >[2=1] | grep '^ok \|^[<>] \|differ\|rror' | sed 's/^ok 9pi:/ok 9pi on the '^$BOARD^', by ix:/'
