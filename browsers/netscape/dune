; browsers/netscape: mini-netscape, Netscape's window over the engine
; (docs/plans/plan_browser.md, stage 7). The program here is linked with
; the platform that writes a frame to a file (the tests'); sdl/ is the
; one with a window, bin/mini-netscape
(library
 (name ix_netscape)
 (wrapped false)
 (modules Tab Browser_zoom Places Scrollbar Browser_profile Worker_spawn Tab_worker)
 (libraries threads.posix ix_graphics_core ix_webapi ix_javascript ix_browser_engine ix_css ix_html ix_http ix_mail ix_tls ix_tcp ix_mime ix_core fpath caps unix))

; the window's worker, a thread under OCaml 4.14, a domain under OCaml 5
; (Worker_spawn.mli)
(rule
 (targets Worker_spawn.ml)
 (deps spawn/threads.ml)
 (enabled_if (< %{ocaml_version} 5.0))
 (action (copy spawn/threads.ml Worker_spawn.ml)))
(rule
 (targets Worker_spawn.ml)
 (deps spawn/domains.ml)
 (enabled_if (>= %{ocaml_version} 5.0))
 (action (copy spawn/domains.ml Worker_spawn.ml)))

(executable
 (name Netscape)
 (modules Netscape)
 (libraries ix_netscape ix_browser_engine ix_css ix_html ix_http ix_playground ix_playground_render ix_playground_ppm ix_core caps unix))
