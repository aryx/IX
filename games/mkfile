# games/, built by ix's tools: first the libraries that the games share,
# once (mkgames: lib_playground, lib_graphics/software, a platform),
# then each directory of games, side by side.
TOP=..
DIR=games
# (audio, because the games of two directories ask for it, puzzle and
# shmup, which are made side by side; so its units are made here first,
# once)
WITH=audio
GAMES=
CATEGORIES=puzzle fps fps/doom fps/quake racing/virtua arcade shmup
# (B, where what is made goes, is passed on when it was given, as
# tests/lite.sh does; otherwise the default is a path from each
# directory)
# (NPROC directories are built at once, and each mk gets its share of
# the jobs, NPROC divided among the seven, at least one. So there are
# NPROC compiles at once in all, as in another directory. The seven at
# once with NPROC jobs each would run seven of the games' compiles at
# once on the card (NPROC 1 under QEMU, 864 MB), where ml is killed out
# of memory, in self-mix's games.)
all:V: directories
directories:V: libs
	b=(); if(~ $B /*) b='B='^$B
	j=`{echo $#CATEGORIES $NPROC | awk '{j = int($2 / $1); if(j < 1) j = 1; print j}'}
	pids=()
	for(d in $CATEGORIES){
		@{cd $d && $MK 'O='$O 'OS='$OS 'PLATFORM='$PLATFORM 'NPROC='$j $b} & pids=($pids $apid)
		if(~ $#pids $NPROC){ for(p in $pids){ wait $p; ~ $status '' || exit 1 }; pids=() }
	}
	for(p in $pids){ wait $p; ~ $status '' || exit 1 }
<mkgames

