# The tiny programs, built by ix's tools: each one file (and for the
# CPUs their library's, for tiny-vcs SHA-1 and zlib), with its start
# and its link. TinyKernel.ml is not here: tiny-ml compiles it, for
# tiny-machine.
#
# Their library is t-ix's own, TinyLibHost/ (LIB=tiny): TinyLibHost/ocaml/,
# the modules the tiny programs name and the functions they call
# (TinyLibHost/README.md), with mini-ml's runtime and the C library
# that are TinyLibHost's too (TinyLibHost/c/); nothing of lib_core/ is
# in them. Or, with mini-mk LIB=core, m-ix's: lib_core/'s standard
# library and its commons/ (with mini-git's SHA-1 and zlib, compiled
# there). The default is TinyLibHost's where it is, for arm64 (O=7),
# and lib_core's for arm (O=5), TinyLibHost/c/ being arm64's alone.
# What is built is under _mk/$O/tiny for the default, _mk/$O/tiny-core
# (or tiny-tiny) for the other.
# (old: LIB=core the default, TinyLibHost's with LIB=tiny under
# _mk/$O/tinylib: the library of the tiny programs was used by none of
# them unless asked)
TOP=..
<$TOP/mkfiles/mkconfig
DEFLIB=`{case $O in 7) echo tiny;; *) echo core;; esac}
LIB=$DEFLIB
D=`{if [ $LIB = $DEFLIB ]; then echo $B/tiny; else echo $B/tiny-$LIB; fi}
# TinyLibHost's units, in the order they are linked and initialized
# (lib_core/units.txt's, then commons/'s)
TSTD=Pervasives Int32 Int64 Seq List Char String Bytes Array Sys Hashtbl Filename Obj Queue \
 Buffer Printf Option Int Float Fun \
 Fpath Cap CapSys CapStdlib Logs Logs_fmt Unix CapUnix \
 Common Console Logging Procs Fpath_ Chan FS
TL=$D/lib
TUNITS=${TSTD:%=$TL/%.$O}
# (SHA-1 and zlib: mini-git's objects, or TinyLibHost's)
V=`{case $LIB in tiny) echo $TL;; *) echo $B/version_control;; esac}
# (TinyLibHost first: the shell's TinyLibSystem is the one there)
INCLUDES=`{case $LIB in tiny) echo -I TinyLibHost -I . -I $D -I TinyMachine -I TinyKernel -I TinyLibHost/ocaml;; *) echo -I TinyLibHost -I . -I $D -I TinyMachine -I TinyKernel -I ../lib_crypto -I ../lib_compression $STDI;; esac}
START=`{case $LIB in tiny) echo $ML -start $TSTD;; *) echo $ML -start $STD $COMMONS;; esac}
STDOBJS=`{case $LIB in tiny) echo $TL/TinyLibHost.a;; *) echo $STDOBJS;; esac}
STDEND=`{case $LIB in tiny) echo $TL/std_exit.$O $TL/runtime.$O $TL/start.$O;; *) echo $STDEND;; esac}
LINK=$LD -H7 -nofollow
LIBS=$STDOBJS $STDEND $TOP/mkfiles/mkconfig
PROGS=tiny-build tiny-shell tiny-utils tiny-editor tiny-c tiny-ml tiny-db tiny-vcs tiny-cpu tiny-machine tiny-prof tiny-mkfs

all:V: ${PROGS:%=$D/%}

# (each unit alone: none names another, but TinyCPU and TinyMachine their libraries,
# and TinyMachine TinyKernelNetwork, the other end of its wire)
$D/%.$O: %.ml
	mkdir -p $D
	$ML $INCLUDES -o $target $stem.ml

# (TinyLibHost's, with LIB=tiny, arm64's default)
$TL/%.$O: TinyLibHost/ocaml/%.ml
	mkdir -p $TL
	$ML -I TinyLibHost/ocaml -o $target TinyLibHost/ocaml/$stem.ml

# (its runtime and C library: one object of C, one of assembly; arm64's)
TRT=`{ls TinyLibHost/c/*.[chs]}
$TL/runtime.$O: $TRT
	mkdir -p $TL
	$CC -ITinyLibHost/c -o $target TinyLibHost/c/runtime.c
$TL/start.$O: TinyLibHost/c/start.s
	mkdir -p $TL
	$AS -o $target TinyLibHost/c/start.s
$TL/TinyLibHost.a: $TUNITS
	rm -f $target
	$AR u $target $TUNITS
$D/TinyCPU.$O $D/TinyMachineDevices.$O $D/TinyMachine.$O $D/TinyProfiler.$O: TinyMachine/TinyMachineCPU.ml
$D/TinyProfiler.$O: TinyMachine/TinyMachineDevices.ml
$D/TinyMachine.$O: TinyMachine/TinyMachineDevices.ml TinyKernel/TinyKernelNetwork.ml TinyMachine/TinyMachinePeer.ml
$D/TinyMachinePeer.$O: TinyKernel/TinyKernelNetwork.ml

# (a blank line above: a # line right under a rule's head is its recipe,
# and TinyMachinePeer's object was never compiled)
# (tiny-machine's parts are in TinyMachine/, the kernel's stack, which
# is the wire's other end, in TinyKernel/)
$D/TinyMachine%.$O: TinyMachine/TinyMachine%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target TinyMachine/TinyMachine$stem.ml
$D/TinyKernelNetwork.$O: TinyKernel/TinyKernelNetwork.ml
	mkdir -p $D
	$ML $INCLUDES -o $target TinyKernel/TinyKernelNetwork.ml

# (tiny-ml's prelude is a file of its ML, TinyLibCore.ml: its
# text as a string in a unit of the compiler's, made here, as
# tiny/dune's rule makes it)
$D/TinyMLPrelude.ml: TinyLibCore.ml
	mkdir -p $D
	(echo 'let prelude = {|'; cat TinyLibCore.ml; echo '|}') > $target
$D/TinyMLPrelude.$O: $D/TinyMLPrelude.ml
	$ML $INCLUDES -o $target $D/TinyMLPrelude.ml
$D/TinyML.$O: $D/TinyMLPrelude.$O

# (tiny-mkfs is t6's, a step before tiny-kernel: its file is there)
$D/TinyMkfs.$O: TinyKernel/steps/t6/TinyMkfs.ml
	mkdir -p $D
	$ML $INCLUDES -o $target TinyKernel/steps/t6/TinyMkfs.ml

$D/tiny-build: $V/Sha1.$O $D/TinyBuildSystem.$O $LIBS
	$START Sha1 TinyBuildSystem Std_exit -o $D/TinyBuildSystem.start.$O
	$LINK -o $target $D/TinyBuildSystem.start.$O $STDOBJS $V/Sha1.$O $D/TinyBuildSystem.$O $STDEND
# (the shell's system, the host's: TinyLibHost/TinyLibSystem.ml;
# TinyKernel/libml/TinyLibSystem.ml is tiny-machine's, tiny-ml's to
# compile. Not beside TinyShell.ml: mini-ml looks for a module in the
# directory of the file it compiles before any -I)
$D/TinyLibSystem.$O: TinyLibHost/TinyLibSystem.ml
	mkdir -p $D
	$ML $INCLUDES -o $target TinyLibHost/TinyLibSystem.ml
$D/TinyShell.$O: $D/TinyLibSystem.$O TinyShell.ml
$D/tiny-shell: $D/TinyLibSystem.$O $D/TinyShell.$O $LIBS
	$START TinyLibSystem TinyShell Std_exit -o $D/TinyShell.start.$O
	$LINK -o $target $D/TinyShell.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyShell.$O $STDEND
# (the utilities, on the same TinyLibSystem as the shell, and
# TinyLibRegex for grep)
$D/TinyUtilities.$O: $D/TinyLibSystem.$O $D/TinyLibRegex.$O TinyUtilities.ml
$D/tiny-utils: $D/TinyLibSystem.$O $D/TinyLibRegex.$O $D/TinyUtilities.$O $LIBS
	$START TinyLibSystem TinyLibRegex TinyUtilities Std_exit -o $D/TinyUtilities.start.$O
	$LINK -o $target $D/TinyUtilities.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyLibRegex.$O $D/TinyUtilities.$O $STDEND
# (the line editor, on the same TinyLibSystem as the shell and the
# same TinyLibRegex as grep: it is tiny-kernel's ed and sam too)
$D/TinyEditorLine.$O: $D/TinyLibSystem.$O $D/TinyLibRegex.$O TinyEditorLine.ml
$D/tiny-editor: $D/TinyLibSystem.$O $D/TinyLibRegex.$O $D/TinyEditorLine.$O $LIBS
	$START TinyLibSystem TinyLibRegex TinyEditorLine Std_exit -o $D/TinyEditorLine.start.$O
	$LINK -o $target $D/TinyEditorLine.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyLibRegex.$O $D/TinyEditorLine.$O $STDEND
$D/tiny-c: $D/TinyC.$O $LIBS
	$START TinyC Std_exit -o $D/TinyC.start.$O
	$LINK -o $target $D/TinyC.start.$O $STDOBJS $D/TinyC.$O $STDEND
$D/tiny-ml: $D/TinyMLPrelude.$O $D/TinyML.$O $LIBS
	$START TinyMLPrelude TinyML Std_exit -o $D/TinyML.start.$O
	$LINK -o $target $D/TinyML.start.$O $STDOBJS $D/TinyMLPrelude.$O $D/TinyML.$O $STDEND
$D/tiny-db: $D/TinyDatabase.$O $LIBS
	$START TinyDatabase Std_exit -o $D/TinyDatabase.start.$O
	$LINK -o $target $D/TinyDatabase.start.$O $STDOBJS $D/TinyDatabase.$O $STDEND
$D/tiny-vcs: $V/Sha1.$O $V/Zlib.$O $D/TinyVCS.$O $LIBS
	$START Sha1 Zlib TinyVCS Std_exit -o $D/TinyVCS.start.$O
	$LINK -o $target $D/TinyVCS.start.$O $STDOBJS $V/Sha1.$O $V/Zlib.$O $D/TinyVCS.$O $STDEND
$D/tiny-cpu: $D/TinyMachineCPU.$O $D/TinyCPU.$O $LIBS
	$START TinyMachineCPU TinyCPU Std_exit -o $D/TinyCPU.start.$O
	$LINK -o $target $D/TinyCPU.start.$O $STDOBJS $D/TinyMachineCPU.$O $D/TinyCPU.$O $STDEND
$D/tiny-machine: $D/TinyMachineCPU.$O $D/TinyMachineDevices.$O $D/TinyKernelNetwork.$O $D/TinyMachinePeer.$O $D/TinyMachine.$O $LIBS
	$START TinyMachineCPU TinyMachineDevices TinyKernelNetwork TinyMachinePeer TinyMachine Std_exit -o $D/TinyMachine.start.$O
	$LINK -o $target $D/TinyMachine.start.$O $STDOBJS $D/TinyMachineCPU.$O $D/TinyMachineDevices.$O $D/TinyKernelNetwork.$O $D/TinyMachinePeer.$O $D/TinyMachine.$O $STDEND
$D/tiny-prof: $D/TinyMachineCPU.$O $D/TinyMachineDevices.$O $D/TinyProfiler.$O $LIBS
	$START TinyMachineCPU TinyMachineDevices TinyProfiler Std_exit -o $D/TinyProfiler.start.$O
	$LINK -o $target $D/TinyProfiler.start.$O $STDOBJS $D/TinyMachineCPU.$O $D/TinyMachineDevices.$O $D/TinyProfiler.$O $STDEND
$D/tiny-mkfs: $D/TinyMkfs.$O $LIBS
	$START TinyMkfs Std_exit -o $D/TinyMkfs.start.$O
	$LINK -o $target $D/TinyMkfs.start.$O $STDOBJS $D/TinyMkfs.$O $STDEND

clean:V:
	rm -rf $D
