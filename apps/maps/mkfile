# mini-maps, built by ix's tools: its units, then the program, linked with
# the libraries (mkfiles/mklibs): the cryptography, the compression, the
# network, the pictures, the playground and one platform of it. The
# platform is ppm's on Linux (no window: a frame written to a file, the
# tests'), the draw device's with OS=plan9 (mini-9pi: a window of
# mini-rio, as the games', games/mkgames).
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/apps/maps
PLATFORM=`{if(~ $OS plan9) echo draw; if not echo ppm}
# (each after the ones it names)
LIBDIRS=lib_crypto lib_compression lib_networking lib_graphics lib_playground lib_gui \
 lib_playground/platforms lib_playground/platforms/$PLATFORM
<$TOP/mkfiles/mklibs
# (the libraries before lib_core: lib_playground's Cmd is Elm's, not commons/'s)
INCLUDES=-I . -I $D $LIBI $STDI
# (each before the ones that name it)
LIB=Mercator Tiles Worker_spawn Tile_worker Map_window
LIBOBJS=${LIB:%=$D/%.$O}
LOCAL=`{ls *.ml *.mli} $LIBSRC
LIBS=$LIBOBJS $LIBA $STDOBJS $STDEND $TOP/mkfiles/mkconfig

all:V: $D/mini-maps

$D/%.$O: %.ml $LOCAL
	mkdir -p $D
	$ML $INCLUDES -o $target $stem.ml

# the worker: lib_core's threads, a large one (Worker_spawn.mli)
$D/Worker_spawn.$O: $TOP/browsers/netscape/spawn/large_threads.ml $TOP/browsers/netscape/Worker_spawn.mli
	mkdir -p $D
	cp $TOP/browsers/netscape/Worker_spawn.mli $D/Worker_spawn.mli
	cp $TOP/browsers/netscape/spawn/large_threads.ml $D/Worker_spawn.ml
	$ML $INCLUDES -o $target $D/Worker_spawn.ml

$D/mini-maps: $D/Maps.$O $LIBS
	$ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA} $LIB Maps Std_exit -o $D/Maps.start.$O
	$LD $LDH -nofollow -o $target $D/Maps.start.$O $STDOBJS $LIBA $LIBOBJS $D/Maps.$O $STDEND

# the units' order (mkfiles/mkdepend)
DEPOBJ=D
DEPDIRS=. $D
DEPUNITS=$LIB Maps
<$TOP/mkfiles/mkdepend

clean:V:
	rm -rf $D
