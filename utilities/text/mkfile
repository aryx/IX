# utilities/text, built by ix's tools: each program is one file, built
# with its start and its link (for Plan 9, run mini-mk O=5 OS=plan9)
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/utilities/text
MADE=`{mkdir -p $D}
INCLUDES=-I . $STDI
LIBS=$STDOBJS $STDEND $TOP/mkfiles/mkconfig

all:V: $D/mini-grep $D/mini-uniq $D/mini-tr $D/mini-sed $D/mini-sort

$D/%.$O: %.ml
	$ML $INCLUDES -o $target $stem.ml
$D/mini-grep: $D/Grep.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Grep.$O $STDEND
$D/mini-uniq: $D/Uniq.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Uniq.$O $STDEND
$D/mini-tr: $D/Tr.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Tr.$O $STDEND
$D/mini-sed: $D/Sed.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Sed.$O $STDEND
$D/mini-sort: $D/Sort.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Sort.$O $STDEND

clean:V:
	rm -rf $D
