# mini-5i, built by ix's tools; its units are in folders (core, arm32,
# arm64, process)
TOP=..
DIR=machine
PROG=mini-5i
SRC=Bits Memory Elf Arm32_isa Arm32 Arm32_fast Mmu32 Arm64_isa Arm64 Mmu64 Show_arm32 Show_arm64 Host_calls Linux Plan9 Host Cpu CLI Main
LOCAL=`{ls *.ml *.mli core/*.ml* arm32/*.ml* arm64/*.ml* process/*.ml* compat/*.ml compat/*.mli}
GEN=
LIBI=-I core -I arm32 -I arm64 -I process -I compat
LIBUNITS=
LIBOBJS=
# (its traces: the program's tables read)
LIBDIRS=lib_executable
<$TOP/mkfiles/mkconfig
<$TOP/mkfiles/mkprog

# each folder's units, a rule each, its source the prerequisite (one %
# rule for every unit, beside mkprog's, mk refuses), one recipe a unit,
# so that .depend orders each: core process arm32 arm64 compat
# old: the folders' units said whole, compiled by one recipe, each found
#   by its name (*/)
$D/%.$O: core/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target core/$stem.ml
$D/%.$O: process/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target process/$stem.ml
$D/%.$O: arm32/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target arm32/$stem.ml
$D/%.$O: arm64/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target arm64/$stem.ml
$D/%.$O: compat/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target compat/$stem.ml
