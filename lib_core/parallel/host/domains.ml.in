(* See Parallel.mli. This is the version for OCaml 5: each worker has a
 * domain, and the locks are the Mutex and Condition of its standard
 * library, which work between domains. The file is
 * lib_core/parallel/host/domains.ml.in, which dune copies. *)

let available = true
let spawn (f : unit -> unit) : unit = ignore (Domain.spawn f : unit Domain.t)

type lock = Mutex.t
let lock () : lock = Mutex.create ()
let take (l : lock) : unit = Mutex.lock l
let give (l : lock) : unit = Mutex.unlock l

type cond = Condition.t
let cond () : cond = Condition.create ()
let wait (c : cond) (l : lock) : unit = Condition.wait c l
let signal (c : cond) : unit = Condition.signal c
let broadcast (c : cond) : unit = Condition.broadcast c
