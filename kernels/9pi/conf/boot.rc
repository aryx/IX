#!/boot/rc
# Claude Code
# Copyright (C) 2026 Yoann Padioleau. LGPL 2.1: see license.txt.
#
# mini-9pi's /boot/boot when it boots with ix's programs (plan_rio.md:
# make ix): the ones of the kernel's bootdir, and with an SD card
# (make card) the ones of its second partition (mini-rio); ix's own programs (mini-rc runs
# this, with its own rcmain; echo, bind, ls... are utilities/'s). The
# devices bound where programs look for them, as principia's boot.rc
# does before it mounts the card, then rc on the console.

/boot/echo 'mini-9pi: ix''s programs, in the kernel''s image'

# the machine's owner, as Plan 9's boot says it: this process's and
# its children's user, the files' owner
/boot/echo -n pad > '#k/hostowner'

path=(/bin /boot)
# (and /boot's programs in /bin too, after the others: a script's
# first line says #!/bin/rc)
bind -a /boot /bin

bind -c '#e' /env
bind -a '#ec' /env
bind -c '#s' /srv
bind '#p' /proc
bind '#d' /fd
bind '#k' /sys
bind -a '#P' /dev
bind -a '#S' /dev
bind -a '#i' /dev
bind -a '#m' /dev
bind -a '#A' /dev

# the clock: a Pi has no clock chip and the kernel's time starts at 0
# (9pi's). The day mini-9pi was started (the Makefile's KERNDATE_IX,
# the date of the kernel's own files), until something knows better.
echo 1790380800 > /dev/time

# the SD card, when there is one with a FAT partition (make card's):
# fdisk tells the disk's driver the partitions it reads in the MBR.
if(ls /dev/sdM0/data > /dev/null >[2] /dev/null){
	fdisk -p /dev/sdM0/data > /dev/sdM0/ctl
	# the card's second partition is the root: xv6's file system, by
	# the kernel (Kfs), as Plan 9 has its file server's: at /root, and
	# after the kernel's own directories at / (so /usr, /tmp are its);
	# its mnt is /mnt (mount points), and its progs, the programs
	# that are not in the kernel's image, a directory for each kind
	# (/progs/system, /progs/apps, /progs/utilities/text...: the
	# Makefile's CARD_PROGS), are /bin's, after the image's own: a
	# bind for each, the card's /lib/namespace
	if(ls /dev/sdM0/other > /dev/null >[2] /dev/null){
		bind -c '#x' /root
		bind -a /root /
		bind -c /root/mnt /mnt
		. /root/lib/namespace
		bind -a /root/rc/bin /bin
		home=/usr/pad
		cd $home
		# what Plan 9's termrc gives its programs, mk's among them,
		# when the card has ix's sources and tools
		# (docs/plans/plan_self_hosting.md): the machine's type
		# (mkfiles/mkconfig names ix's tools ml, ld... by it, and
		# mini-ml, mini-ld... on Linux, which has none), its cores
		# (mk's jobs at once: a line of #c/sysstat each), and the
		# recipes' shell
		objtype=arm
		ifs='
' { cores=`{cat '#c/sysstat'} }
		NPROC=$#cores
		MKSHELL=/bin/rc
	}
	# the first partition, the firmware's FAT (the kernel is one of
	# its files): at /mnt/fat. dossrv serves it; without dossrv in the
	# image (make ix-kernel), the kernel's own FAT (Kdos: the same
	# code, lib_fat's, as a device)
	if(ls /dev/sdM0/dos > /dev/null >[2] /dev/null){
		if(ls -d /mnt/fat > /dev/null >[2] /dev/null){
			if(ls /boot/dossrv > /dev/null >[2] /dev/null){
				dossrv
				mount -c /srv/dos /mnt/fat /dev/sdM0/dos
			}
			if not bind -c '#Fdos' /mnt/fat
		}
	}
}

# the processor's speed, when the kernel measured one (a board: the
# banner's "cpu0:" line has left the screen by now; 0 under an
# emulator, and nothing said): 700, or what config.txt overclocks it to
cpu=`{cat '#P/cputype'}
if(! ~ $cpu(3) 0) echo cpu: $cpu(3) MHz
# and, on a board too (the kernel's '#ec' is empty under an emulator),
# which firmware started it: the day its files were built
# (kernels/firmware/README.md says each set's); and which card this
# is: the line make card wrote when it last made the card's image,
# mini-9pi's version, the commit and the minute
# (inside the test of the speed: no process more under an emulator,
# whose recorded consoles have the processes' numbers)
if(! ~ $cpu(3) 0){
	if(ls '#ec/firmware' > /dev/null >[2] /dev/null) echo firmware: `{cat '#ec/firmware'}
	if(ls /mnt/fat/version.txt > /dev/null >[2] /dev/null) cat /mnt/fat/version.txt
}

# the USB keyboard and mouse, when their driver is in the image (make
# ix-usb: mini-usbd, a program, buses/user/usbd)
if(ls /boot/usbd > /dev/null >[2] /dev/null) usbd
# without it, the kernel finds and reads them itself (Kusb: the same
# code, lib_usb's, called by the kernel)
if not echo kernel > '#u/usb/ctl'

# the network, when the machine has an Ethernet (the Pi's is a USB
# device, as -device usb-net gives an emulator one): IP's files and the
# interface's at /net, the interface given to IP. Its address: under an
# emulator (no speed measured, above) the one QEMU's and mini-qemu's
# network gives every guest, with its gateway and its name server.
# Then the clock from the network, when mini-timesync is there and a
# server answers: a certificate's dates are checked against it.
# On a board there is no DHCP (ipconfig is not ix's), and the address
# is one that needs nobody: the card's, when its FAT partition has an
# ip.txt (a line, an address and a mask: written from any computer),
# else the board's kind's, 192.168.9.1 a Pi 1 and 192.168.9.2 a Pi 2
# (192.168.9.3 another). So two boards joined by one cable are a
# network with nothing typed, and each knows where the other is:
#	tronscroll 'net=host'                       on the Pi 1
#	tronscroll 'net=join' 'host=192.168.9.1'    on the Pi 2
# (two boards of one kind: an ip.txt on one's card). No gateway, no
# name server: the cable's other end is all there is.
# (a board's adapter is behind its hub, which usbd, started above, is
# still going through: waited for, some seconds)
if(! ~ $cpu(3) 0) for(i in 1 2 3 4 5) if(! ls '#l0/ether0' > /dev/null >[2] /dev/null) sleep 1
if(ls '#l0/ether0' > /dev/null >[2] /dev/null){
	bind -a '#I' /net
	bind -a '#l0' /net
	echo bind ether /net/ether0 > /net/ipifc/clone
	if(! ~ $cpu(3) 0){
		ip=(192.168.9.3 255.255.255.0)
		if(~ $cpu(2) 1176JZF-S) ip=(192.168.9.1 255.255.255.0)
		if(~ $cpu(2) Cortex-A7) ip=(192.168.9.2 255.255.255.0)
		if(ls /mnt/fat/ip.txt > /dev/null >[2] /dev/null) ip=`{cat /mnt/fat/ip.txt}
		echo add $ip > /net/ipifc/0/ctl
		echo ip: $ip(1) ether: `{cat /net/ether0/addr}
	}
	if(~ $cpu(3) 0){
		echo add 10.0.2.15 255.255.255.0 > /net/ipifc/0/ctl
		echo add 0 0 10.0.2.2 > /net/iproute
		echo 'dns=10.0.2.3' > /net/ndb
		# (/bin: the image's /boot, or the card's /progs/net)
		if(ls /bin/timesync > /dev/null >[2] /dev/null){
			now=`{timesync pool.ntp.org >[2] /dev/null}
			if(! ~ $#now 0) echo $now > /dev/time
		}
	}
}

. -i '#d/0'
