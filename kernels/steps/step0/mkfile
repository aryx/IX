# mini-xv6, step 0: the bare board, built by ix's tools before any OCaml
# (docs/plans/done/plan_kernel_mini_ml.md, steps 1, 2 and 9). It runs
# on the Pi 4 (arm64, O=7) or the Pi 1 (arm, mini-mk O=5, which uses
# pi1/'s assembly and expected lines). This mkfile makes two images, without a
# header (-H0), with their text where the board loads it (-T):
#   hello-s.img   a page of assembly (hello.s)
#   hello-c.img   a C program (hello.c) compiled by mini-cc: l.s starts
#                 it, on top of goken's C library, with shim.c in
#                 Linux's place
#   mini-mk          builds the images, under _mk/7/kernels/steps/step0/
#   mini-mk check    boots each under mini-qemu, and under QEMU if it
#                    is there, and checks its line
TOP=../../..
<$TOP/mkfiles/mkconfig
<$TOP/kernels/lib_machine/mkboard
D=$B/kernels/steps/step0
IMAGE=$LD -H0 -T $LOAD -E _start -nofollow
# (the board's expected lines, such as pi1/expected-s on the Pi 1)
EXPECTED=${P}expected

all:V: $D/hello-s.img $D/hello-c.img

# (The assembly is the board's own, and the C is for both boards.)
$D/hello.$O: ${P}hello.s
	mkdir -p $D
	$AS -o $target $prereq
$D/l.$O: ${P}l.s
	mkdir -p $D
	$AS -o $target $prereq
$D/shim.$O: shim.c
	mkdir -p $D
	$CC $CINC -o $target shim.c
$D/helloc.$O: hello.c
	mkdir -p $D
	$CC $CINC -o $target hello.c

$D/hello-s.img: $D/hello.$O
	$IMAGE -o $target $D/hello.$O
$D/hello-c.img: $D/l.$O $D/shim.$O $D/helloc.$O $L/libc.a
	$IMAGE -o $target $D/l.$O $D/shim.$O $D/helloc.$O $L/libc.a

# A kernel does not stop, so check reads its line, then ends the
# emulator.
check:V: all
	for(k in s c){
		boot=`{echo $BOOT | sed 's|IMAGE|'$D/hello-$k.img'|'}
		timeout 3 mini-qemu $boot -nographic < /dev/null > $D/mini-$k.txt >[2]/dev/null || true
		cmp $D/mini-$k.txt $EXPECTED-$k && echo 'ok step0: hello-'$k' under mini-qemu'
		if(whatis $QEMU >/dev/null >[2=1]){
			timeout 3 $QEMU $boot $QEMUSMP -display none -monitor none -serial file:$D/qemu-$k.txt < /dev/null >[2]/dev/null || true
			cmp $D/qemu-$k.txt $EXPECTED-$k && echo 'ok step0: hello-'$k' under QEMU'
		}
		if not echo 'step0: hello-'$k', no QEMU, not booted under it'
	}

clean:V:
	rm -rf $D
