# mini-ml, built by ix's tools (and so by itself): the front end with
# its lexer (made by mini-lex) and its grammar (made by mini-yacc), the
# preprocessor (pp/), then the back ends (simple/, compat/, opti/,
# ssa/), what a debugger needs (debug/), .NET's back end (dotnet/, over
# mini-dotnet's writer of assemblies), and the command
TOP=../..
DIR=languages/ml
PROG=mini-ml
SRC=Ast Annotations Parser Lexer Scope Resolve Typing Bits Derive Pp Ir Summary Fold Lower Gas Opti Ssa Ssa_build Unbox Untag Cse Licm Alloc Zero_alloc Gen Emit Lines_ml Acid_ml Il_code Il_types Il_functions Il_patterns Il_externals Il_printf Il_prims Il_exprs Lower_il CLI Main
LOCAL=`{ls *.ml *.mli *.mly *.mll pp/*.ml pp/*.mli simple/*.ml simple/*.mli compat/*.ml compat/*.mli opti/*.ml opti/*.mli ssa/*.ml ssa/*.mli debug/*.ml debug/*.mli dotnet/*.ml dotnet/*.mli}
LIBI=-I pp -I simple -I compat -I opti -I ssa -I debug -I dotnet
# (assembler: Asm, the objects' form, and Lexer_asm Parser_asm, the
# assembly it writes read into an object; lib_code: the SSA form's
# algorithms, Dominators Braun Liveness
# Coloring, which mini-cc links too; languages/dotnet/assembly: the
# writer of assemblies, Writer and what it stands on)
LIBDIRS=assembler lib_code languages/dotnet/assembly
<$TOP/mkfiles/mkconfig
GEN=$B/languages/ml/Parser.ml $B/languages/ml/Lexer.ml
LIBOBJS=
<$TOP/mkfiles/mkprog

# the units that are not here: those that mini-yacc and mini-lex made,
# and each subdirectory's units, by their names (as in
# languages/c/mkfile)
$D/Parser.$O: $D/Parser.ml $LOCAL
	$ML $INCLUDES -o $target $D/Parser.ml
$D/Lexer.$O: $D/Lexer.ml $D/Parser.ml $LOCAL
	$ML $INCLUDES -o $target $D/Lexer.ml

# pp/'s units (Bits Derive Pp), with one recipe each, so that .depend
# orders each one
$D/%.$O: pp/%.ml
	$ML $INCLUDES -o $target pp/$stem.ml

# simple/'s units (Ir Summary Fold Lower Gen), with one recipe each, so
# that .depend orders each one
$D/%.$O: simple/%.ml
	$ML $INCLUDES -o $target simple/$stem.ml
$D/Gas.$O: compat/Gas.ml $LOCAL $GEN
	$ML $INCLUDES -o $target compat/Gas.ml
$D/Opti.$O: opti/Opti.ml $LOCAL $GEN
	$ML $INCLUDES -o $target opti/Opti.ml

# ssa/'s units (Ssa Ssa_build Unbox Untag Cse Licm Alloc Emit), with one
# recipe each, so that .depend orders each one
$D/%.$O: ssa/%.ml
	$ML $INCLUDES -o $target ssa/$stem.ml

# debug/'s units (Lines_ml Acid_ml), with one recipe each, so that
# .depend orders each one
$D/%.$O: debug/%.ml
	$ML $INCLUDES -o $target debug/$stem.ml

# dotnet/'s units (Il_code Il_types Il_functions Il_patterns Il_externals
# Il_printf Il_prims Il_exprs Lower_il), by their names
$D/%.$O: dotnet/%.ml
	$ML $INCLUDES -o $target dotnet/$stem.ml
