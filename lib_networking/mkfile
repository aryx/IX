# lib_networking, a library of ix's tools (mkfiles/mklib): TCP, UDP and
# DNS, TLS 1.3 and its certificates, HTTP and its cookies, and a mailto:
# (mail/'s Mailto, for mini-netscape; the rest of mail/ is mini-pim's,
# which only dune builds). 9p/ is not in it, because it is OCaml's (the
# games' lockstep, netcode, is in lib_playground/netcode).
TOP=..
<$TOP/mkfiles/mkconfig
LIB=lib_networking
# (Plan 9's Tcp and Udp use /net's files where Linux's use sockets;
# their directory is found last, and so they are the ones taken)
OSDIR=`{~ $OS plan9 && echo tcp/plan9}
DIRS=tcp tls http mail $OSDIR
NEEDS=lib_crypto lib_compression
UNITS=Udp Dns Tcp Base64 Civil Clock Asn1 Pem X509 Tls12 Tls13 Tls_client Url Urlencoded Http Cookie Cookie_jar Keep_alive Http_client Mailto
<$TOP/mkfiles/mklib
