# mini-netscape, built by ix's tools (docs/plans/plan_browser.md, stage
# 10): the window's own units, compiled here, then the program, linked
# with the libraries (mkfiles/mklibs): the cryptography, the
# compression, the network, the pictures and their readers, the
# playground and one platform of it, and the browser's (HTML, CSS,
# JavaScript, the boxes, a page's scripts: browsers/html, css,
# javascript, engine, webapi). The platform is ppm's on Linux (no
# window: a frame written to a file, the tests'), the draw device's
# with OS=plan9 (mini-9pi: a window of mini-rio, as the games',
# games/mkgames).
# old: the browser's units listed here, found by their names in their
# directories and compiled here
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/browsers/netscape
PLATFORM=`{if(~ $OS plan9) echo draw; if not echo ppm}
# (each after the ones it names)
LIBDIRS=lib_crypto lib_compression lib_networking lib_graphics lib_playground \
 browsers/html browsers/css browsers/javascript browsers/engine browsers/webapi \
 lib_playground/platforms lib_playground/platforms/$PLATFORM
<$TOP/mkfiles/mklibs
# (the libraries before lib_core: lib_playground's Cmd is Elm's, not commons/'s)
INCLUDES=-I . $LIBI $STDI
# (each before the ones that name it)
LIB=Browser_zoom Browser_helpers Places Location_field Scrollbar Browser_profile Worker_spawn Tab Tab_worker
LIBOBJS=${LIB:%=$D/%.$O}
# (JavaScript's two units nobody names: browsers/javascript's mkfile)
WHOLE=$B/browsers/javascript/Js_quicken.$O $B/browsers/javascript/Js_compile.$O
LOCAL=`{ls *.ml *.mli} $LIBSRC
LIBS=$LIBOBJS $LIBA $STDOBJS $STDEND $TOP/mkfiles/mkconfig

# (netscape: the name the frames' test asks for, as a game's; mini-netscape: the program's)
all:V: $D/mini-netscape

$D/%.$O: %.ml $LOCAL
	mkdir -p $D
	$ML $INCLUDES -o $target $stem.ml

# the window's worker: lib_core's threads, a large one (Worker_spawn.mli)
$D/Worker_spawn.$O: spawn/large_threads.ml Worker_spawn.mli
	mkdir -p $D
	cp Worker_spawn.mli $D/Worker_spawn.mli
	cp spawn/large_threads.ml $D/Worker_spawn.ml
	$ML $INCLUDES -o $target $D/Worker_spawn.ml

$D/mini-netscape: $D/netscape
	cp $D/netscape $target
$D/netscape: $D/Netscape.$O $LIBS
	$ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA} $LIB Netscape Std_exit -o $D/Netscape.start.$O
	$LD $LDH -nofollow -o $target $D/Netscape.start.$O $STDOBJS $LIBA $WHOLE $LIBOBJS $D/Netscape.$O $STDEND

clean:V:
	rm -rf $D
