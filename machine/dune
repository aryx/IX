; mini-5i (plan_arm.md): the CPU cores, the process, the CLI, in
; folders (the library ix_machine; Cpu, CLI and Main are here):
;   core/     what the two processors stand on: Bits (a word of 32 or
;             64 bits in an int), Memory (the address space, its RAM
;             and its devices)
;   arm32/    Arm32_isa (the state), Arm32 (decode and execute),
;             Arm32_fast (the instructions run often, decoded once),
;             Mmu32 (the ARMv6 MMU: mini-qemu's)
;   arm64/    Arm64_isa, Arm64, Mmu64
;   process/  a program run as a process of the host's: Elf (it
;             loaded), Host_calls (what a personality asks of the
;             host), Linux and Plan9 (the two personalities: their
;             system calls), Host (Host_calls by Unix)
; compat/ (the printer of an instruction) and tests/ have their own
; stanzas and are not of the folders.
(include_subdirs unqualified)

(library
 (name ix_machine)
 (wrapped false)
 (modules Bits Memory Elf Arm32_isa Arm32 Arm32_fast Mmu32 Arm64_isa Arm64 Mmu64 Host_calls Linux Plan9 Host Cpu)
 ; mlpp's type t = [%mli] (Mmu32, Mmu64: a pilot): the workspace's mini-ml first
 (preprocess (action (run %{bin:mini-ml} -pp %{input-file})))
 (preprocessor_deps (source_tree .))
 (libraries ix_core caps fpath unix))

; the command: the machine, and the printer of an instruction for -t
(library
 (name ix_machine_cli)
 (wrapped false)
 (modules CLI)
 (libraries ix_machine ix_machine_compat ix_core caps fpath unix))

(executable
 (name Main)
 (public_name mini-5i)
 (package ix)
 (modules Main)
 (libraries ix_machine_cli caps))

; release (mini-pi, the website): no bounds checked in the arrays and bytes
; of the interpreter (plan_web.md, stage 2); the tests are built with them
(env (release (flags (:standard -unsafe))))
