# browsers/javascript as a library (mkfiles/mklib), which reads and runs
# the language, for mini-netscape; and mini-node, the engine at a
# prompt, linked with that library and with lib_playground's (Lehmer,
# for Math.random's numbers)
TOP=../..
<$TOP/mkfiles/mkconfig
LIB=browsers/javascript
DIRS=values parsing eval opti library
NEEDS=lib_playground
# (each unit comes before the ones that name it. Js_quicken and
# Js_compile come after Js_eval, which they tell about themselves when
# the program starts. Nobody names them, so a program links their
# objects, as dune's -linkall does.)
UNITS=Js_prelude Js_ast Per_domain Mini_opti Js_string Js_lexer Js_parse Js_coroutine Js_regexp Js_value Js_operators \
 Js_scope Js_json Js_promise Js_builtins Js_frame Js_props Js_globals Js_eval Js_quicken Js_compile
# (mini-node's two units, below, come after the library's units they
# name)
DEPMORE=CLI Main
<$TOP/mkfiles/mklib

LIBDIRS=lib_playground
<$TOP/mkfiles/mklibs
WHOLE=$D/Js_quicken.$O $D/Js_compile.$O
all:V: $D/mini-node

$D/CLI.$O: CLI.ml CLI.mli $LOCAL
	mkdir -p $D
	$ML $INCLUDES -o $target CLI.ml
$D/Main.$O: Main.ml $D/CLI.$O
	$ML $INCLUDES -I . -o $target Main.ml
$D/mini-node: $D/CLI.$O $D/Main.$O $D/lib.a $LIBA $STDOBJS $STDEND $TOP/mkfiles/mkconfig
	$ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA $D/lib.a} CLI Main Std_exit -o $D/Main.start.$O
	$LD $LDH -nofollow -o $target $D/Main.start.$O $STDOBJS $LIBA $D/lib.a $WHOLE $D/CLI.$O $D/Main.$O $STDEND
