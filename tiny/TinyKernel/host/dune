; what tiny-machine gives tiny-kernel's parts in ML (KGraphics.ml,
; KAudio.ml, KFS.ml), by OCaml for the host, where
; they are tested first and where the window's programs draw with them
; (../../TinyLibSystem/sdl/): KRaw is the machine's memory, an array. On
; tiny-machine the name is externals (../KRaw.ml).
(library
 (name tiny_host_memory)
 (wrapped false)
 (modules KRaw)
 (libraries tiny_machine_devices))

; tiny-mkfs: a disk of tiny-kernel's file system, made on the host by
; KFS.ml itself (TinyMkfs.mli)
(executable
 (name TinyMkfs)
 (public_name tiny-mkfs)
 (package ix)
 (modules TinyMkfs)
 (libraries ix_core fpath caps tiny_lib_system tiny_kernel_fs tiny_host_memory))
