# The libraries a program links, ix's own (mkfiles/mklib), as xix's
# programs name their lib.cma: the includer sets LIBDIRS, each library's
# directory from TOP, each after the ones it names, then includes this.
# LIBA: their archives, for the link; LIBI: their directories, for
# mini-ml's -I, as each library wrote them beside its archive (mklib's
# dirs); LIBSRC: their files, which a program's own units are compiled
# again after (mini-ml reads a unit's .mli, or its .ml when it has
# none). The libraries are built first, in their order (the top
# mkfile's libs, as xix's and principia's top mkfiles build their
# libraries before the programs): a program's mkfile takes their
# archives as they are, and says to build them when one is missing.
# old: each library's own mini-mk asked at every build (make -C's way;
# :Pfalse:, out of date always), and its dirs asked of it: a build
# where nothing changed took 3 minutes 21 for mini-9pi's programs, 8.5 s
# before (2026-10-21)
# The start names the libraries' units in their order:
#   $ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA} Main Std_exit ...
# (not ${LIBDIRS:%=$B/%/lib.a}: of an empty list, mk gives the name
# LIBDIRS; mkprog's programs name none)
# The three by mkfiles/libs.rc, one rc for them.
# old: LIBA=`{for(d in $LIBDIRS) echo $B/$d/lib.a}
#      LIBSRC=`{for(d in $LIBDIRS) $WALK $TOP/$d | awk ...}
#      LIBI=`{$RC $TOP/mkfiles/dirs.rc $B $LIBDIRS}
<|. $TOP/mkfiles/libs.rc libs
# (and the compiler, MLEXE, mkconfig's: the program's units an older
# mini-ml's remade, in mkfiles/mkprog, the games' and every mkfile that
# makes its own; the libraries' by mklib, the stdlib's by lib_core's)
LIBSRC=$LIBSRC $MLEXE

$B/%/lib.a:
	echo 'mklibs: '^$target^' not built: the libraries first, in their order (mini-mk O='^$O^' OS='^$OS^' libs at the top)' >[1=2]
	exit 1
