#
# /lib/ml: tiny-ml's library, TinyLibCore's units compiled each after
# the ones before it (each a .o, and a .tmi that ml reads: -L /lib/ml,
# the default), and what an ML program of tiny-kernel links around its
# own objects: mlsys.o, the ML runtime (/src/runtime/ml.c: the
# allocator, the collector) given tiny-kernel's memory and calls, and
# end.o, the image's end. Built from /src, and already built on the
# image; to see how, or to make it again after changing a source:
#
#     cd /lib/ml; build -n     the recipes, not run
#     build clean; build       all made again (a few minutes)
#
# A program links them so, end.o the last:
#
#     ml -o prog.o prog.ml
#     ld -s -n -o prog /lib/c/start.o /lib/c/udivmod.o /lib/c/libc.o \
#         /lib/c/sys.o /lib/ml/mlsys.o prog.o /lib/ml/[A-Z]*.o /lib/ml/end.o
#
# (the library's units are capitalized, the two around them are not)
#
# (on the host: tiny/TinyKernel/lib/ml/Buildfile; its CORE is
# TinyKernel/Makefile's, which checks it; the image's files are the
# Makefile's, the same bytes)

CORE = Stdlib Char Seq List String Bytes Array Option Int32 Int64 Filename Buffer Printf Marshal Hashtbl Common Sha1 Fpath Fpath_ Exit In_channel Out_channel Chan Logs

all: Stdlib.o mlsys.o end.o

# the units at once, in CORE's order, each given the interfaces before it
Stdlib.o: ${CORE:%=/src/TinyLibCore/%.ml} ${CORE:%=/src/TinyLibCore/%.mli}
	b=(); for(m in $CORE) { ml -c -nostdlib -o $m.o $b /src/TinyLibCore/$m.ml; b=($b $m.tmi) }

mlsys.o: /src/TinyLibSystem/tinykernel/mlsys.c /src/runtime/ml.c /src/TinyKernel/libc/user.h
	cc -o $target /src/TinyLibSystem/tinykernel/mlsys.c
end.o: /src/TinyKernel/end.s
	as -o $target /src/TinyKernel/end.s

# build clean: the objects and interfaces removed
clean:
	rm -f *.o *.tmi
