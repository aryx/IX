(* See Parallel.mli. This is the version for OCaml 4.14, where only one
 * thread runs OCaml: there is no worker, and the only one who is there
 * always gets the lock. The file is lib_core/parallel/host/single.ml.in,
 * which dune copies. *)

let available = false
let spawn (_ : unit -> unit) : unit = invalid_arg "Parallel.spawn: this OCaml has no domains"

type lock = unit
let lock () : lock = ()
let take (_ : lock) : unit = ()
let give (_ : lock) : unit = ()

type cond = unit
let cond () : cond = ()
(* (nobody else is there to tell) *)
let wait (_ : cond) (_ : lock) : unit = invalid_arg "Parallel.wait: this OCaml has no domains"
let signal (_ : cond) : unit = ()
let broadcast (_ : cond) : unit = ()
