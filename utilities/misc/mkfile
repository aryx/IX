# utilities/misc, built by ix's tools: each program is one file, built
# with its start and its link (for Plan 9, run mini-mk O=5 OS=plan9)
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/utilities/misc
MADE=`{mkdir -p $D}
INCLUDES=-I . $STDI
LIBS=$STDOBJS $STDEND $TOP/mkfiles/mkconfig

all:V: $D/mini-echo $D/mini-basename $D/mini-wc $D/mini-seq $D/mini-cleanname $D/mini-du $D/mini-test

$D/%.$O: %.ml
	$ML $INCLUDES -o $target $stem.ml
$D/mini-echo: $D/Echo.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Echo.$O $STDEND
$D/mini-basename: $D/Basename.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Basename.$O $STDEND
$D/mini-wc: $D/Wc.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Wc.$O $STDEND

# (Seq_, because Seq is the standard library's)
$D/mini-seq: $D/Seq_.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Seq_.$O $STDEND
$D/mini-cleanname: $D/Cleanname.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Cleanname.$O $STDEND
$D/mini-du: $D/Du.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Du.$O $STDEND
$D/mini-test: $D/Test.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Test.$O $STDEND

clean:V:
	rm -rf $D
