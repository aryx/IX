#
# mini-pi: boot a Raspberry Pi kernel under mini-qemu (raspberry/,
# mini-qemu) without its long command line: the kernel, its image, the
# options its own Makefile gives QEMU.
#
#   ./mini-pi xv6            xv6 arm-pi1-bis, the console in this terminal
#   ./mini-pi xv6-pi1        xv6 arm-pi1
#   ./mini-pi xv6-pi4        xv6 arm64-pi4, the Pi4 (one core; -c 4 its four)
#   ./mini-pi 9pi            principia's 9pi, its SD card image, the console
#                       in this terminal (the mini UART)
#   ./mini-pi mini-xv6-pi1   ix's mini-xv6 (kernel/xv6/: xv6 in OCaml) on the
#                       Pi1, with xv6 arm-pi1's fs.img; built first
#   ./mini-pi mini-xv6-pi4   the same kernel on the Pi4, with xv6
#                       arm64-pi4's fs.img (one core); -g for both: its
#                       console drawn in a window, a USB keyboard and mouse
#   ./mini-pi mini-9pi       ix's mini-9pi (kernel/9pi/: 9pi in OCaml) on the
#                       Pi1, alone: ix's own programs in the kernel's
#                       image (mini-rc, mini-ed, utilities/'s echo, ls,
#                       cat, bind, mount: kernel/9pi's make ix), to rc's
#                       prompt; built first. Its SD card is ix's own
#                       (make card: build/card.img, the firmware's FAT
#                       with this kernel in it), mounted on /root. -g: a
#                       window, a USB keyboard and mouse (mini-usbd
#                       in the image: make ix-usb): type rio there,
#                       ix's own (windows/): its menu is the right button's
#   ./mini-pi mini-9pi4      the same on the Pi4 (arm64; the programs are
#                       arm's, run in AArch32)
#   ./mini-pi mini-oberon    ix's mini-oberon (kernel/oberon/: the Oberon
#                       system in OCaml, plan_system_oberon.md) on the
#                       Pi1, built first by ix's own tools (mini-mk);
#                       it draws: -g for its screen in a window
#   ./mini-pi mini-oberon4   the same on the Pi4 (arm64)
#   ./mini-pi mini-9pi-principia   mini-9pi on the Pi1 with principia's
#                       programs and SD card image (its rc, dossrv, rio),
#                       to rc's prompt; -g: its console drawn in a window
#                       as 9pi draws it, a USB keyboard and mouse: type
#                       rio there (the draw device, Devdraw.ml)
#   ./mini-pi mini-9pi4-principia  the same on the Pi4 (arm64, the same arm
#                       programs run in AArch32: kernel/9pi/syscalls/Ureg.mli)
#                       (-p c for the four: principia's C pixels, not the
#                       OCaml ones: kernel/9pi/lib_graphics/Draw.mli)
#
# Options:
#   -g   a window: the framebuffer (and for xv6, a USB keyboard: type in
#        the window or in the terminal; for 9pi, a USB keyboard and
#        mouse: the draw console, rio from it; a click grabs the mouse,
#        Ctrl-Alt-G releases it)
#   -w   9pi, mini-9pi: write to the SD card image (by default its writes are kept
#        in memory and lost at exit, QEMU's snapshot=on)
#   -q   run QEMU instead, with the same arguments (to compare)
#   -d   mini-qemu's log of unassigned I/O and undefined instructions
#   -n   no build (use mini-qemu, and mini-xv6 or mini-9pi, as last built)
#   -v   verbose, to see where it blocks: each build step's output and
#        time (ocaml-light's first build takes about 5 minutes), and
#        every 2s mini-qemu's line saying where the guest is: the
#        board's time, how idle, the kernel functions it runs (named
#        from the kernel's ELF; raspberry/Status.mli)
#   -p P mini-9pi, mini-9pi4: the pixels (the draw device's memdraw), ocaml
#        (the default) or c (principia's); the same as PIXEL=P before
#   -c N xv6-pi4: N cores (1 to 4, default 1; xv6's idle cores spin, so
#        each one more slows it down)
#
# Quit with Ctrl-A then x (or close the window).
#
# Where the kernels are: $XV6 (default ~/xv6: xv6-multiarch, its ports
# built), $PRINCIPIA (default ~/principia: 9pi built, qemu-sd.img),
# mini-xv6 in ix's kernel/xv6/ (with $XV6's arm-pi1 and arm64-pi4 fs.img),
# mini-9pi in ix's kernel/9pi/ (with $PRINCIPIA's bootdir and qemu-sd.img).

set -e
# claude: ix's checkout, also when run as bin/mini-pi (a link into
# _build/default/, where dune copies the script); installed elsewhere
# (dune install), it needs $IX, the checkout
ROOT=$(dirname "$(readlink -f "$0")")
case $ROOT in */_build/default) ROOT=${ROOT%/_build/default};; esac
ROOT=${IX:-$ROOT}
[ -d "$ROOT/raspberry" ] || { echo "mini-pi: $ROOT is not ix's checkout (set IX)" >&2; exit 2; }
XV6=${XV6:-$HOME/xv6}
PRINCIPIA=${PRINCIPIA:-$HOME/principia}
graphics=0; write=0; qemu=0; debug=0; build=1; cores=1; verbose=0; elf=

say() { echo "mini-pi: $*" >&2; }
# claude: a build step, named (a first build is long and silent:
# ocaml-light's 5 minutes); -v: its output and time
step() {
  local what=$1; shift
  say "building $what"
  if [ $verbose = 1 ]; then
    local t0=$SECONDS
    "$@" >&2 || return 1
    say "built $what ($((SECONDS - t0))s)"
  else
    "$@" > /dev/null
  fi
}
# alone, the kernels; --help, the options too
kernels() { sed -n '/^# mini-pi:/,/^# Options:/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; echo "(./mini-pi --help: the options, and where the kernels are)"; exit 2; }
usage() { sed -n '/^# mini-pi:/,/^# mini-9pi in ix/p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

[ $# = 0 ] && kernels
[ "$1" = --help ] && usage
while getopts gwqdnvc:p:h o; do
  case $o in
    g) graphics=1;; w) write=1;; q) qemu=1;; d) debug=1;; n) build=0;; v) verbose=1;; c) cores=$OPTARG;; p) PIXEL=$OPTARG;; *) usage;;
  esac
done
shift $((OPTIND - 1))
[ $# = 1 ] || usage

case $1 in
  xv6|xv6-pi1)
    port=arm-pi1-bis; image=kernel.img
    [ $1 = xv6-pi1 ] && { port=arm-pi1; image=kernel-qemu.img; }
    dir=$XV6/forks/$port
    args=(-M raspi1ap -kernel $image)
    if [ $graphics = 1 ]; then args+=(-serial mon:stdio -device usb-kbd); else args+=(-nographic); fi
    ;;
  xv6-pi4)
    dir=$XV6/forks/arm64-pi4; image=kernel/kernel
    [ $graphics = 1 ] && { echo "mini-pi: xv6-pi4 has no graphics"; exit 1; }
    # QEMU's raspi4b wants its four cores
    smp=$cores; [ $qemu = 1 ] && smp=4
    args=(-cpu cortex-a72 -M raspi4b -kernel $image -m 2G -smp $smp -nographic)
    ;;
  mini-xv6-pi1|mini-xv6-pi4)
    board=${1#mini-xv6-}
    dir=$ROOT/kernel/xv6
    if [ $build = 1 ]; then
      arch=arm; [ $board = pi4 ] && arch=arm64
      step "ocaml-light for $arch" $ROOT/kernel/ocaml-light.sh $arch && step "mini-xv6 ($board)" make -C $dir BOARD=$board XV6=$XV6 || { echo "mini-pi: mini-xv6 not built"; exit 1; }
    fi
    # -g: a window, its framebuffer console (Screen.ml: the console's
    # output drawn), a USB keyboard and mouse (Usbhost.ml: type in the
    # window or the terminal; the mouse moves the screen's cursor)
    display=(-nographic); [ $graphics = 1 ] && display=(-serial mon:stdio -device usb-kbd -device usb-mouse)
    elf=$dir/build/$board/kernel.elf
    if [ $board = pi1 ]; then
      image=kernel-pi1.img
      args=(-M raspi1ap -device loader,file=$image,addr=0x8000,cpu-num=0,force-raw=on "${display[@]}")
    else
      image=kernel-pi4.elf
      smp=1; [ $qemu = 1 ] && smp=4
      args=(-cpu cortex-a72 -M raspi4b -kernel $image -m 2G -smp $smp "${display[@]}")
    fi
    ;;
  mini-9pi|mini-9pi4)
    # alone: ix's own programs in the image (kernel/9pi's make ix), no card
    dir=$ROOT/kernel/9pi
    board=pi1; arch=arm; [ $1 = mini-9pi4 ] && { board=pi4; arch=arm64; }
    if [ $build = 1 ]; then
      # (the Pi1's card too: the Pi4's firmware is not in ix yet; -g: with
      # mini-usbd in the image, for the window's keyboard and mouse)
      what=ix; [ $board = pi1 ] && what=card
      [ $graphics = 1 ] && what="$what ix-usb"
      step "ocaml-light for $arch" $ROOT/kernel/ocaml-light.sh $arch && step "$1" make -C $dir BOARD=$board ${PIXEL:+PIXEL=$PIXEL} PRINCIPIA=$PRINCIPIA $what || { echo "mini-pi: $1 not built"; exit 1; }
    fi
    display=(-nographic); [ $graphics = 1 ] && display=(-serial mon:stdio -device usb-kbd -device usb-mouse)
    pix=-ocaml; [ "$PIXEL" = c ] && pix=
    elf=$dir/build/$board$pix-ix/kernel.elf
    if [ $board = pi1 ]; then
      image=kernel-pi1-ix.img; [ $graphics = 1 ] && image=kernel-pi1-ixu.img
      snapshot=",snapshot=on"; [ $write = 1 ] && snapshot=""
      sd=(); [ -f $dir/build/card.img ] && sd=(-drive file=build/card.img,if=sd,format=raw$snapshot)
      args=(-M raspi1ap -device loader,file=$image,addr=0x8000,cpu-num=0,force-raw=on "${sd[@]}" "${display[@]}")
    else
      image=kernel-pi4-ix.elf; [ $graphics = 1 ] && image=kernel-pi4-ixu.elf
      smp=1; [ $qemu = 1 ] && smp=4
      args=(-cpu cortex-a72 -M raspi4b -kernel $image -m 2G -smp $smp "${display[@]}")
    fi
    ;;
  mini-oberon|mini-oberon4)
    # built by ix's tools (the mkfiles): the standard library, then the
    # kernel, under _mk; the disk's files are inside the image
    o=5; [ $1 = mini-oberon4 ] && o=7
    dir=$ROOT/_mk/$o/kernel/oberon
    if [ $build = 1 ]; then
      step "ix's programs" sh -c "cd $ROOT && dune build @install" &&
      step "the standard library, by ix" sh -c "cd $ROOT/lib_core && PATH=$ROOT/bin:\$PATH mini-mk O=$o" &&
      step "$1" sh -c "cd $ROOT/kernel/oberon && PATH=$ROOT/bin:\$PATH mini-mk O=$o" || { echo "mini-pi: $1 not built"; exit 1; }
    fi
    display=(-nographic); [ $graphics = 1 ] && display=(-serial mon:stdio -device usb-kbd -device usb-mouse)
    if [ $o = 5 ]; then
      image=kernel.img
      args=(-M raspi1ap -device loader,file=$image,addr=0x8000,cpu-num=0,force-raw=on "${display[@]}")
    else
      image=kernel8.img
      smp=1; [ $qemu = 1 ] && smp=4
      args=(-cpu cortex-a72 -M raspi4b -kernel $image -m 2G -smp $smp "${display[@]}")
    fi
    ;;
  mini-9pi-principia|mini-9pi4-principia)
    dir=$ROOT/kernel/9pi
    board=pi1; arch=arm; [ $1 = mini-9pi4-principia ] && { board=pi4; arch=arm64; }
    [ -f $PRINCIPIA/qemu-sd.img ] || { echo "mini-pi: no $PRINCIPIA/qemu-sd.img (principia: mk disk)"; exit 1; }
    if [ $build = 1 ]; then
      step "ocaml-light for $arch" $ROOT/kernel/ocaml-light.sh $arch && step "$1" make -C $dir BOARD=$board ${PIXEL:+PIXEL=$PIXEL} PRINCIPIA=$PRINCIPIA || { echo "mini-pi: $1 not built"; exit 1; }
    fi
    snapshot=",snapshot=on"; [ $write = 1 ] && snapshot=""
    # its console the PL011 (kernel/lib's), in this terminal; -g: also
    # drawn in a window (Swconsole.ml), a USB keyboard (usbd's usb/kb:
    # type in the window) and mouse (the arrow cursor, Swcursor.ml)
    display=(-nographic); [ $graphics = 1 ] && display=(-serial mon:stdio -device usb-kbd -device usb-mouse)
    sd=(-drive file=$PRINCIPIA/qemu-sd.img,if=sd,format=raw$snapshot)
    # the ELF, for -v's names (kernel/lib/kernel.mk's build directory)
    pix=-ocaml; [ "$PIXEL" = c ] && pix=
    elf=$dir/build/$board$pix/kernel.elf
    if [ $board = pi1 ]; then
      image=kernel-pi1.img
      args=(-M raspi1ap -device loader,file=$image,addr=0x8000,cpu-num=0,force-raw=on "${sd[@]}" "${display[@]}")
    else
      image=kernel-pi4.elf
      smp=1; [ $qemu = 1 ] && smp=4
      args=(-cpu cortex-a72 -M raspi4b -kernel $image -m 2G -smp $smp "${sd[@]}" "${display[@]}")
    fi
    ;;
  9pi)
    dir=$PRINCIPIA
    image=kernel/COMPILE/9/bcm/9pi
    snapshot=",snapshot=on"; [ $write = 1 ] && snapshot=""
    [ -f $dir/qemu-sd.img ] || { echo "mini-pi: no $dir/qemu-sd.img (principia: mk disk)"; exit 1; }
    args=(-M raspi1ap -device loader,file=$image,addr=0x8000,cpu-num=0,force-raw=on
          -drive file=qemu-sd.img,if=sd,format=raw$snapshot -serial null -serial mon:stdio)
    # graphics as principia's "mk run": the draw console, a USB keyboard
    # and mouse (rio from it; a click in the window grabs the mouse,
    # Ctrl-Alt-G lets it go)
    if [ $graphics = 1 ]; then args+=(-device usb-kbd -device usb-mouse); else args+=(-display none); fi
    ;;
  *) usage;;
esac
[ -f $dir/$image ] || { echo "mini-pi: no $dir/$image (build the kernel first)"; exit 1; }

# what is used, on standard error (the console's output stays clean)
emulator=$ROOT/_build/default/raspberry/Main.exe
QEMU64=${QEMU64:-/media/pad/extradrive1/pad/work/TOOLCHAINS/qemu/build/qemu-system-aarch64}
[ -x $QEMU64 ] || QEMU64=$(command -v qemu-system-aarch64)
qemu_exe=$(command -v qemu-system-arm); case $1 in xv6-pi4|mini-xv6-pi4|mini-9pi4|mini-9pi4-principia|mini-oberon4) qemu_exe=$QEMU64;; esac
[ $qemu = 1 ] && emulator=$qemu_exe
say "emulator: $emulator$( [ $qemu = 0 ] && echo " (mini-qemu)")"
say "kernel:   $dir/$image ($(stat -c %s $dir/$image) bytes, built $(date -r $dir/$image '+%Y-%m-%d %H:%M'))"
if [ $1 = 9pi ] || [ $1 = mini-9pi-principia ] || [ $1 = mini-9pi4-principia ]; then
  if [ $write = 1 ]; then mode="written in place"; else mode="read-only: writes kept in memory, lost at exit (-w to keep them)"; fi
  say "SD card:  $PRINCIPIA/qemu-sd.img ($(( $(stat -c %s $PRINCIPIA/qemu-sd.img) / 1024 / 1024 )) MB, $mode)"
  if [ $1 = 9pi ]; then say "console:  the mini UART (serial 1)"; else say "console:  the PL011 (serial 0)"; fi
else
  case $1 in mini-oberon*) say "disk:     its files (Oberon's fonts, System.Tool) are inside the kernel image";;
    mini-9pi*) say "disk:     the programs are inside the kernel image (its bootdir, /boot)$( [ $1 = mini-9pi ] && [ -f $dir/build/card.img ] && echo "; SD card: $dir/build/card.img" )";;
    *) say "disk:     the file system is inside the kernel image (xv6's ramdisk)";; esac
  say "console:  the PL011 (serial 0)"
  [ $1 = xv6-pi4 ] && [ $qemu = 0 ] && say "cores:    $cores of the Pi4's four (-smp $cores); the boot takes about $((20 * cores))s (kinit fills 128MB)"
fi
[ $graphics = 1 ] && case $1 in
  mini-oberon*) say "display:  a window, Oberon's screen";;
  mini-xv6-*|mini-9pi*) say "display:  a window, the console drawn there, a USB keyboard and mouse (a click grabs it, Ctrl-Alt-G lets it go)";;
  *) say "display:  a window, and a USB keyboard$( [ $1 = 9pi ] && echo ' and mouse (a click grabs it, Ctrl-Alt-G lets it go)')";;
esac
say "command:  (cd $dir && $emulator ${args[*]})"
say "quit:     Ctrl-A then x$( [ $graphics = 1 ] && echo ', or close the window')"

if [ $qemu = 1 ]; then
  cd $dir && exec $qemu_exe "${args[@]}"
fi
if [ $build = 1 ]; then
  step mini-qemu sh -c "cd $ROOT && dune build --profile release ./raspberry/Main.exe" || exit 1
fi
[ $debug = 1 ] && args+=(-d)
# claude: -v: where the guest is every 2s, its PCs named from the
# kernel's ELF (xv6's own kernels are ELFs; 9pi's a Plan 9 a.out)
if [ $verbose = 1 ]; then
  args+=(-status 2)
  [ -z "$elf" ] && case $image in *.elf|*/kernel) elf=$dir/$image;; esac
  [ -n "$elf" ] && [ -f "$elf" ] && args+=(-symbols $elf)
fi
cd $dir && exec $ROOT/_build/default/raspberry/Main.exe "${args[@]}"
