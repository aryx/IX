; debug/: what a debugger needs (plan_debugger.md), in the library
(copy_files# debug/*.{ml,mli})

(library
 (name ix_ld)
 (wrapped false)
 (modules Program Debug_link Link Arm Arm64 Exe Symtab)
 (libraries ix_core ix_asm fpath logs caps))

; the command: the passes, Follow unless -nofollow
(library
 (name ix_ld_cli)
 (wrapped false)
 (modules CLI)
 (libraries ix_ld ix_ld_compat ix_core ix_asm fpath logs caps))

(executable
 (name Main)
 (public_name mini-ld)
 (package ix)
 (modules Main)
 (libraries ix_ld_cli caps))
