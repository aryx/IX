; tiny programs on the host, in a window of SDL's: TinyCalls.ml, the
; kernel's calls (../TinyKernel/host/TinyCalls.mli) a window's, and the
; few lines of each program, tiny-kernel's own (../TinyKernel/user/),
; compiled by OCaml here. Not counted by make loc (an sdl/ directory: a
; program's host), as tiny-machine-window is not.

(library
 (name tiny_host_calls_sdl)
 (implements tiny_host_calls)
 (modules TinyCalls TinyFont)
 (libraries tiny_kernel_graphics tiny_kernel_audio tiny_host_memory tiny_machine_sdl tiny_machine_devices tiny_machine_peer unix))

; the machine's font, tiny-kernel's (../TinyKernel/fonts/README.md), in
; the program
(rule
 (targets TinyFont.ml)
 (deps (:font ../TinyKernel/fonts/grey.font))
 (action
  (with-stdout-to %{targets}
   (progn
    (echo "(* TinyKernel/fonts/grey.font *)\nlet bits = {font|")
    (cat %{font})
    (echo "|font}\n")))))

(copy_files# ../TinyKernel/user/office.ml)
(copy_files# ../TinyKernel/user/emacs.ml)
(copy_files# ../TinyKernel/user/calc.ml)
(copy_files# ../TinyKernel/user/tetris.ml)
(copy_files# ../TinyKernel/user/www.ml)
(copy_files# ../TinyKernel/user/troff.ml)
(copy_files# ../TinyKernel/user/play.ml)

(executable
 (name office)
 (public_name tiny-office)
 (package ix)
 (modules office)
 (libraries tiny_office tiny_lib_gui tiny_host_calls_sdl))

(executable
 (name emacs)
 (public_name tiny-emacs)
 (package ix)
 (modules emacs)
 (libraries tiny_editor_screen tiny_lib_gui tiny_host_calls_sdl))

(executable
 (name calc)
 (public_name tiny-calc)
 (package ix)
 (modules calc)
 (libraries tiny_app_calculator tiny_lib_gui tiny_host_calls_sdl))

(executable
 (name www)
 (public_name tiny-www)
 (package ix)
 (modules www)
 (libraries tiny_browser tiny_host_calls_sdl))

(executable
 (name troff)
 (public_name tiny-troff)
 (package ix)
 (modules troff)
 (libraries tiny_troff tiny_lib_gui tiny_host_calls_sdl))

(executable
 (name play)
 (public_name tiny-play)
 (package ix)
 (modules play)
 (libraries tiny_play tiny_lib_gui tiny_host_calls_sdl))

(executable
 (name tetris)
 (public_name tiny-tetris)
 (package ix)
 (modules tetris)
 (libraries tiny_app_tetris tiny_lib_playground tiny_host_calls_sdl))
