# mini-xv6, step 1, on the Pi 4 by ix's tools (plan_kernel_mini_ml.md,
# step 3): the same Main.ml as the Makefile's (the Pi 1's, by
# ocaml-light and gcc), compiled by mini-ml, on mini-ml's runtime (by
# mini-cc, with the board's heap), the whole stdlib, goken's C library,
# and step 0's start and shim in Linux's place; linked by mini-ld as an
# image without a header.
#   mini-mk          _mk/7/kernel/step1/kernel8.img
#   mini-mk check    booted under mini-qemu, and under QEMU if it is
#                    there: expected-pi4, the Makefile's expected lines
#                    but the sum, which the Pi 1's 31 bits wrap
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/kernel/step1
LIBC=$TOP/lib_core/libc
CINC=-I$LIBC/include -I$LIBC/include/utf -I$LIBC -I$LIBC/include/arch/arm64 -Darm64 -Dlinux
# the heap: two halves of 4M words (32 MB each), a value stack of 1 MB
# (quoted: after a variable's =, mk reads a word before another = as attributes)
HEAP='-DMAXHEAP=4194304' '-DSTACK=131072'
BOOT=-cpu cortex-a72 -M raspi4b -m 2G -kernel $D/kernel8.img
QEMU=/home/pad/work/TOOLCHAINS/qemu/build/qemu-system-aarch64

all:V: $D/kernel8.img

$D/Main.$O: Main.ml
	mkdir -p $D
	$ML $STDI -o $target Main.ml
$D/start.$O: mkfile $TOP/mkfiles/mkconfig
	mkdir -p $D
	$ML -start $STD $COMMONS Main Std_exit -o $target
$D/runtime.$O: $TOP/languages/ml/runtime/runtime.c mkfile
	mkdir -p $D
	$CC $CINC $HEAP -o $target $TOP/languages/ml/runtime/runtime.c
$D/l.$O: ../step0/l.s
	mkdir -p $D
	$AS -o $target ../step0/l.s
$D/shim.$O: ../step0/shim.c
	mkdir -p $D
	$CC $CINC -o $target ../step0/shim.c

OBJS=$D/l.$O $D/shim.$O $D/start.$O $STDOBJS $D/Main.$O $L/std_exit.$O $D/runtime.$O $L/libc.a
$D/kernel8.img: $OBJS
	$LD -H0 -T 0x80000 -E _start -nofollow -o $target $OBJS

check:V: $D/kernel8.img
	timeout 20 mini-qemu $BOOT -nographic < /dev/null > $D/mini.txt 2> /dev/null || true
	cmp $D/mini.txt expected-pi4 && echo "ok step1: under mini-qemu"
	if [ -x $QEMU ]; then
		timeout 10 $QEMU $BOOT -smp 4 -display none -monitor none -serial file:$D/qemu.txt < /dev/null 2> /dev/null || true
		cmp $D/qemu.txt expected-pi4 && echo "ok step1: under QEMU"
	fi

clean:V:
	rm -rf $D
