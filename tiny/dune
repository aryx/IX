(library
 (name tiny_browser)
 (wrapped false)
 (modules TinyBrowser)
 (libraries tiny_lib_draw tiny_host_calls))

(executable
 (name TinyML)
 (public_name tiny-ml)
 (package ix)
 (modules TinyML TinyMLPrelude)
 (libraries ix_core fpath caps))

; tiny-ml's prelude, a file of its ML (TinyLibCore.ml), as a
; string in a module of the compiler's
(rule
 (targets TinyMLPrelude.ml)
 (deps TinyLibCore.ml)
 (action
  (with-stdout-to
   %{targets}
   (progn
    (echo "let prelude = {|\n")
    (cat %{deps})
    (echo "|}\n")))))

