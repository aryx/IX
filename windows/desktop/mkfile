# the desktop's programs, built by ix's tools (for Plan 9: mini-mk O=5
# OS=plan9). Their shared modules are in lib/. lib_graphics's units are
# compiled here: those of the screen, and for desk those that read a
# picture, with lib_compression's. (Linking all of lib_graphics' archive
# would bring 9 MB of PDF, fonts and films for a wallpaper.)
TOP=../..
<$TOP/mkfiles/mkconfig
LIBDIRS=lib_compression
<$TOP/mkfiles/mklibs
D=$B/windows/desktop
G=../../lib_graphics
DIRS=. lib $G $G/core $G/images
INCLUDES=-I . -I lib -I $G -I $G/core -I $G/images $LIBI $STDI
GFX=Point Rectangle Display Draw Font_default Font Mouse Keyboard Cursor Menu
IMG=Rgba_image Dct Jpeg_progressive Png Jpeg Image_file
PANEL=$GFX Taskbar Wsys Prefs Panel
EXPOSE=$GFX Taskbar Wsys Tiles Expose
MENU=$GFX Apps Icon Startmenu
DESK=$GFX $IMG Taskbar Apps Icon Prefs Paper Desk
SETTINGS=$GFX Taskbar Prefs Settings
UNITS=$GFX $IMG Taskbar Wsys Tiles Apps Icon Prefs Paper Panel Startmenu Desk Settings Expose
# (each program's objects are in a variable of their own, because a
# recipe is rc's, which has no ${:})
PANELOBJS=${PANEL:%=$D/%.$O}
MENUOBJS=${MENU:%=$D/%.$O}
DESKOBJS=${DESK:%=$D/%.$O}
SETTINGSOBJS=${SETTINGS:%=$D/%.$O}
EXPOSEOBJS=${EXPOSE:%=$D/%.$O}
LOCAL=`{ls *.ml lib/*.ml lib/*.mli ../../lib_graphics/*.ml ../../lib_graphics/*.mli ../../lib_graphics/core/*.ml ../../lib_graphics/images/*.ml} $LIBSRC

all:V: $D/panel $D/startmenu $D/desk $D/settings $D/expose

# a unit from the last of DIRS that has it (the loop keeps the last)
$D/%.$O: $LOCAL
	mkdir -p $D
	for(d in $DIRS) if(ls $d/$stem.ml >/dev/null >[2=1]) f=$d/$stem.ml
	$ML $INCLUDES -o $target $f

# a program: its units in their order, then the start and the link
$D/panel: $PANELOBJS $STDOBJS $STDEND $TOP/mkfiles/mkconfig
	$ML -start $STD $COMMONS $PANEL Std_exit -o $D/panel.start.$O
	$LD $LDH -nofollow -o $target $D/panel.start.$O $STDOBJS $PANELOBJS $STDEND
$D/startmenu: $MENUOBJS $STDOBJS $STDEND $TOP/mkfiles/mkconfig
	$ML -start $STD $COMMONS $MENU Std_exit -o $D/startmenu.start.$O
	$LD $LDH -nofollow -o $target $D/startmenu.start.$O $STDOBJS $MENUOBJS $STDEND
$D/desk: $DESKOBJS $LIBA $STDOBJS $STDEND $TOP/mkfiles/mkconfig
	$ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA} $DESK Std_exit -o $D/desk.start.$O
	$LD $LDH -nofollow -o $target $D/desk.start.$O $STDOBJS $LIBA $DESKOBJS $STDEND
$D/settings: $SETTINGSOBJS $STDOBJS $STDEND $TOP/mkfiles/mkconfig
	$ML -start $STD $COMMONS $SETTINGS Std_exit -o $D/settings.start.$O
	$LD $LDH -nofollow -o $target $D/settings.start.$O $STDOBJS $SETTINGSOBJS $STDEND
$D/expose: $EXPOSEOBJS $STDOBJS $STDEND $TOP/mkfiles/mkconfig
	$ML -start $STD $COMMONS $EXPOSE Std_exit -o $D/expose.start.$O
	$LD $LDH -nofollow -o $target $D/expose.start.$O $STDOBJS $EXPOSEOBJS $STDEND

clean:V:
	rm -rf $D

# the units' order (mkfiles/mkdepend)
DEPOBJ=D
DEPDIRS=$DIRS
DEPUNITS=$UNITS
<$TOP/mkfiles/mkdepend
