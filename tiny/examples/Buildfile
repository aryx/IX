#
# Small programs to read, build and run on tiny-kernel. They are in
# /examples, which has the same files as this directory. Each file's
# header says more about it:
#
#     C          ML           what
#     hello.c    helloml.ml   a print (hello with square.s, in assembly)
#     shapes.c   shapesml.ml  a picture drawn, the drawing's messages
#     fetch.c    fetchml.ml   a document of another machine, by Gopher
#     procs.c    procsml.ml   a pipe, fork, exec and wait: a shell's pipeline
#                game.ml      a ball, on the playground (TinyLibPlayground)
#                gui.ml       a counter, on the widgets (TinyLibGUI)
#     spin.s                  prof's example, with spin.prof
#
# build makes all of them; build gui makes one by its name. What they
# link besides their own objects is already built in /lib:
# - /lib/c has C's runtime and tiny-kernel's calls, with start.o first
#   (the machine starts there), and drawing and dialing;
# - /lib/ml has ML's runtime (mlsys.o), the library (stdlib.a and its
#   units), the libraries that a program that draws stands on, and
#   end.o, the program's end, linked last.
# They are built in /src and copied to /lib by its build install. -s
# puts the labels, the names that debug shows, after the image; -map
# also writes them beside it.
#
# On the host it works the same way, with the tools tiny-cc..., and with
# /lib as TinyKernel/Makefile installs it for the disk, in _make/system:
#     tiny-build TINY=tiny- LIB=../TinyKernel/_make/system/lib

TINY =
CC = ${TINY}cc
AS = ${TINY}as
LD = ${TINY}ld
ML = ${TINY}ml
LIB = /lib

CRT = ${LIB}/c/start.o ${LIB}/c/udivmod.o ${LIB}/c/libc.o ${LIB}/c/sys.o
MLRT = ${LIB}/ml/mlsys.o
STDLIB = ${LIB}/ml/stdlib.a
MLEND = ${LIB}/ml/end.o
# (where tiny-ml reads the library's interfaces)
MLLIB = ${LIB}/ml
# (where user.h is, with the system's calls a C program makes, and
# libc.h)
INC = ${LIB}/c
# (draw.o sends the drawing's messages that draw.h declares)
DRAW = ${LIB}/c/draw.o
# (net.o has reach, which dials by an address or by a name)
NET = ${LIB}/c/net.o
# The libraries that an ML program that draws stands on, each after the
# ones it uses: the system's calls, the drawing's messages, the
# playground and the widgets.
SYS = ${LIB}/ml/TinyLibSystem.o
DRAWLIB = ${LIB}/ml/TinyLibDraw.o
PLAYGROUND = ${LIB}/ml/TinyLibPlayground.o
GUI = ${LIB}/ml/TinyLibGUI.o

all: hello shapes fetch procs helloml shapesml fetchml procsml game gui spin

hello: hello.o square.o
	$LD -map -s -n -o $target $CRT $prereq

hello.o: hello.c ${INC}/user.h
	$CC -I $INC -o $target hello.c
square.o: square.s
	$AS -o $target square.s

shapes: $DRAW shapes.o
	$LD -map -s -n -o $target $CRT $prereq
shapes.o: shapes.c ${INC}/user.h ${INC}/draw.h
	$CC -I $INC -o $target shapes.c

fetch: $NET fetch.o
	$LD -map -s -n -o $target $CRT $prereq
fetch.o: fetch.c ${INC}/user.h
	$CC -I $INC -o $target fetch.c

procs: procs.o
	$LD -map -s -n -o $target $CRT $prereq
procs.o: procs.c ${INC}/user.h
	$CC -I $INC -o $target procs.c

helloml: helloml.o
	$LD -map -s -n -o $target $CRT $MLRT $prereq $STDLIB $MLEND

# (a program of one unit has its code and its start in one object)
helloml.o: helloml.ml
	$ML -L $MLLIB -o $target helloml.ml

# A program on libraries is built as /src's are. Its unit is compiled
# with their interfaces (-I), and ml makes its start from all its units
# (their initializations in order, the table of the globals). Then ld
# links it from the runtimes, the start, the library, the units and the
# end.
%.o: %.ml
	$ML -c -L $MLLIB -I $MLLIB -o $target $stem.ml
%.start.o:
	$ML -o $target $prereq

SHAPESML_UNITS = $SYS $DRAWLIB shapesml.o
shapesml.start.o: $STDLIB $SHAPESML_UNITS
shapesml: $CRT $MLRT shapesml.start.o $STDLIB $SHAPESML_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

FETCHML_UNITS = $SYS fetchml.o
fetchml.start.o: $STDLIB $FETCHML_UNITS
fetchml: $CRT $MLRT fetchml.start.o $STDLIB $FETCHML_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

PROCSML_UNITS = $SYS procsml.o
procsml.start.o: $STDLIB $PROCSML_UNITS
procsml: $CRT $MLRT procsml.start.o $STDLIB $PROCSML_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

GAME_UNITS = $SYS $DRAWLIB $PLAYGROUND game.o
game.start.o: $STDLIB $GAME_UNITS
game: $CRT $MLRT game.start.o $STDLIB $GAME_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

GUI_UNITS = $SYS $DRAWLIB $PLAYGROUND $GUI gui.o
gui.start.o: $STDLIB $GUI_UNITS
gui: $CRT $MLRT gui.start.o $STDLIB $GUI_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

# spin is linked alone, with no runtime. It is prof's example, with
# spin.prof, which says where its instructions went and which tiny-cpu
# -prof wrote on the host. tiny-kernel has no tiny-cpu, so spin.prof is
# kept here, and build never makes it there:
#     prof spin.prof -u spin.map
#     tiny-build TINY=tiny- spin.prof     makes it again, on the host
spin: spin.o
	$LD -map -o $target spin.o
spin.map: spin
spin.o: spin.s
	$AS -o $target spin.s
spin.prof: spin
	tiny-cpu -prof $target spin > /dev/null

clean:
	rm -f hello shapes fetch procs helloml shapesml fetchml procsml game gui spin *.o *.tmi *.map
