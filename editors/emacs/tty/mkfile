LIBI=-I .. -I ../core -I ../features -I ../modes -I ../../../lib_code -I ../../../languages/ml/highlight -I ../../../languages/c/highlight -I ../../../assembler/highlight -I ../../../languages/smalltalk/highlight -I ../../../languages/scheme/highlight -I ../../../languages/pascal/highlight -I ../../../lib_terminal -I ../../../lib_terminal/unix -I ../../../lib_playground/random
LIBUNITS=
LIBOBJS=
<$TOP/mkfiles/mkconfig
# (the two lexers mini-lex makes)
GEN=$B/editors/emacs/tty/Lexer_ml.ml $B/editors/emacs/tty/Lexer_c.ml
