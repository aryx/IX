; version_control: mini-git, mini-diff and mini-merge3, after git9, in
; folders (one library, ix_vcs; the three mains and CLI are here):
;   objects/   what a repository is made of: Hash (SHA-1 names), Object
;              (blobs, trees, commits, tags), Loose (an object a file),
;              Delta, Pack and Packer (objects packed, and their
;              deltas), Store (an object wherever it is)
;   repo/      the repository around them: Repo, Refs, Conf (its
;              configuration), Query (the revision language), Fs (its
;              paths, as git9's git/fs), Index9 (the staging file),
;              Walk (the work tree against the index and a commit)
;   diff/      Diff, Merge3, and Difftool: the two other programs
;   wire/      Proto (git's protocol), Get, Send, Serve
;   commands/  git9's commands (Commands), Save (a commit made), Log,
;              Flags (Plan 9's ARGBEGIN)
; tests/ has its own stanzas and is not of the folders.
(include_subdirs unqualified)

(library
 (name ix_vcs)
 (wrapped false)
 (modules Hash Object Loose Delta Pack Store Refs Conf Query Repo Flags Log Fs Index9 Walk Save Packer Proto Get Send Serve Diff Merge3 Difftool Commands CLI)
 ; mlpp's a |! b: the workspace's mini-ml first
 (preprocess (action (run %{bin:mini-ml} -pp %{input-file})))
 (preprocessor_deps (source_tree .))
 (libraries ix_core ix_crypto ix_compression fpath unix caps logs))

(executable
 (name Main)
 (public_name mini-git)
 (package ix)
 (modules Main)
 (libraries ix_vcs ix_core caps))

(executable
 (name Diffmain)
 (public_name mini-diff)
 (package ix)
 (modules Diffmain)
 (libraries ix_vcs caps))

(executable
 (name Merge3main)
 (public_name mini-merge3)
 (package ix)
 (modules Merge3main)
 (libraries ix_vcs caps))
