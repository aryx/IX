rc
cd /src/TinyCRuntime; cc -o /libc.tm libc.c
cd /src/TinyKernel/user; cc -o /ping.tm ping.c
cd /
as -o start.o src/TinyCRuntime/start.tm
as -o udivmod.o src/TinyCRuntime/udivmod.tm
as -o sys.o src/TinyKernel/libc/sys.tm
as libc.tm; as ping.tm
ld -s -n -o ping start.o udivmod.o libc.o sys.o ping.o
cmp ping /bin/ping && echo ping: /bin/ping
cd /src; ml -c -o /mach.tm TinyLibMachine.ml; cd /
cmp mach.tm /examples/TinyLibMachine.tm && echo mach.tm: the host
cmp mach.tmi /examples/TinyLibMachine.tmi && echo mach.tmi: the host
as mach.tm; cmp mach.o /examples/TinyLibMachine.o && echo mach.o: the host
ls -l /bin/as /bin/ld /bin/cc /bin/ml
exit
