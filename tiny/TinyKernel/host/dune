; what tiny-machine gives TinyKernelGraphics.ml and TinyLibPlayground.ml, by OCaml
; for the host, where they are tested first: TinyMemory is the machine's
; memory, an array; TinyCalls is the kernel's calls, kept or absent. On
; tiny-machine these names are externals (../memory.ml, ../libml/calls.ml)
(library
 (name tiny_host_memory)
 (wrapped false)
 (modules TinyMemory))

(library
 (name tiny_host_calls)
 (wrapped false)
 (modules TinyCalls))
