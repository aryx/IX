false; echo 1 $status
true; echo 2 $status
true | false; echo 3 $status
false | true | false; echo 4 $status
sh -c 'exit 3'; echo 5 $status
sh -c 'exit 300'; echo 6 $status
nonexistentcmd; echo 7 $status
~ a b; echo 8 $status
! true; echo 9 $status
# (true, not echo: an echo there races with its reader, and says "write on closed pipe" or not)
true | x=inpipe; echo 10 $x
