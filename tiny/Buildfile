#############################################################################
# The programs in C
#############################################################################

# sh is the first shell (rc is the one used); mltests is a test of ML's
# calls; ping, get, put and httpd are the network's programs (get and
# put link net.c, which dials a name); paint draws (with draw.c).
user/sh.o: user/sh.c runtime/c/user.h
sh: $CRT user/sh.o
	$LD -map -s -n -o $target $prereq
user/mltests.o: user/mltests.c runtime/c/user.h
mltests: $CRT user/mltests.o
	$LD -map -s -n -o $target $prereq
user/ping.o: user/ping.c runtime/c/user.h
ping: $CRT user/ping.o
	$LD -map -s -n -o $target $prereq
user/get.o: user/get.c runtime/c/user.h
get: $CRT runtime/c/net.o user/get.o
	$LD -map -s -n -o $target $prereq
user/put.o: user/put.c runtime/c/user.h
put: $CRT runtime/c/net.o user/put.o
	$LD -map -s -n -o $target $prereq
user/httpd.o: user/httpd.c runtime/c/user.h
httpd: $CRT user/httpd.o
	$LD -map -s -n -o $target $prereq
user/paint.o: user/paint.c runtime/c/user.h runtime/c/draw.h
paint: $CRT runtime/c/draw.o user/paint.o
	$LD -map -s -n -o $target $prereq

#############################################################################
# The kernel: TinyKernel/
#############################################################################

# The kernel is made by its own Buildfile, TinyKernel/Buildfile, from
# its units, its assembly and the library. Like the library's build, it
# runs each time (kernel is not a file), and it runs after the library's.
# TinyKernel/kernel.img is made with it.
kernel: $STDLIB
	cd TinyKernel && $BUILD ML=^$ML CC=^$CC AS=^$AS LD=^$LD
TinyKernel/kernel.img: kernel

#############################################################################
# The system and the image
#############################################################################

# build install puts the system in /bin, /lib and /examples. On
# tiny-kernel, these are the disk's (make self). On the host, they are
# in a directory, which TinyKernel/Makefile turns into a disk, disk.img
# (with tiny-mkfs, on the host; the sources, /src, are the second disk,
# src.img).
#
# /bin holds the programs. utils is there under each of its names, as a
# hard link (cat is utils, and so are ls, wc...); emacs is also there as
# editor, and ed as sam.
UTILS = [ basename cat cmp cp date du echo grep kill ln ls mkdir mv ps pwd \
    rm seq sleep sort tail tee test touch walk wc xd

# /lib holds what a program built on tiny-kernel links, already built
# here.
# /lib/c holds C's files: the runtime, the system's calls, drawing and
# dialing, and their headers (cc -I /lib/c finds user.h, which includes
# libc.h).
# /lib/ml holds ML's files: its runtime, the program's end, the library
# (its archive and its units' interfaces, for ml -L /lib/ml), and the
# libraries that a program that draws stands on, each as its object and
# its interface (for ml -I /lib/ml): the system's calls, the drawing's
# messages, the playground and the widgets.
LIBC = runtime/c/start.o runtime/c/udivmod.o runtime/c/libc.o \
    runtime/c/sys.o runtime/c/draw.o runtime/c/net.o \
    runtime/c/libc.h runtime/c/user.h runtime/c/draw.h
MLLIBS = $SYS $DRAWLIB $PLAYGROUND $GUI
LIBML = runtime/ml/mlsys.o runtime/ml/end.o \
    $MLLIBS ${MLLIBS:%.o=%.tmi}
# (The .tmi are made with stdlib.a, by TinyLibCore/Buildfile. They are
# not prerequisites, because this file's %.tmi would make them again.)
LIBUNITS = ${CORE:%=TinyLibCore/%.tmi} $STDLIB

# /examples holds examples/'s files, chosen by their kinds with rc's
# globs (its sources, not what a build of them there makes: the
# programs, *.o, *.tmi, *.map). They are not prerequisites, so an
# example changed alone does not make the disk again.
#
# build install copies the files above where they go, from where they
# are built (as Plan 9's mk install does). On the host, it copies into a
# directory, with the three given by their names (TinyKernel/Makefile's
# _make/system):
#     tiny-build TINY=tiny- BIN=d/bin LIB=d/lib EXAMPLES=d/examples install
# install is not a file, so it runs each time it is asked for.
BIN = /bin
LIB = /lib
EXAMPLES = /examples
install: $PROGS $LIBC $LIBML $STDLIB
	mkdir -p $BIN $LIB/c $LIB/ml $EXAMPLES
	for(f in $PROGS) cp $f $BIN/$f
	for(u in $UTILS) { rm -f $BIN/$u; ln $BIN/utils $BIN/$u }
	rm -f $BIN/editor $BIN/sam; ln $BIN/emacs $BIN/editor; ln $BIN/ed $BIN/sam
	for(f in $LIBC) cp $f $LIB/c/^`{basename $f}
	for(f in $LIBML $LIBUNITS) cp $f $LIB/ml/^`{basename $f}
	cp examples/Buildfile examples/*.c examples/*.ml examples/*.s examples/*.prof examples/*.ixd examples/*.wav $EXAMPLES

# boot.img holds the kernel, then /boot's files, each as its name, its
# size and its bytes (a hard link as a name and a line "link bin/utils"
# or "link bin/ed"), and an empty line at the end. /boot is the repair
# kit, what a person needs when the disk does not come up: sh, rc, the
# utilities and ed, in bin/ (the first process is /bin/sh, the disk's if
# there is one, else the image's). /boot also holds the boot's
# configuration, a file named memory: MEMORY, taken from the environment
# (TinyKernel/Makefile's MEMORY=segments or pages), is the kernel's way
# of giving memory, and it comes with MEMSIZE. The recipe is the same on
# the host and on tiny-kernel, where it runs in a copy of tiny/
# (TinyKernel/Makefile's _make/src, the second disk's /src). One file is
# made beforehand, on the host alone: TinyKernel/kfont.s, the font's
# bytes.
BOOT = sh rc utils ed
boot.img: TinyKernel/kernel.img $BOOT
	cat TinyKernel/kernel.img > $target
	for(f in $BOOT) { n=`{wc -c < $f}; echo bin/$f; echo $n; cat $f } >> $target
	for(u in $UTILS) { echo bin/$u; echo link bin/utils } >> $target
	{ echo bin/sam; echo link bin/ed } >> $target
	if(~ $MEMORY segments pages) { echo memory; echo $MEMSIZE; echo $MEMORY } >> $target
	echo >> $target
#`

#############################################################################
# The units' dependencies
#############################################################################

# .depend holds the ML units' rules: a unit's object, then the
# interfaces of the units it names and its .mli. ml -depend writes them
# as ocamldep writes OCaml's (and as m-ix's mini-ml -depend does). Its
# sources are every .ml of INCLUDES' directories, then the files of
# each program with parts, read with that program's own -I's (its main
# file's line comes again, now with its parts, and tiny-build merges a
# target's lines). A unit that is added is found. The host's programs
# among them, TinyCPU.ml and TinyMachine.ml, give lines that no target
# asks for, or are left out, with a message, when tiny-ml cannot read
# them. The globs are written here, not in a variable, because rc does
# not glob a * that comes from a variable. .depend is kept beside this
# file, as ocaml-light's stdlib keeps its own (TinyLibCore/ and
# TinyKernel/ have theirs, and they are made again too). `build depend`
# makes it again after a unit names another one, or after a unit is
# added.
depend:
	$ML -depend $INCLUDES *.ml TinyLibSystem/tinykernel/*.ml user/*.ml > .depend
	$ML -depend $INCLUDES $CC_INCLUDES TinyC.ml TinyC/*.ml >> .depend
	$ML -depend $INCLUDES $ML_INCLUDES TinyML.ml TinyML/*.ml >> .depend
	$ML -depend $INCLUDES $OFFICE_INCLUDES TinyOffice.ml TinyTroff.ml TinyOffice/*.ml >> .depend
	$ML -depend $INCLUDES $WWW_INCLUDES TinyBrowser.ml TinyBrowser/*.ml >> .depend
	@{ cd TinyLibCore && $BUILD ML=^$ML depend }
	@{ cd TinyKernel && $BUILD ML=^$ML depend }

<.depend

#############################################################################
# clean: removing what this file made (the objects and interfaces
# beside their sources, each directory by name; the programs, the image
# and the maps; the library's and the kernel's files by their Buildfiles)
#############################################################################

clean:
	@{ cd TinyLibCore && $BUILD clean }
	@{ cd TinyKernel && $BUILD clean }
	rm -f *.o *.tmi TinyBrowser/*.o TinyBrowser/*.tmi TinyC/*.o TinyC/*.tmi \
	    TinyLibSystem/tinykernel/*.o TinyLibSystem/tinykernel/*.tmi \
	    TinyML/*.o TinyML/*.tmi TinyOffice/*.o TinyOffice/*.tmi \
	    runtime/c/*.o runtime/ml/*.o \
	    user/*.o user/*.tmi *.map $PROGS boot.img
