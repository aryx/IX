#
# t-IX built by tiny-build, under t-IX: this file is to be /src/Buildfile
# on tiny-kernel's image, where /src is tiny/; for now it is tried on the
# host (docs/plans/plan_tiny_buildfile.md, its steps).
#
#     cd /src
#     build build          tiny-build itself, as /src/build, to run
#     build rc             the shell; any program by its name in /bin
#     build                every program, the kernel, the image
#
# It is also meant to be read: how t-IX's pieces fit together, from the
# bottom up. A program stands on its own units, on the libraries
# several programs share, on the standard library (TinyLibCore/), and
# on the runtimes, what a program links besides its own code; the
# kernel stands on the same library and runtime; the image is the
# kernel and all the rest, as files.
#
# What a recipe makes is beside its source: TinyShell.o and its
# interface TinyShell.tmi beside TinyShell.ml, TinyC/TinyCParser.o in
# TinyC/; a program at the top, by its name (rc, build, ml). `build
# clean` removes them.
#
# The tools are tiny-kernel's: ml (tiny-ml), cc (tiny-c), as
# (tiny-assembler), ld (tiny-linker), ar (tiny-ar), build (tiny-build).
# On the host they are tiny-ml and so on: a directory of links named
# ml, cc, as, ld, ar and build first in the PATH runs this file there
# too. A recipe is rc's, on both: tiny-build runs it with tiny-shell on
# the host, /bin/rc on tiny-kernel.
#
# coupling: TinyKernel/Makefile says the same, its lists (CORE, UNITS_x
# a program's units, I_x a unit's interfaces, MEM_x, KUNITS): a
# change to one is a change to the other, until the Makefile is made
# from this file (the plan's last step).
#
# Its problems, today's tools':
# - CORE, the library's units, said here and in TinyLibCore/Buildfile:
#   tiny-build has no glob for the sources that make the library again;
# - the libraries shared by several programs (TinyLibSystem, TinyLibGUI)
#   still their objects, named in each link.


# the programs, by their names in /bin; then the kernel
PROGS = sh rc emacs office troff play mltests paint windows square tetris \
    calc temp ping get put httpd utils ed bigmem www prof db vcs build as ld \
    ar cc ml trace debug

all: $PROGS kernel.img


#############################################################################
# How each kind of file is made
#############################################################################
# the standard library (below): stdlib.a, which every ML program links,
# made with its units' interfaces, which every ML unit reads (-L
# TinyLibCore); CORE, its units, for what makes it again and for the
# image's /lib/ml
CORE = Stdlib Char Seq List String Bytes Array Option Int32 Int64 \
    Filename Buffer Printf Marshal Hashtbl Common Sha1 Fpath Fpath_ Exit \
    In_channel Out_channel Chan Logs
STDLIB = TinyLibCore/stdlib.a

# an ML unit: its source alone; tiny-ml reads the library from
# TinyLibCore/ (-L) and finds the interfaces of the modules the source
# names in INCLUDES' directories (-I), each after those it stands on.
# Its prerequisites are tiny-build's alone, what must be made before it
# and what makes it again: the library (STDLIB, its interfaces made
# with it, as Plan 9's mkfiles make every object depend on all the
# headers), and the interfaces it reads, its line in .depend (at the
# end); as mini-ml in m-ix, the compiler's arguments are not its
# prerequisites. Its .tmi made with its .o
INCLUDES = -I . -I TinyLibSystem/tinykernel -I TinyC -I TinyML -I TinyOffice \
    -I TinyBrowser -I TinyKernel -I user -I tests/TinyLibPlayground_tests
%.o: %.ml $STDLIB
	ml -c -L TinyLibCore $INCLUDES -o $target $stem.ml
%.tmi: %.o

# C, by tiny-c; assembly written by hand, by tiny-assembler (the
# compilers write their objects themselves)
%.o: %.c
	cc -o $target $stem.c
%.o: %.s
	as -o $target $stem.s


#############################################################################
# The runtimes: what a program links besides its own code
#############################################################################

# C's, on any system (runtime/): _start, which calls main, then exits,
# linked first since the machine starts at 0; the unsigned division
# tiny-c calls; libc, print and the strings. Then tiny-kernel's calls
# for C (TinyKernel/libc/: sys.s, a sys instruction each; draw.c and
# net.c for the programs that draw or dial)
CRT = runtime/start.o runtime/udivmod.o runtime/libc.o TinyKernel/libc/sys.o

# ML's: runtime/ml.c, the allocator and Cheney's collector, #included by
# mlsys.c, which gives it tiny-kernel's memory and calls; end.s, the
# image's end, where an ML program's value stack can start, linked last
MLRT = TinyLibSystem/tinykernel/mlsys.o
MLEND = TinyKernel/end.o
TinyLibSystem/tinykernel/mlsys.o: TinyLibSystem/tinykernel/mlsys.c runtime/ml.c TinyKernel/libc/user.h


#############################################################################
# The standard library: TinyLibCore/, OCaml's subset
#############################################################################

# Made by its own Buildfile, TinyLibCore/Buildfile, as ocaml-light's
# stdlib by its Makefile and m-ix's libraries by their mkfiles: its
# units compiled among themselves, then kept in stdlib.a in the order
# they start in. Asked again when one of its sources changes; it knows
# which units to make again. On the image they are /lib/ml.
# coupling: CORE is TinyLibCore/Buildfile's.
$STDLIB: ${CORE:%=TinyLibCore/%.ml} ${CORE:%=TinyLibCore/%.mli} \
    TinyLibCore/Buildfile
	cd TinyLibCore && build


#############################################################################
# The libraries: what several programs share
#############################################################################

# the system's calls, tiny-kernel's side of TinyLibSystem.mli (its unix/
# side is the host's, by dune); the machine's code (libmach: the
# instructions, the objects, the labels); the regular expressions; and
# the window's: the picture's messages, the playground (a game's loop),
# the widgets


#############################################################################
# The shell, the utilities, the editors, the stores
#############################################################################

# rc the shell; utils, cat ls grep... in one program (/bin/cat a link
# to it); ed and sam, the line editor; db and vcs, a database and a
# version control; build, this file's reader.
# Each: its main (its units' initializations, in their order), and the
# program, linked: the C runtime, ML's, its main, its units, the
# library, the end. Its units' rules are .depend's (at the end).

# rc
rc.o: $STDLIB TinyLibSystem/tinykernel/TinyLibSystem.tmi TinyShell.tmi
	ml -o $target $prereq
rc: $CRT $MLRT rc.o TinyLibSystem/tinykernel/TinyLibSystem.o TinyShell.o \
    $STDLIB $MLEND
	ld -map -s -n -o $target $prereq

