# mini-xv6, step 0: the bare Pi 4 by ix's tools, before any OCaml
# (plan_kernel_mini_ml.md, steps 1 and 2). Two images, without a header
# (-H0), their text where the board loads it (-T):
#   hello-s.img   a page of assembly (hello.s)
#   hello-c.img   a C program (hello.c) by mini-cc: l.s starts it, over
#                 goken's C library and shim.c in Linux's place
#   mini-mk          the images, under _mk/7/kernel/step0/
#   mini-mk check    each booted under mini-qemu, and under QEMU if it
#                    is there: its line
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/kernel/step0
LIBC=$TOP/lib_core/libc
CINC=-I$LIBC/include -I$LIBC/include/utf -I$LIBC -I$LIBC/include/arch/arm64 -Darm64 -Dlinux
IMAGE=$LD -H0 -T 0x80000 -E _start -nofollow
BOOT=-cpu cortex-a72 -M raspi4b -m 2G
QEMU=/home/pad/work/TOOLCHAINS/qemu/build/qemu-system-aarch64

all:V: $D/hello-s.img $D/hello-c.img

# (one rule with % for an object: mk refuses two; the C by their names)
$D/%.$O: %.s
	mkdir -p $D
	$AS -o $target $stem.s
$D/shim.$O: shim.c
	mkdir -p $D
	$CC $CINC -o $target shim.c
$D/helloc.$O: hello.c
	mkdir -p $D
	$CC $CINC -o $target hello.c

$D/hello-s.img: $D/hello.$O
	$IMAGE -o $target $D/hello.$O
$D/hello-c.img: $D/l.$O $D/shim.$O $D/helloc.$O $L/libc.a
	$IMAGE -o $target $D/l.$O $D/shim.$O $D/helloc.$O $L/libc.a

# a kernel does not stop: its line, then the emulator is ended
check:V: all
	for k in s c; do
		timeout 3 mini-qemu $BOOT -kernel $D/hello-$k.img -nographic < /dev/null > $D/mini-$k.txt 2> /dev/null || true
		cmp $D/mini-$k.txt expected-$k && echo "ok step0: hello-$k under mini-qemu"
		if [ -x $QEMU ]; then
			timeout 3 $QEMU $BOOT -kernel $D/hello-$k.img -smp 4 -display none -monitor none -serial file:$D/qemu-$k.txt < /dev/null 2> /dev/null || true
			cmp $D/qemu-$k.txt expected-$k && echo "ok step0: hello-$k under QEMU"
		fi
	done

clean:V:
	rm -rf $D
