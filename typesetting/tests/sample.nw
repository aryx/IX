\section{The loop}
\label{sec:loop}

<<function [[count]]>>=
int count(FILE *f) {
	int n = 0;
	<<[[count()]] locals>>
	while ((c = getc(f)) != EOF)
		if (c == '\n') n++;	/* 100% of the lines */
	return n;
}
