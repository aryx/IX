; The tiny programs built by OCaml on the host: tiny-c, tiny-ml and
; the machine's tools; the host's tools on TinyLibSystem; and, as
; libraries, the TinyLib*.ml libraries and tiny-kernel's applications,
; for their tests and for the host's windows (user/sdl/). tiny-ml compiles
; most of these files again for tiny-machine (TinyKernel/'s Makefile).

; the labels of OCaml's functions left out, String.starts_with "//" s:
; tiny-ml has none (warning 6, an error in dune's default profile)
(env (_ (flags (:standard -w -6))))

;*****************************************************************************
; The compilers
;*****************************************************************************

; tiny-c on its parts (TinyC/)
(executable
 (name TinyC)
 (public_name tiny-c)
 (package ix)
 (modules TinyC)
 (libraries ix_core fpath caps tiny_lib_system tiny_c_parts))

; tiny-ml on its parts (TinyML/)
(executable
 (name TinyML)
 (public_name tiny-ml)
 (package ix)
 (modules TinyML)
 (libraries ix_core fpath caps tiny_lib_system tiny_ml_parts))

;*****************************************************************************
; The machine's tools
;*****************************************************************************

; tiny-machine's assembler, linker and archiver: a .tm file to an object,
; objects to an image, objects to a library (TinyLibMachine's instructions
; and lines)
(executables
 (names TinyAssembler TinyLinker TinyArchiver)
 (public_names tiny-assembler tiny-linker tiny-ar)
 (package ix)
 (modules TinyAssembler TinyLinker TinyArchiver)
 (libraries ix_core fpath caps tiny_lib_machine tiny_lib_system))

; tiny-cpu, the processor alone: an image run as a program, with three
; system calls, the host's
(executable
 (name TinyCPU)
 (public_name tiny-cpu)
 (package ix)
 (modules TinyCPU)
 (libraries ix_core fpath caps tiny_machine_cpu tiny_lib_system))

; tiny-machine, the processor with a kernel's machine: two modes, traps, a
; timer, pages, a console, a disk, and (-window, -net) a screen, keys, a
; speaker and a wire
(executable
 (name TinyMachine)
 (public_name tiny-machine)
 (package ix)
 (modules TinyMachine)
 (libraries ix_core fpath unix caps tiny_machine_cpu tiny_machine_devices tiny_kernel_network tiny_machine_peer ix_parallel
  tiny_lib_system))

; tiny-prof: where the instructions went, by function, from a profile of
; tiny-cpu -prof or tiny-machine -prof and tiny-linker's maps of what ran
; (on TinyLibSystem: a tool of tiny-kernel's too, /bin/prof)
(executable
 (name TinyProfiler)
 (public_name tiny-prof)
 (package ix)
 (modules TinyProfiler)
 (libraries ix_core fpath unix caps tiny_lib_system tiny_lib_machine))

;*****************************************************************************
; The host's tools on TinyLibSystem
;*****************************************************************************

; (TinyLibSystem is TinyLibSystem/unix/'s here, over OCaml's Unix; tiny-kernel has
; its own, TinyLibSystem/tinykernel/)

(executable
 (name TinyBuildSystem)
 (public_name tiny-build)
 (package ix)
 (modules TinyBuildSystem)
 (libraries ix_core fpath unix caps ix_crypto tiny_lib_system))

; the shell, the line editor and the utilities (with grep's and the
; editor's regular expressions)
(executables
 (names TinyShell TinyEditorLine TinyUtilities)
 (public_names tiny-shell tiny-editor tiny-utils)
 (package ix)
 (modules TinyShell TinyEditorLine TinyUtilities)
 ; (the shell's tree, said by -debug)
 (preprocess (per_module ((pps ppx_deriving.show) TinyShell)))
 (libraries ix_core fpath unix caps tiny_lib_system tiny_lib_regex))

(executable
 (name TinyDatabase)
 (public_name tiny-db)
 (package ix)
 (modules TinyDatabase)
 (libraries ix_core fpath unix caps tiny_lib_system))

(executable
 (name TinyVCS)
 (public_name tiny-vcs)
 (package ix)
 (modules TinyVCS)
 (libraries ix_core unix caps ix_crypto tiny_lib_system))

;*****************************************************************************
; The libraries
;*****************************************************************************

; TinyLibSystem.mli, what a tool asks of its system: a virtual library
; here, beside its .mli, its implementations TinyLibSystem/'s (unix/,
; the default; tinykernel/ is tiny-ml's, TinyKernel/Makefile)
(library
 (name tiny_lib_system)
 (wrapped false)
 (modules TinyLibSystem)
 (virtual_modules TinyLibSystem)
 (default_implementation tiny_lib_system_unix)
 (libraries ix_core fpath caps))

; TinyLibRegex.ml, the regular expressions of grep and of tiny-editor
; (tiny-ml compiles it too, before TinyUtilities.ml and TinyEditorLine.ml)
(library
 (name tiny_lib_regex)
 (wrapped false)
 (modules TinyLibRegex))

; TinyLibMachine.ml, tiny-machine's libmach: the instructions and their
; words, the lines of assembly the compilers make, the objects, a
; program's labels; the toolchain's (the compilers, the assembler, the
; linker, tiny-prof, debug) and tiny-machine's (its CPU decodes the
; words). (old: TinyMachine/'s ISA and Asm, and TinyLibSymbols.ml)
(library
 (name tiny_lib_machine)
 (wrapped false)
 (modules TinyLibMachine)
 ; (the objects' show_line, tiny-linker -debug's)
 (preprocess (pps ppx_deriving.show)))

; TinyLibDraw.ml, a program's side of tiny-kernel's drawing: its messages
; and their bytes
(library
 (name tiny_lib_draw)
 (wrapped false)
 (modules TinyLibDraw))

; TinyLibPlayground.ml, what a game of tiny-kernel's is written on, here
; for a game's test on the host: TinyLibSystem is the system, the tests'
; stub or a window
(library
 (name tiny_lib_playground)
 (wrapped false)
 (modules TinyLibPlayground)
 (libraries fpath caps tiny_lib_draw tiny_lib_system))

; TinyLibGUI.ml, what a program with buttons is written on
(library
 (name tiny_lib_gui)
 (wrapped false)
 (modules TinyLibGUI)
 (libraries fpath caps tiny_lib_playground tiny_lib_system))

;*****************************************************************************
; tiny-kernel's applications
;*****************************************************************************

; Built here as libraries, for their tests on the host and for the host's
; windows (user/sdl/); on the machine, tiny-ml compiles them.

; TinyAppTetris.ml, tetris, a game on TinyLibPlayground
(library
 (name tiny_app_tetris)
 (wrapped false)
 (modules TinyAppTetris)
 (libraries tiny_lib_playground))

; TinyPlay.ml, a WAV file played on tiny-kernel's speaker (play there,
; tiny-play on the host: user/sdl/); its test decodes a file
(library
 (name tiny_play)
 (wrapped false)
 (modules TinyPlay)
 (libraries tiny_lib_playground))

; TinyEditorScreen.ml, the screen editor: the editor itself, with no system
; under it (tests/TinyEditorScreen_tests/'s test types keys at it)
(library
 (name tiny_editor_screen)
 (wrapped false)
 (modules TinyEditorScreen)
 (libraries fpath caps tiny_lib_playground tiny_lib_gui tiny_lib_system))

; TinyAppCalculator.ml and TinyAppTemperature.ml, calc and temp, on
; TinyLibGUI
(library
 (name tiny_app_calculator)
 (wrapped false)
 (modules TinyAppCalculator)
 (libraries tiny_lib_gui))

(library
 (name tiny_app_temperature)
 (wrapped false)
 (modules TinyAppTemperature)
 (libraries tiny_lib_gui))

; TinyOffice.ml, tiny-office's page and its parts, with no system under it
; (tests/TinyOffice_tests/'s test types keys and moves the mouse at it)
(library
 (name tiny_office)
 (wrapped false)
 (modules TinyOffice)
 (libraries fpath tiny_lib_gui tiny_office_parts))

; TinyTroff.ml, tiny-troff: a page of the office (or a Markdown file) as
; text or HTML (tests/TinyTroff_tests/'s test prints a page both ways)
(library
 (name tiny_troff)
 (wrapped false)
 (modules TinyTroff)
 (libraries caps tiny_office_parts tiny_lib_system))

; TinyBrowser.ml, www, tiny-kernel's browser, on its parts (TinyBrowser/):
; built here as a library for tiny-www (user/sdl/)
(library
 (name tiny_browser)
 (wrapped false)
 (modules TinyBrowser)
 (libraries tiny_lib_gui tiny_browser_parts tiny_browser_screen))

; TinyWindows.ml, tiny-kernel's window system. OCaml only checks it: its
; pipes and box, the windows' shells, are tiny-kernel's
; (TinyLibSystem.box), so no program here links it.
(library
 (name tiny_windows)
 (wrapped false)
 (modules TinyWindows)
 (libraries caps fpath tiny_lib_system tiny_lib_draw))

; TinyDebugger.ml and TinyTracer.ml, tiny-kernel's debugger and tracer.
; OCaml only checks them, as TinyWindows: their u_trace is tiny-kernel's
; call, so no program here links them.
(library
 (name tiny_debugger)
 (wrapped false)
 (modules TinyDebugger TinyTracer)
 (libraries caps fpath tiny_lib_system tiny_lib_gui tiny_lib_machine))
