//
// ml.acid: the stack of a program of ix's, by mini-ml, in acid
// (plan_debugger.md, stage 8). acid's own stk() is libmach's walk, which
// knows a function's frame by its .frame in the symbol table; mini-ml's
// functions make their frames themselves (the table says L, a leaf, and
// .frame 0), so the walk stops after the first. Here the frames are read
// from the functions' first instructions, as a debugger without tables
// reads them (gdb's prologue analysis), in acid, with acid's own @ and *:
//
//     mini-ml's:  SUB $n, R13       (or n from the pool: MOVW n(PC), R11;
//                 MOVW R14, 0(R13)   SUB R11, R13)
//     5l's (C):   MOVW.W R14, -n(R13)
//
// the return address at 0(SP) once saved, the caller's SP n bytes up;
// before the save, and in a leaf without one, the link register.
//
//     mini-acid -l port.acid -l arm.acid -l ml.acid prog
//     acid: new(); bpset(f1_down); cont(); cont(); cont(); cont()
//     acid: mlstk()                          (stk() stops at the second)
//     f1_down Down.ml:5                      (down 0, at its first instruction)
//     f1_down+0x3c Down.ml:5                 (down 1, 2, 3: their calls)
//     f1_down+0x3c Down.ml:5
//     f1_down+0x3c Down.ml:5
//     Down.Init+0x68 ?file?:0
//     ml_program+0x264 ?file?:0
//     main+0x190 ?file?:0
//     _main+0x20 libc/arch/arm/rt0.s:17

// a function's frame by its prologue: {its size, the address of the
// return's save}; {} when it has none. Read in the program's file (@),
// not the process (*): a breakpoint there is in the process's text
defn mlframe(start)
{
	local w, imm, rot, n;

	w = @fmt(start, 'X');
	if (w & 0xfffff000) == 0xe24dd000 && @fmt(start+4, 'X') == 0xe58de000 then {
		imm = w & 0xff;
		rot = 2*((w>>8) & 15);
		n = imm;
		if rot != 0 then
			n = ((imm>>rot) | (imm<<(32-rot))) & 0xffffffff;
		return {n, start+4};
	}
	if (w & 0xfffff000) == 0xe59fb000 && @fmt(start+4, 'X') == 0xe04dd00b
	&& @fmt(start+8, 'X') == 0xe58de000 then
		return {@fmt(start+8+(w & 0xfff), 'X'), start+8};
	if (w & 0xfffff000) == 0xe52de000 then
		return {w & 0xfff, start};
	return {};
}

// the frames from (pc, sp, link), each {the function, where in it, the
// caller's sp}, the innermost first, to _main
defn mlframes(pc, sp, link)
{
	local frames, f, start, p, ret, size, n;

	frames = {};
	n = 0;
	while n < 40 do {
		f = fnbound(pc);
		if f == {} then
			return frames;
		start = f[0];
		append frames, {start, pc, sp};
		if start == _main then
			return frames;
		p = mlframe(start);
		if p == {} then {
			// a leaf without a save: the link, the innermost only
			if n > 0 then
				return frames;
			ret = link;
			size = 0;
		} else if pc <= p[1] then {
			// before the save: the link; its frame made if past the start
			if n > 0 then
				return frames;
			ret = link;
			size = 0;
			if pc > start then
				size = p[0];
		} else {
			ret = *fmt(sp, 'X');
			size = p[0];
		}
		if ret == 0 then
			return frames;
		// (the call's address, in the caller: the return less 4)
		pc = ret-4;
		sp = sp+size;
		n = n+1;
	}
	return frames;
}

// the stack of the process now, a line a frame: the function and the
// offset, the file and the line
defn mlstk()
{
	local l, f;

	l = mlframes(*PC, *SP, *R14);
	while l do {
		f = head l;
		print(fmt(f[1], 'a'), " ");
		pfl(f[1]);
		l = tail l;
	}
}
