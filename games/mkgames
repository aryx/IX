# A directory of games, built by ix's tools: the author's playground's
# games (docs/plans/plan_playground.md), each linked with lib_playground,
# the rasterizer (lib_graphics/software) and one platform (PLATFORM):
# ppm, no window, a frame written to a file (Linux's); and Plan 9's two
# (mini-mk O=5 OS=plan9: mini-9pi's), over lib_graphics's client of the
# draw device: draw, the device asked for each shape (the default there:
# the author, 2026-10-07, having seen its frames a second: "let's
# default to the draw-device platform then when building games, for
# now"), and software, the pixels computed here and given as a picture
# (PLATFORM=software: made beside, games/puzzle-soft). A directory's mkfile sets TOP,
# DIR (its directory from TOP) and GAMES (its units: Tetris), says its
# first target (all: games), then includes this; games/mkfile makes the
# libraries once (libs), then each directory. The libraries' units are
# compiled here,
# each directory's objects in a directory of its own (a % of mk's takes a
# / too: one directory under another would be two rules for a unit).
<$TOP/mkfiles/mkconfig
PLATFORM=`{case $OS in plan9) echo draw;; *) echo ppm;; esac}
# (a game linked with the platform that computes its pixels is made
# beside the other: games/puzzle-soft)
BESIDE=`{case $PLATFORM in software) echo -soft;; esac}
D=$B/$DIR$BESIDE
G=$TOP/lib_graphics/software
P=$TOP/lib_playground
F=$P/platforms/$PLATFORM
GO=$B/lib_graphics/software
PO=$B/lib_playground/lib
EO=$B/lib_playground/core
NO=$B/lib_playground/random
LO=$B/lib_playground/layers
AO=$B/lib_playground/apis
H=$TOP/lib_physics
HO=$B/lib_physics
RO=$B/lib_playground/render
FO=$B/lib_playground/$PLATFORM
C=$TOP/lib_graphics
CO=$B/lib_playground/client
U=$TOP/lib_gui
UO=$B/lib_playground/gui
W=$P/ways
WO=$B/lib_playground/ways
S=$TOP/languages/scheme
SO=$B/lib_playground/scheme
M=$TOP/apps/office/formula
MO=$B/lib_playground/formula
K=$TOP/apps/kits
KO=$B/lib_playground/kits
X=$TOP/examples/gui4
XO=$B/lib_playground/gui4
Z=$TOP/lib_compression
ZO=$B/lib_playground/compression
Q=$TOP/apps/office
QO=$B/lib_playground/office
# (apps/office's folders: a unit is compiled from the one that has it)
OFFICEDIRS=document richtext paint draw sheet shapes parts file_menu suite
OFFICEI=${OFFICEDIRS:%=-I $Q/%}
# (lib_playground before lib_core: its Cmd is Elm's, not commons/'s)
INCLUDES=-I . -I $F -I $P/platforms -I $P -I $P/core -I $P/random -I $P/layers -I $P/apis -I $W -I $U -I $S -I $M -I $K -I $X -I $Z $OFFICEI -I $H -I $G -I $C $STDI
SOFT=Opti Rgba_image Xpm Framebuffer Vec2 Affine Fill Line Circle Stroke Hershey_futural Hershey
# (lib_playground's folders: core/, random/, itself, layers/)
CORE=Color Basics Time Cmd Sub Set
RANDOM=Lehmer
PLAY=Playground
LAYERS=Camera2d Sprite Tilemap Scene2d
# (what only some games ask is linked for those: a directory's mkfile
# says WITH=physics; a program is its units whole, 0.3 MB more with these
# ten, and mini-9pi's card is 31 MB. Physics, and lib_physics, the engine
# under it.)
# (and for a program that is not a game, apps/'s and examples/':
# gui, lib_gui and the playground's Gui over it; ways, Bigbang; scheme,
# the language, languages/scheme's units but its command; formula, a
# sheet's formulas (apps/office/formula); kits, apps/kits (Undo); gui4,
# the tasks written four ways (examples/gui4); office, what
# mini-office stands on (apps/office's folders: a text with looks and
# its page, a picture as bits, one as objects, a document's bytes,
# their shapes, the parts), and Packbits under them)
APIS=`{case "$WITH" in *physics*) echo Physics;; esac; case "$WITH" in *gui*) echo Gui;; esac}
GUI=`{case "$WITH" in *gui*) echo Widget Theme Text Text_edit Focus Layout Grid Look Immediate Retained Mvc Mvu;; esac}
WAYS=`{case "$WITH" in *ways*) echo Bigbang;; esac}
SCHEME=`{case "$WITH" in *scheme*) echo Sexpr Sexpr_read Scheme_image Scheme Scheme_syntax Scheme_prims Scheme_prelude Scheme_eval Scheme_step;; esac}
FORMULA=`{case "$WITH" in *formula*) echo Formula;; esac}
KITS=`{case "$WITH" in *kits*) echo Undo;; esac}
COMPRESSION=`{case "$WITH" in *office*) echo Packbits;; esac}
COMPRESSIONOBJS=`{for u in $COMPRESSION; do echo $ZO/$u.$O; done}
# (sheet: a sheet and how it is drawn, alone, for Gui7Cells; with formula)
OFFICE=`{case "$WITH" in *office*) echo Saved Style Rich Page Bitmap Pattern Seed_fill Paint Figure Drawing Sheet Sheet_view Stroke_text Figure_shapes Component Part_text Part_sheet Part_picture Part_drawing Part_chart File_menu Document Office_page Office_templates Office_model Office_edit Office_update Office_view;; *sheet*) echo Sheet Sheet_view;; esac}
OFFICEOBJS=`{for u in $OFFICE; do echo $QO/$u.$O; done}
GUI4=`{case "$WITH" in *gui4*) echo Gui4 Gui4Counter Gui4Temperature Gui4Flight Gui4Timer Gui4Circles;; esac}
FORMULAOBJS=`{for u in $FORMULA; do echo $MO/$u.$O; done}
KITSOBJS=`{for u in $KITS; do echo $KO/$u.$O; done}
GUI4OBJS=`{for u in $GUI4; do echo $XO/$u.$O; done}
GUIOBJS=`{for u in $GUI; do echo $UO/$u.$O; done}
WAYSOBJS=`{for u in $WAYS; do echo $WO/$u.$O; done}
SCHEMEOBJS=`{for u in $SCHEME; do echo $SO/$u.$O; done}
PHYSICS=`{case "$WITH" in *physics*) echo Body Shape Contact Collide Broadphase Resolve Joint2d Solver Force Integrate;; esac}
APISOBJS=`{for u in $APIS; do echo $AO/$u.$O; done}
PHYSICSOBJS=`{for u in $PHYSICS; do echo $HO/$u.$O; done}
# (the Plan 9 platforms' loop: not for the one without a window)
LOOP=`{case $PLATFORM in ppm) ;; *) echo Plan9_loop;; esac}
RENDER=Shape_render_software Input_script Session Redraw Store $LOOP
RENDEROBJS=`{for u in $RENDER; do echo $RO/$u.$O; done}
PLAT=Playground_platform
# (the draw device's client, for a platform with a window; a list that may
# be empty is the shell's to turn into objects: mk's ${X:%=...} of nothing
# is the name X)
CLIENT=`{case $PLATFORM in ppm) ;; *) echo Point Rectangle Display Draw Font_default Font Mouse Keyboard;; esac}
CLIENTOBJS=`{for u in $CLIENT; do echo $CO/$u.$O; done}
LIB=$SOFT $COMPRESSION $CLIENT $PHYSICS $CORE $RANDOM $GUI $FORMULA $KITS $GUI4 $PLAY $LAYERS $APIS $WAYS $SCHEME $OFFICE $RENDER $PLAT
LIBOBJS=${SOFT:%=$GO/%.$O} $COMPRESSIONOBJS $CLIENTOBJS $PHYSICSOBJS ${CORE:%=$EO/%.$O} ${RANDOM:%=$NO/%.$O} $GUIOBJS $FORMULAOBJS $KITSOBJS $GUI4OBJS ${PLAY:%=$PO/%.$O} ${LAYERS:%=$LO/%.$O} $APISOBJS $WAYSOBJS $SCHEMEOBJS $OFFICEOBJS $RENDEROBJS ${PLAT:%=$FO/%.$O}
LOCAL=`{ls *.ml $G/*.ml $G/*.mli $P/*.ml $P/*.mli $P/core/*.ml $P/core/*.mli $P/random/*.ml $P/random/*.mli $P/layers/*.ml $P/layers/*.mli $P/apis/*.ml $P/apis/*.mli $W/*.ml $W/*.mli $U/*.ml $U/*.mli $S/*.ml $S/*.mli $M/*.ml $M/*.mli $K/*.ml $K/*.mli $X/*.ml $X/*.mli $Z/*.ml $Z/*.mli $Q/[a-eg-z]*/*.ml $Q/[a-eg-z]*/*.mli $H/*.ml $H/*.mli $P/platforms/*.ml $P/platforms/*.mli $F/*.ml $F/*.mli $C/*.ml $C/*.mli 2> /dev/null}
LIBS=$LIBOBJS $STDOBJS $STDEND $TOP/mkfiles/mkconfig

libs:V: $LIBOBJS
games:V: ${GAMES:%=$D/%.linked}

$GO/%.$O: $G/%.ml $LOCAL
	mkdir -p $GO
	$ML $INCLUDES -o $target $G/$stem.ml
$PO/%.$O: $P/%.ml $LOCAL
	mkdir -p $PO
	$ML $INCLUDES -o $target $P/$stem.ml
$EO/%.$O: $P/core/%.ml $LOCAL
	mkdir -p $EO
	$ML $INCLUDES -o $target $P/core/$stem.ml
$NO/%.$O: $P/random/%.ml $LOCAL
	mkdir -p $NO
	$ML $INCLUDES -o $target $P/random/$stem.ml
$LO/%.$O: $P/layers/%.ml $LOCAL
	mkdir -p $LO
	$ML $INCLUDES -o $target $P/layers/$stem.ml
$AO/%.$O: $P/apis/%.ml $LOCAL
	mkdir -p $AO
	$ML $INCLUDES -o $target $P/apis/$stem.ml
$UO/%.$O: $U/%.ml $LOCAL
	mkdir -p $UO
	$ML $INCLUDES -o $target $U/$stem.ml
$WO/%.$O: $W/%.ml $LOCAL
	mkdir -p $WO
	$ML $INCLUDES -o $target $W/$stem.ml
$SO/%.$O: $S/%.ml $LOCAL
	mkdir -p $SO
	$ML $INCLUDES -o $target $S/$stem.ml
$MO/%.$O: $M/%.ml $LOCAL
	mkdir -p $MO
	$ML $INCLUDES -o $target $M/$stem.ml
$KO/%.$O: $K/%.ml $LOCAL
	mkdir -p $KO
	$ML $INCLUDES -o $target $K/$stem.ml
$XO/%.$O: $X/%.ml $LOCAL
	mkdir -p $XO
	$ML $INCLUDES -o $target $X/$stem.ml
$ZO/%.$O: $Z/%.ml $LOCAL
	mkdir -p $ZO
	$ML $INCLUDES -o $target $Z/$stem.ml
$QO/%.$O: $LOCAL
	mkdir -p $QO
	$ML $INCLUDES -o $target `ls $Q/*/$stem.ml | grep -v '/tests/\|/formula/'`
$HO/%.$O: $H/%.ml $LOCAL
	mkdir -p $HO
	$ML $INCLUDES -o $target $H/$stem.ml
$RO/%.$O: $P/platforms/%.ml $LOCAL
	mkdir -p $RO
	$ML $INCLUDES -o $target $P/platforms/$stem.ml
$FO/%.$O: $F/%.ml $LOCAL
	mkdir -p $FO
	$ML $INCLUDES -o $target $F/$stem.ml
$CO/%.$O: $C/%.ml $LOCAL
	mkdir -p $CO
	$ML $INCLUDES -o $target $C/$stem.ml

# a game: its unit (Tetris.ml), the program its name in small letters
# (tetris); Tetris.linked says it is made
$D/%.$O: %.ml $LOCAL
	mkdir -p $D
	$ML $INCLUDES -o $target $stem.ml
$D/%.linked: $D/%.$O $LIBS
	$ML -start $STD $COMMONS $LIB $stem Std_exit -o $D/$stem.start.$O
	$LD $LDH -nofollow -o $D/`echo $stem | tr A-Z a-z` $D/$stem.start.$O $STDOBJS $LIBOBJS $D/$stem.$O $STDEND
	touch $target

clean:V:
	rm -rf $D
	if [ $DIR = games ]; then rm -rf $GO $B/lib_playground $HO; fi
