# mini-emacs for mini-9pi (mini-mk O=5 OS=plan9): emacs, the editor
# (../core, ../features, ../modes, ../Config), in a window of mini-rio's
# that the draw device paints (lib_terminal/hosts: Window_draw, over
# Cells and lib_graphics), with the languages' highlighters (lib_code,
# languages/*/highlight, assembler/highlight, and two lexers made by
# mini-lex), over the libraries lib_terminal and lib_terminal/hosts.
# Their units are taken from their directories, each by its name.
TOP=../../..
DIR=editors/emacs/draw
PROG=emacs
SRC=Token_ml Lexer_ml Names_ml Highlight_ml Token_c Lexer_c Highlight_c Highlight_asm Highlight_st Highlight_scheme Highlight_pascal Highlight_prolog Text Efuns Globals Keymap Action Ebuffer Frame Window Top_window Move Edit Scroll Minibuffer Interactive Multi_buffers Multi_frames Copy_paste Search Highlight Indent Transform Macros Emouse Paren_mode Ocaml_mode C_mode Asm_mode Smalltalk_mode Scheme_mode Pascal_mode Prolog_mode Dired Buffer_menu Config Config_pad Start Main
LOCAL=`{ls *.ml ../*.ml ../*.mli ../core/*.ml ../core/*.mli ../features/*.ml ../features/*.mli ../modes/*.ml ../modes/*.mli ../../../languages/ml/highlight/*.ml ../../../languages/ml/highlight/*.mli ../../../languages/c/highlight/*.ml ../../../languages/c/highlight/*.mli ../../../assembler/highlight/*.ml ../../../assembler/highlight/*.mli ../../../languages/smalltalk/highlight/*.ml ../../../languages/smalltalk/highlight/*.mli ../../../languages/scheme/highlight/*.ml ../../../languages/scheme/highlight/*.mli ../../../languages/pascal/highlight/*.ml ../../../languages/pascal/highlight/*.mli ../../../languages/prolog/highlight/*.ml ../../../languages/prolog/highlight/*.mli ../../../languages/ml/highlight/Lexer_ml.mll ../../../languages/c/highlight/Lexer_c.mll}
LIBI=-I .. -I ../core -I ../features -I ../modes -I ../../../languages/ml/highlight -I ../../../languages/c/highlight -I ../../../assembler/highlight -I ../../../languages/smalltalk/highlight -I ../../../languages/scheme/highlight -I ../../../languages/pascal/highlight -I ../../../languages/prolog/highlight -I ../../../languages/ml
# (lib_code: Highlight_code, the highlighters' categories; lib_terminal,
# the Lehmer its Talk names; lib_terminal/hosts, over lib_graphics)
LIBDIRS=lib_code lib_playground/random lib_terminal lib_compression lib_graphics lib_terminal/hosts
<$TOP/mkfiles/mkconfig
# (mini-ml's tree, its annotations, its parser and lexer, which Names_ml
# needs: mini-ml's objects, as mini-singml links them; the top mkfile
# builds languages/ml first. old: compiled again here, the parser and
# lexer made by mini-yacc and mini-lex beside this program's objects)
LIBOBJS=$B/languages/ml/Ast.$O $B/languages/ml/Annotations.$O $B/languages/ml/Parser.$O $B/languages/ml/Lexer.$O
LIBI=$LIBI -I $B/languages/ml
# (the highlighters' two lexers, and mini-ml's parser and lexer, made
# by languages/ml)
GEN=$B/editors/emacs/draw/Lexer_ml.ml $B/editors/emacs/draw/Lexer_c.ml $B/languages/ml/Parser.ml $B/languages/ml/Lexer.ml
<$TOP/mkfiles/mkprog

# the other directories' units, each by its name
$D/Text.$O: ../core/Text.ml $LOCAL
	$ML $INCLUDES -o $target ../core/Text.ml
