# mini-quake, built by ix's tools (docs/plans/done/plan_quake.md): its units,
# compiled here, then the program, linked with the libraries
# (mkfiles/mklibs): the playground and one platform of it, the
# pictures' core. The platform is ppm's on Linux (no window: a frame
# written to a file, the tests'), the draw device's with OS=plan9
# (mini-9pi: a window of mini-rio, or the bare screen, as the games',
# ../../mkgames); PLATFORM=software, the pixels given as a picture,
# made beside (games/fps/quake-soft).
TOP=../../..
<$TOP/mkfiles/mkconfig
PLATFORM=`{if(~ $OS plan9) echo draw; if not echo ppm}
BESIDE=`{~ $PLATFORM software && echo -soft}
D=$B/games/fps/quake$BESIDE
# (each after the ones it names)
# (the playground's apis: Audio, Audio3d and Ai, with what they stand on,
# as ../../mkgames)
LIBDIRS=lib_compression lib_graphics lib_playground lib_playground/physics lib_playground/juice lib_gui lib_audio lib_networking \
 lib_networking/netcode lib_ai lib_playground/apis lib_playground/platforms lib_playground/platforms/$PLATFORM
<$TOP/mkfiles/mklibs
# (the folders of the modules: dune's comment says which)
DIRS=. model render server game sound
# (the libraries before lib_core: lib_playground's Cmd is Elm's, not commons/'s)
INCLUDES=${DIRS:%=-I ./%} $LIBI $STDI
# (each before the ones that name it)
LIB=Bspfile Model View Edges Scan Surfcache Spans Bsp Trace Alias Things Render Brushes Play \
 Edict Physics Particles Items Ways Monster_ai Combat Monsters Weapons Game Sound Cdaudio
LIBOBJS=${LIB:%=$D/%.$O}
LOCAL=`{for(d in $DIRS) ls $d/*.ml $d/*.mli >[2]/dev/null} $LIBSRC
LIBS=$LIBOBJS $LIBA $STDOBJS $STDEND $TOP/mkfiles/mkconfig

# (quake: the name the frames' test asks for, as a game's,
# ../../tests/frames.sh; mini-quake: the program's)
all:V: $D/mini-quake

$D/%.$O: $LOCAL
	mkdir -p $D
	f=()
	for(d in $DIRS) if(~ $d/$stem.ml $LOCAL) f=$d/$stem.ml
	$ML $INCLUDES -o $target $f

$D/mini-quake: $D/quake
	cp $D/quake $target
$D/quake: $D/Quake.$O $LIBS
	$ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA} $LIB Quake Std_exit -o $D/Quake.start.$O
	$LD $LDH -nofollow -o $target $D/Quake.start.$O $STDOBJS $LIBA $LIBOBJS $D/Quake.$O $STDEND

clean:V:
	rm -rf $D

# the units' order (mkfiles/mkdepend)
DEPOBJ=D
DEPDIRS=$DIRS
DEPUNITS=$LIB Quake
<$TOP/mkfiles/mkdepend
