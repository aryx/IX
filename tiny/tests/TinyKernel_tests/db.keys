db t.db
table books (id int key, title text, year int)
insert books (1, "SICP", 1985), (2, "TAOCP", 1968), (3, "Plan 9", 1995)
table n (i int key, sq int)
insert n (1, 1), (2, 4), (3, 9), (4, 16), (5, 25), (6, 36), (7, 49), (8, 64), (9, 81), (10, 100), (11, 121), (12, 144), (13, 169), (14, 196), (15, 225), (16, 256), (17, 289), (18, 324), (19, 361), (20, 400), (21, 441), (22, 484), (23, 529), (24, 576), (25, 625), (26, 676), (27, 729), (28, 784), (29, 841), (30, 900), (31, 961), (32, 1024), (33, 1089), (34, 1156), (35, 1225), (36, 1296), (37, 1369), (38, 1444), (39, 1521), (40, 1600)
index books year
explain books | where year >= 1985 | sort title desc
books | where year >= 1985 | sort title desc | select title, age = 2026 - year
n | where i > 37
n | group (c = count, s = sum sq, top = max i)
nosuch
db t.db
books | where id = 2 | set year = year + 1
books | where title = "SICP" | delete
books
explain n | where i = 20
n | where i = 20
