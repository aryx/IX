for(f in Stdlib.tmi Stdlib.o Char.tmi Char.o Seq.tmi Seq.o List.tmi List.o String.tmi String.o Bytes.tmi Bytes.o Array.tmi Array.o Option.tmi Option.o Int64.tmi Int64.o Filename.tmi Filename.o Buffer.tmi Buffer.o Printf.tmi Printf.o Marshal.tmi Marshal.o Hashtbl.tmi Hashtbl.o Common.tmi Common.o Sha1.tmi Sha1.o Fpath.tmi Fpath.o Fpath_.tmi Fpath_.o Exit.tmi Exit.o In_channel.tmi In_channel.o Out_channel.tmi Out_channel.o Chan.tmi Chan.o Logs.tmi Logs.o) { n=`{wc -c < lib/$f}; echo lib/ml/$f; echo $n; cat lib/$f } >> boot.img
