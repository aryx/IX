; tiny-machine's parts (../TinyMachine.ml and ../TinyCPU.ml are the
; programs): the CPU, the devices, the wire's other end, and the
; programs beside it, its window, its socket and its page

(library
 (name tiny_machine_cpu)
 (wrapped false)
 (modules TinyMachineCPU))

; tiny-machine's machine without a host: TinyMachine's and TinyMachineWeb's
(library
 (name tiny_machine_devices)
 (wrapped false)
 (modules TinyMachineDevices)
 (libraries tiny_machine_cpu))

; the other end of tiny-machine's wire, TinyKernelNetwork with a few lines on
; top: TinyMachine's and TinyMachineWeb's
(library
 (name tiny_machine_peer)
 (wrapped false)
 (modules TinyMachinePeer)
 (libraries tiny_kernel_network tiny_machine_devices))

; tiny-machine's way out to other programs: a connection of the host's
; on its standard input and output (TinyMachine's -net-out and
; -net-forward run it, as its -window runs TinyMachineWindow)
(executable
 (name TinyMachineSocket)
 (public_name tiny-machine-socket)
 (package ix)
 (modules TinyMachineSocket)
 (libraries ix_core caps unix))

; tiny-machine's way to the web, for tiny-kernel's browser: a page's
; bytes fetched by ix's own TLS and HTTP (TinyMachine's -net-out runs it)
(executable
 (name TinyMachineFetch)
 (public_name tiny-machine-fetch)
 (package ix)
 (modules TinyMachineFetch)
 (libraries tiny_machine_devices ix_graphics_images ix_http ix_tls ix_tcp ix_core caps unix))

; an SDL window (tsdl), the C library tiny programs link: tiny-machine's
; window, and the tiny programs on the host (../sdl/)
(library
 (name tiny_machine_sdl)
 (wrapped false)
 (modules TinyMachineSDL)
 (libraries tsdl))

; tiny-machine's window
(executable
 (name TinyMachineWindow)
 (public_name tiny-machine-window)
 (package ix)
 (modules TinyMachineWindow)
 (libraries tiny_machine_sdl unix))

; tiny-machine in a web page (plan_web.md): the machine by js_of_ocaml,
; TinyMachineWeb.html its page (./tiny-machine -web dir tiny-kernel);
; optional: built where the library js_of_ocaml is installed
(executable
 (name TinyMachineWeb)
 (modules TinyMachineWeb)
 (modes js)
 (optional)
 (libraries tiny_machine_cpu tiny_machine_devices tiny_kernel_network tiny_machine_peer js_of_ocaml))
