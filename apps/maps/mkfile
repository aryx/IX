# mini-maps, built by ix's tools: its units, then the program, which is
# linked with the libraries (mkfiles/mklibs): the cryptography, the
# compression, the network, the pictures, the playground, the widgets
# (lib_gui) and one platform of the playground. The platform is ppm's on
# Linux, where there is no window and a frame is written to a file for
# the tests. With OS=plan9 (mini-9pi) it is the draw device's, a window
# of mini-rio, as for the games (games/mkgames).
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/apps/maps
PLATFORM=`{if(~ $OS plan9) echo draw; if not echo ppm}
# (each library comes after the ones it names)
LIBDIRS=lib_crypto lib_compression lib_networking lib_graphics lib_playground lib_gui \
 lib_playground/platforms lib_playground/platforms/$PLATFORM
<$TOP/mkfiles/mklibs
# (the libraries come before lib_core, so that Cmd is lib_playground's,
# Elm's, and not commons/'s)
INCLUDES=-I . -I $D $LIBI $STDI
# (each unit comes before the ones that name it)
LIB=Mercator Tiles Tile_cache Place Weather Map_look Weather_panel Map_http Roads Route Routing Worker_spawn Map_worker Map_services Map_window
LIBOBJS=${LIB:%=$D/%.$O}
LOCAL=`{ls *.ml *.mli} $LIBSRC
LIBS=$LIBOBJS $LIBA $STDOBJS $STDEND $TOP/mkfiles/mkconfig

all:V: $D/mini-maps

$D/%.$O: %.ml $LOCAL
	mkdir -p $D
	$ML $INCLUDES -o $target $stem.ml

# the worker, a thread of lib_core's, a large one (Worker_spawn.mli)
$D/Worker_spawn.$O: $TOP/browsers/netscape/spawn/large_threads.ml $TOP/browsers/netscape/Worker_spawn.mli
	mkdir -p $D
	cp $TOP/browsers/netscape/Worker_spawn.mli $D/Worker_spawn.mli
	cp $TOP/browsers/netscape/spawn/large_threads.ml $D/Worker_spawn.ml
	$ML $INCLUDES -o $target $D/Worker_spawn.ml

$D/mini-maps: $D/Maps.$O $LIBS
	$ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA} $LIB Maps Std_exit -o $D/Maps.start.$O
	$LD $LDH -nofollow -o $target $D/Maps.start.$O $STDOBJS $LIBA $LIBOBJS $D/Maps.$O $STDEND

# the units' order (mkfiles/mkdepend)
DEPOBJ=D
DEPDIRS=. $D
DEPUNITS=$LIB Maps
<$TOP/mkfiles/mkdepend

clean:V:
	rm -rf $D
