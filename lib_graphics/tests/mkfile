# lib_graphics's programs, for mini-9pi (mini-mk O=5 OS=plan9): the
# library's units are compiled here, then each program with its start
# and its link
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/lib_graphics/tests
MADE=`{mkdir -p $D}
INCLUDES=-I . -I .. $STDI
LIB=Point Rectangle Display Draw Font_default Font Mouse Keyboard Cursor Menu
LIBOBJS=${LIB:%=$D/%.$O}
LOCAL=`{ls *.ml ../*.ml ../*.mli}
LIBS=$LIBOBJS $STDOBJS $STDEND $TOP/mkfiles/mkconfig

all:V: $D/hellodraw $D/hellomenu $D/hellokbd

$D/%.$O: ../%.ml $LOCAL
	$ML $INCLUDES -o $target ../$stem.ml
$D/Hellodraw.$O: Hellodraw.ml $LOCAL
	$ML $INCLUDES -o $target Hellodraw.ml
$D/Hellomenu.$O: Hellomenu.ml $LOCAL
	$ML $INCLUDES -o $target Hellomenu.ml
$D/Hellokbd.$O: Hellokbd.ml $LOCAL
	$ML $INCLUDES -o $target Hellokbd.ml
$D/hellokbd: $D/Hellokbd.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $LIBOBJS $D/Hellokbd.$O $STDEND
$D/hellodraw: $D/Hellodraw.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $LIBOBJS $D/Hellodraw.$O $STDEND
$D/hellomenu: $D/Hellomenu.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $LIBOBJS $D/Hellomenu.$O $STDEND

clean:V:
	rm -rf $D

# the units' order (mkfiles/mkdepend)
DEPOBJ=D
DEPDIRS=.
DEPUNITS=$LIB Hellodraw Hellomenu Hellokbd
<$TOP/mkfiles/mkdepend
