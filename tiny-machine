#
# tiny-machine: a kernel booted on tiny-machine (tiny/TinyMachine.ml),
# as mini-pi boots the Pi's kernels on mini-qemu; built first, with the
# tools of ix's checkout.
#
#   ./tiny-machine tiny-kernel tiny/TinyKernel.ml: a kernel in ML (fork
#                              and exec, round robin, blocking by
#                              closures), its disk the root (a file
#                              system of inodes, copied on write: what
#                              you write is kept, the earlier boots'
#                              files in /dump), the shell on the
#                              console, in /usr/glenda; with -window its
#                              screen, a window system and games
#   ./tiny-machine t6          a step before it (tiny/TinyKernel/steps/t6/):
#                              a kernel in C, its disk (spawn, a FAT, one
#                              kernel stack)
#   ./tiny-machine v0          the first step (tiny/TinyKernel/steps/v0/): a
#                              page of assembly and its four programs
#   ./tiny-machine kernel.tm prog.tm...
#                              a kernel of yours (first) and its programs
#
# Options:
#   -window  tiny-kernel: its screen in a window (640 by 480; the mouse
#        and the keys in it are the machine's). The console stays this
#        terminal, where the first shell is typed at: windows is
#        the window system (the right button: New, then a rectangle
#        swept with the left one; a shell in it), paint a program that
#        draws, on the screen or in a window, square a game of a page
#        (the arrows), tetris the game (the arrows, the space drops)
#   -rate n  the machine's speed, in millions of instructions per
#        second (by default 20 with -window, 8 without). tiny-kernel's
#        programs keep their pace at any speed (its tick is 2.5 ms);
#        what computes finishes sooner. This Mac (an M3 Pro) runs it at
#        50 to 66 at most
#   -web dir  tiny-kernel, t6: nothing run; the machine as a web
#        page in dir (tiny/TinyMachine/TinyMachineWeb.ml, by js_of_ocaml), with the
#        kernel's image: index.html, to serve (it says how) and open
#   -l   the listing of the kernel's image instead of running it
#   -w   t6: write to its disk, fs.img (by default a copy, its writes
#        lost at exit, as mini-pi's snapshot)
#   -n   no build (the tools and the kernel as last built)
#
# Ctrl-C is the kernel's (tiny-kernel: the program running killed),
# Ctrl-\ quits tiny-machine. Quit t6 with Ctrl-D: the shell's
# input ends, then init, and the machine halts. This script is not
# installed: bin/tiny-machine is the machine itself, which runs an
# image (tiny-assembler and tiny-linker make it; -d a disk).

set -e
ROOT=$(dirname "$(readlink -f "$0")")
listing=0; build=1; write=0

# alone, what it runs; --help, the options too
kernels() { sed -n '/^# tiny-machine:/,/^# Options:/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; echo "(./tiny-machine --help: the options)"; exit 2; }
usage() { sed -n '/^# tiny-machine:/,/^# image (tiny-assembler/p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

[ "$1" = --help ] && usage
window=; rate=; web=
while :; do
  case $1 in
    -window) window=-window; shift;;
    -rate) [ $# -ge 2 ] || usage; rate="-rate $2"; shift 2;;
    -web) [ $# -ge 2 ] || usage; web=$2; shift 2;;
    -l) listing=1; shift;;
    -w) write=1; shift;;
    -n) build=0; shift;;
    -h) usage;;
    *) break;;
  esac
done
[ $# = 0 ] && kernels

B=$ROOT/_build/default/tiny
machine=$B/TinyMachine.exe
say() { echo "tiny-machine: $*" >&2; }
# a file's size (wc, not stat -c: GNU's alone; macOS's wc pads its number)
size() { echo $(( $(wc -c < "$1") )); }
short() { local f; for f in "$@"; do f=$(readlink -f "$f"); echo -n "${f#$ROOT/} "; done; }

if [ $build = 1 ]; then
  (cd $ROOT && dune build ./tiny/TinyMachine.exe ./tiny/TinyC.exe ./tiny/TinyAssembler.exe ./tiny/TinyLinker.exe ./tiny/TinyCPU.exe ./tiny/TinyKernel/steps/t6/TinyMkfs.exe ./tiny/TinyML.exe 2>&1) || exit 1
  # (the window is a program apart: the one that links SDL)
  [ -z "$window" ] || (cd $ROOT && dune build ./tiny/TinyMachine/TinyMachineWindow.exe 2>&1) || exit 1
fi

# the page's directory: the machine, its page, the kernel's files; $1
# is what the address says after index.html
page() {
  local query=$1; shift
  (cd $ROOT && dune build --profile release ./tiny/TinyMachine/TinyMachineWeb.bc.js 2>/dev/null) || { say "TinyMachineWeb does not build (dune build ./tiny/TinyMachine/TinyMachineWeb.bc.js says why; it needs the library js_of_ocaml)"; exit 1; }
  mkdir -p "$web"
  cp $B/TinyMachine/TinyMachineWeb.bc.js "$web/TinyMachineWeb.js"; cp $ROOT/tiny/TinyMachine/TinyMachineWeb.html "$web/index.html"; cp "$@" "$web/"
  # the documents of the wire's other end (get's files, a kept picture)
  mkdir -p "$web/www"; cp $ROOT/tiny/tests/www/* "$web/www/"
  chmod -R u+w "$web"
  say "page:    $web ($(du -sh "$web" | cut -f1): index.html, TinyMachineWeb.js, $(for f in "$@"; do echo -n "$(basename $f) "; done))"
  say "serve:   python3 -m http.server -d $web 8000, then http://localhost:8000/$query"
  exit 0
}

case $1 in
  t6)
    dir=$ROOT/tiny/TinyKernel/steps/$1
    if [ $build = 1 ]; then
      make -s -C $dir TC=$B/TinyC.exe AS=$B/TinyAssembler.exe LD=$B/TinyLinker.exe MACHINE=$machine MKFS=$B/TinyKernel/steps/t6/TinyMkfs.exe _make/kernel.img _make/fs.img >&2 || exit 1
    fi
    image=$dir/_make/kernel.img
    disk=$dir/_make/fs.img
    if [ $write = 0 ]; then cp $disk $B/fs-run.img; disk=$B/fs-run.img; mode="a copy: its writes lost at exit (-w to keep them)"; else mode="written in place"; fi
    say "kernel:  $(short $image)($(size $image) bytes; built from $(short $dir))"
    say "disk:    $(short $dir/_make/fs.img)($(( $(size $dir/_make/fs.img) / 1024 )) KB, $mode)"
    say "console: this terminal; Ctrl-D ends the shell, and the machine"
    [ -z "$web" ] || page "?image=kernel.img&disk=fs.img" $image $dir/_make/fs.img
    if [ $listing = 1 ]; then exec $machine -l $image; fi
    say "command: $(short $machine)${rate:+$rate }-d $(short $disk)$(short $image)"
    exec $machine $rate -d $disk $image
    ;;
  tiny-kernel)
    # the programs come in the image, after the kernel (/boot); the disk
    # is the root, made blank at the first run (make clean removes it)
    dir=$ROOT/tiny/TinyKernel
    if [ $build = 1 ]; then
      make -s -C $dir TML=$B/TinyML.exe TC=$B/TinyC.exe AS=$B/TinyAssembler.exe LD=$B/TinyLinker.exe CPU=$B/TinyCPU.exe MACHINE=$machine _make/boot.img >&2 || exit 1
    fi
    image=$dir/_make/boot.img
    say "kernel:  $(short $dir/_make/kernel.img)($(size $dir/_make/kernel.img) bytes; built from $(short $dir)), its programs after it"
    [ -z "$web" ] || page "" $image
    disk=$dir/_make/disk.img
    say "disk:    ${disk#$ROOT/}, the root: what is written there is kept ($([ -f $disk ] && echo "$(( $(size $disk) / 1024 )) KB" || echo "made blank now, 8 MB"); the boots before in /dump)"
    say "console: this terminal; Ctrl-D ends the shell, and the machine"
    [ -z "$window" ] || say "screen:  a window (its end is the machine's); try: windows, the right button in the window (New, a rectangle swept), then tetris typed in it"
    if [ $listing = 1 ]; then exec $machine -l $dir/_make/kernel.img; fi
    (cd $ROOT && dune build ./tiny/TinyMachine/TinyMachineSocket.exe ./tiny/TinyMachine/TinyMachineFetch.exe 2>&1) || exit 1
    say "network: the wire's other end is this program, with tiny/tests/www's documents; try: ping, get il.txt, wiki mandelbrot, www OCaml$([ -n "$window" ] || echo " (-window to see them)")"
    say "         and it is the way out: get / gopher.floodgap.com, get / example.com 80"
    say "         and in: httpd, then http://localhost:8080/ in a browser"
    speed=${rate#-rate }; [ -n "$speed" ] || speed=$([ -n "$window" ] && echo 20 || echo 8)
    say "speed:   $speed million instructions a second (-rate n to change it)"
    say "command: $(short $machine)${window:+$window }${rate:+$rate }-d ${disk#$ROOT/} -net $(short $ROOT/tiny/tests/www)-net-out -net-forward 8080:80 $(short $image)"
    exec $machine $window $rate -d $disk -net $ROOT/tiny/tests/www -net-out -net-forward 8080:80 $image
    ;;
  v0)
    set -- $ROOT/tiny/TinyKernel/steps/v0/kernel.tm $ROOT/tiny/TinyKernel/steps/v0/[abcd].tm
    ;;
  -*|"") usage;;
esac

# .tm files: the kernel first, at 0, then its programs
for f in "$@"; do [ -f "$f" ] || { echo "tiny-machine: no $f (a kernel's name: tiny-kernel, t6, v0)" >&2; exit 1; }; done
image=$B/kernel.img
say "assemble and link: $(short $1)(the kernel, at 0)$( [ $# -gt 1 ] && echo ", then $(short "${@:2}")")"
objs=(); for f in "$@"; do o=$B/$(basename ${f%.tm}).o; $B/TinyAssembler.exe -o $o $f || exit 1; objs+=($o); done
$B/TinyLinker.exe -o $image "${objs[@]}"
say "image: $(short $image)($(size $image) bytes)"
if [ $listing = 1 ]; then exec $machine -l $image; fi
say "run:   $(short $machine)${rate:+$rate }$(short $image)"
exec $machine $rate $image
