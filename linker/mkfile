# linker as a library (mkfiles/mklib), dune's ix_ld: Program, a program
# as linked, Link, the link, Arm and Arm64, the instructions' encoders,
# Exe, the executable written, and debug/'s Debug_link and Symtab, what
# a debugger needs (plan_debugger.md), over the assembler's library and
# lib_executable (Manifest, -map's out.manifest). tools/'s mini-ar and
# mini-nm link it, and mini-dotnet, whose JIT encodes with Arm and
# Arm64, which took this directory's objects one by one before
# (plan_simpler_builds.md, step 4). And mini-ld, compat/'s Follow, CLI
# and Main linked with that library.
TOP=..
<$TOP/mkfiles/mkconfig
LIB=linker
# (compat/: Follow alone, mini-ld's, not the library's; a directory of
# DIRS for libs.rc's rule and the units' order)
DIRS=. debug compat
NEEDS=assembler lib_executable
UNITS=Program Debug_link Link Arm Arm64 Exe Symtab
# (mini-ld's own units, after the library's units they name)
DEPMORE=Follow CLI Main
<$TOP/mkfiles/mklib

LIBDIRS=assembler lib_executable
<$TOP/mkfiles/mklibs
all:V: $D/mini-ld

# (its units: libs.rc's rules, as the library's)
PROGOBJS=${DEPMORE:%=$D/%.$O}
$PROGOBJS: $LOCAL $MLEXE
$D/mini-ld: $PROGOBJS $D/lib.a $LIBA $STDOBJS $STDEND $TOP/mkfiles/mkconfig
	$ML -ld $LINKER -- -o $target $STDOBJS $LIBA $D/lib.a $PROGOBJS $STDEND
