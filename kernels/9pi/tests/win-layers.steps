[('type', "echo 'window -desk colors' > /tmp/s; echo 'window -panel -edge bottom 40 hellorio' >> /tmp/s; echo 'window -popup -hide -at c 300 200 hellorio' >> /tmp/s; echo 'window -at ne 400 200' >> /tmp/s"),
 ('type', "rio -i 'rc /tmp/s'"),
 ('move', 700, 100),
 ('type', 'cat /dev/wsys/1/wctl /dev/wsys/2/wctl; echo'),
 ('move', -400, 640),
 ('buttons', [('down', 'left')]),
 ('buttons', [('up', 'left')]),
 ('type', 'echo keys stay here'),
 ('type', 'echo unhide -id 3 > /dev/wctl'),
 ('move', 200, -300),
 ('move', -400, -300),
 ('buttons', [('down', 'left')]),
 ('buttons', [('up', 'left')]),
 ('buttons', [('down', 'right'), ('move', 0, 51), ('up', 'right')]),
 ('move', 200, 600),
 ('buttons', [('down', 'right')]),
 ('buttons', [('up', 'right')]),
 ('type', 'window -max'),
 ('type', 'echo delete > /dev/wctl'),
 ('type', 'echo exit > /dev/wctl'),
 ('type', 'echo back at the console')]
