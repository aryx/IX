#
# This file builds tiny-kernel, kernel.img, from:
# - TinyKernel.ml and its parts, in ML;
# - the assembly that ML cannot say (kentry.s has the traps and the
#   switch; kdraw.s and kcopy.s have the loops over pixels and over
#   memory);
# - kruntime.c, which is ML's runtime given the machine's memory;
# - kfont.s, the font's pixels, which the Makefile makes on the host
#   from fonts/plan9.font and puts in the copy of tiny/ (no rule here
#   makes it, so on the image, in /src, it is taken as it is);
# - kend.s, which marks the kernel's end, where the files it carries
#   start.
# ../Buildfile runs it at each build (cd TinyKernel && build), after the
# library, which the kernel links from ../TinyLibCore.
#
#     build                  makes kernel.img, and its objects
#     build depend           makes .depend again, after a unit names another one
#     tiny-build TINY=tiny-  does the same on the host, with tiny-ml...
#
# What it makes stays in this directory, next to its sources, so that no
# file is made by two Buildfiles (a pattern takes any name that ends as
# it says, so if this file used ../runtime/c/udivmod.o, its %.o would
# make that file again).

# The tools, by tiny-kernel's names; the host's names are given by
# TINY=tiny- (../Buildfile gives its own, with ML=... CC=...).
TINY =
ML = ${TINY}ml
CC = ${TINY}cc
AS = ${TINY}as
LD = ${TINY}ld

STDLIB = ../TinyLibCore/stdlib.a

all: kernel.img

# A unit is compiled with the library's interfaces (-L) and the
# kernel's (-I .); its prerequisites are its line in .depend. Its .tmi
# is made with its .o.
%.o: %.ml $STDLIB
	$ML -c -L ../TinyLibCore -I . -o $target $stem.ml
%.tmi: %.o
%.start.o:
	$ML -o $target $prereq
%.o: %.c
	$CC -o $target $stem.c
%.o: %.s
	$AS -o $target $stem.s

# The unsigned division that tiny-cc calls (for kruntime.c): the kernel
# has its own object of runtime/'s udivmod.s.
udivmod.o: ../runtime/c/udivmod.s
	$AS -o $target ../runtime/c/udivmod.s
kruntime.o: kruntime.c ../runtime/ml/ml.c

# The units, each after the ones it names. ml makes the kernel's start
# as it makes a program's (see ../TinyML/Link.mli). kentry.o is linked
# first, at 0.
UNITS = KRaw.o KGraphics.o KNetwork.o \
    KAudio.o KFS.o KMemory.o KMachine.o \
    KFiles.o KProcs.o KDevices.o KIO.o \
    KCalls.o KScheduler.o TinyKernel.o
kernel.start.o: $STDLIB $UNITS
kernel.img: kentry.o udivmod.o kruntime.o kdraw.o kcopy.o kfont.o \
    kernel.start.o $STDLIB $UNITS kend.o
	$LD -map -o $target $prereq

# the units' dependencies, written by ml -depend
depend:
	$ML -depend -I . *.ml > .depend

<.depend

clean:
	rm -f *.o *.tmi kernel.img kernel.map
