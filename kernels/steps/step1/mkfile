# mini-xv6, step 1, built by ix's tools, on the Pi 4 or (mini-mk O=5)
# the Pi 1 (docs/plans/done/plan_kernel_mini_ml.md, steps 3 and 9). It
# is the same Main.ml as the Makefile's (the Pi 1's, built by
# ocaml-light and gcc). mini-ml compiles it, and it runs on mini-ml's
# runtime (compiled by mini-cc, with the board's heap), the whole
# stdlib, goken's C library, and step 0's start and shim in Linux's
# place. mini-ld links it as an image without a header.
#   mini-mk          builds _mk/7/kernels/steps/step1/kernel8.img
#   mini-mk check    boots it under mini-qemu, and under QEMU if it is
#                    there, and compares with expected-pi4: the
#                    Makefile's expected lines except the sum, which the
#                    Pi 1's 31 bits wrap (on the Pi 1, it compares with
#                    expected itself)
TOP=../../..
<$TOP/mkfiles/mkconfig
<$TOP/kernels/lib_machine/mkboard
D=$B/kernels/steps/step1
EXPECTED=`{if(~ $O 5) echo expected; if not if(~ $O 7) echo expected-pi4}
# The heap has two halves of 4M words (32 MB each), and the value stack
# has 1 MB. The words are quoted because, after a variable's =, mk reads
# a word before another = as attributes.
HEAP='-DMAXHEAP=4194304' '-DSTACK=131072'

all:V: $D/kernel8.img

$D/Main.$O: Main.ml
	mkdir -p $D
	$ML $STDI -o $target Main.ml
$D/start.$O: mkfile $TOP/mkfiles/mkconfig
	mkdir -p $D
	$ML -start $STD $COMMONS Main Std_exit -o $target
$D/runtime.$O: $RTSRC mkfile
	mkdir -p $D
	$CC $CINC $HEAP -o $target $TOP/languages/ml/runtime/runtime.c
$D/l.$O: ../step0/${P}l.s
	mkdir -p $D
	$AS -o $target $prereq
$D/shim.$O: ../step0/shim.c
	mkdir -p $D
	$CC $CINC -o $target ../step0/shim.c
# memmove and memset come from port's C, a byte at a time, and not from
# libc's arm64 assembly (9front's). That assembly moves pairs of words,
# which fault at an address that is not aligned when the MMU is off, as
# it is here (QEMU raises the alignment fault; mini-qemu does not
# check). With libc's, the kernel does not boot under QEMU.
$D/memmove.$O: $TOP/lib_core/libc/port/memmove.c
	mkdir -p $D
	$CC $CINC -o $target $prereq
$D/memset.$O: $TOP/lib_core/libc/port/memset.c
	mkdir -p $D
	$CC $CINC -o $target $prereq

OBJS=$D/l.$O $D/shim.$O $D/start.$O $STDOBJS $D/Main.$O $L/std_exit.$O \
	$D/runtime.$O $D/memmove.$O $D/memset.$O $L/libc.a
$D/kernel8.img: $OBJS
	$LD -H0 -T $LOAD -E _start -nofollow -o $target $OBJS

check:V: $D/kernel8.img
	boot=`{echo $BOOT | sed 's|IMAGE|'$D/kernel8.img'|'}
	timeout 20 mini-qemu $boot -nographic < /dev/null > $D/mini.txt >[2]/dev/null || true
	cmp $D/mini.txt $EXPECTED && echo 'ok step1: under mini-qemu'
	if(whatis $QEMU >/dev/null >[2=1]){
		timeout 10 $QEMU $boot $QEMUSMP -display none -monitor none -serial file:$D/qemu.txt < /dev/null >[2]/dev/null || true
		cmp $D/qemu.txt $EXPECTED && echo 'ok step1: under QEMU'
	}
	if not echo 'step1: no QEMU, not booted under it'

clean:V:
	rm -rf $D
