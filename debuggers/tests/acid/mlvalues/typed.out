./target:arm plan 9 executable
acid: PID: Mirq interrupt	_main	MOVW.W	R14,#-0x4(R13)
PID: Prefetch Abort/Breakpoint	main+0x4	MOVW	R0,R1
acid: acid: PID: Prefetch Abort/Breakpoint	f2_down	SUB	$#0x10,R13,R13
acid: [Circle 1.5; Rect (3, 4); Empty]
acid: Node (Leaf, "b", Node (Leaf, "c", Leaf))
acid: [Key {code = 65; shift = true}; Quit]
acid: Values.n = {contents = 42}
Values.s = "hello"
Values.l = [1; 2; 3]
Values.p = {x = 1; y = 2; name = "origin"}
Values.shapes = [Circle 1.5; Rect (3, 4); Empty]
Values.pair = (7, "seven")
Values.f = <fun f1_f>
Values.arr = [|10; 20|]
Values.opt = Some (-5)
Values.tree = Node (Leaf, "b", Node (Leaf, "c", Leaf))
Values.named = ("x", 1)
Values.events = [Key {code = 65; shift = true}; Quit]
Values.c = 'z'
Values.down = <fun f2_down>
acid: 
echo kill > /proc/PID/ctl
