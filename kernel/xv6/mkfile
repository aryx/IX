# mini-xv6 on the Pi 4, or (mini-mk O=5) the Pi 1, built by ix's tools
# (plan_kernel_mini_ml.md):
# the Makefile's kernel (ocaml-light, gcc, GNU's as and ld), by mini-ml,
# mini-cc, mini-asm and mini-ld. The same OCaml, the same C;
# ../lib_machine/mkkernel says what else.
#   mini-mk          _mk/7/kernel/xv6/kernel8.img (O=5: _mk/5/kernel/xv6/kernel.img)
#   mini-mk run      under mini-qemu (Ctrl-A x quits)
#   mini-mk check    the Makefile's session, under mini-qemu and QEMU:
#                    the same expected-pi4 (expected-pi1)
TOP=../..
DIR=kernel/xv6
# (Usbhost is kernel/lib_machine's: not every kernel wants it)
KML=Types Proc Fs File ../lib_machine/Usbhost Exec Syscall Main
KNAMES=Types Proc Fs File Usbhost Exec Syscall Main
KI=-I .
KFLAGS=
<$TOP/mkfiles/mkconfig
FS=`{case $O in 5) echo /home/pad/xv6/forks/arm-pi1/user/fs.img;; 7) echo /home/pad/xv6/forks/arm64-pi4/fs.img;; esac}
<$TOP/kernel/lib_machine/mkkernel

run:V: $IMAGE
	mini-qemu $BOOT -nographic

# The Makefile's check, with this image: the session typed at sh, under
# mini-qemu and QEMU, as xv6's C kernel's (expected-pi4, expected-pi1);
# the screen after it, the same under both (and on the Pi 1 as the C
# kernel draws it); the session typed on a USB keyboard, the mouse
# moved; usertests under QEMU.
SESSION_PY=$TOP/kernel/lib_machine/session.py
MINIQEMU=$TOP/_build/default/raspberry/Main.exe
KBOOT=$BOOT -nographic
BOARD=`{case $O in 5) echo pi1;; 7) echo pi4;; esac}
USB=-device usb-kbd -device usb-mouse
check:V: $IMAGE
	session() { $SESSION_PY "$@"; }
	from_init() { sed -n '/init: starting sh/,$p' $1 | grep -v '^hart [0-9] starting$'; }
	typed() { session --timeout $1 --out $D/$2.txt --screendump $D/$2.ppm ls "cat README" "echo hello world" "mkdir d" "ls d" "ln README d/r" "ls d" "wc d/r" "rm d/r" "grep xv6 README" forktest "cat nosuch" "sh -c" -- $3 $KBOOT $4; }
	usb() { session --timeout $1 --usb --move "200,-100;-60,40" --out $D/$2-usb.txt --screendump $D/$2-usb.ppm ls "echo hello world" -- $3 $KBOOT $4 $USB; }
	# the sessions, each an emulator and a kernel waited on: side by side, then compared
	# (old: one after the other, 4 minutes)
	rm -f $D/usertests.ok
	typed 300 mini $MINIQEMU & typed 60 qemu $QEMU "$QEMUSMP" & usb 300 mini $MINIQEMU & usb 120 qemu $QEMU "$QEMUSMP" &
	session --until "ALL TESTS PASSED" --timeout 600 --out $D/usertests.txt usertests -- $QEMU $KBOOT $QEMUSMP > $D/usertests.log 2>&1 && touch $D/usertests.ok &
	wait
	from_init $D/mini.txt | diff - expected-$BOARD && echo "ok xv6 $BOARD, by ix: a session under mini-qemu, as xv6's"
	from_init $D/qemu.txt | diff - expected-$BOARD && echo "ok xv6 $BOARD, by ix: a session under QEMU, as xv6's"
	cmp $D/mini.ppm $D/qemu.ppm && echo "ok xv6 $BOARD, by ix: the screen under mini-qemu, as under QEMU"
	if [ -f expected-$BOARD.ppm.gz ]; then gzip -dc expected-$BOARD.ppm.gz | cmp - $D/qemu.ppm && echo "ok xv6 $BOARD, by ix: the screen as xv6's C kernel draws it"; fi
	(sed -n '1,/^\$ cat README$/p' expected-$BOARD | sed '$d'; sed -n '/^\$ echo hello world$/,/^hello world$/p' expected-$BOARD; echo '$ ') > $D/usb-expected.txt
	from_init $D/mini-usb.txt | diff - $D/usb-expected.txt && from_init $D/qemu-usb.txt | diff - $D/usb-expected.txt && echo "ok xv6 $BOARD, by ix: a session typed on the USB keyboard, under mini-qemu and QEMU"
	cmp $D/mini-usb.ppm $D/qemu-usb.ppm && echo "ok xv6 $BOARD, by ix: the screen after the USB mouse moved, under mini-qemu as under QEMU"
	[ -f $D/usertests.ok ] && echo "ok xv6 $BOARD, by ix: usertests under QEMU"
