(* mini-singularity: the Intro contract, as mini-singml reads it
 * (singml/): a process is told where a service is by being sent an
 * endpoint of it, which is then its own (a capability: Singularity's
 * way). In Sing#'s way of writing it:
 *
 *   contract Intro {
 *     in message Meet(Pong.Imp);
 *     state Start: Meet? -> Done;
 *     state Done: ;
 *   }
 *)

type request = Meet of Pong.imp

let rec start = function Meet _ -> done_
and done_ = ()
