# mini-csc, built by ix's tools: its lexer by mini-lex, and the
# libraries of languages/dotnet it stands on, assembly/ and runtime/.
# (Csc_ast comes first, so that a unit of this directory is compiled
# first and tests/depend_edges.sh looks for CLI here before it looks in
# .., which has mini-dotnet's.)
TOP=../../..
DIR=languages/dotnet/csc
PROG=mini-csc
SRC=Csc_ast Csc_lexer Csc_parser Csc_types Csc_emit Csc_compile CLI Main
LOCAL=`{ls *.ml *.mli *.mll}
LIBI=
# (the assembly's writer, Writer and what it stands on; runtime/'s
# Value and Library)
LIBDIRS=languages/dotnet/assembly languages/dotnet/runtime
<$TOP/mkfiles/mkconfig
GEN=$B/languages/dotnet/csc/Csc_lexer.ml
LIBOBJS=
<$TOP/mkfiles/mkprog

$D/Csc_lexer.$O: $D/Csc_lexer.ml $LOCAL
	$ML $INCLUDES -o $target $D/Csc_lexer.ml
