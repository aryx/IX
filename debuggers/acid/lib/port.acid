//
// port.acid: mini-acid's library, the part every machine shares; the
// machine's is arm.acid (its registers, its functions' prologues). What a
// debugger does is written here, in acid, over the builtins (the process,
// its memory, the symbol table): the user adds to it as to any library.
// Plan 9's /lib/acid/port.acid does the same work; this one is ix's own,
// smaller: its essentials, and one stack walk for C's frames and
// mini-ml's alike (Plan 9's is libmach's, which stops at mini-ml's).
//
//     new()                   the program run, stopped in main
//     bpset(a) bpdel(a) bptab()       breakpoints
//     cont() step() next() stmnt() func()
//                             run; an instruction; a line, over calls;
//                             a line; out of the function
//     stk() lstk()            the stack (lstk: the locals too)
//     src(a) asm(a) mem(a, "4X") regs() procs()
//     pcomplex(a, "T")        a value of a complex type, as print shows
//                             it: Node {name=0x203c "one", p=Point {...}}
//     ml(v)                   an ML value by its words: ml(*Values.l)
//                             prints [1; 2; 3]; a global by its type
//                             (mini-ml -g): ml(Values.p) {x = 1; ...}
//     mlvars()                the globals mini-ml -g described

// a frame's function and place: name+0xoff file:line
defn pfl(addr)
{
	print(pcfile(addr), ":", pcline(addr), "\n");
}

// the frames from (pc, sp, link), the innermost first, each {its
// function, where in it, its sp}, to the start (isstart: arm.acid's
// _main, arm64.acid's main): a function's frame by its
// prologue (arm.acid's frame), its caller's address at 0(SP) once saved,
// the link before (and in a leaf, the innermost only)
defn frames(pc, sp, link)
{
	local l, f, start, p, ret, size, n;

	l = {};
	n = 0;
	while n < 40 do {
		f = fnbound(pc);
		if f == {} then
			return l;
		start = f[0];
		append l, {start, pc, sp};
		if isstart(start) then
			return l;
		p = frame(start);
		if p == {} || pc <= p[1] then {
			if n > 0 then
				return l;
			ret = link;
			size = 0;
			if p != {} && pc > start then
				size = p[0];
		} else {
			ret = *fmt(sp, 'X');
			size = p[0];
		}
		if ret == 0 then
			return l;
		pc = ret-4;		// the call
		sp = sp+size;
		n = n+1;
	}
	return l;
}

defn params(l)
{
	while l do {
		print((head l)[0], "=", itoa((head l)[1], "%ux"));
		l = tail l;
		if l then
			print(",");
	}
}

defn locals(l)
{
	while l do {
		print("\t", (head l)[0], "=", itoa((head l)[1], "%ux"), "\n");
		l = tail l;
	}
}

// the stack: a frame a line, its parameters and locals from the symbol
// table (the builtin strace's, libmach's walk: C's functions have them,
// mini-ml's none), its frames taken while they are the walk's
defn _stk(dolocals)
{
	local l, f, t;

	l = frames(*PC, *SP, linkreg());
	t = strace(*PC, *SP, linkreg());
	while l do {
		f = head l;
		if isstart(f[0]) then {
			print(fmt(f[1], 'a'), " ");
			pfl(f[1]);
			return {};
		}
		print(fmt(f[0], 'a'), "(");
		if t != {} && (head t)[0] == f[0] then
			params((head t)[2]);
		print(")+", itoa(f[1]-f[0], "%ux"), " ");
		pfl(f[1]);
		if dolocals && t != {} && (head t)[0] == f[0] then
			locals((head t)[3]);
		if t != {} && (head t)[0] == f[0] then
			t = tail t;
		else
			t = {};
		l = tail l;
	}
}

defn stk() { _stk(0); }
defn lstk() { _stk(1); }

// a source file's lines, read once (srcpath's directories tried for a
// relative name)
srcfiles = {};
srctext = {};
srcpath = {"./"};
defn findsrc(file)
{
	local i, dirs, text;

	i = match(file, srcfiles);
	if i >= 0 then
		return srctext[i];
	text = file(file);
	dirs = srcpath;
	while text == {} && dirs do {
		text = file(head dirs+file);
		dirs = tail dirs;
	}
	if text != {} then {
		srcfiles = append srcfiles, file;
		srctext = append srctext, text;
	}
	return text;
}

// the source around an address, its line marked
defn src(addr)
{
	local text, line, n;

	text = findsrc(pcfile(addr));
	if text == {} then {
		print("no source for ", pcfile(addr), "\n");
		return {};
	}
	line = pcline(addr)-1;
	print(pcfile(addr), ":", line+1, "\n");
	n = line-5;
	loop 0, 10 do {
		if n >= 0 && text[n] != {} then {
			if n == line then
				print(">");
			else
				print(" ");
			print(n+1, "\t", text[n], "\n");
		}
		n = n+1;
	}
}

// breakpoints: the instruction there replaced by bpinst, the program's
// own (@) put back to run it
defn bpset(addr)
{
	if status(pid) != "Stopped" then {
		print("Waiting...\n");
		stop(pid);
	}
	if match(addr, bplist) >= 0 then
		print("breakpoint already set at ", fmt(addr, 'a'), "\n");
	else {
		*fmt(addr, bpfmt) = bpinst;
		bplist = append bplist, addr;
	}
}

defn bpdel(addr)
{
	local l, n;

	if match(addr, bplist) < 0 then {
		print("no breakpoint at ", fmt(addr, 'a'), "\n");
		return {};
	}
	addr = fmt(addr, bpfmt);
	*addr = @addr;
	l = {};
	n = bplist;
	while n do {
		if head n != addr then
			l = append l, head n;
		n = tail n;
	}
	bplist = l;
}

defn bptab()
{
	local l;

	l = bplist;
	while l do {
		print("\t", fmt(head l, 'X'), " ", fmt(head l, 'a'), "  ", fmt(head l, 'i'), "\n");
		l = tail l;
	}
}

// one instruction: breakpoints where it may go next (follow), the
// process run until it stops at one, the instructions put back
defn step()
{
	local here, targets, l;

	here = 0;
	if match(*PC, bplist) >= 0 then {
		here = fmt(*PC, bpfmt);
		*here = @here;
	}
	targets = follow(*PC);
	l = targets;
	while l do {
		*fmt(head l, bpfmt) = bpinst;
		l = tail l;
	}
	startstop(pid);
	l = targets;
	while l do {
		*fmt(head l, bpfmt) = @fmt(head l, bpfmt);
		l = tail l;
	}
	if here != 0 then
		*here = bpinst;
}

defn cont()
{
	local here;

	here = fmt(*PC, bpfmt);
	if match(here, bplist) >= 0 then {
		*here = @here;
		step();
		*here = bpinst;
	}
	startstop(pid);
}

// a line: instructions until the line changes
defn stmnt()
{
	local line;

	line = pcline(*PC);
	while line == pcline(*PC) do
		step();
	src(*PC);
}

// out of the function: instructions until the pc leaves it
defn func()
{
	local f;

	f = fnbound(*PC);
	while *PC >= f[0] && *PC < f[1] do
		step();
}

// a line, over the calls it makes: a call left is stepped until the
// stack is back to this frame
defn next()
{
	local sp, f;

	sp = *SP;
	f = fnbound(*PC);
	stmnt();
	if *PC >= f[0] && *PC < f[1] then
		return {};
	while (*PC < f[0] || *PC >= f[1]) && sp >= *SP do
		step();
	src(*PC);
}

defn new()
{
	bplist = {};
	newproc(progargs);
	bpset(follow(main)[0]);
	cont();
	bpdel(*PC);
}

// called by mini-acid at a stop: where and why
defn stopped(pid)
{
	local l;

	print(pid, ": ", reason(*TYPE), "\t", fmt(*PC, 'a'), "\t", fmt(*PC, 'i'), "\n");
	if notes && notes[0] != "sys: breakpoint" then {
		print("Notes pending:\n");
		l = notes;
		while l do {
			print("\t", head l, "\n");
			l = tail l;
		}
	}
}

defn procs()
{
	local l, p;

	p = pid;
	l = proclist;
	while l do {
		setproc(head l);
		print(head l, ": ", status(head l), " at ", fmt(*PC, 'a'), "\n");
		l = tail l;
	}
	if p != 0 then
		setproc(p);
}

// the instructions from an address to its function's end, 30 at most
defn asm(addr)
{
	local f;

	f = fnbound(addr);
	loop 1, 30 do {
		print(fmt(addr, 'a'), "\t", fmt(addr, 'i'), "\n");
		addr = addr+4;
		if f != {} && addr >= f[1] then
			return {};
	}
}

// memory as a format says: "4X" four words in hexadecimal, "s" a string
defn mem(addr, f)
{
	local i, n;

	i = 0;
	while f[i] != 0 do {
		n = 0;
		while '0' <= f[i] && f[i] <= '9' do {
			n = 10*n+f[i]-'0';
			i = i+1;
		}
		if n <= 0 then
			n = 1;
		addr = fmt(addr, f[i]);
		while n > 0 do {
			print(*addr++, " ");
			n = n-1;
		}
		i = i+1;
	}
	print("\n");
	return addr;
}

progargs = "";

// whether an address is in one of the maps (the process's text, its
// data to the stack's top): a pointer followed only there
defn readable(a)
{
	local l;

	l = map();
	while l != {} do {
		if a >= (head l)[1] && a < (head l)[2] then
			return 1;
		l = tail l;
	}
	return 0;
}

// the C string at an address if its bytes read as one (printable, to a
// NUL, 64 at most), else {}
defn cstring(a)
{
	local s, c, n;

	s = "";
	n = 0;
	while n < 64 && readable(a+n) do {
		c = *((a+n)\b);
		if c == 0 then
			return s;
		if c < 32 || c > 126 then
			return {};
		s = s + c;
		n = n + 1;
	}
	return {};
}

// a member at an address, by its format (aggr's) and its complex type
// if it has one: a structure in it as pcomplex, a pointer with its
// type, nil, or its string; a short and a char signed, a char as one
defn pmember(a, f, t)
{
	local v, s;

	if f == "a" then {
		if t != "" then
			pcomplex(a, t);
		else
			print(a\X);
		return {};
	}
	if f == "A" || f == "X" || f == "Y" then {
		// (a pointer of 8 bytes: 'Y', or 'A' on arm64)
		if f == "Y" || (f == "A" && objtype == "arm64") then
			v = *(a\Y);
		else
			v = *(a\X);
		if v == 0 then
			print("nil");
		else if t != "" then
			print("(", t, "*)", v);
		else {
			print(v);
			s = cstring(v);
			if s != {} then
				print(" \"", s, "\"");
		}
		return {};
	}
	v = *fmt(a, f[0]);
	if f == "d" then {
		if v >= 0x8000 then
			v = v - 0x10000;
		print(v\D);
	} else if f == "C" then {
		if v >= 0x80 then
			v = v - 0x100;
		if v >= 32 && v < 127 then
			print("'", v\c, "'");
		else
			print(v\D);
	} else if f == "b" || f == "u" then
		print(v\D);
	else if f == "W" then
		print(v\Z);
	else
		print(v);
}

// a value of a complex type, on one line: its members by their formats
// and offsets (the aggr's, members()), a structure in it the same way.
// print calls it for a complex value (5c -a's T(addr) prints a member a
// line, its pointers in hexadecimal: still there, called by its name)
defn pcomplex(addr, t)
{
	local ms, m, sep;

	print(t, " {");
	sep = "";
	ms = members(t);
	while ms != {} do {
		m = head ms;
		print(sep, m[0], "=");
		pmember(addr + m[2], m[1], m[3]);
		sep = ", ";
		ms = tail ms;
	}
	print("}");
}

// mini-ml's values, by their words alone (its runtime's mlvalues.h): an
// odd word the integer n as 2n+1, an even one a block's address, its
// header the word before (its size in words << 10, its tag the low
// byte): 252 a string, 253 a float, 247 a closure (its code first),
// 254 and 255 an int32 and an int64, 251 a float array, below 247 a
// tuple, a record or a constructor's arguments. No type says which of
// the last: a block is (f0, f1, ...), #tag(f0, ...) when its tag is not
// 0, a chain of pairs to 0 a list when it has two cells at least (a
// record's names, a constructor's: the program's types, not here).
// On arm, 4-byte words.
defn mlint(w)
{
	if w >= 0x80000000 then
		w = w - 0x100000000;
	return (w - 1) / 2;
}

defn mlstring(v, n)
{
	local i, c;

	print("\"");
	i = 0;
	while i < n && i < 64 do {
		c = *((v+i)\b);
		if c == '"' || c == '\\' then
			print("\\", c\c);
		else if c == '\n' then
			print("\\n");
		else if c >= 32 && c < 127 then
			print(c\c);
		else
			print("\\", c\D);
		i = i + 1;
	}
	if n > 64 then
		print("...");
	print("\"");
}

// a chain of pairs ending in 0 ([]): its length, else 0
defn mllist(v)
{
	local n, h;

	n = 0;
	while (v & 1) == 0 && n < 1000 do {
		if !readable(v-4) then
			return 0;
		h = *((v-4)\X);
		if (h & 255) != 0 || (h >> 10) != 2 then
			return 0;
		v = *((v+4)\X);
		n = n + 1;
	}
	if v != 1 then
		return 0;
	return n;
}

// a value, its blocks to depth d
defn mlv(v, d)
{
	local h, tag, size, i, sep, n;

	if v & 1 then {
		print(mlint(v)\D);
		return {};
	}
	if v == 0 || !readable(v-4) then {
		print(v\X);
		return {};
	}
	h = *((v-4)\X);
	tag = h & 255;
	size = h >> 10;
	if tag == 252 then {
		mlstring(v, size*4 - 1 - *((v+size*4-1)\b));
		return {};
	}
	if tag == 253 then {
		print(*(v\F));
		return {};
	}
	if tag == 254 then {
		print(*(v\D), "l");
		return {};
	}
	if tag == 255 then {
		print(*(v\V), "L");
		return {};
	}
	if tag == 247 then {
		print("<fun ", fmt(*(v\X), 'a'), ">");
		return {};
	}
	if d == 0 then {
		print("...");
		return {};
	}
	if tag == 251 then {
		print("[|");
		sep = "";
		i = 0;
		while i < size/2 && i < 16 do {
			print(sep, *((v+i*8)\F));
			sep = "; ";
			i = i + 1;
		}
		print("|]");
		return {};
	}
	n = mllist(v);
	if tag == 0 && n >= 2 then {
		print("[");
		sep = "";
		i = 0;
		while i < n && i < 16 do {
			print(sep);
			mlv(*(v\X), d-1);
			v = *((v+4)\X);
			sep = "; ";
			i = i + 1;
		}
		if n > 16 then
			print("; ...");
		print("]");
		return {};
	}
	if tag != 0 then
		print("#", tag\D);
	print("(");
	sep = "";
	i = 0;
	while i < size && i < 16 do {
		print(sep);
		mlv(*((v+i*4)\X), d-1);
		sep = ", ";
		i = i + 1;
	}
	if size > 16 then
		print(", ...");
	print(")");
}

// mini-ml -g's descriptions (its Acid_ml), which the program's .acid
// adds to: each type's {path, params, "variant", {constant names},
// {name, args...}...}, {path, params, "record", {name, type}...} or
// {path, params, "=", type}; each global's {symbol, type}, a type a
// list, its path and its arguments: {"list", {"int"}}
mltypes = {};
mlglobals = {};

// the description of the type of this path, or {}
defn mltypeof(p)
{
	local l;

	l = mltypes;
	while l != {} do {
		if (head l)[0] == p then
			return head l;
		l = tail l;
	}
	return {};
}

// a type, its variables ('a) replaced as env says ({{"'a", type}...})
defn mlsubst(t, env)
{
	local r, a, e;

	if t[0][0] == '\'' then {
		e = env;
		while e != {} do {
			if (head e)[0] == t[0] then
				return (head e)[1];
			e = tail e;
		}
		return t;
	}
	r = {t[0]};
	a = tail t;
	while a != {} do {
		r = append r, mlsubst(head a, env);
		a = tail a;
	}
	return r;
}

// whether a constructor's one argument is written in parentheses: a
// negative number, a constructor's with arguments
defn mlparen(v, t)
{
	local desc;

	if t[0] == "int" then
		return (v & 1) && mlint(v) < 0;
	desc = mltypeof(t[0]);
	if desc == {} then
		return 0;
	return desc[2] == "variant" && (v & 1) == 0;
}

// the fields of a block, from i, by their types (a tuple's, a
// constructor's arguments, an array's elements: one type, many)
defn mlfields(v, ts, env, d, sep0)
{
	local i, sep;

	i = 0;
	sep = "";
	while ts != {} do {
		print(sep);
		mlt(*((v+i*4)\X), mlsubst(head ts, env), d-1);
		sep = sep0;
		i = i + 1;
		ts = tail ts;
	}
}

// a value of a type: as OCaml's toplevel prints it, its names by the
// descriptions; by its words (mlv) where it has none
defn mlt(v, t, d)
{
	local n, desc, env, ps, as, cs, i, sep, h, tag, c;

	n = t[0];
	if n == "int" then {
		print(mlint(v)\D);
		return {};
	}
	if n == "char" then {
		print("'", mlint(v)\c, "'");
		return {};
	}
	if n == "bool" then {
		if v == 3 then
			print("true");
		else
			print("false");
		return {};
	}
	if n == "unit" then {
		print("()");
		return {};
	}
	if n == "->" || n == "string" || n == "bytes" || n == "float" || n == "exn" || n == "Int32.t" || n == "Int64.t" || n[0] == '\'' then {
		mlv(v, d);
		return {};
	}
	if (v & 1) == 0 && !readable(v-4) then {
		print(v\X);
		return {};
	}
	if d == 0 then {
		print("...");
		return {};
	}
	if n == "list" then {
		print("[");
		sep = "";
		i = 0;
		while (v & 1) == 0 && i < 16 do {
			print(sep);
			mlt(*(v\X), t[1], d-1);
			v = *((v+4)\X);
			sep = "; ";
			i = i + 1;
		}
		if (v & 1) == 0 then
			print("; ...");
		print("]");
		return {};
	}
	if n == "array" then {
		h = *((v-4)\X);
		if (h & 255) == 251 then {
			mlv(v, d);
			return {};
		}
		print("[|");
		sep = "";
		i = 0;
		while i < (h >> 10) && i < 16 do {
			print(sep);
			mlt(*((v+i*4)\X), t[1], d-1);
			sep = "; ";
			i = i + 1;
		}
		if (h >> 10) > 16 then
			print("; ...");
		print("|]");
		return {};
	}
	if n == "*" then {
		print("(");
		mlfields(v, tail t, {}, d, ", ");
		print(")");
		return {};
	}
	desc = mltypeof(n);
	if desc == {} then {
		mlv(v, d);
		return {};
	}
	env = {};
	ps = desc[1];
	as = tail t;
	while ps != {} && as != {} do {
		env = append env, {head ps, head as};
		ps = tail ps;
		as = tail as;
	}
	if desc[2] == "=" then {
		mlt(v, mlsubst(desc[3], env), d);
		return {};
	}
	if desc[2] == "record" then {
		print("{");
		cs = tail tail tail desc;
		sep = "";
		i = 0;
		while cs != {} do {
			print(sep, (head cs)[0], " = ");
			mlt(*((v+i*4)\X), mlsubst((head cs)[1], env), d-1);
			sep = "; ";
			i = i + 1;
			cs = tail cs;
		}
		print("}");
		return {};
	}
	if v & 1 then {
		cs = desc[3];
		i = mlint(v);
		while i > 0 && cs != {} do {
			cs = tail cs;
			i = i - 1;
		}
		if cs == {} then
			print(v\X);
		else
			print(head cs);
		return {};
	}
	tag = *((v-4)\X) & 255;
	cs = tail tail tail tail desc;
	while tag > 0 && cs != {} do {
		cs = tail cs;
		tag = tag - 1;
	}
	if cs == {} then {
		mlv(v, d);
		return {};
	}
	c = head cs;
	as = tail c;
	print(c[0]);
	if tail as == {} then {
		h = mlsubst(head as, env);
		if mlparen(*(v\X), h) then {
			print(" (");
			mlt(*(v\X), h, d-1);
			print(")");
		} else {
			print(" ");
			mlt(*(v\X), h, d-1);
		}
	} else {
		print(" (");
		mlfields(v, as, env, d, ", ");
		print(")");
	}
}

// an ML value printed: a unit's global (Values.shapes) by its type when
// mini-ml -g described it, else (or *Values.shapes) by its words
defn ml(v)
{
	local g;

	g = mlglobals;
	while g != {} do {
		if var((head g)[0]) == v then {
			mlt(*(v\X), (head g)[1], 6);
			print("\n");
			return {};
		}
		g = tail g;
	}
	mlv(v, 6);
	print("\n");
}

// the described globals, each with its value
defn mlvars()
{
	local g;

	g = mlglobals;
	while g != {} do {
		print((head g)[0], " = ");
		ml(var((head g)[0]));
		g = tail g;
	}
}
