; languages/ml/highlight: OCaml read to be coloured, not compiled (the
; author's playground's languages/ocaml, docs/plans/plan_emacs.md):
; Token_ml (every token kept, comments too), Lexer_ml (one that never
; fails, on a text half typed) and Highlight_ml (each token's
; category, from its neighbours). For mini-emacs.
(library
 (name ix_highlight_ml)
 (wrapped false)
 ; (the text is the playground's: what it leaves unused stays)
 (flags (:standard -w -26-27-32-33-35-37-39-69))
 (libraries ix_code))

(ocamllex Lexer_ml)
