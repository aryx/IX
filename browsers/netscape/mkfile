# mini-netscape, built by ix's tools (docs/plans/plan_browser.md, stage
# 10): the browser's units -- HTML, CSS, JavaScript, a page's scripts,
# the boxes -- found by its name in their directories and compiled
# here, then the program, linked with the libraries (mkfiles/mklibs:
# the cryptography, the compression, the network, the pictures and
# their readers, the playground and one platform of it). The
# platform is ppm's on Linux (no window: a frame written to a file, the
# tests'), the draw device's with OS=plan9 (mini-9pi: a window of
# mini-rio, as the games', games/mkgames).
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/browsers/netscape
PLATFORM=`{case $OS in plan9) echo draw;; *) echo ppm;; esac}
# (each after the ones it names)
LIBDIRS=lib_crypto lib_compression lib_networking lib_graphics lib_playground lib_playground/platforms lib_playground/platforms/$PLATFORM
<$TOP/mkfiles/mklibs
J=../javascript
W=../webapi
# (the libraries before lib_core: lib_playground's Cmd is Elm's, not commons/'s)
DIRS=. ../html ../css $J/values $J/parsing $J/eval $J/opti $J/library ../engine/layout ../engine/display ../engine/page $W/dom $W/window $W/net $W/run
# (written out: mk's ${DIRS:%=-I %} gives -I. for the first)
INCLUDES=-I . -I ../html -I ../css -I $J/values -I $J/parsing -I $J/eval -I $J/opti -I $J/library -I ../engine/layout -I ../engine/display -I ../engine/page -I $W -I $W/dom -I $W/window -I $W/net -I $W/run $LIBI $STDI
# (each before the ones that name it: ocamldep -sort's order; Js_quicken
# and Js_compile after Js_eval, which they tell of themselves when the
# program starts)
LIB=Js_prelude Browser_zoom Script_prelude Cors Style Browser_history Js_ast Per_domain Mini_opti Js_string Ua_sheet Css_syntax Dtd Dom Charset Entities Html_lexer Css_values Js_lexer Js_parse Js_coroutine Js_regexp Browser_url Table_layout Js_value Js_operators Selectors Looks Cascade Line_mode Html_tree Forms Css Js_scope Js_json Js_promise Browser_picture Html_layout Stroke_text Script_events Script_dom Hit Browser_text Browser_draw Js_builtins Js_frame Js_props Css_grid Computed Js_globals Flex_layout Grid_layout Box_layout Js_eval Js_quicken Js_compile Browser_boxes Browser_page Script_host LocalStorage Script_window Script_fetch Event_loop XMLHttpRequest Script_url Script_element Script_document Browser_forms Browser_script Browser_helpers Places Browser_profile Worker_spawn Tab Tab_worker
LIBOBJS=${LIB:%=$D/%.$O}
LOCAL=`{for d in $DIRS $W; do ls $d/*.ml $d/*.mli 2> /dev/null; done} $LIBSRC
LIBS=$LIBOBJS $LIBA $STDOBJS $STDEND $TOP/mkfiles/mkconfig

# (netscape: the name the frames' test asks for, as a game's; mini-netscape: the program's)
all:V: $D/mini-netscape

$D/%.$O: $LOCAL
	mkdir -p $D
	for d in $DIRS; do [ -f $d/$stem.ml ] && f=$d/$stem.ml; done
	$ML $INCLUDES -o $target $f

# the window's worker: lib_core's threads, a large one (Worker_spawn.mli)
$D/Worker_spawn.$O: spawn/large_threads.ml Worker_spawn.mli
	mkdir -p $D
	cp Worker_spawn.mli $D/Worker_spawn.mli
	cp spawn/large_threads.ml $D/Worker_spawn.ml
	$ML $INCLUDES -o $target $D/Worker_spawn.ml

$D/mini-netscape: $D/netscape
	cp $D/netscape $target
$D/netscape: $D/Netscape.$O $LIBS
	$ML -start $STD $COMMONS `$TOP/mkfiles/units.sh $LIBA` $LIB Netscape Std_exit -o $D/Netscape.start.$O
	$LD $LDH -nofollow -o $target $D/Netscape.start.$O $STDOBJS $LIBA $LIBOBJS $D/Netscape.$O $STDEND

clean:V:
	rm -rf $D
