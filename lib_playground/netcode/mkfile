# lib_playground's netcode, a library of its own (mkfiles/mklib): the
# players' inputs exchanged, lockstep and rollback, over lib_networking's
# Udp (apis/'s Multiplayer over it); apart from lib_playground, after
# it, since it names its Lehmer (old: lib_networking/netcode)
TOP=../..
<$TOP/mkfiles/mkconfig
LIB=lib_playground/netcode
DIRS=.
NEEDS=lib_networking lib_playground
UNITS=Checksum Sim_net Transport Wire Inputs Lockstep Rollback
<$TOP/mkfiles/mklib
