#!/boot/rc -m /boot/rcmain
# Claude Code
# Copyright (C) 2026 Yoann Padioleau. LGPL 2.1: see license.txt.
#
# mini-9pi's stage B check (plan_9pi.md): /boot/boot replaced by this,
# boot.rc's first lines (the devices bound, before the SD card), then
# an interactive rc on the console, as boot.rc's last line starts it.

/boot/echo booooooooting ARM ...

path=(/bin /boot)

bind -c '#e' /env
bind -a '#ec' /env
bind -c '#s' /srv
bind '#p' /proc
bind '#d' /fd
bind '#k' /sys
echo -n 'start' > '#c/swap'
bind -a '#P' /dev
bind -a '#S' /dev

. -i '#d/0'
