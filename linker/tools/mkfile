# the linker's tools, built by ix's tools: mini-ar, the librarian, and
# mini-nm, which prints the names (principia's linkers/misc/ has ar.c
# and nm.c side by side). Each is one file, over the linker's library
# for objects and libraries (and the assembler's, under it); mini-nm
# is over lib_executable too, for an a.out's tables.
# old: the assembler's and the linker's objects, named one by one
TOP=../..
DIR=linker/tools
LIBDIRS=assembler lib_executable linker
<$TOP/mkfiles/mkconfig
D=$B/$DIR
<$TOP/mkfiles/mklibs
INCLUDES=-I . $LIBI $STDI $STDSUM
MADE=`{mkdir -p $D}

all:V: $D/mini-ar $D/mini-nm

$D/%.$O: %.ml $LIBSRC
	$ML $INCLUDES -o $target $stem.ml
$D/mini-ar $D/mini-nm: $LIBA $STDOBJS $STDEND
$D/mini-ar: $D/Ar.$O
	$ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA} Ar Std_exit -o $D/Ar.start.$O
	$LD $LDH -nofollow -o $target $D/Ar.start.$O $STDOBJS $LIBA $D/Ar.$O $STDEND
$D/mini-nm: $D/Nm.$O
	$ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA} Nm Std_exit -o $D/Nm.start.$O
	$LD $LDH -nofollow -o $target $D/Nm.start.$O $STDOBJS $LIBA $D/Nm.$O $STDEND

clean:V:
	rm -rf $D
