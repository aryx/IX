#
# The top mkfile's lines that depend on the system and on the
# libraries' mkfiles, as mk text for mk's <| (read by rc's ., as
# mkfiles/config.rc). mk's variables are the environment.
# usage: <|. mkfiles/top.rc
# DIRS: the directories of programs the system builds; MORE: the games
# again on Plan 9, for its software platform.
if(~ $OS plan9) echo 'DIRS=$BOTH $PLAN9
MORE=games-software'
if not echo 'DIRS=$BOTH $LINUX
MORE='
# each library after the ones its mkfile needs: NEEDS=lib_core lib_mime
# in lib_x/mkfile gives lib_x.dir:V: lib_core.dir lib_mime.dir
for(d in $LIBS){
	n=`{sed -n 's/^NEEDS=//p' $d/mkfile}
	if(! ~ $#n 0) echo $d^'.dir:V:' $n^.dir
}
# ARGS: what each directory's mk is given, the machine and the system,
# and B when it was given as a path from the root (tests/lite.sh builds
# in a directory of its own, where a directory's mkconfig would say
# _mk/$O). Each in quotes: mk reads a first word O=7 as an attribute.
q=''''
a=$q^'O='^$O^$q^' '^$q^'OS='^$OS^$q
if(~ $B /*) a=$a^' '^$q^'B='^$B^$q
echo 'ARGS='^$a
