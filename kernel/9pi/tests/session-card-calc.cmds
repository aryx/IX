echo a b c | awk '{ print $3 > "/tmp/awk.out"; print NF }'; cat /tmp/awk.out; rm /tmp/awk.out
awk 'BEGIN { "echo from rc" | getline x; print x; print system("echo by system") }'
awk '{ n[$1]++ } END { for (w in n) print w, n[w] }' readme readme
