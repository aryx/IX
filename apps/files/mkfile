# apps/files, built by ix's tools: mini-files (Folder and the unit
# Files, for the program files) and mini-open (the unit Open, for the
# program open). The platform is ppm's on Linux, where there is no
# window and a frame is written to a file for the tests. With OS=plan9
# it is the draw device's, a window of mini-rio, as for the games
# (games/mkgames).
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/apps/files
PLATFORM=`{if(~ $OS plan9) echo draw; if not echo ppm}
LIBDIRS=lib_mime lib_compression lib_graphics lib_playground lib_gui lib_playground/platforms lib_playground/platforms/$PLATFORM
<$TOP/mkfiles/mklibs
INCLUDES=-I . -I $D $LIBI $STDI
LIB=Folder Icons
LIBOBJS=${LIB:%=$D/%.$O}
LOCAL=`{ls *.ml *.mli} $LIBSRC
LIBS=$LIBOBJS $LIBA $STDOBJS $STDEND $TOP/mkfiles/mkconfig

all:V: $D/files $D/open

$D/%.$O: %.ml $LOCAL
	mkdir -p $D
	$ML $INCLUDES -o $target $stem.ml

$D/files: $D/Files.$O $LIBS
	$ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA} $LIB Files Std_exit -o $D/Files.start.$O
	$LD $LDH -nofollow -o $target $D/Files.start.$O $STDOBJS $LIBA $LIBOBJS $D/Files.$O $STDEND
$D/open: $D/Open.$O $LIBS
	$ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA} Open Std_exit -o $D/Open.start.$O
	$LD $LDH -nofollow -o $target $D/Open.start.$O $STDOBJS $LIBA $D/Open.$O $STDEND

# the units' order (mkfiles/mkdepend)
DEPOBJ=D
DEPDIRS=. $D
DEPUNITS=$LIB Files Open
<$TOP/mkfiles/mkdepend

clean:V:
	rm -rf $D
