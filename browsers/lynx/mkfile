# mini-lynx, built by ix's tools: the program, linked with the libraries
# (mkfiles/mklibs: the network and browsers/html)
# old: browsers/html's units compiled here
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/browsers/lynx
LIBDIRS=lib_crypto lib_compression lib_networking browsers/html
<$TOP/mkfiles/mklibs
INCLUDES=-I . $LIBI $STDI
LIBS=$LIBA $STDOBJS $STDEND $TOP/mkfiles/mkconfig

all:V: $D/mini-lynx

$D/%.$O: %.ml $LIBSRC
	mkdir -p $D
	$ML $INCLUDES -o $target $stem.ml
$D/mini-lynx: $D/Lynx.$O $LIBS
	$ML -start $STD $COMMONS `$TOP/mkfiles/units.sh $LIBA` Lynx Std_exit -o $D/Lynx.start.$O
	$LD $LDH -nofollow -o $target $D/Lynx.start.$O $STDOBJS $LIBA $D/Lynx.$O $STDEND

clean:V:
	rm -rf $D
