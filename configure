#!/bin/sh
# Claude Code
# Copyright (C) 2026 Yoann Padioleau. LGPL 2.1: see license.txt.
set -eu # to debug this script add '-x'

###############################################################################
# Prelude
###############################################################################
# The goal of this script is to automate the configuration and installation
# of packages that are needed to then compile ix itself, on Linux and macOS.
# coupling: adapted from ~/github/ocaml-elm-playground/configure
#
# Three things, the first one alone needed by make:
#  - the tools and the opam packages of dune's build (make, make test)
#  - what the kernels' builds want more (./mini-pi mini-9pi...): a C cross
#    compiler for the Pi1, GNU's or, where there is none (macOS), LLVM's
#    (clang and lld, with musl's headers fetched in _cross/), written in
#    Makefile.config, and the other projects' checkouts (ocaml-light,
#    principia, xv6): all optional, mini-9pi being built by ix's own
#    tools without them
#  - what a few tests compare with (GNU's objdump, qemu, 9base), and
#    python3, which the build does without (its tools are OCaml's) but
#    many tests, the kernels' checks and make loc are written in

for arg in "$@"; do
    case "$arg" in
        --help|-h)
            echo "Usage: ./configure"
            echo ""
            echo "Checks the tools ix's build needs, installs its opam packages,"
            echo "and writes the kernels' cross compiler in Makefile.config (for ./mini-pi)."
            echo "Environment: OCAML_LIGHT, PRINCIPIA, XV6 (the checkouts, default"
            echo "~/ocaml-light, ~/principia, ~/xv6)."
            exit 0 ;;
        *) echo "Unknown option: $arg"; exit 1 ;;
    esac
done

###############################################################################
# Helper functions
###############################################################################

ok()   { echo "  [OK]   $1"; }
warn() { echo "  [WARN] $1"; }
err()  { echo "  [ERR]  $1" >&2; }

errors=0

need_command() {
    if command -v "$1" >/dev/null 2>&1; then
        ok "$1 ($(command -v "$1"))"
    else
        err "$1 not found in PATH"
        errors=$((errors + 1))
    fi
}

# want_command cmd "what does without it"
want_command() {
    if command -v "$1" >/dev/null 2>&1; then
        ok "$1 ($(command -v "$1"))"
    else
        warn "$1 not found; $2"
    fi
}

# want_dir dir "what does without it"
want_dir() {
    if [ -d "$1" ]; then
        ok "$1"
    else
        warn "$1 not found; $2"
    fi
}

check_tar() {
    # opam fetches package sources as .tar.gz and shells out to 'tar xfz'.
    # A project-local bootstrap toolchain (e.g. this machine's goken9cc or
    # xix env.sh, or ix's own bin/ with its mini-tar) ahead in $PATH can
    # shadow GNU/BSD tar with something that doesn't understand combined
    # flags or gzip, and opam then fails deep into package fetching.
    _t=$(mktemp -d)
    echo hello > "$_t/f"
    if tar czf "$_t/f.tgz" -C "$_t" f >/dev/null 2>&1 \
       && tar xzf "$_t/f.tgz" -C "$_t" >/dev/null 2>&1; then
        ok "tar ($(command -v tar)) supports gzip archives"
    else
        err "tar ($(command -v tar)) failed a basic 'tar czf'/'tar xzf' round-trip"
        err "  opam needs a real tar to fetch package sources. If \$PATH has a"
        err "  project-local toolchain bin/ ahead of /usr/bin, open a fresh shell and retry."
        errors=$((errors + 1))
    fi
    rm -rf "$_t"
}

check_c_lib() {
    name="$1"
    pkg="$2"
    header="$3"
    why="$4"

    if command -v pkg-config >/dev/null 2>&1 \
       && pkg-config --exists "$pkg" 2>/dev/null; then
        ok "$name (pkg-config: $pkg)"
        return 0
    fi

    search_dirs="/usr/include /usr/local/include"
    if command -v brew >/dev/null 2>&1; then
        search_dirs="$search_dirs $(brew --prefix 2>/dev/null)/include"
    fi

    for dir in $search_dirs; do
        if [ -f "$dir/$header" ]; then
            ok "$name (header: $dir/$header)"
            return 0
        fi
    done

    warn "$name not found (pkg-config module '$pkg', header '$header'); $why"
}

# LLVM's tools: Homebrew's (which keeps llvm off the PATH; Apple's own
# clang has no ld.lld beside it), or the PATH's
find_llvm() {
    for _f in llvm lld; do
        _p="$(brew --prefix "$_f" 2>/dev/null || true)/bin/$1"
        if [ -x "$_p" ]; then echo "$_p"; return 0; fi
    done
    command -v "$1" 2>/dev/null
}

# The C library's headers for the Pi1, which the OCaml runtime's files
# include (stdio.h, string.h...) and GNU's cross compiler has from its
# glibc: musl's, fetched once (its release, checked by its SHA-256) and
# installed alone in _cross/, no library: the kernels link their own
# (kernels/lib_machine/libc.c).
MUSL=musl-1.2.5
MUSL_SHA256=a9a118bbe84d8764da0ea0d28b3ab3fae8477fc7e4085d90102b8596fc7c75e4
MUSL_DIR=_cross/$MUSL-arm
fetch_musl_headers() {
    [ -f "$MUSL_DIR/usr/include/stdio.h" ] && return 0
    _t=$(mktemp -d)
    ( cd "$_t" \
      && curl -fsSLO "https://musl.libc.org/releases/$MUSL.tar.gz" \
      && echo "$MUSL_SHA256  $MUSL.tar.gz" | shasum -a 256 -c - >/dev/null \
      && tar xzf "$MUSL.tar.gz" ) >/dev/null 2>&1 \
    && rm -rf "$MUSL_DIR" && mkdir -p "$MUSL_DIR" \
    && make -s -C "$_t/$MUSL" ARCH=arm prefix=/usr DESTDIR="$PWD/$MUSL_DIR" install-headers >/dev/null 2>&1
    _r=$?
    rm -rf "$_t"
    return $_r
}

# On macOS, extend PKG_CONFIG_PATH for Homebrew
if command -v brew >/dev/null 2>&1; then
    _brew_prefix="$(brew --prefix 2>/dev/null || true)"
    if [ -n "$_brew_prefix" ]; then
        PKG_CONFIG_PATH="${_brew_prefix}/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
        export PKG_CONFIG_PATH
    fi
fi

###############################################################################
# Check required tools
###############################################################################

echo "Checking required tools..."

need_command ocaml
need_command opam
need_command make
need_command bash
need_command tar
command -v tar >/dev/null 2>&1 && check_tar

if [ "$errors" -ne 0 ]; then
    echo "$errors error(s) found. Please fix the issues above and re-run ./configure."
    exit 1
fi

echo ""

###############################################################################
# Check C libraries
###############################################################################
# coupling: dune-project's tsdl (mini-qemu's window, the graphical hosts)

echo "Checking C libraries..."

check_c_lib "SDL2"   "sdl2"   "SDL2/SDL.h" "tsdl won't build without it"
check_c_lib "libffi" "libffi" "ffi.h"      "tsdl (ctypes) won't build without it"

echo ""

###############################################################################
# Check what the kernels' builds need (./mini-pi)
###############################################################################
# coupling: mini-pi, kernels/ocaml-light.sh, kernels/lib_machine/kernel.mk,
# kernels/9pi/Makefile

echo "Checking the kernels' tools (for ./mini-pi; make does without them)..."

# the Pi1's C cross compiler: GNU's, or clang and lld (macOS: Homebrew
# has no arm-linux-gnueabihf-gcc), written in Makefile.config for
# kernels/lib_machine/kernel.mk and kernels/ocaml-light.sh
config="# Generated by configure. DO NOT MODIFY!"
if command -v arm-linux-gnueabihf-gcc >/dev/null 2>&1; then
    ok "arm-linux-gnueabihf-gcc ($(command -v arm-linux-gnueabihf-gcc))"
elif clang=$(find_llvm clang) && lld=$(find_llvm ld.lld) && objcopy=$(find_llvm llvm-objcopy) \
     && fetch_musl_headers; then
    cc="$clang --target=arm-linux-musleabihf --sysroot=$PWD/$MUSL_DIR"
    config="$config
# The Pi1's cross tools: clang and lld, over musl's headers ($MUSL)
PI1_CC = $cc
PI1_AS = $cc -c -x assembler
PI1_LD = $lld
PI1_OBJCOPY = $objcopy"
    ok "the Pi1's cross compiler: $clang, $lld, $MUSL's headers in $MUSL_DIR"
else
    case "$(uname -s)" in
    Darwin) how="brew install llvm lld, and re-run ./configure" ;;
    *)      how="install gcc-arm-linux-gnueabihf, or llvm and lld" ;;
    esac
    warn "no C cross compiler for the Pi1; mini-9pi is then compiled by ix's own tools, and mini-xv6-pi1 won't build: $how"
fi
echo "$config" > Makefile.config
# (the Pi4's kernels by ocaml-light are compiled by the host's own gcc,
# an arm64 Linux's; elsewhere mini-pi has ix's own tools compile them)

want_command md5sum "kernels/ocaml-light.sh needs it (macOS: brew install coreutils)"
want_command git    "kernels/ocaml-light.sh clones ocaml-light with it"
# the other projects' checkouts: all optional
want_dir "${OCAML_LIGHT:-$HOME/ocaml-light}" "mini-9pi is then compiled by ix's own tools (mini-ml: a bigger kernel); mini-xv6 won't build (set OCAML_LIGHT)"
want_dir "${PRINCIPIA:-$HOME/principia}"     "./mini-pi mini-9pi-principia and 9pi, and the tests against principia's 9pi, won't run (set PRINCIPIA)"
want_dir "${XV6:-$HOME/xv6}"                 "./mini-pi mini-xv6-* and xv6 won't run: its fs.img and its ports come from it (set XV6)"

echo ""

###############################################################################
# Check what the tests compare with
###############################################################################
# coupling: Dockerfile's apt-get line

echo "Checking the tests' references (optional)..."

want_command qemu-system-arm          "./mini-pi -q and the kernels' sessions under QEMU won't run"
want_command qemu-arm                 "the arm programs' tests under qemu-user won't run (Linux only)"
want_command arm-linux-gnueabihf-objdump "the ARM decoders' tests against GNU's objdump won't run"
want_command aarch64-linux-gnu-objdump   "the arm64 decoders' tests against GNU's objdump won't run"
want_command bc                       "the tests' timings won't print"
want_command python3                  "make test, make test-lite, the kernels' checks and make loc won't run (the build does without it)"

echo ""

###############################################################################
# Install opam dependencies
###############################################################################

echo "Installing opam dependencies..."
# coupling: dune-project's (depends ...) and the Dockerfile's opam line
# (ix has no .opam file to give to --deps-only)
opam install --confirm-level=unsafe-yes -y \
     dune caps fpath logs fmt testo alcotest 'tsdl>=1.3.0' \
     js_of_ocaml-compiler js_of_ocaml ppx_deriving menhir

echo ""
echo "Everything looks fine. You can now run:"
echo ""
echo "   $ make"
echo "   $ make test"
echo "   $ ./mini-pi mini-9pi"
