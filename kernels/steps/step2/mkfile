# mini-xv6, step 2, built by ix's tools, on the Pi 4 or (mini-mk O=5)
# the Pi 1 (docs/plans/done/plan_kernel_mini_ml.md, steps 4 and 9). It
# is the same Main.ml as the Makefile's (the Pi 1's, built by
# ocaml-light and gcc). pi4/ and pi1/ have the machine for it: l.s (the
# vectors, and the trap's entry and return, around step 0's start),
# machine.c (the primitives, and the trap into OCaml through the
# runtime's callback), and user.s (the program in user mode). The C sees
# the runtime through languages/ml/runtime's headers.
#   mini-mk          builds _mk/7/kernels/steps/step2/kernel8.img
#   mini-mk check    boots it under mini-qemu, and under QEMU if it is
#                    there, and compares with the Makefile's expected
#                    lines
TOP=../../..
<$TOP/mkfiles/mkconfig
<$TOP/kernels/lib_machine/mkboard
D=$B/kernels/steps/step2
MADE=`{mkdir -p $D}
BD=`{if(~ $O 5) echo pi1; if not if(~ $O 7) echo pi4}
ENTRY=`{if(~ $O 5) echo _start; if not if(~ $O 7) echo vectors}

all:V: $D/kernel8.img

$D/Main.$O: Main.ml
	$ML $STDI -o $target Main.ml

# (the start of the units of lib_core.a, Main's and std_exit's, in
# that order, as linked)
$D/start.$O: $STDOBJS $D/Main.$O mkfile $TOP/mkfiles/mkconfig
	$ML -start $STDOBJS $D/Main.$O $L/std_exit.$O -o $target

# (mini-ml's runtime with the steps' heap, step0's rt.c, which
# includes it; its parts found by -I)
# old: $CC $CINC $HEAP -o $target $TOP/languages/ml/runtime/runtime.c,
# HEAP='-DMAXHEAP=4194304' '-DSTACK=131072'
$D/runtime.$O: ../step0/rt.c $RTSRC
	$CC $CINC -I$TOP/languages/ml/runtime -o $target ../step0/rt.c
$D/l.$O: $BD/l.s ../step0/${P}l.s
	$AS -o $target $BD/l.s
$D/user.$O: $BD/user.s
	$AS -o $target $BD/user.s
$D/machine_c.$O: $BD/machine.c $TOP/languages/ml/runtime/mlvalues.h $TOP/languages/ml/runtime/callback.h
	$CC $CINC -I$TOP/languages/ml/runtime -o $target $BD/machine.c
$D/shim.$O: ../step0/shim.c
	$CC $CINC -o $target ../step0/shim.c

# memmove and memset come from port's C, a byte at a time, and not from
# libc's arm64 assembly (9front's). That assembly moves pairs of words,
# which fault at an address that is not aligned when the MMU is off, as
# it is here (QEMU raises the alignment fault; mini-qemu does not
# check). With libc's, the kernel does not boot under QEMU.
$D/memmove.$O: $TOP/lib_core/libc/port/memmove.c
	$CC $CINC -o $target $prereq
$D/memset.$O: $TOP/lib_core/libc/port/memset.c
	$CC $CINC -o $target $prereq

# (l comes first, because its vectors, or on the Pi 1 its start, are
# the image's first bytes.)
OBJS=$D/l.$O $D/shim.$O $D/machine_c.$O $D/user.$O $D/start.$O \
	$STDOBJS $D/Main.$O $L/std_exit.$O \
	$D/runtime.$O $D/memmove.$O $D/memset.$O $L/libc.a
$D/kernel8.img: $OBJS
	$LD -H0 -T $LOAD -E $ENTRY -nofollow -o $target $OBJS

check:V: $D/kernel8.img
	boot=`{echo $BOOT | sed 's|IMAGE|'$D/kernel8.img'|'}
	timeout 20 mini-qemu $boot -nographic < /dev/null > $D/mini.txt >[2]/dev/null || true
	cmp $D/mini.txt expected && echo 'ok step2: under mini-qemu'
	if(whatis $QEMU >/dev/null >[2=1]){
		timeout 10 $QEMU $boot $QEMUSMP -display none -monitor none -serial file:$D/qemu.txt < /dev/null >[2]/dev/null || true
		cmp $D/qemu.txt expected && echo 'ok step2: under QEMU'
	}
	if not echo 'step2: no QEMU, not booted under it'

clean:V:
	rm -rf $D
