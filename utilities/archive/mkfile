# utilities/archive, built by ix's tools: each program is one file,
# built with its start and its link with lib_compression
# (mkfiles/mklibs; for Plan 9, run mini-mk O=5 OS=plan9)
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/utilities/archive
MADE=`{mkdir -p $D}
LIBDIRS=lib_compression
<$TOP/mkfiles/mklibs
INCLUDES=-I . $LIBI $STDI
LIBS=$LIBA $STDOBJS $STDEND $TOP/mkfiles/mkconfig

all:V: $D/mini-tar $D/mini-gzip $D/mini-gunzip

$D/%.$O: %.ml $LIBSRC
	$ML $INCLUDES -o $target $stem.ml
$D/mini-tar: $D/Tar.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $LIBA $D/Tar.$O $STDEND
$D/mini-gzip: $D/Gzip.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $LIBA $D/Gzip.$O $STDEND
$D/mini-gunzip: $D/Gunzip.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $LIBA $D/Gunzip.$O $STDEND

clean:V:
	rm -rf $D
