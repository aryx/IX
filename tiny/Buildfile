	ml -nostdlib -o $target $prereq
ed: $CRT $MLRT ed.o TinyLibSystem/tinykernel/TinyLibSystem.o TinyLibRegex.o \
    TinyEditorLine.o $LIBO $MLEND
	ld -map -s -n -o $target $prereq

# db
