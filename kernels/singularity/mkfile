# This mkfile builds mini-singularity for the Pi 4, or for the Pi 1 with
# mini-mk O=5, with ix's tools: mini-ml, mini-cc, mini-asm and mini-ld
# (docs/plans/done/plan_system_singularity.md). Everything it is made
# of is in this directory, and this mkfile lists all of it: its own
# files, and under machine/ the files it shares with the other kernels.
# Each of those is a symbolic link (ls -l machine shows where it
# points). Only the language lives outside: mini-ml's runtime and the
# standard library.
#   mini-mk          builds _mk/7/kernels/singularity/kernel8.img
#                    (with O=5, _mk/5/kernels/singularity/kernel.img)
#   mini-mk run      runs it under mini-qemu (Ctrl-A x quits)
#   mini-mk check    runs a session at its shell, under mini-qemu and QEMU
#   ./numbers.sh     measures what a call, a yield, a message and a
#                    process cost
TOP=../..
# (Its recipes are still sh's, hence MKSHELL=sh, while the other
# mkfiles' recipes are rc's, as mkfiles/mkconfig sets; see
# docs/plans/plan_self_hosting.md.)
MKSHELL=sh
DIR=kernels/singularity
<$TOP/mkfiles/mkconfig

# The machine decides the board: the Pi 4 for arm64, the Pi 1 for arm.
BOARD=`{case $O in 5) echo pi1;; 7) echo pi4;; esac}
ARCH=`{case $O in 5) echo arm;; 7) echo arm64;; esac}
M=machine
BD=$M/$BOARD
# The board's assembly: the Pi 1's l1.s defines its numbers, then
# includes l.s, while the Pi 4's l.s is complete by itself.
LS=`{case $O in 5) echo l1.s;; 7) echo l.s;; esac}
D=$B/$DIR

# the kernel's modules, in the order they start, after the machine's
KERNEL=Contract Programs Exchange Channel Process Abi Main
# The processes' programs. Each is a directory of programs/ (with its
# Main.ml), listed in the order Main names them, and each becomes an
# image of its own inside the kernel's image.
PROGRAMS=init console shell hello tick tock ping pong rogue selftest crash bench nothing
# The contracts. Each is a module of contracts/ written on top of
# lib/Contract and lib/Sip, and every program links them, in this order.
CONTRACTS=Pong Intro Console
# (Pong's module is written by hand, to be read. mini-singml, in
# singml/, makes the others from their declaration, a .contract file.)
HAND=Pong
MADE=Intro Console
UNITS=Machine $KERNEL
LIBDIRS=system core base collections printing parsing concurrency
MLI=-I . -I lib -I $M -I $D ${LIBDIRS:%=-I $TOP/lib_core/%}
STDOBJS=${STD:%=$L/%.$O}

# The C code comes from the board and from the kernels' machine/, and
# runs on top of mini-ml's runtime and ix's C library.
RT=$TOP/languages/ml/runtime
LIBC=$TOP/lib_core/libc
CINC=-I$LIBC/include -I$LIBC/include/utf -I$LIBC -I$LIBC/include/arch/$ARCH -D$ARCH -Dlinux
KINC=$CINC -I$RT -I$BD
KH=$RT/mlvalues.h $RT/callback.h $RT/memory.h $RT/alloc.h $BD/board.h
# The kernel's heap has two halves of 1M words, and its value stack has
# 1 MB. The words are quoted because, after a variable's =, mk reads a
# word before another = as attributes.
HEAP='-DMAXHEAP=1048576' '-DSTACK=131072'
# A process's heap has two halves of 256k words, and its value stack
# has 64k.
PHEAP='-DMAXHEAP=262144' '-DSTACK=65536'

# The image: its name (the one the firmware looks for on each board),
# the address of its text (where the board loads it, in the kernel's
# half), its entry point, and the size of a word of its data.
IMAGE=$D/`{case $O in 5) echo kernel.img;; 7) echo kernel8.img;; esac}
KTEXT=`{case $O in 5) echo 0x80008000;; 7) echo 0xffffff8000080000;; esac}
ENTRY=`{case $O in 5) echo _start;; 7) echo vectors;; esac}
WORD=`{case $O in 5) echo 4;; 7) echo 8;; esac}
# Where the programs are linked: the first at 128 MB of the RAM, and
# the next ones 16 MB apart. The kernel's own memory ends below 96 MB,
# where the exchange heap is (see Exchange). A slot holds a program's
# text, data and bss, and the bss is its heap; Process refuses a
# program that is larger. The addresses are the RAM's as the kernel
# sees it: KHIGH's digits, then eight digits for KLOW plus the address,
# because the shell's numbers stop short of the Pi 4's addresses.
KHIGH=`{case $O in 5) echo 0x;; 7) echo 0xffffff80;; esac}
KLOW=`{case $O in 5) echo 0x80000000;; 7) echo 0;; esac}
PFIRST=0x8000000
PSLOT=0x1000000
# the emulators' arguments, and which QEMU to run
BOOT=`{case $O in 5) echo '-M raspi1ap -device loader,file='$IMAGE',addr=0x8000,cpu-num=0,force-raw=on';; 7) echo '-cpu cortex-a72 -M raspi4b -m 2G -kernel '$IMAGE;; esac}
QEMU=`{case $O in 5) echo qemu-system-arm;; 7) echo /home/pad/work/TOOLCHAINS/qemu/build/qemu-system-aarch64;; esac}
MINIQEMU=$TOP/_build/default/raspberry/Main.exe

all:V: $IMAGE

# The OCaml code: machine/'s module has a rule by its name, and the
# kernel's modules share one rule with %.
LOCAL=`{ls *.ml *.mli}
MSRC=`{ls $M/*.ml $M/*.mli}
$D/Machine.$O: $MSRC
	mkdir -p $D
	$ML $MLI -o $target $M/Machine.ml
$D/%.$O: %.ml $LOCAL $MSRC
	mkdir -p $D
	$ML $MLI -o $target $stem.ml
# The programs, as the kernel sees them: the names in PROGRAMS, as an
# OCaml array, and for each program what its manifest asks of the
# machine. mini-singml reads the manifest, programs/x/Main.manifest; a
# program without one asks for nothing.
MANIFESTS=`{ls programs/*/Main.manifest}
$D/Programs.$O: mkfile $MANIFESTS
	mkdir -p $D
	manifest() { m=programs/$1/Main.manifest; [ -f $m ] || m=/dev/null; echo $m; }
	(echo "(* the mkfile's PROGRAMS, and their manifests *)"
	 echo 'type grant = Registers of int * int | Interrupt of int'
	 echo 'let names : string array = [|'; for p in $PROGRAMS; do echo "  \"$p\";"; done; echo '|]'
	 echo 'let grants : grant list array = [|'; for p in $PROGRAMS; do echo "  `mini-singml -grants \`manifest $p\``;"; done; echo '|]') > $D/Programs.ml
	$ML $MLI -o $target $D/Programs.ml
$D/start.$O: mkfile $TOP/mkfiles/mkconfig
	mkdir -p $D
	$ML -start $STD $UNITS Std_exit -o $target

# the C and the assembly
$D/rt.$O: $RTSRC mkfile
	mkdir -p $D
	$CC $CINC $HEAP -o $target $RT/runtime.c
$D/kruntime.$O: $M/runtime.c $KH
	mkdir -p $D
	$CC $KINC -o $target $M/runtime.c
$D/usb_c.$O: $M/usb.c $KH
	mkdir -p $D
	$CC $KINC -o $target $M/usb.c
$D/machine_c.$O: $BD/machine.c $M/machine.c $KH
	mkdir -p $D
	$CC $KINC -o $target $BD/machine.c
$D/shim.$O: $M/shim.c $BD/board.h
	mkdir -p $D
	$CC $KINC -o $target $M/shim.c
$D/l.$O: $BD/$LS $BD/l.s
	mkdir -p $D
	$AS -o $target $BD/$LS

# the crossing, on the kernel's side
$D/cross.$O: cross.c $KH
	mkdir -p $D
	$CC $KINC -o $target cross.c
$D/crossl.$O: cross_$ARCH.s
	mkdir -p $D
	$AS -o $target cross_$ARCH.s

# A process's program: its Main comes after the standard library and
# Sip (in lib/, the kernel's calls), and before the run-time system,
# which has its own heap (PHEAP). It runs on top of lib/'s start and
# system, where sip.c takes the place of Linux's calls. It is linked at
# its slot's address, with the start first, because the image's first
# bytes are its entry.
$D/sipl.$O: lib/start_$ARCH.s
	mkdir -p $D
	$AS -o $target lib/start_$ARCH.s
$D/sip.$O: lib/sip.c
	mkdir -p $D
	$CC $CINC -I$RT -o $target lib/sip.c
# (The kernel uses this malloc too, because the C library's has 64 MB
# of bss.)
$D/malloc.$O: lib/malloc.c
	mkdir -p $D
	$CC $CINC -o $target lib/malloc.c
# (The kernel uses this Contract too, so there is one description of a
# contract.)
$D/Contract.$O: lib/Contract.ml lib/Contract.mli
	mkdir -p $D
	$ML $PMLI -o $target lib/Contract.ml
$D/Sip.$O: lib/Sip.ml lib/Sip.mli lib/Contract.mli
	mkdir -p $D
	$ML $PMLI -o $target lib/Sip.ml
CSRC=`{ls contracts/*}
CMADE=${MADE:%=$D/%.ml}
${HAND:%=$D/%.$O}: $CSRC lib/Sip.mli lib/Contract.mli
	mkdir -p $D
	for t in $target; do
		$ML $PMLI -o $t contracts/`basename $t .$O`.ml || exit 1
	done
$CMADE: $CSRC
	mkdir -p $D
	for t in $target; do
		mini-singml -o $D contracts/`basename $t .ml`.contract || exit 1
	done
${MADE:%=$D/%.$O}: $CMADE $CSRC lib/Sip.mli lib/Contract.mli
	for t in $target; do
		$ML $PMLI -o $t $D/`basename $t .$O`.ml || exit 1
	done
$D/prt.$O: $RTSRC mkfile
	mkdir -p $D
	$CC $CINC $PHEAP -o $target $RT/runtime.c
$D/pstart.$O: mkfile $TOP/mkfiles/mkconfig
	mkdir -p $D
	$ML -start $STD Contract Sip $CONTRACTS Given Main Std_exit -o $target
PMLI=-I lib -I contracts -I $D ${LIBDIRS:%=-I $TOP/lib_core/%}
POBJS=$D/sipl.$O $D/sip.$O $D/malloc.$O $D/pstart.$O $STDOBJS $D/Contract.$O $D/Sip.$O ${CONTRACTS:%=$D/%.$O}
PEND=$L/std_exit.$O $D/prt.$O $L/libc.a
# (A program's own code is checked first, so that nothing in it could
# reach another program's memory. lib/ and the contracts are not its
# own code.)
# (Each program has a module Given, with what its manifest names and
# the endpoints its parent gave it. mini-singml makes one for each
# program.)
$D/g_%.given: programs/%/Main.ml lib/Sip.mli $MANIFESTS mkfile
	mkdir -p $D/g_$stem
	m=programs/$stem/Main.manifest; [ -f $m ] || m=/dev/null
	mini-singml -given -o $D/g_$stem $m
	$ML $PMLI -o $target $D/g_$stem/Given.ml
$D/p_%.sip: programs/%/Main.ml lib/Sip.mli $CSRC $CMADE $D/g_%.given
	mkdir -p $D
	mini-singml -safe -allow Given `for c in $CONTRACTS; do echo -allow $c; done` programs/$stem/Main.ml
	$ML -I $D/g_$stem $PMLI -o $target programs/$stem/Main.ml
$D/p_%.img: $D/p_%.sip $D/g_%.given $POBJS $PEND mkfile
	i=0; for p in $PROGRAMS; do [ $p = $stem ] && break; i=$((i + 1)); done
	$LD -H0 -T `printf '%s%08x' $KHIGH $(($KLOW + $PFIRST + i * $PSLOT))` -E _sipstart -nofollow -o $target $POBJS $D/g_$stem.given $D/p_$stem.sip $PEND

# The console's font and the programs go inside the kernel, and
# mini-asm -data puts each file's bytes in one DATA. The programs'
# table (cross.c's sip_images) gives, for each program, the address of
# its copy, its size in bytes, the address it is linked at, and its
# slot's size in bytes. There is also the disk that machine.c names.
# This kernel has none, so it is one word, and its size is 0.
PIMAGES=${PROGRAMS:%=$D/p_%.img}
$D/images.$O: $M/font1.bin $PIMAGES mkfile
	mkdir -p $D
	word() { echo "DATA	$1+$(($2 * $WORD))(SB)/$WORD, \$$3"; }
	(echo "GLOBL	fs_image+0(SB), \$$WORD"
	 word fs_image_size 0 0; echo "GLOBL	fs_image_size+0(SB), \$$WORD"
	 i=0
	 for p in $PROGRAMS; do
		word sip_images $((4 * i)) "sip_image$i+0(SB)"
		word sip_images $((4 * i + 1)) `wc -c < $D/p_$p.img | tr -d ' '`
		word sip_images $((4 * i + 3)) $PSLOT
		word sip_images $((4 * i + 2)) `printf '%s%08x' $KHIGH $(($KLOW + $PFIRST + i * $PSLOT))`
		i=$((i + 1))
	 done
	 echo "GLOBL	sip_images+0(SB), \$$((4 * i * $WORD))"
	 word sip_nimages 0 $i; echo "GLOBL	sip_nimages+0(SB), \$$WORD") > $D/images.s
	$AS -data font_image=$M/font1.bin `i=0; for p in $PROGRAMS; do echo -data sip_image$i=$D/p_$p.img; i=$((i + 1)); done` -o $target $D/images.s

# (l comes first, because its vectors, or on the Pi 1 its start, are
# the image's first bytes.)
OBJS=$D/l.$O $D/shim.$O $D/machine_c.$O $D/kruntime.$O $D/usb_c.$O $D/cross.$O $D/crossl.$O $D/malloc.$O $D/images.$O $D/start.$O $STDOBJS ${UNITS:%=$D/%.$O} $L/std_exit.$O $D/rt.$O $L/libc.a
$IMAGE: $OBJS
	$LD -H0 -T $KTEXT -E $ENTRY -nofollow -o $target $OBJS

run:V: $IMAGE
	$MINIQEMU $BOOT -nographic

# check runs a session at the shell, under mini-qemu and QEMU. It types
# lines on the serial line (tests/session.cmds) and compares what the
# console shows (tests/session.expected). The session runs the shell's
# own commands, some programs and one that fails, and selftest, a
# program that tries the kernel: processes running together, a
# contract kept and one broken, and a block that changes hands.
check:V: $IMAGE
	session() { tests/session.py --prompt 'sing> ' --until 'no process left.' --timeout 300 --out $D/$1.txt --lines tests/session.cmds -- $2 $BOOT -nographic > /dev/null 2>&1; }
	session mini-qemu $MINIQEMU & session QEMU $QEMU & wait
	for e in mini-qemu QEMU; do
		(cat $D/$e.txt; echo) | tr -d '\r' | sed '/^$/d' | grep -v '^qemu-system' | diff - tests/session.expected && echo "ok mini-singularity $BOARD: a session at its shell under $e"
	done

clean:V:
	rm -rf $D

# mkfiles/mkdepend gives the units' order
INCLUDES=$MLI
DEPOBJ=D
DEPDIRS=. $M $D
DEPUNITS=$UNITS
<$TOP/mkfiles/mkdepend
