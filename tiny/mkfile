# The tiny programs that run on the host, built by ix's tools: each one
# file (and for the CPUs their library's, for tiny-vcs SHA-1 and zlib),
# with its start and its link, on m-ix's library: lib_core/'s standard
# library and its commons/, and lib_crypto's SHA-1 (mkfiles/mklibs).
# TinyKernel.ml is not here: tiny-ml compiles it, for tiny-machine.
# What is built is under _mk/$O/tiny.
# (old: on arm64 by default on TinyLibHost/, t-ix's trimmed copy of
# lib_core/ with its own runtime and C library, LIB=core for lib_core;
# gone with plan_tiny_self_hosting.md's step 2: it had shown what of
# lib_core/ the tiny programs use)
TOP=..
<$TOP/mkfiles/mkconfig
D=$B/tiny
LIBDIRS=lib_crypto
<$TOP/mkfiles/mklibs
# (the host's TinyLibSystem first: TinyKernel/libml/'s is tiny-ml's)
INCLUDES=-I TinyKernel/host -I . -I $D -I TinyMachine -I TinyKernel -I ../lib_crypto $STDI
START=$ML -start $STD $COMMONS
LINK=$LD -H7 -nofollow
LIBS=$STDOBJS $STDEND $TOP/mkfiles/mkconfig
PROGS=tiny-build tiny-shell tiny-utils tiny-editor tiny-c tiny-ml tiny-assembler tiny-linker tiny-db tiny-vcs tiny-cpu tiny-machine tiny-prof tiny-mkfs

all:V: ${PROGS:%=$D/%}

# (each unit alone: none names another, but TinyCPU and TinyMachine their libraries,
# and TinyMachine TinyKernelNetwork, the other end of its wire)
$D/%.$O: %.ml
	mkdir -p $D
	$ML $INCLUDES -o $target $stem.ml

$D/TinyMachineCPU.$O $D/TinyAssembler.$O $D/TinyLinker.$O $D/TinyCPU.$O $D/TinyMachineDevices.$O $D/TinyMachine.$O: TinyMachine/TinyMachineISA.ml
$D/TinyCPU.$O $D/TinyMachineDevices.$O $D/TinyMachine.$O: TinyMachine/TinyMachineCPU.ml
$D/TinyAssembler.$O $D/TinyLinker.$O $D/TinyC.$O $D/TinyML.$O: $D/TinyLibSystem.$O
$D/TinyMachine.$O: TinyMachine/TinyMachineDevices.ml TinyKernel/TinyKernelNetwork.ml TinyMachine/TinyMachinePeer.ml
$D/TinyMachinePeer.$O: TinyKernel/TinyKernelNetwork.ml

# (a blank line above: a # line right under a rule's head is its recipe,
# and TinyMachinePeer's object was never compiled)
# (tiny-machine's parts are in TinyMachine/, the kernel's stack, which
# is the wire's other end, in TinyKernel/)
$D/TinyMachine%.$O: TinyMachine/TinyMachine%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target TinyMachine/TinyMachine$stem.ml
$D/TinyKernelNetwork.$O: TinyKernel/TinyKernelNetwork.ml
	mkdir -p $D
	$ML $INCLUDES -o $target TinyKernel/TinyKernelNetwork.ml

# (tiny-mkfs is t6's, a step before tiny-kernel: its file is there)
$D/TinyMkfs.$O: TinyKernel/steps/t6/TinyMkfs.ml
	mkdir -p $D
	$ML $INCLUDES -o $target TinyKernel/steps/t6/TinyMkfs.ml

$D/TinyBuildSystem.$O: $D/TinyLibSystem.$O TinyBuildSystem.ml
$D/tiny-build: $LIBA $D/TinyLibSystem.$O $D/TinyBuildSystem.$O $LIBS
	$START Sha1 TinyLibSystem TinyBuildSystem Std_exit -o $D/TinyBuildSystem.start.$O
	$LINK -o $target $D/TinyBuildSystem.start.$O $STDOBJS $LIBA $D/TinyLibSystem.$O $D/TinyBuildSystem.$O $STDEND
# (the shell's system, the host's: TinyKernel/host/TinyLibSystem.ml;
# TinyKernel/libml/TinyLibSystem.ml is tiny-machine's, tiny-ml's to
# compile. Not beside TinyShell.ml: mini-ml looks for a module in the
# directory of the file it compiles before any -I)
$D/TinyLibSystem.$O: TinyKernel/host/TinyLibSystem.ml
	mkdir -p $D
	$ML $INCLUDES -o $target TinyKernel/host/TinyLibSystem.ml
$D/TinyShell.$O: $D/TinyLibSystem.$O TinyShell.ml
$D/tiny-shell: $D/TinyLibSystem.$O $D/TinyShell.$O $LIBS
	$START TinyLibSystem TinyShell Std_exit -o $D/TinyShell.start.$O
	$LINK -o $target $D/TinyShell.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyShell.$O $STDEND
# (the utilities, on the same TinyLibSystem as the shell, and
# TinyLibRegex for grep)
$D/TinyUtilities.$O: $D/TinyLibSystem.$O $D/TinyLibRegex.$O TinyUtilities.ml
$D/tiny-utils: $D/TinyLibSystem.$O $D/TinyLibRegex.$O $D/TinyUtilities.$O $LIBS
	$START TinyLibSystem TinyLibRegex TinyUtilities Std_exit -o $D/TinyUtilities.start.$O
	$LINK -o $target $D/TinyUtilities.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyLibRegex.$O $D/TinyUtilities.$O $STDEND
# (the line editor, on the same TinyLibSystem as the shell and the
# same TinyLibRegex as grep: it is tiny-kernel's ed and sam too)
$D/TinyEditorLine.$O: $D/TinyLibSystem.$O $D/TinyLibRegex.$O TinyEditorLine.ml
$D/tiny-editor: $D/TinyLibSystem.$O $D/TinyLibRegex.$O $D/TinyEditorLine.$O $LIBS
	$START TinyLibSystem TinyLibRegex TinyEditorLine Std_exit -o $D/TinyEditorLine.start.$O
	$LINK -o $target $D/TinyEditorLine.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyLibRegex.$O $D/TinyEditorLine.$O $STDEND
$D/tiny-c: $D/TinyLibSystem.$O $D/TinyC.$O $LIBS
	$START TinyLibSystem TinyC Std_exit -o $D/TinyC.start.$O
	$LINK -o $target $D/TinyC.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyC.$O $STDEND
$D/tiny-ml: $D/TinyLibSystem.$O $D/TinyML.$O $LIBS
	$START TinyLibSystem TinyML Std_exit -o $D/TinyML.start.$O
	$LINK -o $target $D/TinyML.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyML.$O $STDEND
$D/tiny-assembler: $D/TinyLibSystem.$O $D/TinyMachineISA.$O $D/TinyAssembler.$O $LIBS
	$START TinyLibSystem TinyMachineISA TinyAssembler Std_exit -o $D/TinyAssembler.start.$O
	$LINK -o $target $D/TinyAssembler.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyMachineISA.$O $D/TinyAssembler.$O $STDEND
$D/tiny-linker: $D/TinyLibSystem.$O $D/TinyMachineISA.$O $D/TinyLibSymbols.$O $D/TinyLinker.$O $LIBS
	$START TinyLibSystem TinyMachineISA TinyLibSymbols TinyLinker Std_exit -o $D/TinyLinker.start.$O
	$LINK -o $target $D/TinyLinker.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyMachineISA.$O $D/TinyLibSymbols.$O $D/TinyLinker.$O $STDEND
$D/TinyDatabase.$O: $D/TinyLibSystem.$O TinyDatabase.ml
$D/tiny-db: $D/TinyLibSystem.$O $D/TinyDatabase.$O $LIBS
	$START TinyLibSystem TinyDatabase Std_exit -o $D/TinyDatabase.start.$O
	$LINK -o $target $D/TinyDatabase.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyDatabase.$O $STDEND
$D/TinyVCS.$O: $D/TinyLibSystem.$O TinyVCS.ml
$D/tiny-vcs: $LIBA $D/TinyLibSystem.$O $D/TinyVCS.$O $LIBS
	$START Sha1 TinyLibSystem TinyVCS Std_exit -o $D/TinyVCS.start.$O
	$LINK -o $target $D/TinyVCS.start.$O $STDOBJS $LIBA $D/TinyLibSystem.$O $D/TinyVCS.$O $STDEND
$D/tiny-cpu: $D/TinyMachineISA.$O $D/TinyMachineCPU.$O $D/TinyCPU.$O $LIBS
	$START TinyMachineISA TinyMachineCPU TinyCPU Std_exit -o $D/TinyCPU.start.$O
	$LINK -o $target $D/TinyCPU.start.$O $STDOBJS $D/TinyMachineISA.$O $D/TinyMachineCPU.$O $D/TinyCPU.$O $STDEND
$D/tiny-machine: $D/TinyMachineISA.$O $D/TinyMachineCPU.$O $D/TinyMachineDevices.$O $D/TinyKernelNetwork.$O $D/TinyMachinePeer.$O $D/TinyMachine.$O $LIBS
	$START TinyMachineISA TinyMachineCPU TinyMachineDevices TinyKernelNetwork TinyMachinePeer TinyMachine Std_exit -o $D/TinyMachine.start.$O
	$LINK -o $target $D/TinyMachine.start.$O $STDOBJS $D/TinyMachineISA.$O $D/TinyMachineCPU.$O $D/TinyMachineDevices.$O $D/TinyKernelNetwork.$O $D/TinyMachinePeer.$O $D/TinyMachine.$O $STDEND
$D/TinyProfiler.$O $D/TinyLinker.$O: $D/TinyLibSymbols.$O
$D/TinyProfiler.$O: $D/TinyLibSystem.$O TinyProfiler.ml
$D/tiny-prof: $D/TinyLibSystem.$O $D/TinyLibSymbols.$O $D/TinyProfiler.$O $LIBS
	$START TinyLibSystem TinyLibSymbols TinyProfiler Std_exit -o $D/TinyProfiler.start.$O
	$LINK -o $target $D/TinyProfiler.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyLibSymbols.$O $D/TinyProfiler.$O $STDEND
$D/tiny-mkfs: $D/TinyMkfs.$O $LIBS
	$START TinyMkfs Std_exit -o $D/TinyMkfs.start.$O
	$LINK -o $target $D/TinyMkfs.start.$O $STDOBJS $D/TinyMkfs.$O $STDEND

clean:V:
	rm -rf $D
