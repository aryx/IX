// ~/github/ocaml-elm-playground; its guidelines:
// docs/claude_notes/codemapconfig_guidelines.md there)
//
// A tiny program is one file: its skeleton is its own pipeline, from
// its main down to the idea it keeps. [chain] makes one from a list of
// [anchor, role, what flows into it] (the first's third is unused),
// each step joined to the next; a branch is added with bones+ and
// joints+.
local chain(name, steps) = {
  name: name,
  bones: [{ at: s[0], role: s[1] } for s in steps],
  joints: [{ from: steps[i][0], to: steps[i + 1][0], say: steps[i + 1][2] } for i in std.range(0, std.length(steps) - 2)],
};
