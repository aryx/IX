[('type', 'rio'),
 ('move', 100, 60),
 ('buttons', [('down', 'right')]),
 ('buttons', [('up', 'right')]),
 ('buttons', [('down', 'right'), ('move', 500, 300), ('up', 'right')]),
 ('move', -100, -80),
 ('buttons', [('down', 'middle'), ('move', 0, 51), ('up', 'middle')]),
 ('type', 'seq 1 30'),
 ('key', 'down'),
 ('key', 'down'),
 ('type', 'echo scroll > /dev/wctl'),
 ('type', 'cat /dev/wctl'),
 ('type', 'echo resize -dx 600 -dy 330 > /dev/wctl'),
 ('type', 'echo move -minx 300 -miny 200 > /dev/wctl'),
 ('type', 'ls /mnt/wsys; echo $wsys'),
 ('type', 'mkdir /tmp/w; mount $wsys /tmp/w 1; cat /tmp/w/label /tmp/w/wctl'),
 ('type', 'wc -c /dev/screen /dev/window'),
 ('type', 'echo new -r 700 400 1000 560 echo made by wctl > /dev/wctl; sleep 3; echo current > /dev/wctl'),
 ('type', 'echo bottom > /dev/wctl; sleep 3; echo top > /dev/wctl'),
 ('type', 'echo hide -id 2 > /dev/wctl'),
 ('type', 'echo unhide -id 2 > /dev/wctl; sleep 3; echo current > /dev/wctl'),
 ('type', 'echo delete -id 2 > /dev/wctl; echo done')]
