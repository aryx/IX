WINDOWS_UNITS = $SYS $DRAWLIB TinyWindows.o user/windows.o
windows.start.o: $STDLIB $WINDOWS_UNITS
windows: $CRT $MLRT windows.start.o $STDLIB $WINDOWS_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

EMACS_UNITS = $SYS $DRAWLIB $PLAYGROUND $GUI TinyEditorScreen.o user/emacs.o
emacs.start.o: $STDLIB $EMACS_UNITS
emacs: $CRT $MLRT emacs.start.o $STDLIB $EMACS_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

# (the parts that office and troff share)
OFFICE_INCLUDES = -I TinyOffice
OFFICE_PARTS = TinyOffice/Model.o TinyOffice/Text.o TinyOffice/Sheet.o \
