; TinyBrowser.ml's parts (tiny-ml compiles them before it, for www on
; tiny-kernel): the reading of a page into lines, its test's on the
; host (../tests/TinyBrowser_tests/), the addresses, and the HTTP www and
; the wire's other end speak
(library
 (name tiny_browser_parts)
 (wrapped false)
 (modules Strings Charset Tokens Lines Html Url Http))

; TinyBrowser.ml's screen: what it shows, drawn by TinyLibGUI's and the
; kernel's drawing messages (apart from the parts above, which the wire's
; other end links too, with no TinyLibSystem)
(library
 (name tiny_browser_screen)
 (wrapped false)
 (modules Screen)
 (libraries tiny_lib_gui tiny_browser_parts))
