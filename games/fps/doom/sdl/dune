; mini-doom in a window on Linux (SDL): ../Doom.ml, the same text,
; linked with the platform that has a window
; (lib_playground/platforms/sdl). Dune's alone: SDL is outside what
; mini-ml compiles, as Tetris's window.
;   dune exec games/fps/doom/sdl/Doom.exe       (wad=, map=, scale=: Doom.ml)
(copy_files ../Doom.ml)
(executable
 (name Doom)
 (public_name mini-doom)
 (package ix)
 (libraries ix_doom ix_playground ix_playground_sdl ix_graphics_core ix_core fpath caps unix))
(include_subdirs no)
