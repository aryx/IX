#
# tiny-machine: a kernel of tiny-os booted on tiny-machine
# (tiny/TinyMachine.ml), as mini-pi boots the Pi's kernels on mini-qemu;
# built first, with the tools of ix's checkout.
#
#   ./tiny-machine v6          tiny-os v6 (tiny/tiny-os/v6/): xv6's kind
#                              of kernel in C, its disk, the shell on
#                              the console
#   ./tiny-machine t6          tiny-os t6 (tiny/tiny-os/t6/): v6's free
#                              variant (spawn, a FAT, one kernel stack)
#   ./tiny-machine tiny-kernel tiny/TinyKernel.ml: a free kernel in ML
#                              (fork and exec, round robin, blocking by
#                              closures, the files ML values in memory)
#   ./tiny-machine v0          tiny-os v0 (tiny/tiny-os/v0/): a page of
#                              assembly and its four programs
#   ./tiny-machine kernel.tm prog.tm...
#                              a kernel of yours (first) and its programs
#
# Options:
#   -window  tiny-kernel: its screen in a window (640 by 480; the mouse
#        and the keys in it are the machine's). The console stays this
#        terminal, where the first shell is typed at: tiny-windows is
#        the window system (the right button: New, then a rectangle
#        swept with the left one; a shell in it), paint a program that
#        draws, on the screen or in a window, square a game of a page
#        (the arrows)
#   -l   the listing of the kernel's image instead of running it
#   -w   v6, t6: write to its disk, fs.img (by default a copy, its writes
#        lost at exit, as mini-pi's snapshot)
#   -n   no build (the tools and the kernel as last built)
#
# Ctrl-C is the kernel's (tiny-kernel: the program running killed),
# Ctrl-\ quits tiny-machine. Quit v6 or t6 with Ctrl-D: the shell's
# input ends, then init, and the machine halts. This script is not
# installed: bin/tiny-machine is the machine itself, which does each
# step (-o to link, an image to run, -d a disk).

set -e
ROOT=$(dirname "$(readlink -f "$0")")
listing=0; build=1; write=0

# alone, what it runs; --help, the options too
kernels() { sed -n '/^# tiny-machine:/,/^# Options:/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'; echo "(./tiny-machine --help: the options)"; exit 2; }
usage() { sed -n '/^# tiny-machine:/,/^# step (-o to link/p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

[ "$1" = --help ] && usage
window=; [ "$1" = -window ] && { window=-window; shift; }
while getopts lwnh o; do
  case $o in l) listing=1;; w) write=1;; n) build=0;; *) usage;; esac
done
shift $((OPTIND - 1))
[ $# = 0 ] && kernels

B=$ROOT/_build/default/tiny
machine=$B/TinyMachine.exe
say() { echo "tiny-machine: $*" >&2; }
short() { local f; for f in "$@"; do f=$(readlink -f "$f"); echo -n "${f#$ROOT/} "; done; }

if [ $build = 1 ]; then
  (cd $ROOT && dune build ./tiny/TinyMachine.exe ./tiny/TinyC.exe ./tiny/TinyCPU.exe ./tiny/TinyMkfs.exe ./tiny/TinyML.exe 2>&1) || exit 1
  # (the window is a program apart: the one that links SDL)
  [ -z "$window" ] || (cd $ROOT && dune build ./tiny/TinyMachineWindow.exe 2>&1) || exit 1
fi

case $1 in
  v6|t6)
    dir=$ROOT/tiny/tiny-os/$1
    if [ $build = 1 ]; then
      make -s -C $dir TC=$B/TinyC.exe CPU=$B/TinyCPU.exe MACHINE=$machine MKFS=$B/TinyMkfs.exe kernel.img fs.img >&2 || exit 1
    fi
    image=$dir/kernel.img
    disk=$dir/fs.img
    if [ $write = 0 ]; then cp $disk $B/fs-run.img; disk=$B/fs-run.img; mode="a copy: its writes lost at exit (-w to keep them)"; else mode="written in place"; fi
    say "kernel:  $(short $image)($(stat -c %s $image) bytes; built from $(short $dir))"
    say "disk:    $(short $dir/fs.img)($(( $(stat -c %s $dir/fs.img) / 1024 )) KB, $mode)"
    say "console: this terminal; Ctrl-D ends the shell, and the machine"
    if [ $listing = 1 ]; then exec $machine -l $image; fi
    say "command: $(short $machine)-d $(short $disk)$(short $image)"
    exec $machine -d $disk $image
    ;;
  tiny-kernel)
    # no disk: the programs come in the image, after the kernel, and
    # what they write lives in memory until the halt
    dir=$ROOT/tiny/TinyKernel
    if [ $build = 1 ]; then
      make -s -C $dir TML=$B/TinyML.exe TC=$B/TinyC.exe CPU=$B/TinyCPU.exe MACHINE=$machine boot.img >&2 || exit 1
    fi
    image=$dir/boot.img
    say "kernel:  $(short $dir/kernel.img)($(stat -c %s $dir/kernel.img) bytes; built from $(short $dir)), its programs after it"
    say "console: this terminal; Ctrl-D ends the shell, and the machine"
    [ -z "$window" ] || say "screen:  a window (its end is the machine's); try: tiny-windows, then the right button in the window"
    if [ $listing = 1 ]; then exec $machine -l $dir/kernel.img; fi
    say "command: $(short $machine)$window $(short $image)"
    exec $machine $window $image
    ;;
  v0)
    set -- $ROOT/tiny/tiny-os/v0/kernel.tm $ROOT/tiny/tiny-os/v0/[abcd].tm
    ;;
  -*|"") usage;;
esac

# .tm files: the kernel first, at 0, then its programs
for f in "$@"; do [ -f "$f" ] || { echo "tiny-machine: no $f (a kernel's name: v0, v6, t6, tiny-kernel)" >&2; exit 1; }; done
image=$B/kernel.img
say "assemble and link: $(short $1)(the kernel, at 0)$( [ $# -gt 1 ] && echo ", then $(short "${@:2}")")"
$machine -o $image "$@"
say "image: $(short $image)($(stat -c %s $image) bytes)"
if [ $listing = 1 ]; then exec $machine -l $image; fi
say "run:   $(short $machine $image)"
exec $machine $image
