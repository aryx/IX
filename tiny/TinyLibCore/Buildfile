# The standard tiny library, a subset of OCaml's. It holds the first
# units of every ML program, kept in one library, stdlib.a, which a
# program links (ld ... stdlib.a), and their interfaces, one .tmi for
# each unit, which tiny-ml reads (ml -L TinyLibCore).
# ../Buildfile calls it with `cd TinyLibCore && build`.
#
#     build                  makes stdlib.a, and the units' .o and .tmi
#     build depend           makes .depend again, after a unit names another one
#     tiny-build TINY=tiny-  does the same on the host, with tiny-ml, tiny-ar

# The tools, by tiny-kernel's names; the host's names are given by
# TINY=tiny- (the top Buildfile gives its own, with ML=... AR=...).
TINY =
ML = ${TINY}ml
AR = ${TINY}ar

# The library's units, in the order they start in. This is their order
# in the archive, and every program links them in that order (Stdlib
# comes first, because the others call it).
CORE = Stdlib Char Seq List String Bytes Array Option Int32 Int64 \
    Filename Buffer Printf Marshal Hashtbl Common Sha1 Fpath Fpath_ Exit \
    In_channel Out_channel Chan Logs

stdlib.a: ${CORE:%=%.o}
	$AR -o $target $prereq

# A unit is compiled with the interfaces of the units it names, Stdlib's
# first, since OCaml opens it. The library is here (-L .), being made,
# and each unit is compiled after those it names, by its line in
# .depend.
%.o: %.ml
	$ML -c -L . -o $target $stem.ml
%.tmi: %.o

# the units' dependencies, written by ml -depend as ocamldep writes OCaml's
depend:
	$ML -depend -I . *.ml > .depend

<.depend

clean:
	rm -f *.o *.tmi stdlib.a
