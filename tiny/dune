(executable
 (name TinyML)
 (public_name tiny-ml)
 (package ix)
 (modules TinyML TinyMLPrelude)
 (libraries ix_core fpath caps))

; tiny-ml's prelude, a file of its ML (TinyLibCore.ml), as a
; string in a module of the compiler's
(rule
 (targets TinyMLPrelude.ml)
 (deps TinyLibCore.ml)
 (action
  (with-stdout-to
   %{targets}
   (progn
    (echo "let prelude = {|\n")
    (cat %{deps})
    (echo "|}\n")))))

; TinyLibRegex.ml, the regular expressions of grep and of tiny-editor
; (tiny-ml compiles it too, before TinyUtilities.ml and TinyEditorLine.ml)
(library
 (name tiny_lib_regex)
 (wrapped false)
 (modules TinyLibRegex))
