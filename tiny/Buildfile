#############################################################################
# The libraries: what several programs share
#############################################################################

# the system's calls, tiny-kernel's side of TinyLibSystem.mli (its unix/
# side is the host's, by dune); the machine's code (libmach: the
# instructions, the objects, the labels); the regular expressions; and
# the window's: the picture's messages, the playground (a game's loop),
# the widgets

TinyLibSystem/tinykernel/TinyLibSystem.o: $LIB
TinyLibMachine.o: $LIB
TinyLibRegex.o: $LIB TinyLibSystem/tinykernel/TinyLibSystem.tmi
TinyLibDraw.o: $LIB
TinyLibPlayground.o: $LIB TinyLibSystem/tinykernel/TinyLibSystem.tmi \
    TinyLibDraw.tmi
TinyLibGUI.o: $LIB TinyLibSystem/tinykernel/TinyLibSystem.tmi \
    TinyLibDraw.tmi TinyLibPlayground.tmi

#############################################################################
# The shell, the utilities, the editors, the stores
#############################################################################

# rc the shell; utils, cat ls grep... in one program (/bin/cat a link
# to it); ed and sam, the line editor; db and vcs, a database and a
# version control; build, this file's reader.
# Each: its units (the interfaces each reads), its main (the units'
# initializations in their order), and the program, linked: the C
# runtime, ML's, its main, its units, the library, the end.

# rc
TinyShell.o: $LIB TinyLibSystem/tinykernel/TinyLibSystem.tmi
rc.o: $LIB TinyLibSystem/tinykernel/TinyLibSystem.tmi TinyShell.tmi
	ml -nostdlib -o $target $prereq
rc: $CRT $MLRT rc.o TinyLibSystem/tinykernel/TinyLibSystem.o TinyShell.o \
    $LIBO $MLEND
	ld -map -s -n -o $target $prereq

# utils
TinyUtilities.o: $LIB TinyLibSystem/tinykernel/TinyLibSystem.tmi \
    TinyLibRegex.tmi
utils.o: $LIB TinyLibSystem/tinykernel/TinyLibSystem.tmi TinyLibRegex.tmi \
    TinyUtilities.tmi
	ml -nostdlib -o $target $prereq
utils: $CRT $MLRT utils.o TinyLibSystem/tinykernel/TinyLibSystem.o \
    TinyLibRegex.o TinyUtilities.o $LIBO $MLEND
	ld -map -s -n -o $target $prereq

# ed
