; the language, shared by the back ends: simple/ (Lower's stack
; machine, Gen), compat/ (GNU's assembly, Gas), and later opti/
; (plan_ml.md, "Later: compat/, simple/, opti/ here too")
(library
 (name ix_ml)
 (wrapped false)
 (modules Ast Lexer Parser Scope Resolve Typing)
 (preprocess (pps ppx_deriving.show))
 (libraries ix_core ix_asm fpath logs caps))

(ocamllex Lexer)

; the grammar's places are menhir's ($sloc), which mini-yacc reads too:
; menhir here, mini-yacc in the mkfile
(menhir
 (modules Parser))

; the command: the front end given its back ends
(library
 (name ix_ml_cli)
 (wrapped false)
 (modules CLI)
 (libraries ix_ml ix_ml_pp ix_ml_simple ix_ml_compat ix_ml_opti ix_ml_ssa ix_core ix_asm fpath logs caps))

(executable
 (name Main)
 (public_name mini-ml)
 (package ix)
 (modules Main)
 (libraries ix_ml_cli caps))
