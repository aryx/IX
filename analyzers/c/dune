; mini-cc's front end, and its simple back end for -flow (Lower, Opti's
; passes), compiled again here as a wrapped library
; (Ix_analyze_c.Lexer...): mini-ml's front end is in the same program,
; and both compilers have a Lexer, a Parser, an Emit in OCaml's one
; namespace of units. mini-cc's sources are copied by the build, not
; kept here; the facts' own units are (Facts, Ir_facts, C_front, C_flow).
(copy_files# ../../languages/c/{Tree,Tree_helpers,Pre,Declare,Check,Machines,Emit,Com64}.{ml,mli})
(copy_files# ../../languages/c/debug/Acid.{ml,mli})
(copy_files# ../../languages/c/simple/{Ir,Lower,Gen}.{ml,mli})
(copy_files# ../../languages/c/opti/Opti.{ml,mli})
(copy_files ../../languages/c/{Lexer.mll,Parser.mly,Lexer.mli})

(library
 (name ix_analyze_c)
 (modules Tree Tree_helpers Pre Acid Lexer Parser Declare Check Machines Emit
  Com64 Facts C_front Ir Lower Gen Opti Ir_facts C_flow)
 (preprocess (pps ppx_deriving.show))
 (libraries ix_core ix_asm fpath logs caps))

(ocamllex Lexer)

(ocamlyacc Parser)
