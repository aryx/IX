DIR=editors/emacs/draw
PROG=emacs
T=$TOP/lib_terminal
SRC=Line_discipline Vt Curses Tui Highlight_code Ast Parser Lexer Token_ml Lexer_ml Names_ml Highlight_ml Token_c Lexer_c Highlight_c Highlight_asm Highlight_st Highlight_scheme Highlight_pascal Highlight_prolog Text Efuns Globals Keymap Action Ebuffer Frame Window Top_window Move Edit Scroll Minibuffer Interactive Multi_buffers Multi_frames Copy_paste Search Highlight Indent Transform Macros Emouse Paren_mode Ocaml_mode C_mode Asm_mode Smalltalk_mode Scheme_mode Pascal_mode Prolog_mode Dired Buffer_menu Config Config_pad Start Point Rectangle Display Draw Font_default Font Mouse Keyboard Cells Window_draw Main
