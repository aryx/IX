# kernels/tools, built by ix's tools. Each program is one file, with
# its own start and link rules.
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/kernels/tools
MADE=`{mkdir -p $D}
INCLUDES=-I . $STDI
LIBS=$STDOBJS $STDEND $TOP/mkfiles/mkconfig

all:V: $D/mini-mkbootdir $D/mini-mkcard $D/mini-mkfs $D/mini-mkpixdata

$D/%.$O: %.ml
	$ML $INCLUDES -o $target $stem.ml
$D/mini-mkbootdir: $D/Mkbootdir.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Mkbootdir.$O $STDEND
$D/mini-mkcard: $D/Mkcard.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Mkcard.$O $STDEND
$D/mini-mkpixdata: $D/Mkpixdata.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Mkpixdata.$O $STDEND

# (mini-mkfs is linked with lib_xv6fs's unit, which the kernel uses
# too.)
X=../9pi/filesystems/lib_xv6fs
$D/Xv6fs.$O: $X/Xv6fs.ml $X/Xv6fs.mli
	$ML -I $X $INCLUDES -o $target $X/Xv6fs.ml
$D/Mkfs.$O: Mkfs.ml $D/Xv6fs.$O
	$ML -I $X $INCLUDES -o $target Mkfs.ml
$D/mini-mkfs: $D/Mkfs.$O $D/Xv6fs.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Xv6fs.$O $D/Mkfs.$O $STDEND

clean:V:
	rm -rf $D
