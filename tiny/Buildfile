# Claude Code, Copyright (C) 2026 Yoann Padioleau, LGPL (see TinyBuildSystem.ml)
#
# t-IX built by tiny-build, under t-IX: this file is /src/Buildfile on
# tiny-kernel's second disk, where /src is tiny/; the host builds by it
# too, in a copy of tiny/ (TinyKernel/Makefile; make self compares the
# two builds' images).
#
#     cd /src
#     build build          tiny-build itself, as /src/build, to run
#     build rc             the shell; any program by its name in /bin
#     build                every program, the kernel, the image
#     build install        the programs in /bin, /lib, /examples
#
# It is also meant to be read: how t-IX's pieces fit together, from the
# bottom up. A program stands on its own units, on the libraries
# several programs share, on the standard library (TinyLibCore/), and
# on the runtimes, what a program links besides its own code; the
# kernel stands on the same library and runtime; the image is the
# kernel and the few programs that mend a disk, the disk all the rest.
#
# What a recipe makes is beside its source: TinyShell.o and its
# interface TinyShell.tmi beside TinyShell.ml, TinyC/Parser.o in
# TinyC/; a program at the top, by its name (rc, build, ml). `build
# clean` removes them.
#
# The tools are tiny-kernel's: ml, cc, as, ld, ar, build (ML, CC...
# below). On the host they are tiny-ml, tiny-cc and so on, the same
# names after tiny-: tiny-build TINY=tiny- runs this file there (or a
# directory of links named ml, cc... first in the PATH, as
# TinyKernel/Makefile's build in its copy of tiny/). A recipe is rc's,
# on both: tiny-build runs it with tiny-shell on the host, /bin/rc on
# tiny-kernel.
#
# Two parts have their own Buildfile, run from here at each build:
# the library, TinyLibCore/, and the kernel, TinyKernel/. Each makes
# the files of its own directory, and knows which to make again.
#
# What t-IX keeps and drops as a whole is README.md's (twin:, kept:,
# dropped:, twist:). The build's own:
#
# dropped:
# - no source is made: no lex, no yacc, every lexer and parser written
#   by hand, so no rule here makes a .ml or a .c;
# - no configure, no install prefix: build install copies into /bin,
#   /lib and /examples;
# - no glob: tiny-build has none, nor mk's backquotes in a variable
#   (its .mli), so CORE, the library's units, is said here (the disk's
#   /lib/ml) and in TinyLibCore/Buildfile, and the disk's /examples is
#   rc's glob in its recipe, not prerequisites.


# the programs, by their names in /bin; then the kernel (TinyKernel/)
PROGS = sh rc emacs office troff play mltests paint windows square tetris \
    calc temp ping get put httpd utils ed bigmem www prof db vcs build as ld \
    ar cc ml trace debug

all: $PROGS kernel

# the tools, by their names on tiny-kernel; on the host tiny-ml... by
# tiny-build TINY=tiny- (or each, as tiny-build ML=../ml.exe)
TINY =
ML = ${TINY}ml
CC = ${TINY}cc
AS = ${TINY}as
LD = ${TINY}ld
AR = ${TINY}ar
BUILD = ${TINY}build


#############################################################################
# How each kind of file is made
#############################################################################
# the standard library (below): stdlib.a, which every ML program links,
# made with its units' interfaces, which every ML unit reads (-L
# TinyLibCore); CORE, its units, for what makes it again and for the
# disk's /lib/ml
CORE = Stdlib Char Seq List String Bytes Array Option Int32 Int64 \
    Filename Buffer Printf Marshal Hashtbl Common Sha1 Fpath Fpath_ Exit \
    In_channel Out_channel Chan Logs
STDLIB = TinyLibCore/stdlib.a

# an ML unit: its source alone; tiny-ml reads the library from
# TinyLibCore/ (-L) and finds the interfaces of the modules the source
# names in INCLUDES' directories (-I), each after those it stands on.
# Its prerequisites are tiny-build's alone, what must be made before it
# and what makes it again: the library (STDLIB, its interfaces made
# with it, as Plan 9's mkfiles make every object depend on all the
# headers), and the interfaces it reads, its line in .depend (at the
# end); as mini-ml in m-ix, the compiler's arguments are not its
# prerequisites. Its .tmi made with its .o. A rule for each directory
# (mk's &, a stem with no / or .): here tiny/'s own units, user/'s and
# the system's; a program with parts in a directory of their own
# (TinyML/) has its rules in its section, with its own -I's (X_INCLUDES)
# for its parts and its main file, so that two programs' parts may
# have the same names (Lexer)
INCLUDES = -I . -I TinyLibSystem/tinykernel
MLC = $ML -c -L TinyLibCore $INCLUDES
&.o: &.ml $STDLIB
	$MLC -o $target $stem.ml
user/&.o: user/&.ml $STDLIB
	$MLC -o $target user/$stem.ml
TinyLibSystem/tinykernel/&.o: TinyLibSystem/tinykernel/&.ml $STDLIB
	$MLC -o $target TinyLibSystem/tinykernel/$stem.ml
%.tmi: %.o

# an ML program's start, what only the whole program can make (its
# units' initializations in their order, their globals' table, the
# curry functions; TinyML/Link.mli): made by ml of the files the
# program links, its prerequisites, the libraries first, each
# program's line below (P.start.o: $STDLIB $P_UNITS), linked right
# after the ML runtime, which calls it
%.start.o:
	$ML -o $target $prereq

# C, by tiny-cc, its #includes found beside the file, then in runtime/c/
# (libc.h, which user.h includes); assembly written by hand, by tiny-as
# (the compilers write their objects themselves)
%.o: %.c
	$CC -I runtime/c -o $target $stem.c
%.o: %.s
	$AS -o $target $stem.s


#############################################################################
# The runtimes: what a program links besides its own code
#############################################################################

# Each language's in its directory, runtime/c/ and runtime/ml/, as the
# disk's /lib/c and /lib/ml (the TinyLibXxx.ml are libraries a
# program chooses; these, every program links).
#
# C's: _start, which calls main, then exits, linked first since the
# machine starts at 0; the unsigned division tiny-cc calls; libc, print
# and the strings; tiny-kernel's calls, sys.s, a sys instruction each;
# draw.c and net.c for the programs that draw or dial
CRT = runtime/c/start.o runtime/c/udivmod.o runtime/c/libc.o runtime/c/sys.o

# ML's: ml.c, the allocator and Cheney's collector, #included by
# mlsys.c, which gives it tiny-kernel's memory and calls; end.s, the
# program's end, where its value stack can start, linked last
MLRT = runtime/ml/mlsys.o
MLEND = runtime/ml/end.o
runtime/ml/mlsys.o: runtime/ml/mlsys.c runtime/ml/ml.c runtime/c/user.h


#############################################################################
# The standard library: TinyLibCore/, OCaml's subset
#############################################################################

# Made by its own Buildfile, TinyLibCore/Buildfile, as ocaml-light's
# stdlib by its Makefile and m-ix's libraries by their mkfiles: its
# units compiled among themselves, then kept in stdlib.a in the order
# they start in. stdlib is not a file, so it is never up to date: the
# library's build runs each time, and it knows which units to make
# again (by its digests, in TinyLibCore/.tiny-build); stdlib.a is made
# with it, as a .tmi with its .o. On the disk they are /lib/ml.
stdlib:
	cd TinyLibCore && $BUILD ML=^$ML AR=^$AR
$STDLIB: stdlib


#############################################################################
# The libraries: what several programs share
#############################################################################

# the system's calls, tiny-kernel's side of TinyLibSystem.mli (its unix/
# side is the host's, by dune); the machine's code (libmach: the
# instructions, the objects, the labels); the regular expressions; and
# the window's: the picture's messages, the playground (a game's loop),
# the widgets. Each is a whole library in one file (m-ix's are a
# directory and an archive each), so its object is a .a in spirit: one
# name in a program's link. Named in the links of the programs that use
# it, so that which program stands on which is seen below (one archive
# of them all would hide it)
SYS = TinyLibSystem/tinykernel/TinyLibSystem.o
MACH = TinyLibMachine.o
REGEX = TinyLibRegex.o
DRAWLIB = TinyLibDraw.o
PLAYGROUND = TinyLibPlayground.o
GUI = TinyLibGUI.o
#
# An ML program, in the sections below: its units (X_UNITS), its start
# made of them (X.start.o, by ml: TinyML/Link.mli), and the
# program linked by ld: the C runtime, ML's, the start, the library, its
# units, the end (the libraries before the units that use them, OCaml's
# rule). Its units' rules are .depend's (at the end).


#############################################################################
# The shell, the utilities, the editors, the stores
#############################################################################

# rc the shell; utils, cat ls grep... in one program (/bin/cat a link
# to it); ed and sam, the line editor; db and vcs, a database and a
# version control; build, this file's reader.

RC_UNITS = $SYS TinyShell.o
rc.start.o: $STDLIB $RC_UNITS
rc: $CRT $MLRT rc.start.o $STDLIB $RC_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

UTILS_UNITS = $SYS $REGEX TinyUtilities.o
utils.start.o: $STDLIB $UTILS_UNITS
utils: $CRT $MLRT utils.start.o $STDLIB $UTILS_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

ED_UNITS = $SYS $REGEX TinyEditorLine.o
ed.start.o: $STDLIB $ED_UNITS
ed: $CRT $MLRT ed.start.o $STDLIB $ED_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

DB_UNITS = $SYS TinyDatabase.o
db.start.o: $STDLIB $DB_UNITS
db: $CRT $MLRT db.start.o $STDLIB $DB_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

VCS_UNITS = $SYS TinyVCS.o
vcs.start.o: $STDLIB $VCS_UNITS
vcs: $CRT $MLRT vcs.start.o $STDLIB $VCS_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

BUILD_UNITS = $SYS TinyBuildSystem.o
build.start.o: $STDLIB $BUILD_UNITS
build: $CRT $MLRT build.start.o $STDLIB $BUILD_UNITS $MLEND
	$LD -map -s -n -a 16 -o $target $prereq

#############################################################################
# The toolchain, and the tools of the machine's code
#############################################################################

# as, ld, ar, cc and ml, which built all of this; prof, where a profile's
# instructions went; trace, a program's calls; debug, a debugger.

AS_UNITS = $SYS $MACH TinyAssembler.o
as.start.o: $STDLIB $AS_UNITS
as: $CRT $MLRT as.start.o $STDLIB $AS_UNITS $MLEND
	$LD -map -s -n -a 32 -o $target $prereq

LD_UNITS = $SYS $MACH TinyLinker.o
ld.start.o: $STDLIB $LD_UNITS
ld: $CRT $MLRT ld.start.o $STDLIB $LD_UNITS $MLEND
	$LD -map -s -n -a 64 -o $target $prereq

AR_UNITS = $SYS $MACH TinyArchiver.o
ar.start.o: $STDLIB $AR_UNITS
ar: $CRT $MLRT ar.start.o $STDLIB $AR_UNITS $MLEND
	$LD -map -s -n -a 4 -o $target $prereq

CC_INCLUDES = -I TinyC
CC_UNITS = $SYS $MACH TinyC/Types.o TinyC/Lexer.o TinyC/Tree.o \
    TinyC/Lower.o TinyC/Parser.o TinyC/Machine.o TinyC.o
TinyC/&.o: TinyC/&.ml $STDLIB
	$MLC $CC_INCLUDES -o $target TinyC/$stem.ml
TinyC.o: TinyC.ml $STDLIB
	$MLC $CC_INCLUDES -o $target TinyC.ml
cc.start.o: $STDLIB $CC_UNITS
cc: $CRT $MLRT cc.start.o $STDLIB $CC_UNITS $MLEND
	$LD -map -s -n -a 16 -o $target $prereq

ML_INCLUDES = -I TinyML
ML_UNITS = $SYS $MACH TinyML/Lexer.o TinyML/Tree.o TinyML/Formats.o \
    TinyML/Parser.o TinyML/Types.o TinyML/Machine.o TinyML/Compile.o \
    TinyML/Link.o TinyML.o
TinyML/&.o: TinyML/&.ml $STDLIB
	$MLC $ML_INCLUDES -o $target TinyML/$stem.ml
TinyML.o: TinyML.ml $STDLIB
	$MLC $ML_INCLUDES -o $target TinyML.ml
ml.start.o: $STDLIB $ML_UNITS
ml: $CRT $MLRT ml.start.o $STDLIB $ML_UNITS $MLEND
	$LD -map -s -n -a 32 -o $target $prereq

PROF_UNITS = $SYS $MACH TinyProfiler.o
prof.start.o: $STDLIB $PROF_UNITS
prof: $CRT $MLRT prof.start.o $STDLIB $PROF_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

TRACE_UNITS = $SYS TinyTracer.o user/trace.o
trace.start.o: $STDLIB $TRACE_UNITS
trace: $CRT $MLRT trace.start.o $STDLIB $TRACE_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

DEBUG_UNITS = $SYS $DRAWLIB $PLAYGROUND $GUI $MACH TinyDebugger.o \
    user/debug.o
debug.start.o: $STDLIB $DEBUG_UNITS
debug: $CRT $MLRT debug.start.o $STDLIB $DEBUG_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

