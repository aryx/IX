; (its own stanzas, not a part of lib_playground's folders)
(include_subdirs no)

; what the platforms share: a program stepped and a script's keys
; (Session, Input_script), a view's shapes drawn in a Framebuffer, the
; documents stored (Store). (Playground_platform.mli here is each
; platform's: a link to it in its directory.)
(library
 (name ix_playground_render)
 (wrapped false)
 (modules Shape_render_software Input_script Session Redraw Store)
 (libraries ix_playground ix_graphics_software ix_core caps fpath unix))

; the loop the Plan 9 platforms share (the draw device's client under it)
(library
 (name ix_playground_plan9)
 (wrapped false)
 (modules Plan9_loop)
 (libraries ix_playground ix_playground_render ix_graphics ix_threads ix_core caps unix threads.posix))
