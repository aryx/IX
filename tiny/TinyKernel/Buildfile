#
# tiny-kernel, kernel.img: TinyKernel.ml and its parts, in ML; the
# assembly ML cannot say (entry.s: the traps, the switch; draw.s and
# memory.s, the pixels' and the memory's loops); runtime.c, ML's runtime
# given the machine's memory; font.s, the font's pixels (made on the
# host by fonts/Mkfont.ml, on the image as it is); end.s, the kernel's
# end, where the files it carries start. Run by ../Buildfile at each
# build (cd TinyKernel && build), after the library, which it links
# from ../TinyLibCore.
#
#     build                  kernel.img, and its objects
#     build depend           .depend again, after a unit names another one
#     tiny-build TINY=tiny-  the same on the host, by tiny-ml...
#
# What it makes is in this directory, from its sources, so that no file
# has two Buildfiles making it (a pattern takes any name that ends as
# it says: ../runtime/udivmod.o here would be made again by this file's
# %.o).

# the tools, tiny-kernel's names, the host's by TINY=tiny- (../Buildfile
# gives its own, ML=... CC=...)
TINY =
ML = ${TINY}ml
CC = ${TINY}cc
AS = ${TINY}as
LD = ${TINY}ld

STDLIB = ../TinyLibCore/stdlib.a

all: kernel.img

# a unit, with the library's interfaces (-L) and the kernel's (-I .),
# its line in .depend; its .tmi made with its .o
%.o: %.ml $STDLIB
	$ML -c -L ../TinyLibCore -I . -o $target $stem.ml
%.tmi: %.o
%.start.o:
	$ML -o $target $prereq
%.o: %.c
	$CC -o $target $stem.c
%.o: %.s
	$AS -o $target $stem.s

# the unsigned division tiny-cc calls (runtime.c's), the kernel's own
# object of runtime/'s
udivmod.o: ../runtime/udivmod.s
	$AS -o $target ../runtime/udivmod.s
runtime.o: runtime.c ../runtime/ml.c

# the units, each after the ones it names; the kernel's start made by
# ml, as a program's (../TinyML/TinyMLLink.mli). entry.o first, at 0
UNITS = TinyMemory.o TinyKernelGraphics.o TinyKernelNetwork.o \
    TinyKernelAudio.o TinyKernelFS.o TinyKernelMemory.o TinyKernelMachine.o \
    TinyKernelFiles.o TinyKernelProcs.o TinyKernelDevices.o TinyKernelIO.o \
    TinyKernelCalls.o TinyKernelScheduler.o TinyKernel.o
kernel.start.o: $STDLIB $UNITS
kernel.img: entry.o udivmod.o runtime.o draw.o memory.o font.o \
    kernel.start.o $STDLIB $UNITS end.o
	$LD -map -o $target $prereq

# the units' dependencies, written by ml -depend
depend:
	$ML -depend -I . *.ml > .depend

<.depend

clean:
	rm -f *.o *.tmi kernel.img kernel.map
