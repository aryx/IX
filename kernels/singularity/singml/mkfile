# This mkfile builds mini-singml with ix's tools. It is built on top of
# mini-ml's parser, whose objects languages/ml makes (run mini-mk there
# first).
TOP=../../..
DIR=kernels/singularity/singml
PROG=mini-singml
SRC=Description Output Safe Manifest CLI Main
GEN=
LIBUNITS=Ast Parser Lexer
LOCAL=`{ls *.ml *.mli}
<$TOP/mkfiles/mkconfig
LIBI=-I $TOP/languages/ml -I $B/languages/ml
LIBOBJS=$B/languages/ml/Ast.$O $B/languages/ml/Parser.$O $B/languages/ml/Lexer.$O
<$TOP/mkfiles/mkprog
