# utilities/process, built by ix's tools: each program is one file, built
# with its start and its link (for Plan 9, run mini-mk O=5 OS=plan9)
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/utilities/process
MADE=`{mkdir -p $D}
INCLUDES=-I . $STDI
LIBS=$STDOBJS $STDEND $TOP/mkfiles/mkconfig

all:V: $D/mini-sleep $D/mini-ps $D/mini-time $D/mini-free $D/mini-spin

$D/%.$O: %.ml
	$ML $INCLUDES -o $target $stem.ml
$D/mini-sleep: $D/Sleep.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Sleep.$O $STDEND
$D/mini-ps: $D/Ps.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Ps.$O $STDEND
$D/mini-time: $D/Time.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Time.$O $STDEND
$D/mini-free: $D/Free.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Free.$O $STDEND
$D/mini-spin: $D/Spin.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Spin.$O $STDEND

clean:V:
	rm -rf $D
