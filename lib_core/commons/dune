 (name ix_core)
 (wrapped false)
 (modules Common I64 Binary Utf8 Procs Console Logging Json Set_ Map_ Regex Sys_plan9
  ; xix's (lib_core/commons/), imported: README.md
  Exception Exit Fpath_ Chan FS)
 (libraries unix caps fpath logs logs.fmt fmt))

; Source (plan_rio.md): what a program waits for, as a channel's
; messages; with OCaml's threads here (mini-ml's: ../concurrency/)
(library
 (name ix_threads)
 (wrapped false)
 (modules Source)
 (libraries threads.posix unix caps))

; Prelude (plan_ml_bootstrap.md, "Type classes"): Haskell's classes, by
; mlpp's. Apart from ix_core, which mini-ml itself is made of: mini-ml
; -pp writes its dictionaries, from the types, so it reads the stdlib's
; interfaces (-L: lib_core's, ix's own)
(library
 (name ix_prelude)
 (wrapped false)
 (modules Prelude)
 (preprocess (action (run %{bin:mini-ml} -pp -L %{project_root}/lib_core %{input-file})))
 (preprocessor_deps (source_tree %{project_root}/lib_core)))
