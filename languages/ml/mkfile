# mini-ml, built by ix's tools (and so by itself): the front end, its
# lexer by mini-lex and its grammar by mini-yacc, the preprocessor
# (pp/), then the back ends (simple/, compat/, opti/, ssa/), the facts
# for mini-datalog (facts/), the command
TOP=../..
DIR=languages/ml
PROG=mini-ml
SRC=Ast Annotations Parser Lexer Scope Resolve Typing Bits Derive Pp Ir Summary Fold Lower Gas Opti Dominators Braun Liveness Coloring Ssa Ssa_build Unbox Untag Cse Licm Alloc Zero_alloc Gen Emit Ssa_facts Closure_facts CLI Main
LOCAL=`{ls *.ml *.mli *.mly *.mll pp/*.ml pp/*.mli simple/*.ml simple/*.mli compat/*.ml compat/*.mli opti/*.ml opti/*.mli ssa/*.ml ssa/*.mli facts/*.ml facts/*.mli ../../lib_code/*.ml ../../lib_code/*.mli}
LIBI=-I ../../assembler -I pp -I simple -I compat -I opti -I ssa -I facts -I ../../lib_code
LIBUNITS=Asm Lexer_asm Parser_asm
<$TOP/mkfiles/mkconfig
GEN=$B/languages/ml/Parser.ml $B/languages/ml/Lexer.ml
LIBOBJS=$B/assembler/Asm.$O $B/assembler/Lexer_asm.$O $B/assembler/Parser_asm.$O
<$TOP/mkfiles/mkprog

# the units that are not here: those mini-yacc and mini-lex made, and
# each subdirectory's, by their names (as languages/c/mkfile's)
$D/Parser.$O: $D/Parser.ml $LOCAL
	$ML $INCLUDES -o $target $D/Parser.ml
$D/Lexer.$O: $D/Lexer.ml $D/Parser.ml $LOCAL
	$ML $INCLUDES -o $target $D/Lexer.ml
# lib_code's units (Dominators Braun Liveness Coloring: SSA's algorithms,
# mini-cc's too): one recipe each, so that .depend orders each
$D/%.$O: $TOP/lib_code/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target $TOP/lib_code/$stem.ml
# pp/'s units (Bits Derive Pp): one recipe each, so that .depend orders each
$D/%.$O: pp/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target pp/$stem.ml
# simple/'s units (Ir Summary Fold Lower Gen): one recipe each, so that .depend orders each
$D/%.$O: simple/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target simple/$stem.ml
$D/Gas.$O: compat/Gas.ml $LOCAL $GEN
	$ML $INCLUDES -o $target compat/Gas.ml
$D/Opti.$O: opti/Opti.ml $LOCAL $GEN
	$ML $INCLUDES -o $target opti/Opti.ml
# ssa/'s units (Ssa Ssa_build Unbox Untag Cse Licm Alloc Emit): one recipe each, so that .depend orders each
$D/%.$O: ssa/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target ssa/$stem.ml
# facts/'s units (Ssa_facts Closure_facts): one recipe each, so that .depend orders each
$D/%.$O: facts/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target facts/$stem.ml
