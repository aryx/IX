# Claude Code, Copyright (C) 2026 Yoann Padioleau, LGPL (see TinyBuildSystem.ml)
#
# This file builds t-IX with tiny-build, under t-IX. It is /src/Buildfile
# on tiny-kernel's second disk, where /src is tiny/. The host builds with
# it too, in a copy of tiny/ (see TinyKernel/Makefile; make self compares
# the images of the two builds).
#
#     cd /src
#     build build          makes tiny-build itself, as /src/build, to run
#     build rc             makes the shell, or any program by its name
#     build                makes every program, the kernel, the image
#     build install        installs the programs in /bin, /lib, /examples
#
# The file is also meant to be read: it shows how t-IX's pieces fit
# together, from the bottom up. A program stands on its own units, on
# the libraries that several programs share, on the standard library
# (TinyLibCore/), and on the runtimes, which are what a program links
# besides its own code. The kernel stands on the same library and
# runtime. The image holds the kernel and the few programs that mend a
# disk, and the disk holds all the rest.
#
# What a recipe makes goes beside its source: TinyShell.o and its
# interface TinyShell.tmi go beside TinyShell.ml, and TinyC/Parser.o
# goes in TinyC/. A program goes at the top, under its name (rc, build,
# ml). `build clean` removes them.
#
# The tools are tiny-kernel's: ml, cc, as, ld, ar and build (see ML,
# CC... below). On the host they are named tiny-ml, tiny-cc and so on,
# the same names after tiny-, so tiny-build TINY=tiny- runs this file
# there. Another way is to put a directory of links named ml, cc...
# first in the PATH, as TinyKernel/Makefile's build does in its copy of
# tiny/. A recipe is written in rc on both: tiny-build runs it with
# tiny-shell on the host and with /bin/rc on tiny-kernel.
#
# Two parts have their own Buildfile, which this file runs at each
# build: the library, TinyLibCore/, and the kernel, TinyKernel/. Each
# one makes the files of its own directory and knows which ones to make
# again.
#
# README.md says what t-IX as a whole keeps and drops (twin:, kept:,
# dropped:, twist:). Here is what the build itself drops:
#
# dropped:
# - no source is generated: there is no lex and no yacc, since every
#   lexer and parser is written by hand, so no rule here makes a .ml or
#   a .c;
# - no configure and no install prefix: build install copies into /bin,
#   /lib and /examples;
# - no glob, because tiny-build has none, nor mk's backquotes in a
#   variable (see its .mli). So CORE, the list of the library's units,
#   is written out here (for the disk's /lib/ml) and again in
#   TinyLibCore/Buildfile, and the disk's /examples is copied with rc's
#   glob in its recipe, not through prerequisites.


# The programs, listed by their names in /bin, and then the kernel
# (TinyKernel/).
PROGS = sh rc emacs office troff play mltests paint windows square tetris \
    calc temp ping get put httpd utils ed bigmem www prof db vcs build as ld \
    ar cc ml trace debug

all: $PROGS kernel

# The tools, by their names on tiny-kernel. On the host, tiny-build
# TINY=tiny- names them tiny-ml and so on; each one can also be given
# alone, as in tiny-build ML=../ml.exe.
TINY =
ML = ${TINY}ml
CC = ${TINY}cc
AS = ${TINY}as
LD = ${TINY}ld
AR = ${TINY}ar
BUILD = ${TINY}build


#############################################################################
# How each kind of file is made
#############################################################################
# The standard library (see below) is stdlib.a, which every ML program
# links. It is made together with its units' interfaces, which every ML
# unit reads (-L TinyLibCore). CORE lists its units, for the disk's
# /lib/ml (TinyLibCore/Buildfile has its own CORE, to make it).
CORE = Stdlib Char Seq List String Bytes Array Option Int32 Int64 \
    Filename Buffer Printf Marshal Hashtbl Common Sha1 Fpath Fpath_ Exit \
    In_channel Out_channel Chan Logs
STDLIB = TinyLibCore/stdlib.a

# An ML unit is compiled from its source alone. tiny-ml reads the
# library from TinyLibCore/ (-L), and it finds the interfaces of the
# modules that the source names in INCLUDES' directories (-I). Each unit
# is compiled after the units it stands on.
# Its prerequisites are for tiny-build alone: they say what must be made
# before the unit and what makes it again. They are the library (STDLIB,
# whose interfaces are made with it, just as Plan 9's mkfiles make every
# object depend on all the headers) and the interfaces the unit reads,
# which are its line in .depend (at the end). As with mini-ml in m-ix,
# the compiler's arguments are not among its prerequisites. A unit's
# .tmi is made with its .o. There is a rule for each directory (mk's &,
# a stem with no / or .). Here are the rules for tiny/'s own units, for
# user/'s and for the system's. A program with parts in a directory of
# their own (TinyML/) has its rules in its own section, with its own
# -I's (X_INCLUDES) for its parts and its main file, so that the parts
# of two programs may have the same names (Lexer).
INCLUDES = -I . -I TinyLibSystem/tinykernel
MLC = $ML -c -L TinyLibCore $INCLUDES
&.o: &.ml $STDLIB
	$MLC -o $target $stem.ml
user/&.o: user/&.ml $STDLIB
	$MLC -o $target user/$stem.ml
TinyLibSystem/tinykernel/&.o: TinyLibSystem/tinykernel/&.ml $STDLIB
	$MLC -o $target TinyLibSystem/tinykernel/$stem.ml
%.tmi: %.o

# An ML program's start holds what only the whole program can make: its
# units' initializations in their order, the table of their globals,
# and the curry functions (see TinyML/Link.mli). ml makes it from the
# files the program links, the libraries first. Those files are its
# prerequisites, given on each program's line below (P.start.o: $STDLIB
# $P_UNITS). The start is linked right after the ML runtime, which
# calls it.
%.start.o:
	$ML -o $target $prereq

# C is compiled by tiny-cc, which finds the #includes beside the file,
# then in runtime/c/ (libc.h, which user.h includes). Assembly written
# by hand is assembled by tiny-as (the compilers write their objects
# themselves).
%.o: %.c
	$CC -I runtime/c -o $target $stem.c
%.o: %.s
	$AS -o $target $stem.s


#############################################################################
# The runtimes: what a program links besides its own code
#############################################################################

# Each language has its runtime in its own directory, runtime/c/ and
# runtime/ml/, which become the disk's /lib/c and /lib/ml. (The
# TinyLibXxx.ml are libraries that a program chooses; a runtime is
# linked by every program.)
#
# C's runtime has:
# - _start, which calls main and then exits, linked first since the
#   machine starts at 0;
# - the unsigned division that tiny-cc calls;
# - libc, with print and the strings;
# - tiny-kernel's calls, in sys.s, one sys instruction for each;
# - draw.c and net.c, for the programs that draw or dial.
CRT = runtime/c/start.o runtime/c/udivmod.o runtime/c/libc.o runtime/c/sys.o

# ML's runtime is ml.c, the allocator and Cheney's collector. It is
# #included by mlsys.c, which gives it tiny-kernel's memory and calls.
# end.s marks the program's end, where its value stack can start, and
# it is linked last.
MLRT = runtime/ml/mlsys.o
MLEND = runtime/ml/end.o
runtime/ml/mlsys.o: runtime/ml/mlsys.c runtime/ml/ml.c runtime/c/user.h


#############################################################################
# The standard library: TinyLibCore/, OCaml's subset
#############################################################################

# The library is made by its own Buildfile, TinyLibCore/Buildfile, just
# as ocaml-light's stdlib is made by its Makefile and m-ix's libraries
# by their mkfiles. Its units are compiled among themselves, then kept
# in stdlib.a in the order they start in. stdlib is not a file, so it is
# never up to date, and the library's build runs each time. That build
# knows which units to make again (by its digests, in
# TinyLibCore/.tiny-build). stdlib.a is made with stdlib, as a .tmi is
# made with its .o. On the disk, they are in /lib/ml.
stdlib:
	cd TinyLibCore && $BUILD ML=^$ML AR=^$AR
$STDLIB: stdlib


#############################################################################
# The libraries: what several programs share
#############################################################################

# The libraries are:
# - the system's calls, which are tiny-kernel's side of
#   TinyLibSystem.mli (its unix/ side is the host's, built by dune);
# - the machine's code (libmach: the instructions, the objects, the
#   labels);
# - the regular expressions;
# - the window's libraries: the picture's messages, the playground (a
#   game's loop) and the widgets.
# Each one is a whole library in one file (m-ix's are each a directory
# and an archive), so its object is a .a in spirit: one name in a
# program's link. Each is named in the links of the programs that use
# it, so that you can see below which program stands on which library
# (one archive of them all would hide it).
SYS = TinyLibSystem/tinykernel/TinyLibSystem.o
MACH = TinyLibMachine.o
REGEX = TinyLibRegex.o
DRAWLIB = TinyLibDraw.o
PLAYGROUND = TinyLibPlayground.o
GUI = TinyLibGUI.o
#
# Each ML program in the sections below has its units (X_UNITS) and its
# start, made from them (X.start.o, by ml; see TinyML/Link.mli). ld then
# links the program from the C runtime, ML's runtime, the start, the
# library, its units and the end (the libraries come before the units
# that use them, which is OCaml's rule). The rules of its units are in
# .depend (at the end).


#############################################################################
# The shell, the utilities, the editors, the stores
#############################################################################

# rc is the shell; utils is cat, ls, grep... in one program (/bin/cat is
# a link to it); ed, also named sam, is the line editor; db and vcs are a
# database and a version control; build is the reader of this file.

RC_UNITS = $SYS TinyShell.o
rc.start.o: $STDLIB $RC_UNITS
rc: $CRT $MLRT rc.start.o $STDLIB $RC_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

UTILS_UNITS = $SYS $REGEX TinyUtilities.o
utils.start.o: $STDLIB $UTILS_UNITS
utils: $CRT $MLRT utils.start.o $STDLIB $UTILS_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

ED_UNITS = $SYS $REGEX TinyEditorLine.o
ed.start.o: $STDLIB $ED_UNITS
ed: $CRT $MLRT ed.start.o $STDLIB $ED_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

DB_UNITS = $SYS TinyDatabase.o
db.start.o: $STDLIB $DB_UNITS
db: $CRT $MLRT db.start.o $STDLIB $DB_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

VCS_UNITS = $SYS TinyVCS.o
vcs.start.o: $STDLIB $VCS_UNITS
vcs: $CRT $MLRT vcs.start.o $STDLIB $VCS_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

BUILD_UNITS = $SYS TinyBuildSystem.o
build.start.o: $STDLIB $BUILD_UNITS
build: $CRT $MLRT build.start.o $STDLIB $BUILD_UNITS $MLEND
	$LD -map -s -n -a 16 -o $target $prereq

#############################################################################
# The toolchain, and the tools of the machine's code
#############################################################################

# as, ld, ar, cc and ml built all of this; prof shows where a profile's
# instructions went; trace shows a program's calls; debug is a debugger.

AS_UNITS = $SYS $MACH TinyAssembler.o
as.start.o: $STDLIB $AS_UNITS
as: $CRT $MLRT as.start.o $STDLIB $AS_UNITS $MLEND
	$LD -map -s -n -a 32 -o $target $prereq

LD_UNITS = $SYS $MACH TinyLinker.o
ld.start.o: $STDLIB $LD_UNITS
ld: $CRT $MLRT ld.start.o $STDLIB $LD_UNITS $MLEND
	$LD -map -s -n -a 64 -o $target $prereq

AR_UNITS = $SYS $MACH TinyArchiver.o
ar.start.o: $STDLIB $AR_UNITS
ar: $CRT $MLRT ar.start.o $STDLIB $AR_UNITS $MLEND
	$LD -map -s -n -a 4 -o $target $prereq

CC_INCLUDES = -I TinyC
CC_UNITS = $SYS $MACH TinyC/Types.o TinyC/Lexer.o TinyC/Tree.o \
    TinyC/Lower.o TinyC/Parser.o TinyC/Machine.o TinyC.o
TinyC/&.o: TinyC/&.ml $STDLIB
	$MLC $CC_INCLUDES -o $target TinyC/$stem.ml
TinyC.o: TinyC.ml $STDLIB
	$MLC $CC_INCLUDES -o $target TinyC.ml
cc.start.o: $STDLIB $CC_UNITS
cc: $CRT $MLRT cc.start.o $STDLIB $CC_UNITS $MLEND
	$LD -map -s -n -a 16 -o $target $prereq

ML_INCLUDES = -I TinyML
ML_UNITS = $SYS $MACH TinyML/Lexer.o TinyML/Tree.o TinyML/Formats.o \
    TinyML/Parser.o TinyML/Types.o TinyML/Machine.o TinyML/Compile.o \
    TinyML/Link.o TinyML.o
TinyML/&.o: TinyML/&.ml $STDLIB
	$MLC $ML_INCLUDES -o $target TinyML/$stem.ml
TinyML.o: TinyML.ml $STDLIB
	$MLC $ML_INCLUDES -o $target TinyML.ml
ml.start.o: $STDLIB $ML_UNITS
ml: $CRT $MLRT ml.start.o $STDLIB $ML_UNITS $MLEND
	$LD -map -s -n -a 32 -o $target $prereq

PROF_UNITS = $SYS $MACH TinyProfiler.o
prof.start.o: $STDLIB $PROF_UNITS
prof: $CRT $MLRT prof.start.o $STDLIB $PROF_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

TRACE_UNITS = $SYS TinyTracer.o user/trace.o
trace.start.o: $STDLIB $TRACE_UNITS
trace: $CRT $MLRT trace.start.o $STDLIB $TRACE_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

DEBUG_UNITS = $SYS $DRAWLIB $PLAYGROUND $GUI $MACH TinyDebugger.o \
    user/debug.o
debug.start.o: $STDLIB $DEBUG_UNITS
debug: $CRT $MLRT debug.start.o $STDLIB $DEBUG_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

#############################################################################
