# lib_crypto's vectors by ix's tools (mini-mk): Vectors and Speed, each
# with its start and its link with the library (mkfiles/mklibs; vectors.sh
# runs it)
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/lib_crypto/tests
LIBDIRS=lib_crypto
<$TOP/mkfiles/mklibs
INCLUDES=-I . $LIBI $STDI
LIBS=$LIBA $STDOBJS $STDEND $TOP/mkfiles/mkconfig mkfile

all:V: $D/vectors $D/speed

$D/%.$O: %.ml $LIBSRC
	mkdir -p $D
	$ML $INCLUDES -o $target $stem.ml
$D/vectors: $D/Vectors.$O $LIBS
	$ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA} Vectors Std_exit -o $D/Vectors.start.$O
	$LD $LDH -nofollow -o $target $D/Vectors.start.$O $STDOBJS $LIBA $D/Vectors.$O $STDEND
$D/speed: $D/Speed.$O $LIBS
	$ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA} Speed Std_exit -o $D/Speed.start.$O
	$LD $LDH -nofollow -o $target $D/Speed.start.$O $STDOBJS $LIBA $D/Speed.$O $STDEND

clean:V:
	rm -rf $D
