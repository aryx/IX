# The tiny programs that run on the host, built by ix's tools: each one
# file (and for the CPUs their library's, for tiny-vcs SHA-1 and zlib),
# with its start and its link, on m-ix's library: lib_core/'s standard
# library and its commons/, and lib_crypto's SHA-1 (mkfiles/mklibs).
# TinyKernel.ml is not here: tiny-ml compiles it, for tiny-machine.
# What is built is under _mk/$O/tiny.
# (old: on arm64 by default on TinyLibHost/, t-ix's trimmed copy of
# lib_core/ with its own runtime and C library, LIB=core for lib_core;
# gone with plan_tiny_self_hosting.md's step 2: it had shown what of
# lib_core/ the tiny programs use)
TOP=..
<$TOP/mkfiles/mkconfig
D=$B/tiny
LIBDIRS=lib_crypto
<$TOP/mkfiles/mklibs
# (tiny/, where TinyLibSystem.mli is, before its Unix implementation:
# TinyLibSystem/tinykernel/'s is tiny-ml's)
INCLUDES=-I . -I TinyLibSystem/unix -I $D -I ../lib_crypto $STDI
START=$ML -start $STD $COMMONS
LINK=$LD -H7 -nofollow
LIBS=$STDOBJS $STDEND $TOP/mkfiles/mkconfig
PROGS=tiny-build tiny-shell tiny-utils tiny-editor tiny-cc tiny-ml tiny-as tiny-ld tiny-ar tiny-db tiny-vcs tiny-cpu tiny-machine tiny-prof tiny-mkfat

all:V: ${PROGS:%=$D/%}

# (each unit alone: none names another, but TinyCPU and TinyMachine their libraries,
# and TinyMachine KNetwork, the other end of its wire)
$D/%.$O: %.ml
	mkdir -p $D
	$ML $INCLUDES -o $target $stem.ml

$D/TinyMachineCPU.$O $D/TinyAssembler.$O $D/TinyLinker.$O $D/TinyArchiver.$O $D/TinyCPU.$O $D/TinyMachineDevices.$O $D/TinyMachine.$O: TinyLibMachine.ml
$D/TinyCPU.$O $D/TinyMachineDevices.$O $D/TinyMachine.$O: TinyMachine/TinyMachineCPU.ml
$D/TinyAssembler.$O $D/TinyLinker.$O $D/TinyArchiver.$O $D/cc/TinyC.$O $D/TinyML.$O $D/TinyCPU.$O $D/TinyMachine.$O $D/TinyMkfat.$O: $D/TinyLibSystem.$O

# (tiny-ml's passes, TinyML/, each after the ones before it, after TinyLibMachine, the lines they make)
MLC=TinyLibMachine Lexer Tree Formats Parser Types Machine Compile Link
MLCO=${MLC:%=$D/%.$O}
$D/Tree.$O: $D/Lexer.$O
$D/Formats.$O: $D/Tree.$O
$D/Parser.$O: $D/Formats.$O
$D/Types.$O: $D/Parser.$O
$D/Machine.$O: $D/Types.$O $D/TinyLibMachine.$O
$D/Compile.$O: $D/Machine.$O
$D/Link.$O: $D/Compile.$O
$D/TinyML.$O: $D/Link.$O

# (tiny-cc's passes, TinyC/, the same way, after TinyLibMachine, the lines they make;
# their objects in $D/cc/, since tiny-ml's of the same names, Lexer..., are in $D;
# TinyC.ml's too, so that its Lexer... are, for tests/depend_edges.sh, those of $D/cc)
CCP=Types Lexer Tree Lower Parser Machine
CCPO=$D/TinyLibMachine.$O ${CCP:%=$D/cc/%.$O}
$D/cc/Lexer.$O: $D/cc/Types.$O
$D/cc/Tree.$O: $D/cc/Lexer.$O
$D/cc/Lower.$O: $D/cc/Tree.$O
$D/cc/Parser.$O: $D/cc/Lower.$O
$D/cc/Machine.$O: $D/cc/Parser.$O $D/TinyLibMachine.$O
$D/TinyAssembler.$O: $D/TinyLibMachine.$O
$D/cc/TinyC.$O: $D/cc/Machine.$O
$D/TinyMachine.$O: TinyMachine/TinyMachineDevices.ml TinyKernel/KNetwork.ml TinyMachine/TinyMachinePeer.ml $D/Parallel.$O

# (a blank line above: a # line right under a rule's head is its recipe,
# and TinyMachinePeer's object was never compiled)
# (tiny-machine's parts are in TinyMachine/, the kernel's stack, which
# is the wire's other end, in TinyKernel/). A part finds the parts of
# its own directory (mini-ml looks there first); the -I's are the
# directories a program's files name besides, each program's own:
# tiny-machine's, then tiny-cc's and tiny-ml's main files
MACHINE_INCLUDES=-I TinyMachine -I TinyKernel -I TinyBrowser
$D/TinyMachine%.$O: TinyMachine/TinyMachine%.ml
	mkdir -p $D
	$ML $INCLUDES $MACHINE_INCLUDES -o $target TinyMachine/TinyMachine$stem.ml
$D/TinyCPU.$O: TinyCPU.ml
	mkdir -p $D
	$ML $INCLUDES $MACHINE_INCLUDES -o $target TinyCPU.ml
$D/TinyMachine.$O: TinyMachine.ml
	mkdir -p $D
	$ML $INCLUDES $MACHINE_INCLUDES -o $target TinyMachine.ml
# (what www types, which the wire's other end takes the same way)
$D/%.$O: TinyBrowser/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target TinyBrowser/$stem.ml
$D/KNetwork.$O: TinyKernel/KNetwork.ml
	mkdir -p $D
	$ML $INCLUDES -o $target TinyKernel/KNetwork.ml
$D/%.$O: TinyML/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target TinyML/$stem.ml
$D/TinyML.$O: TinyML.ml
	mkdir -p $D
	$ML $INCLUDES -I TinyML -o $target TinyML.ml

# (tiny-cc's: its directories before INCLUDES' $D, where tiny-ml's Lexer.$O is)
CC_INCLUDES=-I TinyC -I $D/cc
$D/cc/%.$O: TinyC/%.ml
	mkdir -p $D/cc
	$ML $CC_INCLUDES $INCLUDES -o $target TinyC/$stem.ml
$D/cc/TinyC.$O: TinyC.ml
	mkdir -p $D/cc
	$ML $CC_INCLUDES $INCLUDES -o $target TinyC.ml

# (tiny-mkfat is t6's, a step before tiny-kernel: its file is there)
$D/TinyMkfat.$O: TinyKernel/steps/t6/TinyMkfat.ml
	mkdir -p $D
	$ML $INCLUDES -o $target TinyKernel/steps/t6/TinyMkfat.ml

$D/TinyBuildSystem.$O: $D/TinyLibSystem.$O TinyBuildSystem.ml
$D/tiny-build: $LIBA $D/TinyLibSystem.$O $D/TinyBuildSystem.$O $LIBS
	$START Sha1 TinyLibSystem TinyBuildSystem Std_exit -o $D/TinyBuildSystem.start.$O
	$LINK -o $target $D/TinyBuildSystem.start.$O $STDOBJS $LIBA $D/TinyLibSystem.$O $D/TinyBuildSystem.$O $STDEND
# (the shell's system, the host's: TinyLibSystem/unix/TinyLibSystem.ml;
# TinyLibSystem/tinykernel/TinyLibSystem.ml is tiny-machine's, tiny-ml's to
# compile. Not beside TinyShell.ml: mini-ml looks for a module in the
# directory of the file it compiles before any -I)
$D/TinyLibSystem.$O: TinyLibSystem/unix/TinyLibSystem.ml
	mkdir -p $D
	$ML $INCLUDES -o $target TinyLibSystem/unix/TinyLibSystem.ml
$D/TinyShell.$O: $D/TinyLibSystem.$O TinyShell.ml
$D/tiny-shell: $D/TinyLibSystem.$O $D/TinyShell.$O $LIBS
	$START TinyLibSystem TinyShell Std_exit -o $D/TinyShell.start.$O
	$LINK -o $target $D/TinyShell.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyShell.$O $STDEND
# (the utilities, on the same TinyLibSystem as the shell, and
# TinyLibRegex for grep)
$D/TinyUtilities.$O: $D/TinyLibSystem.$O $D/TinyLibRegex.$O TinyUtilities.ml
$D/tiny-utils: $D/TinyLibSystem.$O $D/TinyLibRegex.$O $D/TinyUtilities.$O $LIBS
	$START TinyLibSystem TinyLibRegex TinyUtilities Std_exit -o $D/TinyUtilities.start.$O
	$LINK -o $target $D/TinyUtilities.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyLibRegex.$O $D/TinyUtilities.$O $STDEND
# (the line editor, on the same TinyLibSystem as the shell and the
# same TinyLibRegex as grep: it is tiny-kernel's ed and sam too)
$D/TinyEditorLine.$O: $D/TinyLibSystem.$O $D/TinyLibRegex.$O TinyEditorLine.ml
$D/tiny-editor: $D/TinyLibSystem.$O $D/TinyLibRegex.$O $D/TinyEditorLine.$O $LIBS
	$START TinyLibSystem TinyLibRegex TinyEditorLine Std_exit -o $D/TinyEditorLine.start.$O
	$LINK -o $target $D/TinyEditorLine.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyLibRegex.$O $D/TinyEditorLine.$O $STDEND
$D/tiny-cc: $D/TinyLibSystem.$O $CCPO $D/cc/TinyC.$O $LIBS
	$START TinyLibSystem TinyLibMachine $CCP TinyC Std_exit -o $D/TinyC.start.$O
	$LINK -o $target $D/TinyC.start.$O $STDOBJS $D/TinyLibSystem.$O $CCPO $D/cc/TinyC.$O $STDEND
$D/tiny-ml: $D/TinyLibSystem.$O $MLCO $D/TinyML.$O $LIBS
	$START TinyLibSystem $MLC TinyML Std_exit -o $D/TinyML.start.$O
	$LINK -o $target $D/TinyML.start.$O $STDOBJS $D/TinyLibSystem.$O $MLCO $D/TinyML.$O $STDEND
$D/tiny-as: $D/TinyLibSystem.$O $D/TinyLibMachine.$O $D/TinyAssembler.$O $LIBS
	$START TinyLibSystem TinyLibMachine TinyAssembler Std_exit -o $D/TinyAssembler.start.$O
	$LINK -o $target $D/TinyAssembler.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyLibMachine.$O $D/TinyAssembler.$O $STDEND
$D/tiny-ld: $D/TinyLibSystem.$O $D/TinyLibMachine.$O $D/TinyLinker.$O $LIBS
	$START TinyLibSystem TinyLibMachine TinyLinker Std_exit -o $D/TinyLinker.start.$O
	$LINK -o $target $D/TinyLinker.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyLibMachine.$O $D/TinyLinker.$O $STDEND
$D/tiny-ar: $D/TinyLibSystem.$O $D/TinyLibMachine.$O $D/TinyArchiver.$O $LIBS
	$START TinyLibSystem TinyLibMachine TinyArchiver Std_exit -o $D/TinyArchiver.start.$O
	$LINK -o $target $D/TinyArchiver.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyLibMachine.$O $D/TinyArchiver.$O $STDEND
$D/TinyDatabase.$O: $D/TinyLibSystem.$O TinyDatabase.ml
$D/tiny-db: $D/TinyLibSystem.$O $D/TinyDatabase.$O $LIBS
	$START TinyLibSystem TinyDatabase Std_exit -o $D/TinyDatabase.start.$O
	$LINK -o $target $D/TinyDatabase.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyDatabase.$O $STDEND
$D/TinyVCS.$O: $D/TinyLibSystem.$O TinyVCS.ml
$D/tiny-vcs: $LIBA $D/TinyLibSystem.$O $D/TinyVCS.$O $LIBS
	$START Sha1 TinyLibSystem TinyVCS Std_exit -o $D/TinyVCS.start.$O
	$LINK -o $target $D/TinyVCS.start.$O $STDOBJS $LIBA $D/TinyLibSystem.$O $D/TinyVCS.$O $STDEND
$D/tiny-cpu: $D/TinyLibSystem.$O $D/TinyLibMachine.$O $D/TinyMachineCPU.$O $D/TinyCPU.$O $LIBS
	$START TinyLibSystem TinyLibMachine TinyMachineCPU TinyCPU Std_exit -o $D/TinyCPU.start.$O
	$LINK -o $target $D/TinyCPU.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyLibMachine.$O $D/TinyMachineCPU.$O $D/TinyCPU.$O $STDEND
$D/tiny-machine: $D/TinyLibSystem.$O $D/TinyLibMachine.$O $D/TinyMachineCPU.$O $D/TinyMachineDevices.$O $D/KNetwork.$O $D/Strings.$O $D/Url.$O $D/Http.$O $D/TinyMachinePeer.$O $D/Parallel.$O $D/TinyMachine.$O $LIBS
	$START TinyLibSystem TinyLibMachine TinyMachineCPU TinyMachineDevices KNetwork Strings Url Http TinyMachinePeer Parallel TinyMachine Std_exit -o $D/TinyMachine.start.$O
	$LINK -o $target $D/TinyMachine.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyLibMachine.$O $D/TinyMachineCPU.$O $D/TinyMachineDevices.$O $D/KNetwork.$O $D/Strings.$O $D/Url.$O $D/Http.$O $D/TinyMachinePeer.$O $D/Parallel.$O $D/TinyMachine.$O $STDEND
# (Parallel: the host's cores where OCaml has domains, -cores-parallel;
# mini-ml has none: lib_core/parallel's file for OCaml 4.14, which dune
# chooses by the compiler's version)
$D/Parallel.$O: ../lib_core/parallel/host/single.ml.in ../lib_core/parallel/Parallel.mli
	mkdir -p $D
	cp ../lib_core/parallel/Parallel.mli $D/Parallel.mli
	cp ../lib_core/parallel/host/single.ml.in $D/Parallel.ml
	$ML $INCLUDES -o $target $D/Parallel.ml
$D/TinyProfiler.$O $D/TinyLinker.$O $D/TinyArchiver.$O: $D/TinyLibMachine.$O
$D/TinyProfiler.$O: $D/TinyLibSystem.$O TinyProfiler.ml
$D/tiny-prof: $D/TinyLibSystem.$O $D/TinyLibMachine.$O $D/TinyProfiler.$O $LIBS
	$START TinyLibSystem TinyLibMachine TinyProfiler Std_exit -o $D/TinyProfiler.start.$O
	$LINK -o $target $D/TinyProfiler.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyLibMachine.$O $D/TinyProfiler.$O $STDEND
$D/tiny-mkfat: $D/TinyLibSystem.$O $D/TinyMkfat.$O $LIBS
	$START TinyLibSystem TinyMkfat Std_exit -o $D/TinyMkfat.start.$O
	$LINK -o $target $D/TinyMkfat.start.$O $STDOBJS $D/TinyLibSystem.$O $D/TinyMkfat.$O $STDEND

clean:V:
	rm -rf $D

# the units' order (mkfiles/mkdepend); beside the lines above, those
# of each unit that names another here (TinyOffice, TinyTroff,
# TinyKernel are tiny-ml's: no lines; of TinyBrowser, tiny-machine's
# three. old: none of TinyBrowser's, and TinyBrowserHttp compiled
# beside TinyBrowserText, inlining its functions or not by which ended
# first: test-ix-fixpoint's builds differed, one in two or three).
# Not tiny-cc's, TinyC.ml and TinyC/: a unit is found by its name in
# the first directory that has it, and TinyC/'s Lexer... are tiny-ml's
# names too; their order is the lines above
DEPOBJ=D
DEPDIRS=. TinyMachine TinyBrowser TinyML TinyKernel TinyKernel/host TinyLibSystem/unix TinyKernel/steps/t6 $D
DEPBROWSER=TinyBrowser/Strings.ml TinyBrowser/Url.ml TinyBrowser/Http.ml
DEPUNITS=`{ls *.ml TinyMachine/*.ml $DEPBROWSER TinyML/*.ml TinyKernel/KNetwork.ml TinyKernel/host/*.ml TinyLibSystem/unix/*.ml TinyKernel/steps/t6/TinyMkfat.ml | grep -v '^TinyC\.ml$' | sed 's,.*/,,; s,\.ml$,,'}
<$TOP/mkfiles/mkdepend
