# mini-nm, built by ix's tools: lib_executable, and the linker's units for
# its objects and libraries
TOP=../..
DIR=debuggers/nm
PROG=mini-nm
SRC=Nm
LOCAL=`{ls *.ml}
GEN=
LIBDIRS=lib_executable
LIBI=-I ../../assembler -I ../../linker
LIBUNITS=Asm Show_asm Program Link
<$TOP/mkfiles/mkconfig
LIBOBJS=$B/assembler/Asm.$O $B/assembler/Show_asm.$O $B/linker/Program.$O $B/linker/Link.$O
<$TOP/mkfiles/mkprog
