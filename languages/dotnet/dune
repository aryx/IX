; mini-dotnet (docs/plans/done/plan_dotnet.md): a runtime for the assemblies
; Microsoft's C# compiler writes. Metadata (the 45 tables' shapes),
; Image (the PE file read: heaps, tables, a method's body), Signature
; (the blobs' types), Il (the opcodes, a body decoded and encoded),
; Listing (-tables, -S); Value (the runtime's types and values: an
; object's numbers in bytes, its references apart), Library (System's
; classes, ix's own, over lib_core), Types (the loader: classes laid
; out, vtables, tokens resolved, generics instantiated), Frame (a call's
; frame, an exception's first pass), Arith (the instructions' numbers),
; Machine (the IL run), Verifier, Jit (its code as text), Jit_run (that
; code run: mini-asm's parser, mini-ld's encoders), Code_memory (here
; dune's, no JIT: mini-ml/'s is the mkfile's), Writer (an assembly
; written: mini-tiger's).
(library
 (name ix_dotnet)
 (wrapped false)
 (modules :standard \ CLI Main)
 (libraries ix_core ix_asm ix_ld fpath caps))

; the command
(library
 (name ix_dotnet_cli)
 (wrapped false)
 (modules CLI)
 (libraries ix_dotnet ix_core fpath caps))

(executable
 (name Main)
 (public_name mini-dotnet)
 (package ix)
 (modules Main)
 (libraries ix_dotnet_cli ix_core caps))
