# mini-xv6, step 2, by ix's tools, on the Pi 4 or (mini-mk O=5) the
# Pi 1 (plan_kernel_mini_ml.md, steps 4 and 9): the same Main.ml as the
# Makefile's (the Pi 1's, by ocaml-light and gcc). pi4/ and pi1/ have
# the machine for it: l.s (the vectors,
# the trap's entry and return, around step 0's start), machine.c (the
# primitives, the trap into OCaml: the runtime's callback), user.s (the
# program in user mode). The runtime's interface for the C is
# languages/ml/runtime's headers.
#   mini-mk          _mk/7/kernel/steps/step2/kernel8.img
#   mini-mk check    booted under mini-qemu, and under QEMU if it is
#                    there: the Makefile's expected lines
TOP=../../..
<$TOP/mkfiles/mkconfig
<$TOP/kernel/lib/mkboard
D=$B/kernel/steps/step2
BD=`{case $O in 5) echo pi1;; 7) echo pi4;; esac}
ENTRY=`{case $O in 5) echo _start;; 7) echo vectors;; esac}
# (quoted: after a variable's =, mk reads a word before another = as attributes)
HEAP='-DMAXHEAP=4194304' '-DSTACK=131072'

all:V: $D/kernel8.img

$D/Main.$O: Main.ml
	mkdir -p $D
	$ML $STDI -o $target Main.ml
$D/start.$O: mkfile $TOP/mkfiles/mkconfig
	mkdir -p $D
	$ML -start $STD $COMMONS Main Std_exit -o $target
$D/runtime.$O: $TOP/languages/ml/runtime/runtime.c mkfile
	mkdir -p $D
	$CC $CINC $HEAP -o $target $TOP/languages/ml/runtime/runtime.c
$D/l.$O: $BD/l.s ../step0/${P}l.s
	mkdir -p $D
	$AS -o $target $BD/l.s
$D/user.$O: $BD/user.s
	mkdir -p $D
	$AS -o $target $BD/user.s
$D/machine.$O: $BD/machine.c $TOP/languages/ml/runtime/mlvalues.h $TOP/languages/ml/runtime/callback.h
	mkdir -p $D
	$CC $CINC -I$TOP/languages/ml/runtime -o $target $BD/machine.c
$D/shim.$O: ../step0/shim.c
	mkdir -p $D
	$CC $CINC -o $target ../step0/shim.c

# (l first: its vectors, or on the Pi 1 its start, are the image's first bytes)
OBJS=$D/l.$O $D/shim.$O $D/machine.$O $D/user.$O $D/start.$O $STDOBJS $D/Main.$O $L/std_exit.$O $D/runtime.$O $L/libc.a
$D/kernel8.img: $OBJS
	$LD -H0 -T $LOAD -E $ENTRY -nofollow -o $target $OBJS

check:V: $D/kernel8.img
	boot=`echo "$BOOT" | sed "s|IMAGE|$D/kernel8.img|"`
	timeout 20 mini-qemu $boot -nographic < /dev/null > $D/mini.txt 2> /dev/null || true
	cmp $D/mini.txt expected && echo "ok step2: under mini-qemu"
	if [ -x "`command -v $QEMU`" ]; then
		timeout 10 $QEMU $boot $QEMUSMP -display none -monitor none -serial file:$D/qemu.txt < /dev/null 2> /dev/null || true
		cmp $D/qemu.txt expected && echo "ok step2: under QEMU"
	fi

clean:V:
	rm -rf $D
