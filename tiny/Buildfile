#############################################################################
# The kernel: TinyKernel/
#############################################################################

# Made by its own Buildfile, TinyKernel/Buildfile, from its units, its
# assembly and the library; run each time, as the library's (kernel,
# not a file), after it. TinyKernel/kernel.img made with it
kernel: $STDLIB
	cd TinyKernel && $BUILD ML=^$ML CC=^$CC AS=^$AS LD=^$LD
TinyKernel/kernel.img: kernel

#############################################################################
# The image
#############################################################################

# boot.img: the kernel, then each file it carries, its name, its size
# and its bytes: the programs in /bin, the examples, the library in
# /lib/ml and the runtimes in /lib/c and /lib/ml (the sources, /src,
# are on the disk, TinyKernel/Makefile's disk.img, made on the host).
# The same recipe on the host and on tiny-kernel, in a copy of tiny/
# (TinyKernel/Makefile's _make/src, the disk's /src). One file is made
# on the host alone, before: TinyKernel/font.s, the font's bytes.
# MEMORY, from the environment (TinyKernel/Makefile's MEMORY=segments or
# pages), the kernel's way of giving memory, in /lib/memory, with
# MEMSIZE.
UTILS = [ basename cat cmp cp date du echo grep kill ln ls mkdir mv ps pwd \
    rm seq sleep sort tail tee test touch walk wc xd
# /examples: examples/, its files (sources, not what build makes there)
EXAMPLES = examples/Buildfile examples/hello.c examples/square.s \
    examples/helloml.ml examples/spin.s examples/spin.prof \
    examples/report.ixd examples/korobeiniki.wav
LIBC = runtime/start.o runtime/udivmod.o runtime/libc.o \
    TinyKernel/libc/sys.o TinyKernel/lib/c/Buildfile
LIBML = TinyLibSystem/tinykernel/mlsys.o TinyLibSystem/tinykernel/end.o \
    TinyKernel/lib/ml/Buildfile

# (in /lib/ml, the library's interfaces and stdlib.a, as the Makefile's
# image; its .tmi made with it, by TinyLibCore/Buildfile, and not
# prerequisites: this file's %.tmi would make them again)
LIBUNITS = ${CORE:%=TinyLibCore/%.tmi} $STDLIB

# /lib here, lib/: the same files, in lib/c and lib/ml, for a program
# built on the host as on tiny-kernel (examples/: tiny-build TINY=tiny-
# LIB=../lib SRC=..). Not a file: copied again each time it is asked
libs: $LIBC $STDLIB $LIBML
	mkdir -p lib/c lib/ml
	for(f in $LIBC) cp $f lib/c/^`{basename $f}
	for(f in $LIBUNITS $LIBML) cp $f lib/ml/^`{basename $f}

boot.img: TinyKernel/kernel.img $PROGS $EXAMPLES $STDLIB $LIBC $LIBML
	cat TinyKernel/kernel.img > $target
	for(f in $PROGS) { n=`{wc -c < $f}; echo bin/$f; echo $n; cat $f } >> $target
	for(f in $EXAMPLES) { n=`{wc -c < $f}; echo examples/^`{basename $f}; echo $n; cat $f } >> $target
	for(f in $LIBUNITS) { n=`{wc -c < $f}; echo lib/ml/^`{basename $f}; echo $n; cat $f } >> $target
	for(f in $LIBC) { n=`{wc -c < $f}; echo lib/c/^`{basename $f}; echo $n; cat $f } >> $target
	for(f in $LIBML) { n=`{wc -c < $f}; echo lib/ml/^`{basename $f}; echo $n; cat $f } >> $target
	for(u in $UTILS) { echo bin/$u; echo link bin/utils } >> $target
	{ echo bin/editor; echo link bin/emacs; echo bin/sam; echo link bin/ed } >> $target
	if(~ $MEMORY segments pages) { echo lib/memory; echo $MEMSIZE; echo $MEMORY } >> $target
	echo >> $target
#`

#############################################################################
# The units' dependencies
#############################################################################

# The ML units' rules, in .depend: a unit's object, then the interfaces
# of the units it names and its .mli, written by ml -depend as ocamldep
# writes OCaml's (and m-ix's mini-ml -depend). Its sources are every
# .ml of INCLUDES' directories (a unit added is found; the host's
# programs among them, TinyCPU.ml and TinyMachine.ml, are lines no
# target asks for, or left out, said, when tiny-ml cannot read them).
# The globs are written here, not in a variable: rc does not glob a *
# that comes from one. .depend is kept beside this file, as
# ocaml-light's stdlib keeps its own (TinyLibCore/ and TinyKernel/ have
# theirs, made again too): `build depend` makes it again after a unit
# names another one, or a unit is added.
depend:
	$ML -depend $INCLUDES *.ml TinyLibSystem/tinykernel/*.ml TinyC/*.ml TinyML/*.ml TinyOffice/*.ml TinyBrowser/*.ml user/*.ml > .depend
	@{ cd TinyLibCore && $BUILD ML=^$ML depend }
	@{ cd TinyKernel && $BUILD ML=^$ML depend }

<.depend

#############################################################################
# clean: what this file made removed (the objects and interfaces beside
# their sources, each directory by name; the programs, the image, the
# maps; the library's and the kernel's by their Buildfiles)
#############################################################################

clean:
	@{ cd TinyLibCore && $BUILD clean }
	@{ cd TinyKernel && $BUILD clean }
	rm -f lib/c/* lib/ml/*
	rm -f *.o *.tmi TinyBrowser/*.o TinyBrowser/*.tmi TinyC/*.o TinyC/*.tmi \
	    TinyKernel/libc/*.o \
	    TinyKernel/libc/*.tmi TinyKernel/user/*.o TinyKernel/user/*.tmi \
	    TinyLibSystem/tinykernel/*.o \
	    TinyLibSystem/tinykernel/*.tmi TinyML/*.o TinyML/*.tmi TinyOffice/*.o \
	    TinyOffice/*.tmi runtime/*.o runtime/*.tmi \
	    user/*.o user/*.tmi *.map $PROGS boot.img
