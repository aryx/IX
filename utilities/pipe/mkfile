# utilities/pipe, built by ix's tools: each program is one file, built
# with its start and its link (for Plan 9, run mini-mk O=5 OS=plan9)
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/utilities/pipe
MADE=`{mkdir -p $D}
INCLUDES=-I . $STDI
LIBS=$STDOBJS $STDEND $TOP/mkfiles/mkconfig

all:V: $D/mini-tee $D/mini-tail $D/mini-xargs

$D/%.$O: %.ml
	$ML $INCLUDES -o $target $stem.ml
$D/mini-tee: $D/Tee.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Tee.$O $STDEND
$D/mini-tail: $D/Tail.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Tail.$O $STDEND
$D/mini-xargs: $D/Xargs.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Xargs.$O $STDEND

clean:V:
	rm -rf $D
