#
# hello, from hello.c and square.s, helloml, from helloml.ml, and spin,
# from spin.s, built on tiny-kernel by build in /examples (see hello.c,
# helloml.ml and spin.s): all by default, or one by its name (build
# helloml). /examples is this directory, the same files. What they link
# besides their own objects is already built in /lib: /lib/c, C's
# runtime and tiny-kernel's calls, start.o first (the machine starts
# there); /lib/ml, ML's runtime (mlsys.o), the library (stdlib.a, its
# units), and end.o, the program's end, last.
# Each has its Buildfile, which says how it is made from /src. -s puts
# the labels after the image, the names debug shows; -map writes them
# beside it too.
#
# On the host, the same, the tools tiny-cc..., /lib tiny/lib (made by
# tiny-build TINY=tiny- libs in tiny/), /src tiny/:
#     tiny-build TINY=tiny- LIB=../lib SRC=..

TINY =
CC = ${TINY}cc
AS = ${TINY}as
LD = ${TINY}ld
ML = ${TINY}ml
LIB = /lib
SRC = /src

CRT = ${LIB}/c/start.o ${LIB}/c/udivmod.o ${LIB}/c/libc.o ${LIB}/c/sys.o
MLRT = ${LIB}/ml/mlsys.o
STDLIB = ${LIB}/ml/stdlib.a
MLEND = ${LIB}/ml/end.o
# (where tiny-ml reads the library's interfaces)
MLLIB = ${LIB}/ml
# (user.h: the system's calls a C program makes, as libc/'s headers)
INC = ${SRC}/TinyKernel/libc

all: hello helloml spin

hello: hello.o square.o
	$LD -map -s -n -o $target $CRT $prereq

hello.o: hello.c ${INC}/user.h
	$CC -I $INC -o $target hello.c
square.o: square.s
	$AS -o $target square.s

helloml: helloml.o
	$LD -map -s -n -o $target $CRT $MLRT $prereq $STDLIB $MLEND

# (one unit: its code and its start in one object)
helloml.o: helloml.ml
	$ML -L $MLLIB -o $target helloml.ml

# spin alone, no runtime: prof's example, with spin.prof, where its
# instructions went, which tiny-cpu -prof wrote on the host (tiny-kernel
# has no tiny-cpu; so it is kept here, and never made by build there):
#     prof spin.prof -u spin.map
#     tiny-build TINY=tiny- spin.prof     on the host, made again
spin: spin.o
	$LD -map -o $target spin.o
spin.map: spin
spin.o: spin.s
	$AS -o $target spin.s
spin.prof: spin
	tiny-cpu -prof $target spin > /dev/null

clean:
	rm -f hello helloml spin *.o *.map
