% Hybrid (Kastrinis and Smaragdakis, 2013; Doop's S_2obj+H): 2-object
% where the first argument has an object, the call site where it has
% none, in place of the caller's context alone: a call with no object
% (their static call) still tells its callers apart. For about 2obj+H's
% cost, more precise. See object1.dl for its hole.
filtered(I) :- has_object(I).
callee(I, C1, C2, F, O, O1) :-
  passed(I, 1, C1, C2, O, O1, _), has_object(I), fresh(I, C1, C2, F, _, _).
callee(I, C1, C2, F, I, C1) :- fresh(I, C1, C2, F, _, _), \+ has_object(I).
pt(P, O, O1, O, O1, O2) :-
  passed(I, 1, C1, C2, O, O1, O2), filtered(I),
  callee(I, C1, C2, F, O, O1), parameter(F, 1, P).
pt(V, C1, C2, H, C1, none) :- new_site(V, H, C1, C2).
