# mini-chidb, built by ix's tools: its lexer by mini-lex, its grammar by
# mini-yacc; its units are in folders (storage, dbm, sql)
TOP=..
DIR=database
PROG=mini-chidb
SRC=Pager Record Btree Cursor Bytecode Dbm Dbmfile Ast Show_ast Parser Lexer Sql Schema Codegen Optimizer Shell CLI Main
LOCAL=`{ls *.ml *.mli storage/*.ml* dbm/*.ml* sql/*.ml*}
LIBI=-I storage -I dbm -I sql
LIBUNITS=
LIBOBJS=
<$TOP/mkfiles/mkconfig
GEN=$B/database/Parser.ml $B/database/Lexer.ml
<$TOP/mkfiles/mkprog

# each folder's units, with a rule for each folder whose prerequisite is
# the source (mk refuses a second % rule for every unit beside
# mkprog's). Each unit gets its own recipe, so that .depend orders each
# one. The folders: storage dbm sql
$D/%.$O: storage/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target storage/$stem.ml
$D/%.$O: dbm/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target dbm/$stem.ml
$D/%.$O: sql/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target sql/$stem.ml

# the lexer and the grammar, which are in sql/ (mkprog's rules are for
# this directory's files)
$D/Parser.ml: sql/Parser.mly
	mkdir -p $D
	$YACC -b $D/Parser sql/Parser.mly
$D/Lexer.ml: sql/Lexer.mll
	mkdir -p $D
	$LEX -o $target sql/Lexer.mll

# the units that mini-yacc and mini-lex made, each by its name
$D/Parser.$O: $D/Parser.ml $LOCAL
	$ML $INCLUDES -o $target $D/Parser.ml
$D/Lexer.$O: $D/Lexer.ml $D/Parser.ml $LOCAL
	$ML $INCLUDES -o $target $D/Lexer.ml
