rc
mkdir /usr/glenda/self
cd /src
build all boot.img > /usr/glenda/self/first.log
cp boot.img /usr/glenda/self/first.img
echo '(* a comment *)' >> TinyLibRegex.ml
build all boot.img > /usr/glenda/self/comment.log
echo comment: compiled `{grep -c '^ml -c' /usr/glenda/self/comment.log} linked `{grep -c '^ld ' /usr/glenda/self/comment.log}
echo 'let () = print_string ""' >> user/calc.ml
build all boot.img > /usr/glenda/self/calc.log
echo calc: compiled `{grep -c '^ml -c' /usr/glenda/self/calc.log} linked `{grep -c '^ld .* -o calc ' /usr/glenda/self/calc.log} image `{grep -c '^cat TinyKernel/kernel.img > boot.img' /usr/glenda/self/calc.log}
build all boot.img > /usr/glenda/self/last.log
echo last: compiled `{grep -c '^ml -c' /usr/glenda/self/last.log} linked `{grep -c '^ld ' /usr/glenda/self/last.log}
exit
