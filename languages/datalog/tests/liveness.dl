% Liveness, the textbook's equations as rules: a variable is live into
% an instruction that uses it, or that it is live out of and that does
% not define it; live out of one when live into a successor.
%   1: x = 1
%   2: y = x + 1
%   3: if y > 0 goto 5
%   4: x = y
%   5: print(x)
succ(1, 2). succ(2, 3). succ(3, 4). succ(3, 5). succ(4, 5).
def(x, 1). def(y, 2). def(x, 4).
use(x, 2). use(y, 3). use(y, 4). use(x, 5).
live_in(V, P) :- use(V, P).
live_in(V, P) :- live_out(V, P), \+ def(V, P).
live_out(V, P) :- succ(P, Q), live_in(V, Q).
