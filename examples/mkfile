#
# Small programs to read, build and run on mini-9pi, where they are in
# /examples, and on Linux. Each file's header says more about it:
#
#     C          ML            what
#     hello.c    Helloml.ml    a print (hello with square_arm.s, in assembly)
#     procs.c    Procsml.ml    a pipe, fork, exec and wait: a shell's pipeline
#                Fetchml.ml    a document of another machine, by HTTP (lib_networking)
#                Shapesml.ml   a picture drawn, with the draw device (lib_graphics)
#                Game.ml       a ball, on the playground (lib_playground)
#                Counter.ml    a counter, on the widgets (lib_gui)
#
# mk makes all of them; mk game makes one by its name; mk clean removes
# them. procs and shapesml are mini-9pi's only (their headers say why).
# What they link besides their own objects is already built in /lib:
# - /lib/c has C's library (libc.a) and its headers (cc -I /lib/c/include
#   finds u.h, the machine's types, and libc.h);
# - /lib/ml has ML's libraries, each in a directory of its name: its
#   archive (lib.a), and its units' interfaces and summaries, for
#   ml -I. lib_core's is the standard library (lib_core.a), with what
#   ends a program: std_exit and the runtime.
# They are built in /src and copied there by its mk install
# (mkfiles/install.rc).
#
#     cd /examples; mk hello; hello        on mini-9pi's card
#
# On the host it works the same way, with the tools mini-cc..., and with
# /lib as the top mkfile's install made it, in _mk (cd ..; mini-mk
# MINI=mini- install, and with O=5 OS=plan9 for mini-9pi's), where the
# programs go too; mini-5i runs Linux's where the host is not one:
#     mini-mk MINI=mini-                   for Linux on arm64
#     mini-5i ../_mk/7/examples/hello
#     mini-mk MINI=mini- O=5 OS=plan9      mini-9pi's programs

# the machine (5: arm, 7: arm64) and the system (plan9 or linux) the
# programs are for; where the libraries are; where the programs go.
# On mini-9pi they are its own, /lib and here; on the host, which has
# no objtype, Linux's on arm64, and the top mkfile's directories.
# (MINI, the tools' prefix, is given no value here: nothing on the
# card, and on the host mini-, said to mk or in the environment)
O=`{if(~ $#objtype 0) echo 7; if not echo 5}
OS=`{if(~ $#objtype 0) echo linux; if not echo plan9}
HOST=`{if(~ $OS linux) echo ../_mk/$O; if not echo ../_mk/$O-$OS}
LIB=`{if(~ $#objtype 0) echo $HOST/lib; if not echo /lib}
D=`{if(~ $#objtype 0) echo $HOST/examples; if not echo .}
MADE=`{mkdir -p $D}

CC=${MINI}cc -m $O
AS=${MINI}asm -m $O
ML=${MINI}ml -m $O -O3
AR=${MINI}ar
# (the executable's format: Plan 9's a.out, or Linux's ELF)
LDH=`{if(~ $OS plan9) echo -H2; if not echo -H7}
LD=${MINI}ld -m $O $LDH -nofollow

P9=`{~ $OS plan9 && echo procs shapesml}
all:V: hello helloml procsml fetchml game counter $P9

hello:V: $D/hello
procs:V: $D/procs
helloml:V: $D/helloml
procsml:V: $D/procsml
fetchml:V: $D/fetchml
shapesml:V: $D/shapesml
game:V: $D/game
counter:V: $D/counter

# A C program: each file compiled with the C library's headers, then
# linked with libc.a, whose first instructions (rt0) call main.
ARCH=`{if(~ $O 5) echo arm; if not echo arm64}
CINC=-I$LIB/c/include -I$LIB/c/include/utf -D$ARCH -D$OS
LIBC=$LIB/c/libc.a

$D/hello.$O: hello.c
	$CC $CINC -o $target hello.c
$D/square.$O: square_$ARCH.s
	$AS -o $target square_$ARCH.s
$D/hello: $D/hello.$O $D/square.$O $LIBC
	$LD -o $target $prereq

$D/procs.$O: procs.c
	$CC $CINC -o $target procs.c
$D/procs: $D/procs.$O $LIBC
	$LD -o $target $prereq

# An ML program on the standard library alone: its unit compiled with
# the library's interfaces (-I); then ml -o, which writes its start
# from the files it is given (the units' initializations in order: a
# library's units as its index has them, then the unit's own) and runs
# ld on the same files (-ld: with its flags): the start, the library
# (from which ld takes the units the program uses), the unit, and the
# end.
CORE=$LIB/ml/lib_core
STD=$CORE/lib_core.a
END=$CORE/std_exit.$O $CORE/runtime.$O $LIBC

$D/Helloml.$O: Helloml.ml
	$ML -I $CORE -o $target Helloml.ml
$D/helloml: $D/Helloml.$O $STD $END
	$ML -ld $LD -- -o $target $STD $D/Helloml.$O $END

$D/Procsml.$O: Procsml.ml
	$ML -I $CORE -o $target Procsml.ml
$D/procsml: $D/Procsml.$O $STD $END
	$ML -ld $LD -- -o $target $STD $D/Procsml.$O $END

# An ML program on other libraries is built the same way, with their
# interfaces and their archives, each library after the ones it names.
# PLATFORM is what runs a playground program: the draw device on
# mini-9pi, and on Linux ppm, no window, a frame written to a file.
PLATFORM=`{if(~ $OS plan9) echo draw; if not echo ppm}
LIBS=lib_crypto lib_compression lib_graphics lib_playground/random lib_playground lib_playground/physics lib_playground/juice lib_gui lib_audio lib_networking \
 lib_playground/netcode lib_playground/ai lib_playground/apis lib_playground/platforms lib_playground/platforms/$PLATFORM
LIBA=${LIBS:%=$LIB/ml/%/lib.a}
LIBI=${LIBS:%=-I $LIB/ml/%}

$D/%.$O: %.ml $LIBA
	$ML $LIBI -I $CORE -o $target $stem.ml

$D/fetchml: $D/Fetchml.$O $STD $LIBA $END
	$ML -ld $LD -- -o $target $STD $LIBA $D/Fetchml.$O $END
$D/shapesml: $D/Shapesml.$O $STD $LIBA $END
	$ML -ld $LD -- -o $target $STD $LIBA $D/Shapesml.$O $END
$D/game: $D/Game.$O $STD $LIBA $END
	$ML -ld $LD -- -o $target $STD $LIBA $D/Game.$O $END
$D/counter: $D/Counter.$O $STD $LIBA $END
	$ML -ld $LD -- -o $target $STD $LIBA $D/Counter.$O $END

clean:V:
	rm -f $D/*.$O $D/hello $D/procs $D/helloml $D/procsml $D/fetchml $D/shapesml $D/game $D/counter
