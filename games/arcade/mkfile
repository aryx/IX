# games/arcade, built by ix's tools (../mkgames)
TOP=../..
DIR=games/arcade
GAMES=TinyCameltry
WITH=physics
# (TinyBreakout asks for other libraries, the sound and the juice, so
# it is made by mk called again with its own GAMES and WITH, because a
# command line's variables are stronger than a mkfile's. WITH is not
# physics audio juice for both games, because a program linked with
# Audio has a sound, and TinyCameltry would mix its silence at each
# frame.)
# (TinyTronscroll is made the same way, for the netcode and the
# network, because a program links its units whole.)
all:V: games sounding networked
sounding:V: games
	b=(); if(~ $B /*) b='B='^$B
	$MK 'O='$O 'OS='$OS 'PLATFORM='$PLATFORM $b 'GAMES='TinyBreakout 'WITH=audio juice' games
networked:V: sounding
	b=(); if(~ $B /*) b='B='^$B
	$MK 'O='$O 'OS='$OS 'PLATFORM='$PLATFORM $b 'GAMES='TinyTronscroll 'WITH='multiplayer games
<../mkgames
