# apps/music/play, built by ix's tools: mini-play, a sound to /dev/audio, a
# film in a window (Film), so with lib_audio, lib_mime and the graphics. The
# platform is ppm's on Linux (a frame written to a file, the tests'), draw's
# on Plan 9. mini-mk O=5 OS=plan9: for mini-9pi.
TOP=../../..
<$TOP/mkfiles/mkconfig
D=$B/apps/music/play
PLATFORM=`{if(~ $OS plan9) echo draw; if not echo ppm}
LIBDIRS=lib_mime lib_compression lib_graphics lib_playground lib_gui lib_audio lib_networking lib_playground/apis lib_playground/platforms lib_playground/platforms/$PLATFORM
<$TOP/mkfiles/mklibs
# (the MPEG decoders and Player are not in lib_audio's library: compiled here,
# so that no game carries them)
A=$TOP/lib_audio
DIRS=. $A $A/formats/mpeg_audio
INCLUDES=-I . -I $A -I $A/formats/mpeg_audio -I $D $LIBI $STDI
LIB=Layer3_tables Mpeg_audio_header Polyphase Imdct Layer3 Layer2 Mpeg_audio Player Film
LIBOBJS=${LIB:%=$D/%.$O}
LOCAL=`{ls *.ml *.mli ../../../lib_audio/Player.ml* ../../../lib_audio/formats/mpeg_audio/*.ml*} $LIBSRC
LIBS=$LIBOBJS $LIBA $STDOBJS $STDEND $TOP/mkfiles/mkconfig

all:V: $D/mini-play $D/mpg_bench

$D/%.$O: $LOCAL
	mkdir -p $D
	for(d in $DIRS) if(ls $d/$stem.ml >/dev/null >[2=1]) f=$d/$stem.ml
	$ML $INCLUDES -o $target $f

$D/mini-play: $D/Play.$O $LIBS mkfile
	$ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA} $LIB Play Std_exit -o $D/Play.start.$O
	$LD $LDH -nofollow -o $target $D/Play.start.$O $STDOBJS $LIBA $LIBOBJS $D/Play.$O $STDEND

$D/mpg_bench: $D/Mpg_bench.$O $LIBS mkfile
	$ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA} $LIB Mpg_bench Std_exit -o $D/Mpg_bench.start.$O
	$LD $LDH -nofollow -o $target $D/Mpg_bench.start.$O $STDOBJS $LIBA $LIBOBJS $D/Mpg_bench.$O $STDEND

# the units' order (mkfiles/mkdepend)
DEPOBJ=D
DEPDIRS=$DIRS
DEPUNITS=$LIB Play Mpg_bench
<$TOP/mkfiles/mkdepend

clean:V:
	rm -rf $D
