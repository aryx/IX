# mini-netscape, built by ix's tools (docs/plans/plan_browser.md, stage
# 10). The window's own units are compiled here, then the program is
# linked with the libraries (mkfiles/mklibs): the cryptography, the
# compression, the network, the pictures and their readers, the
# playground and one platform of it, and the browser's libraries (HTML,
# CSS, JavaScript, the boxes and a page's scripts, in browsers/html,
# css, javascript, engine and webapi). The platform is ppm's on Linux,
# where there is no window and a frame is written to a file for the
# tests. With OS=plan9 (mini-9pi) it is the draw device's, a window of
# mini-rio, as for the games (games/mkgames).
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/browsers/netscape
PLATFORM=`{if(~ $OS plan9) echo draw; if not echo ppm}
# (each library comes after the ones it names)
LIBDIRS=lib_mime lib_crypto lib_compression lib_networking lib_graphics lib_playground \
 browsers/html browsers/css browsers/javascript browsers/engine browsers/webapi \
 lib_playground/platforms lib_playground/platforms/$PLATFORM
<$TOP/mkfiles/mklibs
# (the libraries come before lib_core, so that Cmd is lib_playground's,
# Elm's, and not commons/'s)
INCLUDES=-I . $LIBI $STDI
# (each unit comes before the ones that name it)
LIB=Browser_zoom Places Scrollbar Browser_profile Worker_spawn Tab Tab_worker
LIBOBJS=${LIB:%=$D/%.$O}
# (JavaScript's two units that nobody names; see browsers/javascript's
# mkfile)
WHOLE=$B/browsers/javascript/Js_quicken.$O $B/browsers/javascript/Js_compile.$O
LOCAL=`{ls *.ml *.mli} $LIBSRC
LIBS=$LIBOBJS $LIBA $STDOBJS $STDEND $TOP/mkfiles/mkconfig

# (netscape is the name that the frames' test asks for, as for a game;
# mini-netscape is the program's name)
all:V: $D/mini-netscape

$D/%.$O: %.ml $LOCAL
	mkdir -p $D
	$ML $INCLUDES -o $target $stem.ml

# the window's worker, a thread of lib_core's, a large one
# (Worker_spawn.mli)
$D/Worker_spawn.$O: spawn/large_threads.ml Worker_spawn.mli
	mkdir -p $D
	cp Worker_spawn.mli $D/Worker_spawn.mli
	cp spawn/large_threads.ml $D/Worker_spawn.ml
	$ML $INCLUDES -o $target $D/Worker_spawn.ml

$D/mini-netscape: $D/netscape
	cp $D/netscape $target
$D/netscape: $D/Netscape.$O $LIBS
	$ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA} $LIB Netscape Std_exit -o $D/Netscape.start.$O
	$LD $LDH -nofollow -o $target $D/Netscape.start.$O $STDOBJS $LIBA $WHOLE $LIBOBJS $D/Netscape.$O $STDEND

# the units' order (mkfiles/mkdepend)
DEPOBJ=D
DEPDIRS=. $D
DEPUNITS=$LIB Netscape
<$TOP/mkfiles/mkdepend

clean:V:
	rm -rf $D
