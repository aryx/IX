//
// arm64.acid: mini-acid's library, arm64's part, on Linux (port.acid
// is the rest; arm.acid the arm's): the breakpoint's size, the link
// register, the registers printed, and the frames, by the frame
// pointer's chain (AAPCS64, gcc's and clang's): a function's prologue
// saves the caller's R29 (FP) and R30 (LR) in a record on the stack
// and points R29 at it,
//
//     STP.W (R29, R30), -n(RSP)     or  SUB $n, RSP
//     MOV   RSP, R29                    STP (R29, R30), m(RSP)
//                                       ADD $m, RSP, R29
//
//     R29 -> | the caller's R29 |  the record: a list, each frame's
//            | its return       |  first word the one before's
//
// so the walk is the list: a return address at 8(R29), the caller's
// record at 0(R29). Before R29 is set (a breakpoint at a function's
// first instruction), and in a leaf that makes no record, the return
// is in R30. ix's compilers make no record: 7c's and mini-ml's frames
// are below the SP, their sizes read from their prologues, as on arm
// (frame).

defn acidinit()
{
	bplist = {};
	bpfmt = 'X';
	mlw = 8;		// an ML value's word (port.acid's ml)
}

defn linkreg() { return *R30; }

// where a stack ends: main (gcc's programs have no _main; libc's start
// calls main)
defn isstart(a) { return a == main; }

// a function's frame by its prologue, read in the program's file (@: a
// breakpoint may be in the process's), in its first four instructions:
//   {"fp", 0, a}   a frame record, R29 set at a (MOV RSP, R29; ADD $m,
//                  RSP, R29): gcc's, clang's
//   {"sp", n, a}   n bytes below the caller's SP, the return at 0(RSP)
//                  once a has run: 7c's MOVD.W R30, -n(RSP) (a its
//                  start), mini-ml's SUB $n, RSP; MOVD R30, 0(RSP)
//   {}             none (a leaf: the return in R30)
defn frame(start)
{
	local i, w, n, imm;

	w = @fmt(start, 'X');
	if (w & 0xffe00fff) == 0xf8000ffe then {
		imm = (w >> 12) & 0x1ff;
		if imm & 0x100 then
			imm = imm - 0x200;
		return {"sp", -imm, start};
	}
	if (w & 0xff8003ff) == 0xd10003ff && @fmt(start+4, 'X') == 0xf90003fe then {
		n = (w >> 10) & 0xfff;
		if w & 0x400000 then
			n = n << 12;
		return {"sp", n, start+4};
	}
	i = 0;
	while i < 4 do {
		w = @fmt(start+i*4, 'X');
		if (w & 0xffc003ff) == 0x910003fd then
			return {"fp", 0, start+i*4};
		i = i + 1;
	}
	return {};
}

// the frames from (pc, sp, link), the innermost first, each {its
// function, where in it, its sp} (port.acid's frames, for arm64), to
// main (isstart) or the list's end; each frame by its function's kind
// (frame), so that a call from gcc's code to ix's, or back, is walked
defn frames(pc, sp, link)
{
	local l, f, start, p, fp, ret, n;

	l = {};
	fp = *R29;
	n = 0;
	while n < 40 do {
		f = fnbound(pc);
		if f == {} then
			return l;
		start = f[0];
		append l, {start, pc, sp};
		if isstart(start) then
			return l;
		p = frame(start);
		if p == {} || pc <= p[2] then {
			// (the prologue not run yet, or a leaf: the innermost's)
			if n > 0 then
				return l;
			ret = link;
			if p != {} && p[0] == "sp" && pc > start then
				sp = sp+p[1];
		} else if p[0] == "sp" then {
			ret = *fmt(sp, 'Y');
			sp = sp+p[1];
		} else {
			if fp == 0 then
				return l;
			ret = *fmt(fp+8, 'Y');
			sp = fp+16;
			fp = *fmt(fp, 'Y');
		}
		if ret == 0 then
			return l;
		pc = ret-4;		// the call
		n = n+1;
	}
	return l;
}

defn regs()
{
	local i;

	i = 0;
	while i < 31 do {
		print("R", i\D, "\t", *fmt(i*8, 'Y'));
		if i % 3 == 2 then
			print("\n");
		else
			print(" ");
		i = i + 1;
	}
	print(" SP\t", *SP, " PC\t", *PC, "\n");
}
