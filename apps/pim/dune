; apps/pim: mini-pim, a suite for organizing a life
; (docs/plans/plan_pim.md), in folders (folders only: one library,
; ix_pim):
;   mail/  the mail (docs/plans/plan_mail.md): its formats, Mail (a
;          message, RFC 5322), Mime (its parts, its encodings, its
;          charsets), Mail_thread (conversations, Zawinski's), the
;          author's playground's libs/networking/mail; its protocols,
;          Smtp and Imap (the clients), Smtp_server and Imap_server
;          (the servers' machines), and Lines, which carries them over
;          TCP or TLS
; Pim.ml, the program from a terminal (mini-pim send, list, read,
; archive); Maild.ml, mini-maild, the server its tests talk to
; (a file's text is the playground's: what it leaves unused stays, no
; warning of it an error)
(include_subdirs unqualified)

(library
 (name ix_pim)
 (wrapped false)
 (modules :standard \ Pim Maild)
 (flags (:standard -w -32-37-69))
 (libraries ix_tls ix_tcp ix_core caps unix))

(executables
 (names Pim Maild)
 (public_names mini-pim mini-maild)
 (package ix)
 (modules Pim Maild)
 (libraries ix_pim ix_tls ix_tcp ix_core fpath caps unix))
