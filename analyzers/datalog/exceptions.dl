% Which exceptions an ML program may let escape (docs/plans/
% plan_dotnet_languages.md, stage 9), over the facts of mini-ml -facts
% (Closure_facts.mli) and the calls of points_to/contexts.dl, each in a
% context (C1, C2): run with instructions.dl, andersen.dl, contexts.dl
% and its context file (insensitive.dl: 0-CFA; call1_heap1.dl: a
% function's calls apart by the call site that called it):
%   at(S, C1, C2, E)        the raise or call S, in that context, may raise E
%   arrives(T, C1, C2, E)   E may come to the try T, from its body
%   passes(T, C1, C2, E)    ... and go through: no case catches it for sure
%   escapes(F, C1, C2, E)   E may leave the function F run in that context
%   uncaught(F, E)          E may leave a unit's toplevel F: the program dies
%   from_c(F, E)            ... or a function C calls (contexts.dl's c_callback)
%   ends_in(T, E)           E may come to a try catching all whose handler
%                           raises E2 (handler_raises(T, E2)): a crash
%   raised(E, R)            an uncaught E may be raised at R
% A raised exception is its constructor when written (raise Empty), a
% handler's variable raised again what that try may arrive at, else the
% exceptions' blocks its argument may point to (pt, exn_block). Not
% here: an index out of bounds (%array_safe_get's Invalid_argument),
% and a function of the library not read raises nothing (lib_core's
% are read with the program, -L); a primitive's are its [@@raise E].
%
% cs-history:
% CLU (Barbara Liskov, 1975) and then Java made a function declare what
% it raises and the compiler check it; ML did not, and the analysis came
% after: Kwangkeun Yi's exception analysis of SML (1994, by abstract
% interpretation), Xavier Leroy and François Pessaux's for OCaml (ocamlexc,
% 2000, by types and row variables, the precision of the type checker).
% Over a call graph, as here, it is the transitive closure plus a
% subtraction at each try: the Datalog is ten lines.
%
% design:
% Over contexts.dl's calls, so a context file chooses; mini-analyze
% -exn's is call1_rec.dl. Two merges made false reports, measured on
% mini-prolog, mini-scheme and mini-datalog:
% - Printf: it reads a format by closures it returns, each one for all
%   the program's formats, their continuations captured, and a captured
%   variable has no context (contexts.dl's m-CFA design): every sprintf
%   raised what any ksprintf's continuation does (mini-scheme's fail).
%   No context file helps (call2_heap1, object1: 110-130 s, 7 GB, the
%   same answers): the model below.
% - A recursive function's callers: with call1_heap1, List.fold_left's
%   own recursive call is the context its callers all end in, so each
%   of them calls every closure given to fold_left (mini-scheme's
%   Scheme_step.Error, caught by Scheme_step.steps, reported).
%   call1_rec.dl keeps the caller's context through such a call.
% With both: mini-prolog's Halt and mini-scheme's Scheme_step.Error and
% Scheme_prims.Error gone; insensitive.dl 7 s and 380 MB on
% mini-prolog, call1_rec.dl 24 s and 1.9 GB (mini-scheme 15 and 22 s).
%
% References: Xavier Leroy, François Pessaux, "Type-based analysis of
% uncaught exceptions" (TOPLAS 2000); Kwangkeun Yi, "Compile-time
% detection of uncaught exceptions in Standard ML programs" (SAS 1994).

at(S, C1, C2, E) :- raise_of(S, E), running(S, C1, C2).
at(R, C1, C2, E) :- reraises(R, T), arrives(T, C1, C2, E).
% (a try's caught object, kept and raised again: what arrived there)
at(R, C1, C2, E) :-
  raise_in(R, F), \+ is_reraise(R), argument(R, 1, V), pt(V, C1, C2, T, H1, H2),
  arrives(T, A1, A2, E).
% (not a handler's variable: it points to every exception of the program)
at(R, C1, C2, E) :-
  raise_in(R, F), \+ is_reraise(R), argument(R, 1, V), pt(V, C1, C2, H, H1, H2),
  exn_block(H, E).
at(I, C1, C2, E) :-
  callee(I, C1, C2, G, N1, N2), \+ modeled(G), escapes(G, N1, N2, E).

% A model of the library (ocamlexc had one of its primitives): Printf's
% functions raise nothing of their own, ksprintf what its continuation
% raises, at its call. Printf interprets a format by closures it returns
% (fun s -> cont_s ...), each one closure for all the program's formats,
% their continuations captured: followed, every sprintf would raise what
% any ksprintf's continuation does (mini-scheme's fail). Not seen: the
% exceptions of a %a or %t printer, and of a format Printf refuses.
modeled_unit('Printf').
modeled(G) :- closure(G, U, L), modeled_unit(U).
continuation_taker('Printf.ksprintf').
% (from each call's argument: from continuation_taker, callee's column
% of F has no index, 1.2 billion lookups, 230 s on mini-prolog)
continuation(K, J, C1, C2) :-
  argument(J, 1, A), callee(J, C1, C2, F, N1, N2), continuation_taker(F),
  pt(A, C1, C2, K, H1, H2).
at(J, C1, C2, E) :- escapes(K, M1, M2, E), continuation(K, J, C1, C2).
is_reraise(R) :- reraises(R, T).

protected(S) :- in_try(S, T).
nested(T) :- try_in_try(T, T2).

arrives(T, C1, C2, E) :- at(S, C1, C2, E), in_try(S, T).
arrives(T2, C1, C2, E) :- passes(T, C1, C2, E), try_in_try(T, T2).
passes(T, C1, C2, E) :- arrives(T, C1, C2, E), \+ catches(T, E), \+ catches_all(T).

% (a raise is a call: in_function says where)
escapes(F, C1, C2, E) :- at(S, C1, C2, E), in_function(S, F), \+ protected(S).
escapes(F, C1, C2, E) :- passes(T, C1, C2, E), try_in_function(T, F), \+ nested(T).

uncaught(F, E) :- init(F), escapes(F, none, none, E).
% (a function C calls, contexts.dl's c_callback: the kernel's trap)
from_c(F, E) :- c_callback(F), escapes(F, none, none, E).
leaves(F, E) :- uncaught(F, E).
leaves(F, E) :- from_c(F, E).
leaves(T, E) :- ends_in(T, E).

% A try that catches all and raises from its handler E2, not what it
% caught: what arrives there ends as E2 (the kernel's guard, whose
% Machine.panic halts, then Failure). Not Invalid_argument: a handler
% building its message with ^ may raise it, and does not mean to.
gives_back(T) :- reraises(R, T).
% (what it caught raised again elsewhere: git's proto_die, given e, raises
% it unless it is Proto.Error; the caught object is the try, T)
gives_back(T) :- raise_in(R, _), argument(R, 1, V), pts(V, T).
handler_raises(T, E2) :-
  catches_all(T), \+ gives_back(T), in_handler(S, T), at(S, _, _, E2),
  E2 \= caml_exn_Invalid_argument.
converts(T) :- handler_raises(T, _).
ends_in(T, E) :- converts(T), arrives(T, _, _, E).

% where an uncaught E may be raised: a raise of E in a context it may
% leave its function from (not each raise's own way out: one of the
% function's raises of E may be caught where another is not)
% (the raises first, the exception checked last: from leaves(F, E), F
% unused, each of its tuples scanned every raise, 187 s on mini-ml)
leaving(E) :- leaves(_, E).
raised(E, R) :-
  raise_in(R, G), at(R, C1, C2, E), leaving(E), escapes(G, C1, C2, E).
