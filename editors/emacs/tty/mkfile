# mini-emacs in a terminal, built by ix's tools: the editor (../core,
# ../features, ../Config) over lib_terminal, with its Tty_unix; their
# units from their directories, by their names
TOP=../../..
DIR=editors/emacs/tty
PROG=mini-emacs-tty
T=$TOP/lib_terminal
SRC=Line_discipline Vt Curses Tui Tty_unix Text Efuns Globals Keymap Action Ebuffer Frame Window Top_window Move Edit Scroll Minibuffer Interactive Multi_buffers Multi_frames Copy_paste Search Config Main
LOCAL=`{ls *.ml ../*.ml ../*.mli ../core/*.ml ../core/*.mli ../features/*.ml ../features/*.mli ../../../lib_terminal/*.ml ../../../lib_terminal/*.mli ../../../lib_terminal/unix/*.ml ../../../lib_terminal/unix/*.mli}
GEN=
LIBI=-I .. -I ../core -I ../features -I ../../../lib_terminal -I ../../../lib_terminal/unix -I ../../../lib_playground/random
LIBUNITS=
LIBOBJS=
<$TOP/mkfiles/mkconfig
<$TOP/mkfiles/mkprog

# the others' units, by their names
$D/Line_discipline.$O: $T/Line_discipline.ml $LOCAL
	mkdir -p $D
	$ML $INCLUDES -o $target $T/Line_discipline.ml
