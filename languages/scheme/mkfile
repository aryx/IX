# languages/scheme as a library (mkfiles/mklib): the language, its
# reader, prims and evaluators, for mini-drscheme too, which compiled
# them from here before (games/mkgames's WITH=scheme;
# plan_simpler_builds.md, step 4); and mini-scheme, its SECD machine,
# CLI and Main linked with that library.
TOP=../..
<$TOP/mkfiles/mkconfig
LIB=languages/scheme
DIRS=.
NEEDS=
UNITS=Sexpr Sexpr_read Scheme_image Scheme Scheme_syntax Scheme_prims Scheme_prelude Scheme_eval Scheme_step
# (mini-scheme's own units, after the library's units they name)
DEPMORE=Scheme_secd CLI Main
<$TOP/mkfiles/mklib

all:V: $D/mini-scheme

# (its units: libs.rc's rule for ., as the library's)
PROGOBJS=${DEPMORE:%=$D/%.$O}
$PROGOBJS: $LOCAL $MLEXE
$D/mini-scheme: $PROGOBJS $D/lib.a $STDOBJS $STDEND $TOP/mkfiles/mkconfig
	$ML -ld $LINKER -- -o $target $STDOBJS $D/lib.a $PROGOBJS $STDEND
