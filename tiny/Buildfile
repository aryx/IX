boot.img: kernel.img $PROGS $LIB $LIBO $LIBC $LIBML
	cat kernel.img > $target
	for(f in $PROGS) { n=`{wc -c < $f}; echo bin/$f; echo $n; cat $f } >> $target
	for(f in $EXAMPLES) { n=`{wc -c < /examples/$f}; echo examples/$f; echo $n; cat /examples/$f } >> $target
	for(f in $SRC) { n=`{wc -c < $f}; echo src/$f; echo $n; cat $f } >> $target
	for(f in $LIB $LIBO) { n=`{wc -c < $f}; echo lib/ml/^`{basename $f}; echo $n; cat $f } >> $target
	for(f in $LIBC) { n=`{wc -c < $f}; echo lib/c/^`{basename $f}; echo $n; cat $f } >> $target
	for(f in $LIBML) { n=`{wc -c < $f}; echo lib/ml/^`{basename $f}; echo $n; cat $f } >> $target
	for(u in $UTILS) { echo bin/$u; echo link bin/utils } >> $target
	{ echo bin/editor; echo link bin/emacs; echo bin/sam; echo link bin/ed } >> $target
	echo >> $target

