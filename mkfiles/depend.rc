#
# A directory's .depend: for each of its units, a line for each other
# of its units it names (mini-ml -depend), so that mk makes a unit after
# those whose summaries it reads (languages/ml/simple/Summary.mli), and
# again when one of them is made again: ocamldep's lines for ocamlopt's
# .cmx. mk text, the objects as $obj/X.$O, obj a variable's name (D,
# L): mk's, read where the mkfile includes it. Included by the mkfiles
# (mkfiles/mkdepend, mkgames'), file made again when it is older than
# the mkfile or a source of the units' directories (or with -f), then
# printed; a unit mini-yacc makes read from its grammar until it is
# there. file, a name alone: in $obj's directory, beside the objects,
# so a build from nothing (a new B: make test's, CI's) makes it anew.
# old: .depend kept in the repository, made by mini-mk depend after a
# build, when one thought to: four directories had none (self-mix);
# then in the source directory, where make test's build found it made
# usage: $RC mkfiles/depend.rc [-f] file obj dir... -- unit...
#   [++ obj dir... -- unit...]...   (ML and INCLUDES: the environment's;
#   a unit's source: the first dir's that has it, then INCLUDES' -I's;
#   each group its objects' variable, the file theirs: mkgames' kits,
#   one ls and one file for the six. old: a file and a run each, six
#   mini-rc's and 30 processes a directory of games when nothing changed)
# (a list again: from a recipe of sh's, as kernels/singularity's, one word)
ML=`{echo $ML}
INCLUDES=`{echo $INCLUDES}
force=()
if(~ $1 -f){ force=1; shift }
file=$1
shift
if(! ~ $file */*) file=$$1/$file
# (a unit's file may be elsewhere, its own rule says where: the -I
# directories too, after those given, as mini-ml looks for a unit)
all=()
a=($*)
while(! ~ $#a 0){
	a=$a(2-)
	while(! ~ $#a 0 && ! ~ $a(1) --){ all=($all $a(1)); a=$a(2-) }
	while(! ~ $#a 0 && ! ~ $a(1) ++) a=$a(2-)
	a=$a(2-)
}
i=$INCLUDES
while(! ~ $#i 0){
	if(~ $i(1) -I && ! ~ $#i 1){ all=($all $i(2)); i=$i(3-) }
	if not i=$i(2-)
}
# (one ls: the newest of the file, the mkfile, the sources; the file
# first among those of the same second, by its name)
newest=`{ls -t $file mkfile $all^/*.ml $all^/*.mly $all^/*.mll >[2]/dev/null | sed 1q}
if(! ~ $#force 0 || ! ~ $newest $file){
	# (through another file, in /tmp: two mk may read the mkfile at
	# once)
	# (its directory by sed: Plan 9 has no dirname, Linux's basename no
	# -d; old: `{dirname $file}, every build on the card failed)
	mkdir -p `{echo $file | sed 's,/[^/]*$,,'}
	a=($*)
	{ while(! ~ $#a 0){
		obj=$a(1)
		a=$a(2-)
		if(! ~ $obj '$'*) obj='$'^$obj
		idirs=()
		while(! ~ $#a 0 && ! ~ $a(1) --){ idirs=($idirs -I $a(1)); a=$a(2-) }
		a=$a(2-)
		units=()
		while(! ~ $#a 0 && ! ~ $a(1) ++){ units=($units $a(1)); a=$a(2-) }
		a=$a(2-)
		# (a group of no units, a kit the game's WITH does not ask: none)
		if(! ~ $#units 0) $ML -depend $obj $idirs $INCLUDES $units || exit 1
	  } } > /tmp/depend.$pid
	cat /tmp/depend.$pid > $file
	rm -f /tmp/depend.$pid
}
cat $file
