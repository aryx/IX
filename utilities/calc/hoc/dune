; mini-hoc: Plan 9's hoc (principia's utilities/calc/hoc), its lexer in
; ocamllex and its grammar in yacc (menhir here, mini-lex and mini-yacc
; in the mkfile)
(library
 (name ix_hoc)
 (wrapped false)
 (modules Ast Symbol Input Lexer Parser Eval CLI)
 (libraries ix_core fpath unix caps))

(ocamllex Lexer)

(menhir
 (modules Parser)
 (flags --unused-tokens))

(executable
 (name Main)
 (public_name mini-hoc)
 (package ix)
 (modules Main)
 (libraries ix_hoc ix_core caps))
