# utilities/namespace, built by ix's tools: each program is one file, built
# with its start and its link (for Plan 9, run mini-mk O=5 OS=plan9)
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/utilities/namespace
MADE=`{mkdir -p $D}
INCLUDES=-I . $STDI
LIBS=$STDOBJS $STDEND $TOP/mkfiles/mkconfig

all:V: $D/mini-bind $D/mini-mount $D/mini-unmount

$D/%.$O: %.ml
	$ML $INCLUDES -o $target $stem.ml
$D/mini-bind: $D/Bind.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Bind.$O $STDEND
$D/mini-mount: $D/Mount.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Mount.$O $STDEND
$D/mini-unmount: $D/Unmount.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Unmount.$O $STDEND

clean:V:
	rm -rf $D
