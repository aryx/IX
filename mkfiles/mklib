# A library of ix's, built by ix's tools: its units compiled, then kept
# in one archive, $B/<its directory>/lib.a, in the order they start in
# (xix's mkfiles/mklib and its lib.cma; lib_core's lib_core.a is one
# too). `mini-ar t` lists an archive's units in that order: what a
# program's start names (mkfiles/mklibs).
# The includer sets, after mkconfig: LIB, its directory from TOP;
# UNITS, each after the ones it names; DIRS, where they are (the last
# one found taken: a system's own file after the common one); NEEDS,
# the libraries whose units they name (their dirs files say where their
# interfaces are: below), even to nothing. The libraries are built in
# order, each after the ones it needs (the top mkfile's libs, as xix's
# and principia's top mkfiles): a library's mkfile never asks another's.
# old: NEEDI asked each needed library's mini-mk (its dirs target),
# which asked its own needed ones: mini-mk run again and again by every
# mkfile read, a build where nothing changed 25 times slower
D=$B/$LIB
# NEEDI, NEEDD and LOCAL (below) by mkfiles/libs.rc, one rc for them,
# which makes $D too (below)
# old: NEEDI=`{$RC $TOP/mkfiles/dirs.rc $B $NEEDS}
#      NEEDD=`{for(d in $NEEDS) echo $B/$d/dirs}
#      LOCAL=`{for(d in $DIRS) ls $d/*.ml $d/*.mli >[2]/dev/null}
#      MADE=`{mkdir -p $D}
<|. $TOP/mkfiles/libs.rc lib
# (./%: mk makes ${DIRS:%=-I %} -Icore, goken's mk too; $D: a unit
# made there, by mini-yacc or mini-lex, the mkfile saying how, as
# typesetting/troff's pic grammar)
INCLUDES=${DIRS:%=-I ./%} -I $D $NEEDI $STDI $STDSUM
OBJS=${UNITS:%=$D/%.$O}
# $D made once, as the mkfile is read: on mini-9pi a process is a tenth
# of a second, and each unit's recipe made it, then looked for its
# source with an ls in each directory (up to ten processes a unit, a
# fifth of lib_core's build on the card, plan_self_hosting.md); its
# source is now found in $LOCAL by rc's ~, a unit made in $D (mini-yacc's)
# when no directory has it.
# old: mkdir -p $D
#      for(d in $DIRS $D) if(ls $d/$stem.ml >/dev/null >[2=1]) f=$d/$stem.ml

# (lib: what mkfiles/mklibs asks; a library's mkfile may make a program
# too, all then, as browsers/javascript's mini-node)
all:V: $D/lib.a $D/dirs
lib:V: $D/lib.a $D/dirs

# (and the compiler, MLEXE: mkconfig)
# old: $D/%.$O: $LOCAL
$D/%.$O: $LOCAL $MLEXE
	f=()
	for(d in $DIRS) if(~ $d/$stem.ml $LOCAL) f=$d/$stem.ml
	if(~ $#f 0) f=$D/$stem.ml
	$ML $INCLUDES -o $target $f
$D/lib.a: $OBJS mkfile
	rm -f $target
	$AR u $target $OBJS

# its directories, for a program's -I (mkfiles/mklibs reads them: the
# library knows which, a system's or a platform's among them), and the
# ones of the libraries it needs (an interface names their types),
# written beside its archive
$D/dirs: mkfile $NEEDD
	{ for(d in $DIRS $D) echo -I `{cd $d && pwd}
	  echo $NEEDI | awk '{ for (i = 1; i < NF; i += 2) print $i, $(i + 1) }' } > $target

# the units' order (mkfiles/mkdepend); DEPMORE, as mkprog's: a
# program's units compiled here, not the library's, their sources in
# the mkfile's directory (., after DIRS)
DEPOBJ=D
DEPDIRS=$DIRS . $D
DEPUNITS=$UNITS $DEPMORE
<$TOP/mkfiles/mkdepend

clean:V:
	rm -rf $D
