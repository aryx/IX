# A program of ix's, built by mini-ml. Its mkfile sets TOP, DIR (its
# directory from TOP), PROG, SRC (its units, each before the ones that
# name it, the main last), LOCAL (its sources), GEN (the units mini-lex
# and mini-yacc make: $D/Parser.ml...), and what else it links: LIBI
# (-I for other directories of ix, whose interfaces it names), LIBUNITS
# and LIBOBJS (their units and their objects, in order). Each is set,
# even to nothing. LIBDIRS, when it is, names the libraries it links
# (mkfiles/mklibs: lib_graphics...). Then it includes mkconfig and this file; a unit in a
# subdirectory (compat/Follow) has a rule of its own after, by its name.
# (Not ${LIBDIRS:%=-I %}: of an empty list, mk gives the name LIBDIRS.)

D=$B/$DIR
OBJS=${SRC:%=$D/%.$O}
# (the program's LIBI kept: mklibs sets LIBI, its libraries')
PROGI=$LIBI
<$TOP/mkfiles/mklibs
INCLUDES=-I . -I $D $PROGI $LIBI $STDI
# $D made once, as the mkfile is read, not by each recipe (a process
# each on mini-9pi: mkfiles/mklib)
MADE=`{mkdir -p $D}

all:V: $D/$PROG

# a unit: mini-ml reads the others' interfaces from their sources, so a
# change in any of the directory's files remakes them all (a second each);
# and the summaries of those it names (their small functions inlined),
# which .depend makes before it. The source alone the rule's prerequisite,
# the others every unit's (below): a unit in a folder then has its
# mkfile's rule, this one dropped (mk's vacuous arcs; with $LOCAL here,
# two recipes for it)
# old: $D/%.$O: %.ml $LOCAL $GEN $LIBSRC
$D/%.$O: %.ml
	$ML $INCLUDES -o $target $stem.ml
$OBJS: $LOCAL $GEN $LIBSRC

# a lexer and a parser: made beside the objects; the mkfile has the rule
# that compiles each ($D/Parser.$O: $D/Parser.ml), which here would be
# a second way to make every unit, and mk refuses two
$D/%.ml: %.mll
	$LEX -o $target $stem.mll
$D/%.ml: %.mly
	$YACC -b $D/$stem $stem.mly

# the start: the units' initializations, in their order
# claude: named after the program, not start.$O: where the file names'
# case does not count (macOS), that is a unit Start's object too
# (editors/emacs's Start.ml)
$D/$PROG.start.$O: mkfile $TOP/mkfiles/mkconfig
	$ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA} $LIBUNITS $SRC Std_exit -o $target

# (the libraries too: a program is linked again when one of them is remade)
# -nofollow: the code in the objects' order, not moved along its flow as
# 5l does (linker/compat/, for goken's bytes): a program of 1 MB of code
# then has conditional branches farther than they reach
$D/$PROG: $D/$PROG.start.$O $OBJS $LIBA $LIBOBJS $STDOBJS $STDEND $TOP/mkfiles/mkprog
	$LD $LDH -nofollow -o $target $D/$PROG.start.$O $STDOBJS $LIBA $LIBOBJS $OBJS $STDEND

# the units' order (mkfiles/depend.rc): mini-mk depend after a build
depend:V: $GEN
	$RC $TOP/mkfiles/depend.rc '$D' . $D -- $SRC > .depend
<.depend

clean:V:
	rm -rf $D
