# mini-git, mini-diff and mini-merge3, built by ix's tools: one set of
# units, three mains; SHA-1 and zlib from the libraries (mkfiles/mklibs:
# lib_crypto, lib_compression); the units are in folders (objects, repo,
# diff, wire, commands)
# old: Sha1 and Zlib compiled here, by their names in the libraries'
# directories
TOP=..
DIR=version_control
PROG=mini-git
VCS=Conf Delta Diff Flags Hash Merge3 Object Pack Proto Loose Difftool Store Repo Refs Query Packer Log \
 Index9 Get Fs Save Send Serve Walk Commands CLI
SRC=$VCS Main
LOCAL=`{ls *.ml *.mli objects/*.ml* repo/*.ml* diff/*.ml* wire/*.ml* commands/*.ml*}
GEN=
LIBI=-I objects -I repo -I diff -I wire -I commands
LIBDIRS=lib_crypto lib_compression
LIBUNITS=
LIBOBJS=
# (the two other programs' mains, below, after the units they name)
DEPMORE=Diffmain Merge3main
<$TOP/mkfiles/mkconfig
<$TOP/mkfiles/mkprog

# each folder's units, a rule each, its source the prerequisite (one %
# rule for every unit, beside mkprog's, mk refuses), one recipe a unit,
# so that .depend orders each: repo objects diff commands wire
# old: the folders' units said whole, compiled by one recipe, each found
#   by its name (*/)
$D/%.$O: repo/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target repo/$stem.ml
$D/%.$O: objects/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target objects/$stem.ml
$D/%.$O: diff/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target diff/$stem.ml
$D/%.$O: commands/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target commands/$stem.ml
$D/%.$O: wire/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target wire/$stem.ml

# the two other programs: the same units, each its main and its start
all:V: $D/mini-diff $D/mini-merge3
VCSOBJS=${VCS:%=$D/%.$O}
$D/start_diff.$O: mkfile $TOP/mkfiles/mkconfig
	$ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA} $VCS Diffmain Std_exit -o $target
$D/mini-diff: $D/start_diff.$O $LIBA $VCSOBJS $D/Diffmain.$O $STDOBJS $STDEND
	$LD -H7 -nofollow -o $target $D/start_diff.$O $STDOBJS $LIBA $VCSOBJS $D/Diffmain.$O $STDEND
$D/start_merge3.$O: mkfile $TOP/mkfiles/mkconfig
	$ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA} $VCS Merge3main Std_exit -o $target
$D/mini-merge3: $D/start_merge3.$O $LIBA $VCSOBJS $D/Merge3main.$O $STDOBJS $STDEND
	$LD -H7 -nofollow -o $target $D/start_merge3.$O $STDOBJS $LIBA $VCSOBJS $D/Merge3main.$O $STDEND
