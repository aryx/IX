# browsers/engine's boxes by ix's tools (mini-mk): Boxes with its start
# and its link, with the libraries (mkfiles/mklibs: browsers/html, css
# and engine; boxes.sh runs it)
# old: their units compiled here
TOP=../../..
<$TOP/mkfiles/mkconfig
D=$B/browsers/engine/tests
LIBDIRS=browsers/html browsers/css browsers/engine
<$TOP/mkfiles/mklibs
INCLUDES=-I . $LIBI $STDI
LIBS=$LIBA $STDOBJS $STDEND $TOP/mkfiles/mkconfig

all:V: $D/boxes

$D/Boxes.$O: Boxes.ml $LIBSRC
	mkdir -p $D
	$ML $INCLUDES -o $target Boxes.ml
$D/boxes: $D/Boxes.$O $LIBS
	$ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA} Boxes Std_exit -o $D/Boxes.start.$O
	$LD $LDH -nofollow -o $target $D/Boxes.start.$O $STDOBJS $LIBA $D/Boxes.$O $STDEND

clean:V:
	rm -rf $D
