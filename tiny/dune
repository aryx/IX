; TinyLibDraw.ml, a program's side of it, and TinyWindows.ml, tiny-kernel's
; window system: tiny-ml compiles them for the machine (TinyKernel/'s
; Makefile); OCaml too, which only checks the second (its externals are
; the machine's: no program is linked)
(library
 (name tiny_lib_draw)
 (wrapped false)
 (modules TinyLibDraw))

; TinyLibPlayground.ml, what a game of tiny-kernel's is written on, here
; for a game's test on the host: TinyCalls is the kernel's calls, kept
(library
 (name tiny_lib_playground)
 (wrapped false)
 (modules TinyLibPlayground)
 (libraries tiny_lib_draw tiny_host_calls))

; TinyAppTetris.ml, a game on it (tiny-kernel's tetris)
(library
 (name tiny_app_tetris)
 (wrapped false)
 (modules TinyAppTetris)
 (libraries tiny_lib_playground))

; TinyEditorScreen.ml, the screen editor: the editor itself, with no system
