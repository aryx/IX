# ../features, ../modes, ../Config) over lib_terminal, with its
# Tty_unix, and the languages' highlighters (lib_code, languages/*/highlight,
# assembler/highlight; two lexers made by mini-lex); their units from
# their directories, by their names
TOP=../../..
DIR=editors/emacs/tty
PROG=mini-emacs-tty
T=$TOP/lib_terminal
SRC=Line_discipline Vt Curses Tui Tty_unix Highlight_code Token_ml Lexer_ml Highlight_ml Token_c Lexer_c Highlight_c Highlight_asm Highlight_st Highlight_scheme Highlight_pascal Text Efuns Globals Keymap Action Ebuffer Frame Window Top_window Move Edit Scroll Minibuffer Interactive Multi_buffers Multi_frames Copy_paste Search Highlight Indent Paren_mode Ocaml_mode C_mode Asm_mode Smalltalk_mode Scheme_mode Pascal_mode Config Main
