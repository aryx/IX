# mini-tiger, built by ix's tools: its lexer by mini-lex, its grammar by
# mini-yacc, its back end in dotnet/, over languages/dotnet/assembly,
# the library that writes an assembly
TOP=../..
DIR=languages/tiger
PROG=mini-tiger
SRC=Tiger_ast Tiger_parser Tiger_lexer Tiger_tree Tiger_semant Tiger_emit CLI Main
LOCAL=`{ls *.ml *.mli *.mly *.mll dotnet/*.ml dotnet/*.mli}
LIBI=-I dotnet
# (the assembly's writer, Writer and what it stands on)
LIBDIRS=languages/dotnet/assembly
<$TOP/mkfiles/mkconfig
GEN=$B/languages/tiger/Tiger_parser.ml $B/languages/tiger/Tiger_lexer.ml
LIBOBJS=
<$TOP/mkfiles/mkprog

$D/Tiger_parser.$O: $D/Tiger_parser.ml $LOCAL
	$ML $INCLUDES -o $target $D/Tiger_parser.ml
$D/Tiger_lexer.$O: $D/Tiger_lexer.ml $D/Tiger_parser.ml $LOCAL
	$ML $INCLUDES -o $target $D/Tiger_lexer.ml
$D/Tiger_emit.$O: dotnet/Tiger_emit.ml $LOCAL
	$ML $INCLUDES -o $target dotnet/Tiger_emit.ml
