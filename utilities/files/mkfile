# utilities/files, built by ix's tools: each program is one file, built
# with its start and its link (for Plan 9, run mini-mk O=5 OS=plan9)
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/utilities/files
MADE=`{mkdir -p $D}
INCLUDES=-I . $STDI
LIBS=$STDOBJS $STDEND $TOP/mkfiles/mkconfig

all:V: $D/mini-cat $D/mini-ls $D/mini-pwd $D/mini-mkdir $D/mini-rm $D/mini-cp $D/mini-mv $D/mini-touch $D/mini-chmod $D/mini-mtime $D/mini-walk

$D/%.$O: %.ml
	$ML $INCLUDES -o $target $stem.ml
$D/mini-cat: $D/Cat.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Cat.$O $STDEND
$D/mini-ls: $D/Ls.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Ls.$O $STDEND
$D/mini-pwd: $D/Pwd.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Pwd.$O $STDEND
$D/mini-mkdir: $D/Mkdir.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Mkdir.$O $STDEND
$D/mini-rm: $D/Rm.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Rm.$O $STDEND
$D/mini-cp: $D/Cp.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Cp.$O $STDEND
$D/mini-mv: $D/Mv.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Mv.$O $STDEND
$D/mini-touch: $D/Touch.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Touch.$O $STDEND
$D/mini-chmod: $D/Chmod.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Chmod.$O $STDEND
$D/mini-mtime: $D/Mtime.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Mtime.$O $STDEND
$D/mini-walk: $D/Walk.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Walk.$O $STDEND

clean:V:
	rm -rf $D
