# games/arcade, built by ix's tools (../mkgames)
TOP=../..
DIR=games/arcade
GAMES=TinyCameltry
WITH=physics
# (TinyBreakout asks for other libraries, the sound and the juice: made
# by mk called again with its own GAMES and WITH, a command line's
# variables being stronger than a mkfile's. Not WITH=physics audio
# juice for both: a program linked with Audio has a sound, and
# TinyCameltry would mix its silence at each frame)
# (and TinyTronscroll for the netcode and the network: a program is its
# units whole)
all:V: games sounding networked
sounding:V: games
	b=; case $B in /*) b="B=$B";; esac
	mini-mk O=$O OS=$OS PLATFORM=$PLATFORM $b GAMES=TinyBreakout 'WITH=audio juice' games
networked:V: sounding
	b=; case $B in /*) b="B=$B";; esac
	mini-mk O=$O OS=$OS PLATFORM=$PLATFORM $b GAMES=TinyTronscroll WITH=multiplayer games
<../mkgames
