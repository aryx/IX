# apps/music/play, built by ix's tools: lib_audio's units (and Lehmer,
# which Sfx draws its numbers from), compiled here, each found by its
# name in the library's folders, then mini-play with its start and its
# link. mini-mk O=5 OS=plan9: for mini-9pi.
TOP=../../..
<$TOP/mkfiles/mkconfig
D=$B/apps/music/play
A=$TOP/lib_audio
DIRS=$TOP/lib_playground/random $A/signal $A/synthesis $A $A/formats/abc $A/formats/wav $A/formats/midi $A/formats/mod $A/formats/mpeg_audio $A/formats/vorbis .
INCLUDES=-I $TOP/lib_playground/random -I $A/signal -I $A/synthesis -I $A -I $A/formats/abc -I $A/formats/wav -I $A/formats/midi -I $A/formats/mod -I $A/formats/mpeg_audio -I $A/formats/vorbis -I . $STDI
# (each before the ones that name it)
LIB=Lehmer Pitch_effect Control Signal Noise Envelope Filter Pluck Fm Oscillator Mod Layer3_tables Mpeg_audio_header Bitstream Polyphase Imdct Abc Doremi Vlc Layer3 Layer2 Midi Mix Resample Space Synth Wav Paula Mpeg_audio Mod_player Ogg Vorbis Vorbis_player Music Instrument Sfx Mixer Player
LIBOBJS=${LIB:%=$D/%.$O}
LOCAL=`{ls *.ml ../../../lib_playground/random/Lehmer.ml* ../../../lib_audio/*.ml* ../../../lib_audio/*/*.ml* ../../../lib_audio/formats/*/*.ml*}
LIBS=$LIBOBJS $STDOBJS $STDEND $TOP/mkfiles/mkconfig

all:V: $D/mini-play

$D/%.$O: $LOCAL
	mkdir -p $D
	for(d in $DIRS) if(ls $d/$stem.ml >/dev/null >[2=1]) f=$d/$stem.ml
	$ML $INCLUDES -o $target $f
$D/mini-play: $D/Play.$O $LIBS mkfile
	$ML -start $STD $COMMONS $LIB Play Std_exit -o $D/Play.start.$O
	$LD $LDH -nofollow -o $target $D/Play.start.$O $STDOBJS $LIBOBJS $D/Play.$O $STDEND

# the units' order (mkfiles/depend.rc): mini-mk depend after a build.
# old: none, the units made in any order: with NPROC 4 one compiled
# before the summary of another it names, nothing of it inlined
# (self-mix: Linux's objects not the card's, made one after the other)
depend:V:
	$RC $TOP/mkfiles/depend.rc '$D' $DIRS -- $LIB Play > .depend
<.depend

clean:V:
	rm -rf $D
