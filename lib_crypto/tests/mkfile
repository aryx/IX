# lib_crypto's vectors, built by ix's tools (mini-mk): Vectors and
# Speed, each with its start and its link with the library
# (mkfiles/mklibs). vectors.sh runs it.
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/lib_crypto/tests
MADE=`{mkdir -p $D}
LIBDIRS=lib_crypto
<$TOP/mkfiles/mklibs
INCLUDES=-I . $LIBI $STDI
LIBS=$LIBA $STDOBJS $STDEND $TOP/mkfiles/mkconfig mkfile

all:V: $D/vectors $D/speed

$D/%.$O: %.ml $LIBSRC
	$ML $INCLUDES -o $target $stem.ml
$D/vectors: $D/Vectors.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $LIBA $D/Vectors.$O $STDEND
$D/speed: $D/Speed.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $LIBA $D/Speed.$O $STDEND

clean:V:
	rm -rf $D
