# The standard tiny library, OCaml's subset: every ML program's first units,
# kept in one library, stdlib.a, which a program links (ld ... stdlib.a),
# and their interfaces, each unit's .tmi, which tiny-ml reads
# (ml -L TinyLibCore).
# Called from ../Buildfile by `cd TinyLibCore && build`.
#
#     build                  stdlib.a, and the units' .o and .tmi
#     build depend           .depend again, after a unit names another one
#     tiny-build TINY=tiny-  the same on the host, by tiny-ml and tiny-ar

# the tools, tiny-kernel's names, the host's by TINY=tiny- (the top
# Buildfile gives its own, ML=... AR=...)
TINY =
ML = ${TINY}ml
AR = ${TINY}ar

# its units, in the order they start in: the archive's, which every
# program links in it (Stdlib first: what the others call)
CORE = Stdlib Char Seq List String Bytes Array Option Int32 Int64 \
    Filename Buffer Printf Marshal Hashtbl Common Sha1 Fpath Fpath_ Exit \
    In_channel Out_channel Chan Logs

stdlib.a: ${CORE:%=%.o}
	$AR -o $target $prereq

# a unit, with the interfaces of the units it names, Stdlib's first, as
# OCaml opens it: the library is here (-L .), being made, each unit
# after those it names, its line in .depend
%.o: %.ml
	$ML -c -L . -o $target $stem.ml
%.tmi: %.o

# the units' dependencies, written by ml -depend as ocamldep writes OCaml's
depend:
	$ML -depend -I . *.ml > .depend

<.depend

clean:
	rm -f *.o *.tmi stdlib.a
