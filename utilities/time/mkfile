# utilities/time, built by ix's tools: each program is one file, built
# with its start and its link (for Plan 9, run mini-mk O=5 OS=plan9)
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/utilities/time
MADE=`{mkdir -p $D}
INCLUDES=-I . $STDI
LIBS=$STDOBJS $STDEND $TOP/mkfiles/mkconfig

all:V: $D/mini-date $D/mini-cal

$D/%.$O: %.ml
	$ML $INCLUDES -o $target $stem.ml
$D/mini-date: $D/Date.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Date.$O $STDEND
$D/mini-cal: $D/Cal.$O $LIBS
	$ML -ld $LINKER -- -o $target $STDOBJS $D/Cal.$O $STDEND

clean:V:
	rm -rf $D
