% cat /mnt/fat/config.txt
# mini-9pi's SD card (kernels/9pi's make card): what the Raspberry Pi's
# firmware reads from the FAT partition before it starts a kernel
# (kernels/firmware/README.md).

# the firmware's own memory, the least: the cut-down firmware (start_cd.elf)
gpu_mem=16

# One card for the Pi 1 and the Pi 2 (docs/plans/plan_pi2.md): the
# firmware reads the section of the board it is on, and loads that
# board's mini-9pi (make card), each with ix's programs in its image,
# at 0x8000. (The sections want a firmware that knows them:
# kernels/firmware/pi1-pi2's does; the files of 2015 would take every
# line, and the last kernel=.)

# the Pi 2 (the 2B, with a BCM2836 or a BCM2837)
[pi2]
kernel=mini9pi2.img

# the Pi 1 (and the Zero)
[pi1]
kernel=mini9pi1.img

# The processor overclocked (it is 700 MHz), by the Foundation's
# settings for a Pi 1: one block of the four below, the others
# commented out. force_turbo: at that speed always, not only when the
# system asks (mini-9pi does not ask). The kernel says the speed it
# measures, before the prompt ("cpu: 800 MHz") and in /dev/cputype. If
# the board does not start, or programs die: a slower block, or none.

# Modest: no more voltage. The author's Pi1, 2026-10-08: "looks good,
# slightly faster indeed", and the kernel's 800.
arm_freq=800
core_freq=250
sdram_freq=400
over_voltage=0
force_turbo=1

# Medium. More voltage: with force_turbo, the board's warranty bit is
# set, for good. Not tried.
#arm_freq=900
#core_freq=250
#sdram_freq=450
#over_voltage=2
#force_turbo=1

# High. Not tried.
#arm_freq=950
#core_freq=250
#sdram_freq=450
#over_voltage=6
#force_turbo=1

# Turbo: known to corrupt SD cards (core_freq). Not tried.
#arm_freq=1000
#core_freq=500
#sdram_freq=600
#over_voltage=6
#force_turbo=1

# what follows is every board's again
[all]
