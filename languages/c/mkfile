# mini-cc, built by ix's tools: the front end, its lexer (by mini-lex)
# and its grammar (by mini-yacc), then the back ends (compat/, simple/,
# opti/, ssa/), the command
TOP=../..
DIR=languages/c
PROG=mini-cc
SRC=Tree Tree_helpers Pre Check Declare Machines Emit Com64 Parser Lexer \
 Multiply Acom Regs Cgen Arm Arm64 Prtree Ir Lower Gen Opti Peep Dominators Braun Liveness Coloring Ssa Ssa_build Alloc Ssa_gen \
 Facts Ir_facts CLI Main
LOCAL=`{ls *.ml *.mli *.mly *.mll compat/*.ml compat/*.mli simple/*.ml simple/*.mli opti/*.ml opti/*.mli ssa/*.ml ssa/*.mli facts/*.ml facts/*.mli ../../lib_code/*.ml ../../lib_code/*.mli}
LIBI=-I ../../assembler -I compat -I simple -I opti -I ssa -I facts -I ../../lib_code
LIBUNITS=Asm Show_asm
<$TOP/mkfiles/mkconfig
GEN=$B/languages/c/Parser.ml $B/languages/c/Lexer.ml
LIBOBJS=$B/assembler/Asm.$O $B/assembler/Show_asm.$O
<$TOP/mkfiles/mkprog

# the units that are not here: the parser mini-yacc made, and each
# back end's, by their names (a second rule with % for every unit, mk
# refuses); a rule of several units is run once for those to make
$D/Parser.$O: $D/Parser.ml $LOCAL
	$ML $INCLUDES -o $target $D/Parser.ml
$D/Lexer.$O: $D/Lexer.ml $D/Parser.ml $LOCAL
	$ML $INCLUDES -o $target $D/Lexer.ml
# compat/'s units (Multiply Acom Regs Cgen Arm Arm64 Prtree): one recipe each, so that .depend orders each
$D/%.$O: compat/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target compat/$stem.ml
# simple/'s units (Ir Lower Gen): one recipe each, so that .depend orders each
$D/%.$O: simple/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target simple/$stem.ml
# opti/'s units (Opti Peep): one recipe each, so that .depend orders each
$D/%.$O: opti/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target opti/$stem.ml
# lib_code's units (Dominators Braun Liveness Coloring: SSA's algorithms,
# mini-ml's too): one recipe each, so that .depend orders each
$D/%.$O: $TOP/lib_code/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target $TOP/lib_code/$stem.ml
# ssa/'s units (Ssa Ssa_build Alloc Ssa_gen): one recipe each, so that .depend orders each
$D/%.$O: ssa/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target ssa/$stem.ml
# facts/'s units (Facts Ir_facts): one recipe each, so that .depend orders each
$D/%.$O: facts/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target facts/$stem.ml
