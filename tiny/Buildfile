	$LD -map -s -n -o $target $prereq
user/mltests.o: user/mltests.c runtime/c/user.h
mltests: $CRT user/mltests.o
	$LD -map -s -n -o $target $prereq
user/ping.o: user/ping.c runtime/c/user.h
ping: $CRT user/ping.o
	$LD -map -s -n -o $target $prereq
user/get.o: user/get.c runtime/c/user.h
get: $CRT runtime/c/net.o user/get.o
	$LD -map -s -n -o $target $prereq
user/put.o: user/put.c runtime/c/user.h
put: $CRT runtime/c/net.o user/put.o
	$LD -map -s -n -o $target $prereq
user/httpd.o: user/httpd.c runtime/c/user.h
httpd: $CRT user/httpd.o
	$LD -map -s -n -o $target $prereq
user/paint.o: user/paint.c runtime/c/user.h runtime/c/draw.h
paint: $CRT runtime/c/draw.o user/paint.o
	$LD -map -s -n -o $target $prereq

#############################################################################
# The kernel: TinyKernel/
#############################################################################

# Made by its own Buildfile, TinyKernel/Buildfile, from its units, its
# assembly and the library; run each time, as the library's (kernel,
# not a file), after it. TinyKernel/kernel.img made with it
kernel: $STDLIB
	cd TinyKernel && $BUILD ML=^$ML CC=^$CC AS=^$AS LD=^$LD
TinyKernel/kernel.img: kernel

#############################################################################
# The system and the image
#############################################################################

# The system, by build install, in /bin, /lib and /examples: on
# tiny-kernel the disk's (make self), on the host a directory, which
# TinyKernel/Makefile makes a disk of, disk.img (by tiny-mkfs, on the
# host; the sources, /src, are the second disk, src.img).
#
# /bin: the programs; utils under each of its names, a hard link (cat is
# utils, ls, wc...), emacs as editor too, ed as sam
UTILS = [ basename cat cmp cp date du echo grep kill ln ls mkdir mv ps pwd \
    rm seq sleep sort tail tee test touch walk wc xd

# /lib: what a program built on tiny-kernel links, already built here.
# /lib/c, C's: the runtime, the system's calls, drawing and dialing,
# and their headers (cc -I /lib/c: user.h, which includes libc.h).
# /lib/ml, ML's: its runtime, the program's end, the library, its
# archive and its units' interfaces (ml -L /lib/ml), and the libraries
# a program that draws stands on, each its object and its interface
# (ml -I /lib/ml): the system's calls, the drawing's messages, the
# playground, the widgets
LIBC = runtime/c/start.o runtime/c/udivmod.o runtime/c/libc.o \
    runtime/c/sys.o runtime/c/draw.o runtime/c/net.o \
    runtime/c/libc.h runtime/c/user.h runtime/c/draw.h
MLLIBS = $SYS $DRAWLIB $PLAYGROUND $GUI
LIBML = runtime/ml/mlsys.o runtime/ml/end.o \
    $MLLIBS ${MLLIBS:%.o=%.tmi}
# (the .tmi made with stdlib.a, by TinyLibCore/Buildfile; not
# prerequisites: this file's %.tmi would make them again)
LIBUNITS = ${CORE:%=TinyLibCore/%.tmi} $STDLIB

# /examples: examples/'s files, by their kinds, rc's globs (its sources,
# not what a build of them there makes: the programs, *.o, *.tmi,
# *.map); not prerequisites, so an example changed alone does not make
# the disk again
#
# build install: the files above copied where they go, from where they
# are built (Plan 9's mk install). On the host, into a directory, the
# three by their names (TinyKernel/Makefile's _make/system):
#     tiny-build TINY=tiny- BIN=d/bin LIB=d/lib EXAMPLES=d/examples install
# Not a file: it runs each time it is asked
BIN = /bin
LIB = /lib
EXAMPLES = /examples
install: $PROGS $LIBC $LIBML $STDLIB
	mkdir -p $BIN $LIB/c $LIB/ml $EXAMPLES
	for(f in $PROGS) cp $f $BIN/$f
	for(u in $UTILS) { rm -f $BIN/$u; ln $BIN/utils $BIN/$u }
	rm -f $BIN/editor $BIN/sam; ln $BIN/emacs $BIN/editor; ln $BIN/ed $BIN/sam
	for(f in $LIBC) cp $f $LIB/c/^`{basename $f}
	for(f in $LIBML $LIBUNITS) cp $f $LIB/ml/^`{basename $f}
	cp examples/Buildfile examples/*.c examples/*.ml examples/*.s examples/*.prof examples/*.ixd examples/*.wav $EXAMPLES

# boot.img: the kernel, then /boot's files, each its name, its size and
# its bytes (a hard link a name and a line "link utils"); an empty line
# at the end. /boot is what a person needs when the disk does not come
# up, the repair kit: sh, rc, the utilities, ed, in bin/ (the first
# process is /bin/sh, the disk's, else the image's); and the boot's
# configuration, memory: MEMORY, from the environment
# (TinyKernel/Makefile's MEMORY=segments or pages), the kernel's way of
# giving memory, with MEMSIZE. The same recipe on the host and on
# tiny-kernel, in a copy of tiny/ (TinyKernel/Makefile's _make/src, the
# second disk's /src). One file is made on the host alone, before:
# TinyKernel/kfont.s, the font's bytes.
BOOT = sh rc utils ed
boot.img: TinyKernel/kernel.img $BOOT
	cat TinyKernel/kernel.img > $target
	for(f in $BOOT) { n=`{wc -c < $f}; echo bin/$f; echo $n; cat $f } >> $target
	for(u in $UTILS) { echo bin/$u; echo link bin/utils } >> $target
	{ echo bin/sam; echo link bin/ed } >> $target
	if(~ $MEMORY segments pages) { echo memory; echo $MEMSIZE; echo $MEMORY } >> $target
	echo >> $target
#`

#############################################################################
# The units' dependencies
#############################################################################

# The ML units' rules, in .depend: a unit's object, then the interfaces
# of the units it names and its .mli, written by ml -depend as ocamldep
# writes OCaml's (and m-ix's mini-ml -depend). Its sources are every
# .ml of INCLUDES' directories, then each program's with parts, by its
# own -I's (its main file's line again, now with its parts; tiny-build
# merges a target's lines) (a unit added is found; the host's
# programs among them, TinyCPU.ml and TinyMachine.ml, are lines no
# target asks for, or left out, said, when tiny-ml cannot read them).
# The globs are written here, not in a variable: rc does not glob a *
# that comes from one. .depend is kept beside this file, as
# ocaml-light's stdlib keeps its own (TinyLibCore/ and TinyKernel/ have
# theirs, made again too): `build depend` makes it again after a unit
# names another one, or a unit is added.
depend:
	$ML -depend $INCLUDES *.ml TinyLibSystem/tinykernel/*.ml user/*.ml > .depend
	$ML -depend $INCLUDES $CC_INCLUDES TinyC.ml TinyC/*.ml >> .depend
	$ML -depend $INCLUDES $ML_INCLUDES TinyML.ml TinyML/*.ml >> .depend
	$ML -depend $INCLUDES $OFFICE_INCLUDES TinyOffice.ml TinyTroff.ml TinyOffice/*.ml >> .depend
	$ML -depend $INCLUDES $WWW_INCLUDES TinyBrowser.ml TinyBrowser/*.ml >> .depend
	@{ cd TinyLibCore && $BUILD ML=^$ML depend }
	@{ cd TinyKernel && $BUILD ML=^$ML depend }

<.depend

#############################################################################
# clean: what this file made removed (the objects and interfaces beside
# their sources, each directory by name; the programs, the image, the
# maps; the library's and the kernel's by their Buildfiles)
#############################################################################

clean:
	@{ cd TinyLibCore && $BUILD clean }
	@{ cd TinyKernel && $BUILD clean }
	rm -f *.o *.tmi TinyBrowser/*.o TinyBrowser/*.tmi TinyC/*.o TinyC/*.tmi \
	    TinyLibSystem/tinykernel/*.o TinyLibSystem/tinykernel/*.tmi \
	    TinyML/*.o TinyML/*.tmi TinyOffice/*.o TinyOffice/*.tmi \
	    runtime/c/*.o runtime/ml/*.o \
	    user/*.o user/*.tmi *.map $PROGS boot.img
