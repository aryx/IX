#
# mkconfig's values that depend on the system, as mk text, for mk's <|:
# one rc and one echo where a backquote each took an rc and an echo
# (7 of them, read by every mini-mk: three times longer a build where
# nothing changed, 2026-10-22). Read by rc's . (no rc started for it),
# in two parts: machine (from $objtype, as before mkconfig's O and OS
# from the command line, which mk keeps over these), then system (from
# the O and OS mk then has).
# usage: <|. $TOP/mkfiles/config.rc machine|system
switch($1){
case machine
	# the tools' names: mini-ml on Linux, ml on mini-9pi's card
	p=''
	o=5
	os=plan9
	if(~ $#objtype 0){ p=mini-; o=7; os=linux }
	if(~ $objtype arm64) o=7
	# mini-ml's optimizations: all (-O3), or the environment's
	# (MLOPT=-O0: none, the simple code generator's whole build)
	if(~ $#MLOPT 0) MLOPT=-O3
	echo 'TOOLPRE='^$p^'
O='^$o^'
OS='^$os^'
MLOPT='^$"MLOPT
	# MLEXE, the compiler's file (rc's whatis, a lookup in $path; none
	# when not found): the objects depend on it, an older mini-ml's
	# remade (its start objects named curry functions that a newer one
	# put elsewhere: mini-ld's "undefined: ml_curry9_0", 2026-10-26)
	echo -n 'MLEXE='
	whatis $p^ml >[2]/dev/null
case system
	ldh=-H7
	b=$TOP/_mk/$O-$OS
	unixdir=system
	p9dir=commons
	if(~ $OS plan9){ ldh=-H2; unixdir=system/plan9; p9dir=system/plan9 }
	if(~ $OS linux) b=$TOP/_mk/$O
	# (rc's glob, not an ls)
	rtsrc=($TOP/languages/ml/runtime/*.[ch])
	echo 'LDH='^$ldh^'
B='^$b^'
UNIXDIR='^$unixdir^'
P9DIR='^$p9dir^'
RTSRC='^$"rtsrc
}
