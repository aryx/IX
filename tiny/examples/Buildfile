#
# hello, from hello.c and square.tm, and helloml, from helloml.ml, built
# on tiny-kernel by build in /examples (see hello.c and helloml.ml): both
# by default, or one by its name (build helloml). What they link besides
# their own objects is already built in /lib: /lib/c, C's runtime and
# tiny-kernel's calls, start.o first (the machine starts there); /lib/ml,
# ML's runtime (mlsys.o), the library (its units, [A-Z]*.o: mlsys.o and
# end.o are lowercase), and end.o, the image's end, last.
# Each has its Buildfile, which says how it is made from /src. -s puts
# the labels after the image, the names debug shows; -map writes them
# beside it too.

CRT = /lib/c/start.o /lib/c/udivmod.o /lib/c/libc.o /lib/c/sys.o

all: hello helloml

hello: hello.o square.o
	ld -map -s -n -o $target $CRT $prereq

hello.o: hello.c /src/TinyKernel/libc/user.h
	cc -o $target hello.c
square.o: square.tm
	as -o $target square.tm

helloml: helloml.o
	ld -map -s -n -o $target $CRT /lib/ml/mlsys.o $prereq /lib/ml/[A-Z]*.o /lib/ml/end.o

# (one unit: its code and its main in one object)
helloml.o: helloml.ml
	ml -o $target helloml.ml

# build clean: what build made here removed, by name: /examples has
# other files that *.o and *.map would take (TinyLibMachine.o, spin.map).
# A target that makes no file is never up to date, so it always runs
clean:
	rm -f hello helloml hello.o square.o helloml.o hello.map helloml.map
