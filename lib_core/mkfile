# The libraries every program of ix links, built by ix's tools: the
# stdlib and ix's own library (mini-ml), mini-ml's runtime (mini-cc),
# and the C library under it (libc/: by mini-cc and mini-asm, kept by
# mini-ar).
TOP=..
<$TOP/mkfiles/mkconfig

all:V: $STDOBJS $STDEND

# a unit is in one of the directories: the rule whose source is there
$L/%.$O: core/%.ml
	mkdir -p $L
	$ML $STDI -o $target core/$stem.ml
$L/%.$O: base/%.ml
	mkdir -p $L
	$ML $STDI -o $target base/$stem.ml
$L/%.$O: collections/%.ml
	mkdir -p $L
	$ML $STDI -o $target collections/$stem.ml
$L/%.$O: printing/%.ml
	mkdir -p $L
	$ML $STDI -o $target printing/$stem.ml
$L/%.$O: parsing/%.ml
	mkdir -p $L
	$ML $STDI -o $target parsing/$stem.ml
$L/%.$O: system/%.ml
	mkdir -p $L
	$ML $STDI -o $target system/$stem.ml
$L/%.$O: concurrency/%.ml
	mkdir -p $L
	$ML $STDI -o $target concurrency/$stem.ml
$L/%.$O: commons/%.ml
	mkdir -p $L
	$ML $STDI -o $target commons/$stem.ml

# (the system's Unix: mkconfig's UNIXDIR)
$L/Unix.$O: $UNIXDIR/Unix.ml
	mkdir -p $L
	$ML $STDI -o $target $UNIXDIR/Unix.ml

# (Source: mini-ml's threads' file, not commons/'s, which is OCaml's)
$L/Source.$O: concurrency/Source.ml
	mkdir -p $L
	$ML $STDI -o $target concurrency/Source.ml
$L/Sys_plan9.$O: $P9DIR/Sys_plan9.ml
	mkdir -p $L
	$ML $STDI -o $target $P9DIR/Sys_plan9.ml

# mini-ml's runtime, on the C library
ARCH=`{case $O in 5) echo arm;; 7) echo arm64;; esac}
# (goken reaches utf.h and os/posix/ through links: here utf's directory
# is searched, and os/posix/ is its os/unix/ under that name)
CINC=-Ilibc/include -Ilibc/include/utf -Ilibc -Ilibc/include/arch/$ARCH -D$ARCH -D$OS
$L/runtime.$O: $TOP/languages/ml/runtime/runtime.c
	mkdir -p $L
	$CC $CINC -o $target $prereq

# The C library: goken's (libc/, with its LICENSE), the files a program
# of mini-ml's links, in C and in assembly: those of every system, then
# those of one (Linux's calls under Plan 9's names; Plan 9's own, where
# a name is the kernel's call: svc_arm.s), then those of one machine.
LIBC_C=ix/fmt port/abort port/asin \
 port/atan port/atan2 port/atexit port/atol port/dirstat \
 port/execl port/exp port/fabs port/floor port/frexp port/lock \
 port/log port/mainargs port/mallocz port/memccpy port/memcmp port/memmove port/memset \
 port/minimal_malloc port/nulldir port/pow port/sin port/sqrt port/strchr \
 port/strcpy port/strdup port/strlen port/strncmp port/strncpy port/strrchr
LIBC_linux=os/linux/dirwstat os/linux/getwd os/linux/open os/linux/stat port/exec port/exits port/fork port/getenv \
 port/remove port/seek port/wait syscall/os/linux/zsyscall_linux
LIBC_plan9=os/plan9/_exits os/plan9/access os/plan9/convD2M os/plan9/convM2D os/plan9/dirread os/plan9/fork \
 os/plan9/getenv os/plan9/getwd os/plan9/stat port/dirwstat port/sbrk port/strcmp
LIBC_linux5=ix/vlrt
LIBC_linux7=port/getcallerpc
LIBC_plan95=ix/vlrt syscall/os/plan9/zsyscall_plan9_arm
LIBC_S5=arch/arm/div arch/arm/getcallerpc arch/arm/rt0 arch/arm/vlop syscall/os/$OS/svc_arm
LIBC_S7=arch/arm64/rt0 syscall/os/$OS/svc_arm64
LC=$L/libc
LIBC=`{case $OS$O in linux5) echo $LIBC_C $LIBC_linux $LIBC_linux5 $LIBC_S5;; linux7) echo $LIBC_C $LIBC_linux $LIBC_linux7 $LIBC_S7;; \
 plan95) echo $LIBC_C $LIBC_plan9 $LIBC_plan95 $LIBC_S5 ix/syscall6_plan9_arm;; esac}
LIBCOBJS=${LIBC:%=$LC/%.$O}

$LC/%.$O: libc/%.c
	mkdir -p `dirname $target`
	$CC $CINC -o $target libc/$stem.c
$LC/%.$O: libc/%.s
	mkdir -p `dirname $target`
	$AS -o $target libc/$stem.s

$L/libc.a: $LIBCOBJS
	rm -f $target
	$AR u $target $LIBCOBJS

clean:V:
	rm -rf $L
