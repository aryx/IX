# games/, built by ix's tools: first the libraries that the games share,
# once (mkgames: lib_playground, lib_graphics/software, a platform),
# then each directory of games, side by side.
TOP=..
DIR=games
# (audio, because the games of two directories ask for it, puzzle and
# shmup, which are made side by side; so its units are made here first,
# once)
WITH=audio
GAMES=
CATEGORIES=puzzle fps fps/doom fps/quake racing/virtua arcade shmup
# (B, where what is made goes, is passed on when it was given, as
# tests/lite.sh does; otherwise the default is a path from each
# directory)
# (NPROC directories are built at once, and each mk gets its share of
# the jobs, NPROC divided among the seven, at least one. So there are
# NPROC compiles at once in all, as in another directory. The seven at
# once with NPROC jobs each would run seven of the games' compiles at
# once on the card (NPROC 1 under QEMU, 864 MB), where ml is killed out
# of memory, in self-mix's games.)
# On Plan 9 each directory again with the software platform (SOFT:
# mkgames' PLATFORM=software, made beside, games/puzzle-soft), after
# that directory's draw one (the two share the units of WITH, made in
# lib_playground's directories) and the software platform's library.
# opti: each directory and platform a target of this mk, which runs
# them as they become ready, NPROC at once, as the top mkfile runs its
# directories: the four-core build of ix on the card ran the seven by
# fours, each four waiting for its slowest, and the software
# platform's seven after all of them (the top mkfile's games-software),
# 326 s then 191, most of its critical path of 735 s
# (plan_9pi_self_speed.md, 2026-11-23).
# old: directories:V: libs, an rc loop of each $d's mk, NPROC at once,
# each NPROC waited for; and the top mkfile's games-software:V:
# games.dir, cd games && $MK $ARGS 'PLATFORM=software'
all:V: directories
<mkgames
# (after mkgames, whose mkconfig says OS when the caller did not; the
# names made by rc, an empty list on Linux: mk's ${SOFT:%=%.soft} of an
# empty SOFT is the word SOFT, as Plan 9's mk's varsub.c)
# (SOFTWARE=0, given to this mk or the top one: the draw platform
# alone, as tests/self.sh's build of ix on the card and on Linux: the
# author, 2026-11-23, "for the self jobs it's fine to skip all the soft
# variant, and keep just the draw one"; a game's units compiled again
# for it were the critical path's last 190 s of 753)
SOFT=`{if(~ $OS plan9 && ! ~ $SOFTWARE 0) for(c in $CATEGORIES) echo $c.soft}
directories:V: ${CATEGORIES:%=%.games} $SOFT
%.games:V: libs
	b=(); if(~ $B /*) b='B='^$B
	j=`{echo $#CATEGORIES $NPROC | awk '{j = int($2 / $1); if(j < 1) j = 1; print j}'}
	cd $stem && $MK 'O='$O 'OS='$OS 'PLATFORM='$PLATFORM 'NPROC='$j $b
%.soft:V: %.games soft-libs
	b=(); if(~ $B /*) b='B='^$B
	j=`{echo $#CATEGORIES $NPROC | awk '{j = int($2 / $1); if(j < 1) j = 1; print j}'}
	cd $stem && $MK 'O='$O 'OS='$OS 'PLATFORM=software' 'NPROC='$j $b
soft-libs:V: libs
	b=(); if(~ $B /*) b='B='^$B
	$MK 'O='$O 'OS='$OS 'PLATFORM=software' $b libs

