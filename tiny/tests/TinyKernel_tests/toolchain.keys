rc
cd /src/runtime; cc -o /libc.o libc.c
cd /src/TinyKernel/user; cc -o /ping.o ping.c
cd /
as -o start.o src/runtime/start.tm
as -o udivmod.o src/runtime/udivmod.tm
as -o sys.o src/TinyKernel/libc/sys.tm
ld -s -n -o ping start.o udivmod.o libc.o sys.o ping.o
cmp ping /bin/ping && echo ping: /bin/ping
cd /src; ml -c -o /mach.o TinyLibMachine.ml; cd /
cmp mach.o /examples/TinyLibMachine.o && echo mach.o: the host
cmp mach.tmi /examples/TinyLibMachine.tmi && echo mach.tmi: the host
cd /src; ml -c -S -o /mach.tm TinyLibMachine.ml; cd /
as -o mach2.o mach.tm; cmp mach2.o mach.o && echo ml -S, then as: the same object
ls -l /bin/as /bin/ld /bin/cc /bin/ml
exit
