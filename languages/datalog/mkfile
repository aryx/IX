# mini-datalog, built by ix's tools. It stands on mini-prolog's terms
# and its reader (../prolog), whose units are taken from their
# directory, each by its name. It also has dotnet/'s compiler of rules
# to .NET, over mini-dotnet's writer.
TOP=../..
DIR=languages/datalog
PROG=mini-datalog
PL=$TOP/languages/prolog
SRC=Prolog Prolog_read Parallel Tuples Btree Relset Hash_index Tree_index Index Datalog Datalog_eval \
 Metadata Signature Il Writer Compile_il CLI Main
LOCAL=`{ls *.ml *.mli ../prolog/Prolog.ml ../prolog/Prolog.mli ../prolog/Prolog_read.ml ../prolog/Prolog_read.mli dotnet/*.ml dotnet/*.mli ../dotnet/assembly/*.ml ../dotnet/assembly/*.mli}
GEN=
LIBI=-I ../prolog -I dotnet -I ../dotnet/assembly
LIBUNITS=
LIBOBJS=
<$TOP/mkfiles/mkconfig
<$TOP/mkfiles/mkprog

# the other directories' units, each by its name
$D/Prolog.$O: $PL/Prolog.ml $LOCAL
	mkdir -p $D
	$ML $INCLUDES -o $target $PL/Prolog.ml
$D/Prolog_read.$O: $PL/Prolog_read.ml $LOCAL
	mkdir -p $D
	$ML $INCLUDES -o $target $PL/Prolog_read.ml
# (Parallel uses the host's cores where OCaml has domains, for -j.
# mini-ml has none yet (plan_ml_multicore.md), so this is
# lib_core/parallel's file for OCaml 4.14, which dune chooses by the
# compiler's version.)
$D/Parallel.$O: $TOP/lib_core/parallel/host/single.ml.in $TOP/lib_core/parallel/Parallel.mli
	mkdir -p $D
	cp $TOP/lib_core/parallel/Parallel.mli $D/Parallel.mli
	cp $TOP/lib_core/parallel/host/single.ml.in $D/Parallel.ml
	$ML $INCLUDES -o $target $D/Parallel.ml
# dotnet/'s unit (Compile_il), and mini-dotnet's writer of assemblies
# (Metadata Signature Il Writer), by their names
$D/Compile_il.$O: dotnet/Compile_il.ml $LOCAL
	mkdir -p $D
	$ML $INCLUDES -o $target dotnet/Compile_il.ml
$D/%.$O: ../dotnet/assembly/%.ml
	mkdir -p $D
	$ML $INCLUDES -o $target ../dotnet/assembly/$stem.ml
