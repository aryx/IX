; typesetting/troff: mini-troff, a document typeset
; (docs/plans/plan_typesetting.md). Its parts in folders (folders
; only: one library, ix_troff):
;   doc/    Doc: a document, whatever it was written in; Layout: its
;           blocks put on lines; To_text, To_pdf: the lines written
;           for a terminal, and as the sheets of a PDF file
;   roff/   what was written for troff. Roff: its input as lines,
;           requests and texts; Fill: the requests that are troff's
;           own and the tree made of the paragraphs; Man, Ms: the
;           macros of the two packages, as cases; Tbl: a table
;   pic/    Pic: a picture; its grammar (Pic_parser), its words
;           (Pic_lexer), its tree (Pic_ast)
;   ixdoc/  the new format, Markdown's lines and \name[options]{text}:
;           Ixdoc reads it, To_ixdoc writes any document in it,
;           Ixdoc_syntax is its marks and its kinds of line
;   latex/  Latex: simple LaTeX and noweb's chunks of code, the books;
;           its parts: Latex_state, Latex_input, Latex_output,
;           Latex_names, Noweb (a chunk), Latex_math, Latex_table; Bib:
;           a bibliography's file
; CLI and Main here are the program.
(include_subdirs unqualified)

(library
 (name ix_troff)
 (wrapped false)
 (modules :standard \ Main)
 (libraries ix_core ix_graphics_pdf ix_graphics_fonts fpath unix caps))

(executable
 (name Main)
 (public_name mini-troff)
 (package ix)
 (modules Main)
 (libraries ix_troff caps))
