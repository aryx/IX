# mini-csc, built by ix's tools: its lexer by mini-lex, and the units of
# languages/dotnet it stands on: runtime/'s, by their names, and
# assembly/, a library. (Csc_ast comes first, so that a unit of this
# directory is compiled first and tests/depend_edges.sh looks for CLI
# here before it looks in .., which has mini-dotnet's.)
TOP=../../..
DIR=languages/dotnet/csc
PROG=mini-csc
N=..
SRC=Csc_ast Value Library Csc_lexer Csc_parser Csc_types Csc_emit Csc_compile CLI Main
LOCAL=`{ls *.ml *.mli *.mll ../runtime/Value.ml* ../runtime/Library.ml*}
LIBI=-I ../runtime
LIBUNITS=
# (the assembly's writer, Writer and what it stands on)
LIBDIRS=languages/dotnet/assembly
<$TOP/mkfiles/mkconfig
GEN=$B/languages/dotnet/csc/Csc_lexer.ml
LIBOBJS=
<$TOP/mkfiles/mkprog

$D/Csc_lexer.$O: $D/Csc_lexer.ml $LOCAL
	$ML $INCLUDES -o $target $D/Csc_lexer.ml

# languages/dotnet's units, by their names
$D/Value.$O: $N/runtime/Value.ml $LOCAL
	$ML $INCLUDES -o $target $N/runtime/Value.ml
$D/Library.$O: $N/runtime/Library.ml $LOCAL
	$ML $INCLUDES -o $target $N/runtime/Library.ml
