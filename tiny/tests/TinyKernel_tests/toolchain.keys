rc
cd /src/runtime/c; cc -o /libc.o libc.c
cd /src/user; cc -I /lib/c -o /ping.o ping.c
cd /
as -o start.o src/runtime/c/start.s
as -o udivmod.o src/runtime/c/udivmod.s
as -o sys.o src/runtime/c/sys.s
ld -s -n -o ping start.o udivmod.o libc.o sys.o ping.o
cmp ping /bin/ping && echo ping: /bin/ping
cd /src; ml -c -o /mach.o TinyLibMachine.ml; cd /
cd /src; ml -c -S -o /mach.s TinyLibMachine.ml; cd /
as -o mach2.o mach.s; cmp mach2.o mach.o && echo ml -S, then as: the same object
ls -l /bin/as /bin/ld /bin/cc /bin/ml
exit
