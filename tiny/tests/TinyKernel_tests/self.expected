% % mkdir -p ml; a=(); for(p in lib/Stdlib.tmi lib/Char.tmi lib/Seq.tmi lib/List.tmi lib/String.tmi lib/Bytes.tmi lib/Array.tmi lib/Option.tmi lib/Int64.tmi lib/Filename.tmi lib/Buffer.tmi lib/Printf.tmi lib/Marshal.tmi lib/Hashtbl.tmi lib/Common.tmi lib/Sha1.tmi lib/Fpath.tmi lib/Fpath_.tmi lib/Exit.tmi lib/In_channel.tmi lib/Out_channel.tmi lib/Chan.tmi lib/Logs.tmi ml/TinyLibSystem.tmi ml/TinyLibDraw.tmi ml/TinyLibPlayground.tmi ml/TinyLibGUI.tmi ml/TinyAppCalculator.tmi /src/user/calc.ml) ~ $p *.mli || a=($a $p); ml -c -nostdlib -o ml/Calc.o $a
mkdir -p bin; ld -map -s -n  -o bin/calc start.o udivmod.o libc.o libc/sys.o libml/mlsys.o main/calc.o ml/TinyLibSystem.o ml/TinyLibDraw.o ml/TinyLibPlayground.o ml/TinyLibGUI.o ml/TinyAppCalculator.o ml/Calc.o lib/Stdlib.o lib/Char.o lib/Seq.o lib/List.o lib/String.o lib/Bytes.o lib/Array.o lib/Option.o lib/Int64.o lib/Filename.o lib/Buffer.o lib/Printf.o lib/Marshal.o lib/Hashtbl.o lib/Common.o lib/Sha1.o lib/Fpath.o lib/Fpath_.o lib/Exit.o lib/In_channel.o lib/Out_channel.o lib/Chan.o lib/Logs.o end.o
cat kernel.img > boot.img
for(f in sh rc emacs office troff play mltests paint windows square tetris calc temp ping get put httpd utils ed bigmem www prof db vcs build as ld cc ml trace debug) { n=`{wc -c < bin/$f}; echo bin/$f; echo $n; cat bin/$f } >> boot.img
for(f in wc.c sh.c emacs.ml TinyEditorScreen.ml report.ixd korobeiniki.wav spin.prof spin.map TinyLibMachine.tmi TinyLibMachine.o) { n=`{wc -c < /examples/$f}; echo examples/$f; echo $n; cat /examples/$f } >> boot.img
