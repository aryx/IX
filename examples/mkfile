#
# Small programs to read, build and run on mini-9pi, where they are in
# /src/examples, and on Linux. Each file's header says more about it:
#
#     C          ML            what
#     hello.c    Helloml.ml    a print (hello with square_arm.s, in assembly)
#     procs.c    Procsml.ml    a pipe, fork, exec and wait: a shell's pipeline
#                Fetchml.ml    a document of another machine, by HTTP (lib_networking)
#                Shapesml.ml   a picture drawn, with the draw device (lib_graphics)
#                Game.ml       a ball, on the playground (lib_playground)
#                Counter.ml    a counter, on the widgets (lib_gui)
#
# mk makes all of them; mk game makes one by its name; mk clean removes
# them. A program is made in _mk, not beside its source (D, below, as
# every directory of ix's). procs and shapesml are mini-9pi's only
# (their headers say why). What they link besides their own objects
# must be built before, by the mkfiles of the libraries:
# - lib_core has C's library (libc.a), the standard library of ML
#   (lib_core.a), and what ends an ML program: std_exit, the runtime
#   and the C library under it. The first four programs need it alone
#   (cd ../lib_core; mk);
# - each other library is an archive, lib.a, in a directory of its
#   name. The top mkfile makes them all in their order (cd ..; mk libs).
#
#     cd /src/examples; mk hello           on mini-9pi's card
#     ../_mk/5-plan9/examples/hello
#     mini-mk MINI=mini-                   on the host, for Linux on arm64
#     mini-5i ../_mk/7/examples/hello      (mini-5i runs it where the host is not one)
#     mini-mk MINI=mini- O=5 OS=plan9      on the host, mini-9pi's programs
#
# The tools are named as on the card (cc, asm, ld, ml); MINI=mini- names
# the host's (mkfiles/mkconfig, which also says O, the machine, and OS,
# the system).
TOP=..
<$TOP/mkfiles/mkconfig
D=$B/examples
MADE=`{mkdir -p $D}

P9=`{~ $OS plan9 && echo procs shapesml}
all:V: hello helloml procsml fetchml game counter $P9

hello:V: $D/hello
procs:V: $D/procs
helloml:V: $D/helloml
procsml:V: $D/procsml
fetchml:V: $D/fetchml
shapesml:V: $D/shapesml
game:V: $D/game
counter:V: $D/counter

# A C program: each file compiled with the C library's headers (u.h,
# the machine's types; libc.h), then linked with libc.a, whose first
# instructions (rt0) call main.
LC=$TOP/lib_core/libc
ARCH=`{if(~ $O 5) echo arm; if not echo arm64}
CINC=-I$LC/include -I$LC/include/utf -I$LC -I$LC/include/arch/$ARCH -D$ARCH -D$OS

$D/hello.$O: hello.c
	$CC $CINC -o $target hello.c
$D/square.$O: square_$ARCH.s
	$AS -o $target square_$ARCH.s
$D/hello: $D/hello.$O $D/square.$O $L/libc.a
	$LD $LDH -nofollow -o $target $prereq

$D/procs.$O: procs.c
	$CC $CINC -o $target procs.c
$D/procs: $D/procs.$O $L/libc.a
	$LD $LDH -nofollow -o $target $prereq

# An ML program on the standard library alone: its unit compiled with
# the library's interfaces (STDI); its start, which ml makes from the
# names of the units it may link (their initializations in order: STD,
# the standard library's, COMMONS, ix's own); then the link: the start,
# the library (from which ld takes the units the program uses), the
# unit, and the end.
$D/Helloml.$O: Helloml.ml
	$ML $STDI -o $target Helloml.ml
$D/Helloml.start: mkfile $MLEXE
	$ML -start $STD $COMMONS Helloml Std_exit -o $target
$D/helloml: $D/Helloml.start $D/Helloml.$O $STDOBJS $STDEND
	$LD $LDH -nofollow -o $target $D/Helloml.start $STDOBJS $D/Helloml.$O $STDEND

$D/Procsml.$O: Procsml.ml
	$ML $STDI -o $target Procsml.ml
$D/Procsml.start: mkfile $MLEXE
	$ML -start $STD $COMMONS Procsml Std_exit -o $target
$D/procsml: $D/Procsml.start $D/Procsml.$O $STDOBJS $STDEND
	$LD $LDH -nofollow -o $target $D/Procsml.start $STDOBJS $D/Procsml.$O $STDEND

# An ML program on other libraries is built the same way, with their
# interfaces (LIBI), their units' names in the start (units.rc lists an
# archive's) and their archives in the link (LIBA): mkfiles/mklibs
# gives the three from LIBDIRS, each library after the ones it names.
# PLATFORM is what runs a playground program: the draw device on
# mini-9pi, and on Linux ppm, no window, a frame written to a file.
PLATFORM=`{if(~ $OS plan9) echo draw; if not echo ppm}
LIBDIRS=lib_crypto lib_compression lib_graphics lib_playground lib_playground/physics lib_playground/juice lib_gui lib_audio lib_networking \
 lib_playground/netcode lib_playground/ai lib_playground/apis lib_playground/platforms lib_playground/platforms/$PLATFORM
<$TOP/mkfiles/mklibs
LIBS=$LIBA $STDOBJS $STDEND

$D/%.$O: %.ml
	$ML -I . $LIBI $STDI -o $target $stem.ml
$D/Fetchml.$O $D/Shapesml.$O $D/Game.$O $D/Counter.$O: $LIBSRC
$D/%.start: mkfile $MLEXE
	$ML -start $STD $COMMONS `{$RC $TOP/mkfiles/units.rc $LIBA} $stem Std_exit -o $target

$D/fetchml: $D/Fetchml.start $D/Fetchml.$O $LIBS
	$LD $LDH -nofollow -o $target $D/Fetchml.start $STDOBJS $LIBA $D/Fetchml.$O $STDEND
$D/shapesml: $D/Shapesml.start $D/Shapesml.$O $LIBS
	$LD $LDH -nofollow -o $target $D/Shapesml.start $STDOBJS $LIBA $D/Shapesml.$O $STDEND
$D/game: $D/Game.start $D/Game.$O $LIBS
	$LD $LDH -nofollow -o $target $D/Game.start $STDOBJS $LIBA $D/Game.$O $STDEND
$D/counter: $D/Counter.start $D/Counter.$O $LIBS
	$LD $LDH -nofollow -o $target $D/Counter.start $STDOBJS $LIBA $D/Counter.$O $STDEND

clean:V:
	rm -rf $D
