# lib_playground's netcode, a library of its own (mkfiles/mklib): it
# exchanges the players' inputs, with lockstep and rollback, over
# lib_networking's Udp (apis/'s Multiplayer is built over it). It is
# apart from lib_playground and built after it, since it names its
# Lehmer.
TOP=../..
<$TOP/mkfiles/mkconfig
LIB=lib_playground/netcode
DIRS=.
NEEDS=lib_networking lib_playground
UNITS=Checksum Sim_net Transport Wire Inputs Lockstep Rollback
<$TOP/mkfiles/mklib
