#
# hello, from hello.c and square.s, and helloml, from helloml.ml, built
# on tiny-kernel by build in /examples (see hello.c and helloml.ml): both
# by default, or one by its name (build helloml). What they link besides
# their own objects is already built in /lib: /lib/c, C's runtime and
# tiny-kernel's calls, start.o first (the machine starts there); /lib/ml,
# ML's runtime (mlsys.o), the library (stdlib.a, its units), and end.o,
# the image's end, last.
# Each has its Buildfile, which says how it is made from /src. -s puts
# the labels after the image, the names debug shows; -map writes them
# beside it too.
#
# On the host, the same, the tools tiny-cc..., /lib tiny/lib (made by
# tiny-build TINY=tiny- libs in tiny/), /src tiny/:
#     tiny-build TINY=tiny- LIB=../lib SRC=..

TINY =
CC = ${TINY}cc
AS = ${TINY}as
LD = ${TINY}ld
ML = ${TINY}ml
LIB = /lib
SRC = /src

CRT = ${LIB}/c/start.o ${LIB}/c/udivmod.o ${LIB}/c/libc.o ${LIB}/c/sys.o
MLRT = ${LIB}/ml/mlsys.o
STDLIB = ${LIB}/ml/stdlib.a
MLEND = ${LIB}/ml/end.o
# (where tiny-ml reads the library's interfaces)
MLLIB = ${LIB}/ml
# (user.h: the system's calls a C program makes, as libc/'s headers)
INC = ${SRC}/TinyKernel/libc

all: hello helloml

hello: hello.o square.o
	$LD -map -s -n -o $target $CRT $prereq

hello.o: hello.c ${INC}/user.h
	$CC -I $INC -o $target hello.c
square.o: square.s
	$AS -o $target square.s

helloml: helloml.o
	$LD -map -s -n -o $target $CRT $MLRT $prereq $STDLIB $MLEND

# (one unit: its code and its start in one object)
helloml.o: helloml.ml
	$ML -L $MLLIB -o $target helloml.ml

# build clean: what build made here removed, by name: /examples has
# other files that *.o and *.map would take (TinyLibMachine.o, spin.map).
# A target that makes no file is never up to date, so it always runs
clean:
	rm -f hello helloml hello.o square.o helloml.o hello.map helloml.map
