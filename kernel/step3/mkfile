# mini-xv6, step 3, on the Pi 4 by ix's tools (plan_kernel_mini_ml.md,
# step 4): the same Main.ml as the Makefile's (the Pi 1's, by
# ocaml-light and gcc): three processes on their own kernel stacks, and
# for mini-ml's runtime on their own value stacks, the collector
# running between their turns. pi4/ has the machine: l.s (step 2's,
# and swtch), machine.c (the contexts, the runtime told which stack
# runs), user.s.
#   mini-mk          _mk/7/kernel/step3/kernel8.img
#   mini-mk check    booted under mini-qemu, and under QEMU if it is
#                    there: the Makefile's expected lines
TOP=../..
<$TOP/mkfiles/mkconfig
D=$B/kernel/step3
LIBC=$TOP/lib_core/libc
CINC=-I$LIBC/include -I$LIBC/include/utf -I$LIBC -I$LIBC/include/arch/arm64 -Darm64 -Dlinux
# (quoted: after a variable's =, mk reads a word before another = as attributes)
HEAP='-DMAXHEAP=4194304' '-DSTACK=131072'
BOOT=-cpu cortex-a72 -M raspi4b -m 2G -kernel $D/kernel8.img
QEMU=/home/pad/work/TOOLCHAINS/qemu/build/qemu-system-aarch64

all:V: $D/kernel8.img

$D/Main.$O: Main.ml
	mkdir -p $D
	$ML $STDI -o $target Main.ml
$D/start.$O: mkfile $TOP/mkfiles/mkconfig
	mkdir -p $D
	$ML -start $STD $COMMONS Main Std_exit -o $target
$D/runtime.$O: $TOP/languages/ml/runtime/runtime.c mkfile
	mkdir -p $D
	$CC $CINC $HEAP -o $target $TOP/languages/ml/runtime/runtime.c
$D/l.$O: pi4/l.s ../step2/pi4/l.s ../step0/l.s
	mkdir -p $D
	$AS -o $target pi4/l.s
$D/user.$O: pi4/user.s
	mkdir -p $D
	$AS -o $target pi4/user.s
$D/machine.$O: pi4/machine.c $TOP/languages/ml/runtime/mlvalues.h $TOP/languages/ml/runtime/callback.h
	mkdir -p $D
	$CC $CINC -I$TOP/languages/ml/runtime -o $target pi4/machine.c
$D/shim.$O: ../step0/shim.c
	mkdir -p $D
	$CC $CINC -o $target ../step0/shim.c

# (l first: its vectors are the image's first bytes)
OBJS=$D/l.$O $D/shim.$O $D/machine.$O $D/user.$O $D/start.$O $STDOBJS $D/Main.$O $L/std_exit.$O $D/runtime.$O $L/libc.a
$D/kernel8.img: $OBJS
	$LD -H0 -T 0x80000 -E vectors -nofollow -o $target $OBJS

check:V: $D/kernel8.img
	timeout 20 mini-qemu $BOOT -nographic < /dev/null > $D/mini.txt 2> /dev/null || true
	cmp $D/mini.txt expected && echo "ok step3: under mini-qemu"
	if [ -x $QEMU ]; then
		timeout 10 $QEMU $BOOT -smp 4 -display none -monitor none -serial file:$D/qemu.txt < /dev/null 2> /dev/null || true
		cmp $D/qemu.txt expected && echo "ok step3: under QEMU"
	fi

clean:V:
	rm -rf $D
