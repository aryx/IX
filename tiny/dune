(library
 (name tiny_lib_cpu)
 (wrapped false)
 (modules TinyLibCPU))

(executable
 (name TinyCPU)
 (public_name tiny-cpu)
 (package ix)
 (modules TinyCPU)
 (libraries ix_core fpath caps tiny_lib_cpu))

; tiny-machine's machine without a host: TinyMachine's and TinyMachineWeb's
(library
 (name tiny_lib_machine)
 (wrapped false)
 (modules TinyLibMachine)
 (libraries tiny_lib_cpu))

(executable
 (name TinyMachine)
 (public_name tiny-machine)
 (package ix)
 (modules TinyMachine)
 (libraries ix_core fpath unix caps tiny_lib_cpu tiny_lib_machine tiny_network tiny_lib_peer))

; TinyNetwork.ml, tiny-kernel's part that speaks to the network
; (tiny-ml compiles it there), here for the host: its test, and the
; other end of tiny-machine's wire
(library
 (name tiny_network)
 (wrapped false)
 (modules TinyNetwork))

; the other end of tiny-machine's wire, TinyNetwork with a few lines on
; top: TinyMachine's and TinyMachineWeb's
(library
 (name tiny_lib_peer)
 (wrapped false)
 (modules TinyLibPeer)
 (libraries tiny_network))

; TinyGraphics.ml, tiny-kernel's part that draws (tiny-ml compiles it
; there), here for the host: TinyMemory (TinyKernel/host/) is the machine's
; memory, an array
(library
 (name tiny_graphics)
 (wrapped false)
 (modules TinyGraphics)
 (libraries tiny_host_memory))

; TinyDraw.ml, a program's side of it, and TinyWindows.ml, tiny-kernel's
; window system: tiny-ml compiles them for the machine (TinyKernel/'s
; Makefile); OCaml too, which only checks the second (its externals are
; the machine's: no program is linked)
(library
 (name tiny_draw)
 (wrapped false)
 (modules TinyDraw))

; TinyPlayground.ml, what a game of tiny-kernel's is written on, here
; for a game's test on the host: TinyCalls is the kernel's calls, kept
(library
 (name tiny_playground)
 (wrapped false)
 (modules TinyPlayground)
 (libraries tiny_draw tiny_host_calls))

; TinyTetris.ml, a game on it (tiny-kernel's tetris)
(library
 (name tiny_tetris)
 (wrapped false)
 (modules TinyTetris)
 (libraries tiny_playground))

; TinyGUI.ml, what a program with buttons is written on, and
; TinyAppCalculator.ml and TinyAppTemperature.ml, tiny-kernel's calc and temp,
; on it
(library
 (name tiny_gui)
 (wrapped false)
 (modules TinyGUI)
 (libraries tiny_playground))

(library
 (name tiny_app_calculator)
 (wrapped false)
 (modules TinyAppCalculator)
 (libraries tiny_gui))

(library
 (name tiny_app_temperature)
 (wrapped false)
 (modules TinyAppTemperature)
 (libraries tiny_gui))

(library
 (name tiny_windows)
 (wrapped false)
 (modules TinyWindows)
 (libraries tiny_draw))

; tiny-machine's window: the one tiny program linking a C library (SDL)
; tiny-machine's way out to other programs: a connection of the host's
; on its standard input and output (TinyMachine's -net-out and
; -net-forward run it, as its -window runs TinyMachineWindow)
(executable
 (name TinyMachineSocket)
 (public_name tiny-machine-socket)
 (package ix)
 (modules TinyMachineSocket)
 (libraries ix_core caps unix))

(executable
 (name TinyMachineWindow)
 (public_name tiny-machine-window)
 (package ix)
 (modules TinyMachineWindow)
 (libraries ix_raspberry ix_sdl_display unix))

(executable
 (name TinyML)
 (public_name tiny-ml)
 (package ix)
 (modules TinyML)
 (libraries ix_core fpath caps))

; tiny-machine in a web page (plan_web.md): the machine by js_of_ocaml,
; TinyMachineWeb.html its page (./tiny-machine -web dir tiny-kernel);
; optional: built where the library js_of_ocaml is installed
(executable
 (name TinyMachineWeb)
 (modules TinyMachineWeb)
 (modes js)
 (optional)
 (libraries tiny_lib_cpu tiny_lib_machine tiny_network tiny_lib_peer js_of_ocaml))
