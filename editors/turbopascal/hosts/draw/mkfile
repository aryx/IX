# mini-turbopascal for mini-9pi (mini-mk O=5 OS=plan9): turbopascal, the
# IDE (../../editor), in a window of mini-rio's that the draw device
# paints (lib_terminal/hosts: Window_draw, over Cells and lib_graphics),
# over the libraries languages/pascal (mini-pascal's), lib_terminal
# and lib_terminal/hosts. The IDE's units are taken from their
# directories, each by its name.
TOP=../../../..
DIR=editors/turbopascal/hosts/draw
PROG=turbopascal
KIT=../../editor
SRC=Turbo_edit Turbo_debug Turbo_menus Turbo_update Turbo_view Tui_turbo Keys Main
LOCAL=`{ls *.ml ../../*.ml ../../*.mli ../../editor/*.ml ../../editor/*.mli}
GEN=
LIBI=-I ../.. -I ../../editor
LIBUNITS=
# (lib_terminal; Lehmer, the numbers its Talk draws; lib_terminal/hosts,
# over lib_graphics, its client of the draw device)
LIBDIRS=lib_playground/random lib_terminal languages/pascal lib_compression lib_graphics lib_terminal/hosts
LIBOBJS=
<$TOP/mkfiles/mkconfig
<$TOP/mkfiles/mkprog

# the other directories' units, each by its name
$D/Turbo_edit.$O: $KIT/Turbo_edit.ml $LOCAL
	$ML $INCLUDES -o $target $KIT/Turbo_edit.ml
$D/Turbo_debug.$O: $KIT/Turbo_debug.ml $LOCAL
	$ML $INCLUDES -o $target $KIT/Turbo_debug.ml
$D/Turbo_menus.$O: $KIT/Turbo_menus.ml $LOCAL
	$ML $INCLUDES -o $target $KIT/Turbo_menus.ml
$D/Turbo_update.$O: $KIT/Turbo_update.ml $LOCAL
	$ML $INCLUDES -o $target $KIT/Turbo_update.ml
$D/Turbo_view.$O: $KIT/Turbo_view.ml $LOCAL
	$ML $INCLUDES -o $target $KIT/Turbo_view.ml
$D/Tui_turbo.$O: $KIT/Tui_turbo.ml $LOCAL
	$ML $INCLUDES -o $target $KIT/Tui_turbo.ml
$D/Keys.$O: ../../Keys.ml $LOCAL
	$ML $INCLUDES -o $target ../../Keys.ml
