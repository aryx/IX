# The libraries every program of ix links, built by ix's tools: the
# stdlib and ix's own library (mini-ml), mini-ml's runtime (mini-cc),
# and the C library under it (goken's sources, by mini-cc).
TOP=..
<$TOP/mkfiles/mkconfig

all:V: $STDOBJS $STDEND

# a unit is in one of the directories: the rule whose source is there
$L/%.$O: core/%.ml
	mkdir -p $L
	$ML $STDI -o $target core/$stem.ml
$L/%.$O: base/%.ml
	mkdir -p $L
	$ML $STDI -o $target base/$stem.ml
$L/%.$O: collections/%.ml
	mkdir -p $L
	$ML $STDI -o $target collections/$stem.ml
$L/%.$O: printing/%.ml
	mkdir -p $L
	$ML $STDI -o $target printing/$stem.ml
$L/%.$O: parsing/%.ml
	mkdir -p $L
	$ML $STDI -o $target parsing/$stem.ml
$L/%.$O: system/%.ml
	mkdir -p $L
	$ML $STDI -o $target system/$stem.ml
$L/%.$O: commons/%.ml
	mkdir -p $L
	$ML $STDI -o $target commons/$stem.ml

ARCH=`{case $O in 5) echo arm;; 7) echo arm64;; esac}
$L/runtime.$O: $TOP/languages/ml/runtime/runtime.c
	mkdir -p $L
	$CC -I$GOKEN/include -I$GOKEN/include/ALL -I$GOKEN/include/arch/$ARCH -o $target $prereq

# goken's libc, each file by mini-cc or mini-asm, the archive by mini-ld
# (linker/tests/libc.sh, which also compares them with goken's own)
$L/libc.a:
	mkdir -p $L
	MINICC=1 $TOP/linker/tests/libc.sh $O `cd $L && pwd`/libc > /dev/null
	cp $L/libc/t/libc.a $target

clean:V:
	rm -rf $L
