# mini-usbd, built by ix's tools (for Plan 9: mini-mk O=5 OS=plan9), with
# ../../lib_usb's units (the kernel's too)
TOP=../../../../..
<$TOP/mkfiles/mkconfig
D=$B/kernels/9pi/buses/user/usbd
G=../../lib_usb
INCLUDES=-I . -I $G $STDI
LIB=Usbdesc Hid Usbbus
SRC=Usbdev Usbd
LIBOBJS=${LIB:%=$D/%.$O}
SRCOBJS=${SRC:%=$D/%.$O}
LOCAL=`{ls *.ml *.mli ../../lib_usb/*.ml ../../lib_usb/*.mli}

all:V: $D/mini-usbd

$D/%.$O: $G/%.ml $LOCAL
	mkdir -p $D
	$ML $INCLUDES -o $target $G/$stem.ml
$D/Usbdev.$O: Usbdev.ml $LOCAL
	mkdir -p $D
	$ML $INCLUDES -o $target Usbdev.ml
$D/Usbd.$O: Usbd.ml $LOCAL
	mkdir -p $D
	$ML $INCLUDES -o $target Usbd.ml
$D/mini-usbd: $SRCOBJS $LIBOBJS $STDOBJS $STDEND $TOP/mkfiles/mkconfig
	$ML -start $STD $COMMONS $LIB $SRC Std_exit -o $D/start.$O
	$LD $LDH -nofollow -o $target $D/start.$O $STDOBJS $LIBOBJS $SRCOBJS $STDEND

# the units' order (mkfiles/depend.rc): mini-mk depend after a build.
# old: none, the units made in any order: with NPROC 4 one compiled
# before the summary of another it names, nothing of it inlined
# (self-mix: Linux's objects not the card's, made one after the other)
depend:V:
	$RC $TOP/mkfiles/depend.rc '$D' $G . -- $LIB $SRC > .depend
<.depend

clean:V:
	rm -rf $D
