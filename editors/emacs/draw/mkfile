LIBI=-I .. -I ../core -I ../features -I ../modes -I ../../../lib_code -I ../../../languages/ml/highlight -I ../../../languages/c/highlight -I ../../../assembler/highlight -I ../../../languages/smalltalk/highlight -I ../../../languages/scheme/highlight -I ../../../languages/pascal/highlight -I ../../../languages/prolog/highlight -I ../../../lib_terminal -I ../../../lib_terminal/hosts -I ../../../lib_terminal/hosts/draw -I ../../../lib_graphics -I ../../../lib_playground/random -I ../../../languages/ml
