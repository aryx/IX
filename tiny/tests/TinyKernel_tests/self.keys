rc
mkdir /usr/glenda/self
cd /src
build boot.img > /usr/glenda/self/first.log
cp boot.img /usr/glenda/self/first.img
echo '(* a comment *)' >> TinyLibRegex.ml
build boot.img > /usr/glenda/self/comment.log
grep -c '^ml -c' /usr/glenda/self/comment.log; grep -c '^ld ' /usr/glenda/self/comment.log
echo 'let () = print_string ""' >> user/calc.ml
build boot.img > /usr/glenda/self/calc.log
grep -c '^ml -c' /usr/glenda/self/calc.log; grep -c '^ld .* -o calc ' /usr/glenda/self/calc.log; grep -c '^cat kernel.img > boot.img' /usr/glenda/self/calc.log
build boot.img
exit
