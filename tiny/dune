; TinyLibDraw.ml, a program's side of it, and TinyWindows.ml, tiny-kernel's
; window system: tiny-ml compiles them for the machine (TinyKernel/'s
; Makefile); OCaml too, which only checks the second (its externals are
; the machine's: no program is linked)
(library
 (name tiny_lib_draw)
 (wrapped false)
 (modules TinyLibDraw))

; TinyLibPlayground.ml, what a game of tiny-kernel's is written on, here
; for a game's test on the host: TinyCalls is the kernel's calls, kept
(library
 (name tiny_lib_playground)
 (wrapped false)
 (modules TinyLibPlayground)
 (libraries tiny_lib_draw tiny_host_calls))

; TinyAppTetris.ml, a game on it (tiny-kernel's tetris)
(library
 (name tiny_app_tetris)
 (wrapped false)
 (modules TinyAppTetris)
 (libraries tiny_lib_playground))

; TinyEditorScreen.ml, the screen editor: the editor itself, with no system
; under it (tests/TinyEditorScreen_tests/'s test types keys at it)
(library
 (name tiny_editor_screen)
 (wrapped false)
 (modules TinyEditorScreen)
 (libraries tiny_lib_draw))

; TinyOffice.ml, tiny-office's page and its parts, with no system under it
; (tests/TinyOffice_tests/'s test types keys and moves the mouse at it)
(library
 (name tiny_office)
 (wrapped false)
 (modules TinyOffice)
 (libraries tiny_editor_screen))

; TinyLibGUI.ml, what a program with buttons is written on, and
; TinyAppCalculator.ml and TinyAppTemperature.ml, tiny-kernel's calc and temp,
; on it
(library
 (name tiny_lib_gui)
 (wrapped false)
 (modules TinyLibGUI)
 (libraries tiny_lib_playground))

(library
 (name tiny_app_calculator)
 (wrapped false)
 (modules TinyAppCalculator)
 (libraries tiny_lib_gui))

(library
 (name tiny_app_temperature)
 (wrapped false)
 (modules TinyAppTemperature)
 (libraries tiny_lib_gui))

(library
 (name tiny_windows)
 (wrapped false)
 (modules TinyWindows)
 (libraries tiny_lib_draw))

; TinyBrowser.ml, www, tiny-kernel's browser: built here as a library for
