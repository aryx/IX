# mini-dotnet, built by ix's tools. The JIT's encoders are the linker's
# (Arm, Arm64): the linker's library, over the assembler's, linked here
# as by linker/tools. Its memory is jit/mini-ml/'s Code_memory, not
# dune's.
# old: the linker's units compiled again here, a rule each, the linker
# being made beside this directory, not before it; then its objects
# and the assembler's, named one by one
TOP=../..
DIR=languages/dotnet
PROG=mini-dotnet
SRC=Frame Arith Machine Verifier Jit Code_memory Jit_run CLI Main
LOCAL=`{ls *.ml *.mli interpreter/*.ml* jit/*.ml* jit/mini-ml/*.ml}
GEN=
LIBI=-I interpreter -I jit
# (assembly/, the file's tables, read and written: a library, which
# mini-cc, mini-ml, mini-csc, mini-tiger and mini-datalog link too;
# runtime/, Value, Library and Types, one too, which mini-csc links;
# the linker's, whose dirs name its build directory too: its units'
# summaries, which the JIT inlines from, as when compiled here)
LIBDIRS=assembler lib_executable linker languages/dotnet/assembly languages/dotnet/runtime
<$TOP/mkfiles/mkconfig
LIBOBJS=
<$TOP/mkfiles/mkprog

# the JIT's memory, mini-ml's version (jit/Code_memory.ml is dune's)
$D/Code_memory.$O: jit/mini-ml/Code_memory.ml
	$ML $INCLUDES -o $target jit/mini-ml/Code_memory.ml

# the units in folders (dune's comment says which): each one is
# compiled from the folder that has it, and mkprog's rule (for a unit
# here) is not used for them
$D/%.$O: interpreter/%.ml
	$ML $INCLUDES -o $target interpreter/$stem.ml
$D/%.$O: jit/%.ml
	$ML $INCLUDES -o $target jit/$stem.ml
