sizeofNode = 20;
aggr Node
{
	'X' 0 name;
	Point 4 p;
	'A' Node 12 next;
	'b' 16 c;
	'd' 18 s;
};

defn
Node(addr) {
	complex Node addr;
	print("	name	", addr.name\X, "\n");
	print("Point p {\n");
	Point(addr.p);
	print("}\n");
	print("	next	", addr.next\X, "\n");
	print("	c	", addr.c, "\n");
	print("	s	", addr.s, "\n");
};

