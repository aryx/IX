#############################################################################

# TinyKernel.ml and its parts, in ML, each unit after the ones before it;
# the assembly ML cannot say (entry.s: the traps, the switch; draw.s and
# memory.s, the pixels' and the memory's loops); runtime.c, ML's runtime
# given the machine's memory; font.s, the font's pixels (made on the
# host by fonts/Mkfont.ml, on the image as it is); end.s, the image's
# end, where the files it carries start. kernel.img: entry.o first, at 0
TinyKernel/runtime.o: TinyKernel/runtime.c runtime/ml.c
TinyKernel/kernel.o: $STDLIB TinyKernel/TinyMemory.tmi \
    TinyKernel/TinyKernelGraphics.tmi TinyKernel/TinyKernelNetwork.tmi \
    TinyKernel/TinyKernelAudio.tmi TinyKernel/TinyKernelFS.tmi \
    TinyKernel/TinyKernelMemory.tmi TinyKernel/TinyKernelMachine.tmi \
    TinyKernel/TinyKernelFiles.tmi TinyKernel/TinyKernelProcs.tmi \
    TinyKernel/TinyKernelDevices.tmi TinyKernel/TinyKernelIO.tmi \
    TinyKernel/TinyKernelCalls.tmi TinyKernel/TinyKernelScheduler.tmi \
    TinyKernel.tmi
	ml -o $target $prereq
kernel.img: TinyKernel/entry.o runtime/udivmod.o TinyKernel/runtime.o \
    TinyKernel/draw.o TinyKernel/memory.o TinyKernel/font.o \
    TinyKernel/kernel.o TinyKernel/TinyMemory.o \
    TinyKernel/TinyKernelGraphics.o TinyKernel/TinyKernelNetwork.o \
    TinyKernel/TinyKernelAudio.o TinyKernel/TinyKernelFS.o \
    TinyKernel/TinyKernelMemory.o TinyKernel/TinyKernelMachine.o \
    TinyKernel/TinyKernelFiles.o TinyKernel/TinyKernelProcs.o \
    TinyKernel/TinyKernelDevices.o TinyKernel/TinyKernelIO.o \
    TinyKernel/TinyKernelCalls.o TinyKernel/TinyKernelScheduler.o \
    TinyKernel.o $STDLIB $MLEND
	ld -map -o $target $prereq

#############################################################################
# The image
#############################################################################

# boot.img: the kernel, then each file it carries, its name, its size
# and its bytes: the programs in /bin, the examples, the library in
# /lib/ml and the runtimes in /lib/c and /lib/ml (the sources, /src,
# are on the disk, TinyKernel/Makefile's disk.img, made on the host).
# The same recipe on the host and on tiny-kernel, in a copy of tiny/
# (TinyKernel/Makefile's _make/src, the disk's /src). Two of the
# examples are made on the host alone, before: a profile and its map
# (examples/spin.prof and spin.map, tiny-cpu -prof's); and so is
# TinyKernel/font.s, the font's bytes. MEMORY, from the environment
# (TinyKernel/Makefile's MEMORY=segments or pages), the kernel's way of
# giving memory, in /lib/memory, with MEMSIZE.
UTILS = [ basename cat cmp cp date du echo grep kill ln ls mkdir mv ps pwd \
    rm seq sleep sort tail tee test touch walk wc xd
EXAMPLES = TinyKernel/steps/t6/user/wc.c TinyKernel/user/sh.c user/emacs.ml \
    TinyEditorScreen.ml examples/report.ixd examples/korobeiniki.wav \
    examples/spin.prof examples/spin.map TinyLibMachine.tmi TinyLibMachine.o \
    examples/hello.c examples/square.s examples/helloml.ml examples/Buildfile
LIBC = runtime/start.o runtime/udivmod.o runtime/libc.o TinyKernel/libc/sys.o TinyKernel/lib/c/Buildfile
LIBML = TinyLibSystem/tinykernel/mlsys.o TinyKernel/end.o TinyKernel/lib/ml/Buildfile

# (in /lib/ml, the library's interfaces and stdlib.a, as the Makefile's
# image)
LIBUNITS = ${CORE:%=TinyLibCore/%.tmi} $STDLIB

boot.img: kernel.img $PROGS $EXAMPLES $STDLIB $LIBC $LIBML
	cat kernel.img > $target
	for(f in $PROGS) { n=`{wc -c < $f}; echo bin/$f; echo $n; cat $f } >> $target
	for(f in $EXAMPLES) { n=`{wc -c < $f}; echo examples/^`{basename $f}; echo $n; cat $f } >> $target
	for(f in $LIBUNITS) { n=`{wc -c < $f}; echo lib/ml/^`{basename $f}; echo $n; cat $f } >> $target
	for(f in $LIBC) { n=`{wc -c < $f}; echo lib/c/^`{basename $f}; echo $n; cat $f } >> $target
	for(f in $LIBML) { n=`{wc -c < $f}; echo lib/ml/^`{basename $f}; echo $n; cat $f } >> $target
	for(u in $UTILS) { echo bin/$u; echo link bin/utils } >> $target
	{ echo bin/editor; echo link bin/emacs; echo bin/sam; echo link bin/ed } >> $target
	if(~ $MEMORY segments pages) { echo lib/memory; echo $MEMSIZE; echo $MEMORY } >> $target
	echo >> $target
#`

#############################################################################
# The units' dependencies
#############################################################################

# The ML units' rules, in .depend: a unit's object, then the interfaces
# of the units it names and its .mli, written by ml -depend as ocamldep
# writes OCaml's (and m-ix's mini-ml -depend). Its sources are every
# .ml of INCLUDES' directories (a unit added is found; the host's
# programs among them, TinyCPU.ml and TinyMachine.ml, are lines no
# target asks for, or left out, said, when tiny-ml cannot read them).
# The globs are written here, not in a variable: rc does not glob a *
# that comes from one. .depend is kept beside this file, as
# ocaml-light's stdlib keeps its own (TinyLibCore/ has its own too):
# `build depend` makes it again after a unit names another one, or a
# unit is added.
depend:
	ml -depend $INCLUDES *.ml TinyLibSystem/tinykernel/*.ml TinyC/*.ml TinyML/*.ml TinyOffice/*.ml TinyBrowser/*.ml TinyKernel/*.ml user/*.ml tests/TinyLibPlayground_tests/*.ml > .depend

<.depend

#############################################################################
# clean: what this file made removed (the objects and interfaces beside
# their sources, each directory by name; the programs, the kernel, the
# image, the maps)
#############################################################################

clean:
	cd TinyLibCore && build clean
	rm -f *.o *.tmi TinyBrowser/*.o TinyBrowser/*.tmi TinyC/*.o TinyC/*.tmi \
	    TinyKernel/*.o TinyKernel/*.tmi TinyKernel/libc/*.o \
	    TinyKernel/libc/*.tmi TinyKernel/user/*.o TinyKernel/user/*.tmi \
	    TinyLibSystem/tinykernel/*.o \
	    TinyLibSystem/tinykernel/*.tmi TinyML/*.o TinyML/*.tmi TinyOffice/*.o \
	    TinyOffice/*.tmi runtime/*.o runtime/*.tmi \
	    tests/TinyLibPlayground_tests/*.o tests/TinyLibPlayground_tests/*.tmi \
	    user/*.o user/*.tmi *.map $PROGS kernel.img boot.img
