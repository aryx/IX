#
# Small programs to read, build and run on tiny-kernel, in /examples,
# this directory, the same files; each its file's header:
#
#     C          ML           what
#     hello.c    helloml.ml   a print (hello with square.s, in assembly)
#     shapes.c   shapesml.ml  a picture drawn, the drawing's messages
#     fetch.c    fetchml.ml   a document of another machine, by Gopher
#     procs.c    procsml.ml   a pipe, fork, exec and wait: a shell's pipeline
#                game.ml      a ball, on the playground (TinyLibPlayground)
#                gui.ml       a counter, on the widgets (TinyLibGUI)
#     spin.s                  prof's example, with spin.prof
#
# build: all of them; build gui: one by its name. What they link besides
# their own objects is already built in /lib: /lib/c, C's runtime and
# tiny-kernel's calls, start.o first (the machine starts there), drawing
# and dialing; /lib/ml, ML's runtime (mlsys.o), the library (stdlib.a,
# its units), the libraries a program that draws stands on, and end.o,
# the program's end, last. They are built in /src and copied there by
# its build install. -s puts the labels after the image, the names debug
# shows; -map writes them beside it too.
#
# On the host, the same, the tools tiny-cc..., /lib tiny/lib (made by
# tiny-build TINY=tiny- LIB=lib install in tiny/):
#     tiny-build TINY=tiny- LIB=../lib

TINY =
CC = ${TINY}cc
AS = ${TINY}as
LD = ${TINY}ld
ML = ${TINY}ml
LIB = /lib

CRT = ${LIB}/c/start.o ${LIB}/c/udivmod.o ${LIB}/c/libc.o ${LIB}/c/sys.o
MLRT = ${LIB}/ml/mlsys.o
STDLIB = ${LIB}/ml/stdlib.a
MLEND = ${LIB}/ml/end.o
# (where tiny-ml reads the library's interfaces)
MLLIB = ${LIB}/ml
# (user.h: the system's calls a C program makes, and libc.h)
INC = ${LIB}/c
# (draw.o: the drawing's messages, draw.h's)
DRAW = ${LIB}/c/draw.o
# (net.o: dial by an address or by a name, reach)
NET = ${LIB}/c/net.o
# the libraries an ML program that draws stands on, each after the ones
# it uses: the system's calls, the drawing's messages, the playground,
# the widgets
SYS = ${LIB}/ml/TinyLibSystem.o
DRAWLIB = ${LIB}/ml/TinyLibDraw.o
PLAY = ${LIB}/ml/TinyLibPlayground.o
GUI = ${LIB}/ml/TinyLibGUI.o

all: hello shapes fetch procs helloml shapesml fetchml procsml game gui spin

hello: hello.o square.o
	$LD -map -s -n -o $target $CRT $prereq

hello.o: hello.c ${INC}/user.h
	$CC -I $INC -o $target hello.c
square.o: square.s
	$AS -o $target square.s

shapes: $DRAW shapes.o
	$LD -map -s -n -o $target $CRT $prereq
shapes.o: shapes.c ${INC}/user.h ${INC}/draw.h
	$CC -I $INC -o $target shapes.c

fetch: $NET fetch.o
	$LD -map -s -n -o $target $CRT $prereq
fetch.o: fetch.c ${INC}/user.h
	$CC -I $INC -o $target fetch.c

procs: procs.o
	$LD -map -s -n -o $target $CRT $prereq
procs.o: procs.c ${INC}/user.h
	$CC -I $INC -o $target procs.c

helloml: helloml.o
	$LD -map -s -n -o $target $CRT $MLRT $prereq $STDLIB $MLEND

# (one unit: its code and its start in one object)
helloml.o: helloml.ml
	$ML -L $MLLIB -o $target helloml.ml

# A program on libraries, as /src's: its unit compiled with their
# interfaces (-I), its start made by ml from all its units (their
# initializations in order, the globals' table), then linked by ld: the
# runtimes, the start, the library, the units, the end
%.o: %.ml
	$ML -c -L $MLLIB -I $MLLIB -o $target $stem.ml
%.start.o:
	$ML -o $target $prereq

SHAPESML_UNITS = $SYS $DRAWLIB shapesml.o
shapesml.start.o: $STDLIB $SHAPESML_UNITS
shapesml: $CRT $MLRT shapesml.start.o $STDLIB $SHAPESML_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

FETCHML_UNITS = $SYS fetchml.o
fetchml.start.o: $STDLIB $FETCHML_UNITS
fetchml: $CRT $MLRT fetchml.start.o $STDLIB $FETCHML_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

PROCSML_UNITS = $SYS procsml.o
procsml.start.o: $STDLIB $PROCSML_UNITS
procsml: $CRT $MLRT procsml.start.o $STDLIB $PROCSML_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

GAME_UNITS = $SYS $DRAWLIB $PLAY game.o
game.start.o: $STDLIB $GAME_UNITS
game: $CRT $MLRT game.start.o $STDLIB $GAME_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

GUI_UNITS = $SYS $DRAWLIB $PLAY $GUI gui.o
gui.start.o: $STDLIB $GUI_UNITS
gui: $CRT $MLRT gui.start.o $STDLIB $GUI_UNITS $MLEND
	$LD -map -s -n -o $target $prereq

# spin alone, no runtime: prof's example, with spin.prof, where its
# instructions went, which tiny-cpu -prof wrote on the host (tiny-kernel
# has no tiny-cpu; so it is kept here, and never made by build there):
#     prof spin.prof -u spin.map
#     tiny-build TINY=tiny- spin.prof     on the host, made again
spin: spin.o
	$LD -map -o $target spin.o
spin.map: spin
spin.o: spin.s
	$AS -o $target spin.s
spin.prof: spin
	tiny-cpu -prof $target spin > /dev/null

clean:
	rm -f hello shapes fetch procs helloml shapesml fetchml procsml game gui spin *.o *.tmi *.map
