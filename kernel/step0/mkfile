# mini-xv6, step 0: the bare board by ix's tools, before any OCaml
# (plan_kernel_mini_ml.md, steps 1, 2 and 9): the Pi 4 (arm64, O=7) or
# the Pi 1 (arm, mini-mk O=5: pi1/'s assembly and expected lines). Two
# images, without a header (-H0), their text where the board loads it
# (-T):
#   hello-s.img   a page of assembly (hello.s)
#   hello-c.img   a C program (hello.c) by mini-cc: l.s starts it, over
#                 goken's C library and shim.c in Linux's place
#   mini-mk          the images, under _mk/7/kernel/step0/
#   mini-mk check    each booted under mini-qemu, and under QEMU if it
#                    is there: its line
TOP=../..
<$TOP/mkfiles/mkconfig
<$TOP/kernel/lib/mkboard
D=$B/kernel/step0
IMAGE=$LD -H0 -T $LOAD -E _start -nofollow

all:V: $D/hello-s.img $D/hello-c.img

# (the assembly is the board's; the C is for both)
$D/hello.$O: ${P}hello.s
	mkdir -p $D
	$AS -o $target ${P}hello.s
$D/l.$O: ${P}l.s
	mkdir -p $D
	$AS -o $target ${P}l.s
$D/shim.$O: shim.c
	mkdir -p $D
	$CC $CINC -o $target shim.c
$D/helloc.$O: hello.c
	mkdir -p $D
	$CC $CINC -o $target hello.c

$D/hello-s.img: $D/hello.$O
	$IMAGE -o $target $D/hello.$O
$D/hello-c.img: $D/l.$O $D/shim.$O $D/helloc.$O $L/libc.a
	$IMAGE -o $target $D/l.$O $D/shim.$O $D/helloc.$O $L/libc.a

# a kernel does not stop: its line, then the emulator is ended
check:V: all
	for k in s c; do
		boot=`echo "$BOOT" | sed "s|IMAGE|$D/hello-$k.img|"`
		timeout 3 mini-qemu $boot -nographic < /dev/null > $D/mini-$k.txt 2> /dev/null || true
		cmp $D/mini-$k.txt ${P}expected-$k && echo "ok step0: hello-$k under mini-qemu"
		if [ -x "`command -v $QEMU`" ]; then
			timeout 3 $QEMU $boot $QEMUSMP -display none -monitor none -serial file:$D/qemu-$k.txt < /dev/null 2> /dev/null || true
			cmp $D/qemu-$k.txt ${P}expected-$k && echo "ok step0: hello-$k under QEMU"
		fi
	done

clean:V:
	rm -rf $D
